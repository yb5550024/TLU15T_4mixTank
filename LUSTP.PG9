PROCEDURE  MP1
PARAMETERS  P1,P2,P3
  MX="1"
  MLA_LAG=0
  XSTP=INT((VUSE+RATVOL-0.1)/RATVOL)
  DO WHILE MLA_LAG < VUSE
    IF VAL(MX) < XSTP
      MLA_LAG=MLA_LAG+RATVOL
      SELE 2
      XM_PLUS=0
      FOR XNP=1  TO 12
	XNPC=LTRIM(STR(INT(XNP),2,0))
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * RATVOL
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := 0
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,5] := RATVOL
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG
	IF LCHTYPE=16	.OR.  UCHTYPE=19   .OR.  UCHTYPE=30
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * RATVOL
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,3] := 0
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,5] := RATVOL
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG
	ENDIF

	IF XNP <=5
	  IF M&XNPC >0
	    XM_PLUS=XM_PLUS + A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]
	  ENDIF
	ENDIF
      NEXT
      SELE 16
      LOCA  FOR (DSRATNO=ARATNO)
      IF .NOT.	EOF()
	A_PRESS_N0[GD_PRESS,VAL(MX),8,3] := DSCO1  * RATVOL
	A_PRESS_N0[GD_PRESS,VAL(MX),9,3] := DSCO2  * RATVOL
	FOR XNP=1  TO 5
	  X_DSW=(DSCO1 +DSCO2) * RATVOL *A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]/XM_PLUS
	  XNPC=LTRIM(STR(INT(XNP),2,0))
	  IF A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] >0
	    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := X_DSW
	  ENDIF
	NEXT
      ENDIF
      SELE 2
    ELSE
      LVUSE=VUSE -MLA_LAG
      MLA_LAG=VUSE
      XM_PLUS=0
      SELE 2
      FOR XNP=1  TO 12
	XNPC=LTRIM(STR(INT(XNP),2,0))
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * LVUSE
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := 0
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,5] := LVUSE
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG

	IF LCHTYPE=16	 .OR.  UCHTYPE=19  .OR.  UCHTYPE=30
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * RATVOL
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,3] := 0
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,5] := RATVOL
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG
	ENDIF

	IF XNP <=5
	  IF M&XNPC >0
	    XM_PLUS=XM_PLUS + A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]
	  ENDIF
	ENDIF
      NEXT
      SELE 16
      LOCA  FOR (DSRATNO=ARATNO)
      IF .NOT.	EOF()
	A_PRESS_N0[GD_PRESS,VAL(MX),8,3] := DSCO1  * LVUSE
	A_PRESS_N0[GD_PRESS,VAL(MX),9,3] := DSCO2  * LVUSE
	FOR XNP=1  TO 5
	  X_DSW=(DSCO1 +DSCO2) * LVUSE	*A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]/XM_PLUS
	  XNPC=LTRIM(STR(INT(XNP),2,0))
	  IF A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] >0
	    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := X_DSW
	  ENDIF
	NEXT
      ENDIF
      SELE 2
    ENDIF
    MX=LTRIM(STR(INT(VAL(MX)+1),2,0))
  ENDDO
RETU
**-----------------------------------------------------------------------------
PROCEDURE  MP1_1
PARAMETERS  P1,P2,P3
SELE 8
MX=INT((VUSE+0.4)*2)*.5
LOCA FOR (MLAV=RATVOL) .AND.(MLMV=MX)
IF   .NOT. EOF()
  MX="1"
  MLA_LAG=0
  DO WHILE MLA&MX >0
    IF MLMV_1 > MLA_LAG
      X_MLA=MLA&MX
      MLA_LAG=MLA_LAG+X_MLA
      XM_PLUS=0
      SELE 2
      FOR XNP=1  TO 12
	XNPC=LTRIM(STR(INT(XNP),2,0))
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * X_MLA
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := 0
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,5] := X_MLA
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG
	IF LCHTYPE=16	.OR.  UCHTYPE=19   .OR.  UCHTYPE=30
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * RATVOL
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,3] := 0
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,5] := RATVOL
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG
	ENDIF




	IF XNP <=5
	  IF M&XNPC >0
	    XM_PLUS=XM_PLUS + A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]
	  ENDIF
	ENDIF
      NEXT
      SELE 16
      LOCA  FOR (DSRATNO=ARATNO)
      IF .NOT.	EOF()
	A_PRESS_N0[GD_PRESS,VAL(MX),8,3] := DSCO1  * X_MLA
	A_PRESS_N0[GD_PRESS,VAL(MX),9,3] := DSCO2  * X_MLA
	FOR XNP=1  TO 5
	  X_DSW=(DSCO1 +DSCO2) * X_MLA	*A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]/XM_PLUS
	  XNPC=LTRIM(STR(INT(XNP),2,0))
	  IF A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] >0
	    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := X_DSW
	  ENDIF
	NEXT
      ENDIF
      SELE 8
    ELSE
      LVUSE=VUSE -MLMV_1
      MLA_LAG=MLA_LAG+LVUSE
      XM_PLUS=0
      SELE 2
      FOR XNP=1  TO 12
	XNPC=LTRIM(STR(INT(XNP),2,0))
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * LVUSE
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := 0
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,5] := LVUSE
	A_PRESS_N0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG

	IF LCHTYPE=16	.OR.  UCHTYPE=19   .OR.  UCHTYPE=30
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * RATVOL
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,3] := 0
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,5] := RATVOL
	  A_PRESS_B0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG
	ENDIF





	IF XNP <=5
	  IF M&XNPC >0
	    XM_PLUS=XM_PLUS + A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]
	  ENDIF
	ENDIF
      NEXT
      SELE 16
      LOCA  FOR (DSRATNO=ARATNO)
      IF .NOT.	EOF()
	A_PRESS_N0[GD_PRESS,VAL(MX),8,3] := DSCO1  * LVUSE
	A_PRESS_N0[GD_PRESS,VAL(MX),9,3] := DSCO2  * LVUSE
	FOR XNP=1  TO 5
	  X_DSW=(DSCO1 +DSCO2) * LVUSE	*A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]/XM_PLUS
	  XNPC=LTRIM(STR(INT(XNP),2,0))
	  IF A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] >0
	    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := X_DSW
	  ENDIF
	NEXT
      ENDIF
      SELE 8
    ENDIF
    MX=LTRIM(STR(INT(VAL(MX)+1),2,0))
  ENDDO
ELSE
  DO MP1
ENDIF
RETU
**------------------------------------------------------------------------------------------------------------
PROCEDURE  STP1
PARAMETERS  P1,P2,P3
STP_ZN=0
STP_FN=1
STP_FC="1"
DO CASE
CASE (STP1=0)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE (LCHTYPE=2 .or. LCHTYPE=6 .or. LCHTYPE=7 .or. LCHTYPE=9 .or. LCHTYPE=10	.or. LCHTYPE=11  .or. LCHTYPE=12  .or. LCHTYPE=13 ) .AND. NEXTOK1=1
    IF (A_PRESS_N0[1,21,STP_FN,1] =77)
      A_PRESS_N0[1,21,STP_FN,1] :=0
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      NEXTOK1=0
      A_PRESS_N0[1,21,STP_FN,1] :=0
      STP&STP_FC=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,ix,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE LCHTYPE=4 .AND. NEXTOK1=1 .and. STP2=0 .and. STP3=0
    IF (A_PRESS_N0[1,21,1,1] =77)
      A_PRESS_N0[1,21,1,1] :=0
      A_PRESS_N0[1,21,2,1] :=0
      A_PRESS_N0[1,21,3,1] :=0
      a_copy_4(A_PRESS_N0,1,3)
      NEXTOK1=0
      STP1=1
      STP2=0
      STP3=0
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,ix,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE	(LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5 .OR. LCHTYPE=30 .OR. LCHTYPE=15 ) .AND. NEXTOK1=1 .and. STP2=0 .and. STP3=0 .and. STP4=0
    IF (A_PRESS_N0[1,21,1,1] =77)
      A_PRESS_N0[1,21,1,1] :=0
      A_PRESS_N0[1,21,2,1] :=0
      A_PRESS_N0[1,21,3,1] :=0
      A_PRESS_N0[1,21,4,1] :=0
      a_copy_4(A_PRESS_N0,1,4)
      IF UCHTYPE=19	    .OR.  storb_e=1
	a_copy_4(A_PRESS_B0,1,4)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP1=1
      STP2=0
      STP3=0
      STP4=0
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,ix,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE	(LCHTYPE=21 ) .AND. NEXTOK1=1 .and. STP2=0 .and. STP3=0 .and. STP4=0 .and. STP5=0
    IF (A_PRESS_N0[1,21,1,1] =77)
      A_PRESS_N0[1,21,1,1] :=0
      A_PRESS_N0[1,21,2,1] :=0
      A_PRESS_N0[1,21,3,1] :=0
      A_PRESS_N0[1,21,4,1] :=0
      A_PRESS_N0[1,21,5,1] :=0
      a_copy_4(A_PRESS_N0,1,5)
      NEXTOK1=0
      STP1=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,ix,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE (LCHTYPE=8  .or. LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26 )  .AND. NEXTOK1=1 .and. STP2=0
    IF (A_PRESS_N0[1,21,1,1] =77)
      A_PRESS_N0[1,21,1,1] :=0
      A_PRESS_N0[1,21,2,1] :=0
      a_copy_4(A_PRESS_N0,1,2)
      IF LCHTYPE=16
	a_copy_4(A_PRESS_B0,1,2)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP1=1
      STP2=0
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,ix,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  ENDCASE

CASE (STP1=1)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  STP1=2
  IF STPN1=1
    E_STORE = 1
    X=_TOT_D_A[20,4] +2
    IF _TOT_D_A[2,X]=0
      E_STORE = 0
    ENDIF
    &&IF E_STORE =1
    &&	DO  PNT_TIT
    &&ENDIF
  ENDIF
  DO  CASE
  CASE LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7  .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12  .or. LCHTYPE=13
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      WTANK_F[STP_FN,1] :=77	&& 77=­p¶q¤¤,1=­p¶qok,-99=can ¶i®Æ,0=NOTHING
      STP1=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE LCHTYPE=4
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      IF KOT=1
	WTANK_F[1,1] :=77
	WTANK_F[2,1] :=77
	WTANK_F[3,1] :=77
      ENDIF
      STP1=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE	 LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5   .OR. LCHTYPE=30	.OR. LCHTYPE=15
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      WTANK_F[1,1] :=77
      WTANK_F[2,1] :=77
      WTANK_F[3,1] :=77
      WTANK_F[4,1] :=77
      STP1=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE	 LCHTYPE=21
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      WTANK_F[1,1] :=77
      WTANK_F[2,1] :=77
      WTANK_F[3,1] :=77
      WTANK_F[4,1] :=77
      WTANK_F[5,1] :=77
      STP1=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE (LCHTYPE=8  .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26  )
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      WTANK_F[1,1] :=77
      WTANK_F[2,1] :=77
      STP1=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  ENDCASE
CASE STP1=2
  DO CASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    SETDLA(0,0)
    DO CASE
    CASE LCHTYPE=2 .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      WTANK_F[STP_FN,1] :=1    && 77=­p¶q¤¤,1=­p¶qok,-99=can ¶i®Æ,0=NOTHING
      STP&STP_FC=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      STP&STP_FC=4
    CASE LCHTYPE=4
      STP1=0
      STP2=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30	 .or.  LCHTYPE=8    .OR. LCHTYPE=15  .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=21 .or. LCHTYPE=26
      STP1=0
      STP2=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    ENDCASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    ADJWN=0
    ADJWN_f=0
    IF WATER_INPUT=1

      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * G1_WATER/100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      IF  UCHTYPE=16 .or. UCHTYPE=17
	XA1=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * GS_ADJ[1]  /100)
	XA2=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] * GS_ADJ[3]	/100)
	GS_ADJW[3]=XA1 +XA2
	XA1=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * GS_ADJ[2]  /100)
	XA2=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] * GS_ADJ[4]	/100)
	GS_ADJW[4]=XA1 +XA2
      ENDIF
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] *(1+ ((GS_ADJ[1] +GS_ADJ[2]) /100)))
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * G1_WATER   /100)
      do  case
      case  lchtype=21
	 ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * WATER_inc[stp_fn]/100)
	 ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * WATER_inc[stp_fn]/100)
	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      endcase
    ENDIF
    DO CASE
    CASE LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] + ADJWN )
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1  && THE WEIGHT SCALE BIGGER THEN THE SETTING DATA
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +ADJWN_f  PICT "&XMC_F"
	  DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
	  WTANK_F[STP_FN,1] :=1     && 77=­p¶q¤¤,1=­p¶qok,-99=can ¶i®Æ,0=NOTHING
	  EWN=WDATA(STP_ZN)-2048
	  EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	  XMC_F=A_M_NAME[STP_FN,3]
	  *@  8,A_M_NAME[STP_FN,13]  SAY  EW1	PICT "&XMC_F"
	  SETCHDATA(STP_ZN,EWN)
	  STP&STP_FC=4
	ENDIF
	RETU
      ENDIF
    CASE LCHTYPE=4
      RDDLY(STP_FN,0,A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1])
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1  && THE WEIGHT SCALE BIGGER THEN THE SETTING DATA
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)  .OR. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+2,1]>0)
	    EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=EW1*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(0,EWN)
	    STP1=0
	    STP2=1
	  ELSE
	    EWN=WDATA(0)-2048
	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(0,EWN)
	    STP1=0
	    STP2=1
	  ENDIF
	ENDIF
	RETU
      ENDIF
    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30	 .or. LCHTYPE=8  .OR. LCHTYPE=15   .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=21 .or. LCHTYPE=26
      RDDLY(STP_FN,0,A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1])
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1  && THE WEIGHT SCALE BIGGER THEN THE SETTING DATA
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)  .OR. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+2,1]>0)  .OR. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+3,1]>0)
	     if  storb_e=1
	       EW1=A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,1]
	       A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	     endif

	    EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=EW1*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(0,EWN)
	    STP1=0
	    STP2=1
	  ELSE
	    EWN=WDATA(0)-2048
	    if	 storb_e=1
	      EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
	      A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    endif
	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(0,EWN)
	    STP1=0
	    STP2=1
	  ENDIF
	ENDIF
	RETU
      ENDIF
    ENDCASE
    XMC_F=A_M_NAME[STP_FN,3]
    @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN_f  PICT "&XMC_F"
    SET COLOR TO &C2  / &C1
    *MTANK_MARK(6,STP_FN,1)
    DSPA_ARROW(STP_FN,1,14)  && úD
    do case
    CASE LCHTYPE=2 .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      SET COLOR TO &C10 / &C1
      *@ 11,7  SAY   "úZúYúYúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
      CLEACHW(0)  &&CLEA  EACH	LEVAL OF WEIGHT
      *WEIG_RESCALL(STP_FN)
    CASE LCHTYPE=4
      SET COLOR TO &C10 / &C1
      *@ 11,7  SAY   "úZúYúYúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
      CLEACHW(0)  &&CLEA  EACH	LEVAL OF WEIGHT
      WEIG_RESCALL(STP_FN)
    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5 .OR. LCHTYPE=30  .or. LCHTYPE=8  .OR. LCHTYPE=15	 .or.  LCHTYPE=16 .or. LCHTYPE=17  .or. LCHTYPE=21 .or. LCHTYPE=26
      SET COLOR TO &C10 / &C1
      *@ 11,7  SAY   "úZúYúYúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
      CLEACHW(0)  &&CLEA  EACH	LEVAL OF WEIGHT
      WEIG_RESCALL(STP_FN)
    ENDCASE
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
    SET COLOR TO &C7 +/ &C1
    CLEACHMEM(STP_ZN)
    SETDLA(0,0)
    SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] +ADJWN
    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETOK(STP_ZN)
    DOUT(STP_ZN,1)
    STP1=3
  ENDCASE
CASE STP1=3
  DO CASE
  case	LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
    ADJWN=0
    IF WATER_INPUT=1
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * G1_WATER /100)
    ENDIF
    X=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
    IF	ADJWN	<> X
      ADJW12(STP_ZN,(ADJWN  -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] :=ADJWN
      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * G1_WATER /100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      XMC_F=A_M_NAME[STP_FN,3]
      IF MODY_D1=0
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN_f  PICT "&XMC_F"
      ENDIF
    ENDIF
  ENDCASE
  TST1_LS1(STP_FN)
  IF LS1[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS2(STP_FN)
  IF RDOK2(STP_ZN)=0
    DOUT(STP_ZN,0)
    STOPTM&STP_FC=0
    DOUT3(0,0)
    EWN=CHENDATA(STP_ZN)
    if lchtype=14   .OR. LCHTYPE=32    .OR.  storb_e=1
      EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
      A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    endif
    EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
    XMC_F=A_M_NAME[STP_FN,3]
    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
    SET COLOR TO &C2 / &C1
    *MTANK_MARK(6,STP_FN,0)
    DSPA_ARROW(STP_FN,0,0) && EREASE úD
    SET COLOR TO &C7 +/ &C1
    DO CASE
    CASE LCHTYPE=2 .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      WTANK_F[STP_FN,1] :=1	&& 77=­p¶q¤¤,1=­p¶qok,-99=can ¶i®Æ,0=NOTHING
      STP1=4
      *STP2=2
      *X=EWN
      *SETDLA(0,X)
    CASE LCHTYPE=4
      STP1=0
      STP2=2
      X=EWN
      SETDLA(0,X)
    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30	  .or.	LCHTYPE=8  .OR. LCHTYPE=15 .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=21 .or. LCHTYPE=26
      STP1=0
      STP2=1
      X=EWN
      SETDLA(0,X)
    ENDCASE
  ENDIF
CASE STP1=4  .AND.  (WTANK_F[1,1]=-99)
  IF KOT=1
    IF ( DIN(9)=1 )   .OR.  ( DIN(12)=0)
      RETU
    ENDIF
  ELSE
    IF ( DIN(8)=1) .OR. (DIN(11)=0)
      RETU
    ENDIF
  ENDIF
  IF  TIME1[STP_FN,2] =0
    TIME1[STP_FN,2] :=SECONDS()
  ENDIF
  IF ABS(SECONDS()-TIME1[STP_FN,2]) >=TIME1[STP_FN,1]
    TIME1[STP_FN,2] :=0
    STP1=5
  ENDIF
  IF GS_DROPOK(A_M_NAME[STP_FN,8] +1)<> 1
    IF SPACIAL_0=0
      STP1=4
    ENDIF
  ENDIF
CASE STP1=5
  GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=2
  IF LCHTYPE=2	.or. LCHTYPE=6	.or. LCHTYPE=7	 .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
    WTANK_F[STP_FN,1]=0
    TOTDR1=TOTDR1-1
    DRTKF=0
    TOTANK1=0
    STP&STP_FC=6
    if	(A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
      SET COLOR TO &C11 / &C1
      *@ 11,7  SAY   "úLúPúPúKúPúPúO"
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
      dout2(A_M_NAME[STP_FN,8],1)
      SETZERTM(0,PZERTM1)
      SETZEROK(0)
    endif
    TOTANK=1
    SET COLOR TO &C7 +/ &C1
    *SETZER(0,INT((A_M_NAME[1,7]/A_M_NAME[1,6])*PER*2048)+2048)
    if	lchtype=2
      IF LAGDATE=DATE()
	LAGW=LAGW+ A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]
      ELSE
	LAGW= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]
	LAGDATE=DATE()
      ENDIF
      SAVE TO LAGDATA9 ALL LIKE LAG*
      @ 0,26 SAY  LAGW	 PICT  "9999.9"
      ACT_V=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,6]
      @ 17,12 SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,6]  PICT  "99.9"
    endif
  ENDIF
CASE STP1=6
    if	(A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
      TST1_LS2(STP_FN)
      IF LS2[STP_FN,2]=1
	RETU
      ENDIF
      TST0_LS1(STP_FN,STP_FN)
    else
      setZokn(A_M_NAME[STP_FN,8],0)
    ENDIF
  IF  RDZEROK(A_M_NAME[STP_FN,8])=0
      dout2(A_M_NAME[STP_FN,8],0)
      *DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[1,13]  SAY  "    " PICT "&XMC_F"
      A_M_NAME[1,10] := A_M_NAME[1,9]
      A_M_NAME[1,12] := A_M_NAME[1,6]
      CLEACHMEM(0)
      STPN1=STPN1+1
      STP1=7
      SET COLOR TO &C2 / &C1
      *@ 11,7  SAY   "úLúPúPúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[1,1] :=0
      WTANK_F[1,2] :=1
  ENDIF
CASE STP1=7
  GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=1
  GS_DROPRST()
  IF  LCHTYPE=2 .or. LCHTYPE=6	.or. LCHTYPE=7.or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP1=1
    ELSE
      STP1=0
      STPN1=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  ENDIF
ENDCASE
RETU
**------------------------------------------------------------------------------------------------------------
PROCEDURE  STP2
PARAMETERS  P1,P2,P3
STP_ZN=1
STP_FN=2
STP_FC="2"
DO CASE
CASE (STP2=0)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE (LCHTYPE=2 .or. LCHTYPE=6 .or. LCHTYPE=7  .or. LCHTYPE=9 .or. LCHTYPE=10  .or. LCHTYPE=11 .or. LCHTYPE=12  .or. LCHTYPE=13  )  .AND. NEXTOK1=1
    IF (A_PRESS_N0[1,21,STP_FN,1] =77)
      A_PRESS_N0[1,21,STP_FN,1] :=0
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      NEXTOK1=0
      A_PRESS_N0[1,21,STP_FN,1] :=0
      STP&STP_FC=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,ix,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE LCHTYPE=4
  ENDCASE
CASE (STP2=1)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7   .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
    IF ((A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1))
      WTANK_F[STP_FN,1] :=77
      STP&STP_FC=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE LCHTYPE=4
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP2=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE	 LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30   .OR.  LCHTYPE=8	.OR. LCHTYPE=15 .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=21 .or. LCHTYPE=26
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP2=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  ENDCASE
CASE STP2=2
  DRAF=0
  dspch1_nor=0
  GS_CHG=0
  DO CASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    dspch1_nor=1
    DO CASE
    CASE LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7  .OR. LCHTYPE=8 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12  .or. LCHTYPE=13   .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26
      STP&STP_FC=4
      WTANK_F[STP_FN,1] :=1
      DO CASE
      CASE LCHTYPE=8  .or.  LCHTYPE=16 .or. LCHTYPE=17	 .or. LCHTYPE=26
	WTANK_F[STP_FN-1,1] :=1
      ENDCASE
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE LCHTYPE=4
      STP2=0
      STP3=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5 .OR. LCHTYPE=30	.OR. LCHTYPE=15.or. LCHTYPE=21
      STP2=0
      STP3=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    ENDCASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    dspch1_nor=0
    X=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]
    IF	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
      DSPDATA_A[STP_FN] := 1
    ELSE
      DSPDATA_A[STP_FN] := 0
    ENDIF
    ADJWN=0
    ADJWN_f=0
    IF WATER_INPUT=1

      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] *(1+ ((GS_ADJ[3] +GS_ADJ[4]) /100)))
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * (G2_WATER )/100)

      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * G2_WATER /100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      do  case
      case  lchtype=21
	 ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * WATER_inc[stp_fn]/100)
	 ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * WATER_inc[stp_fn]/100)
	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      endcase
    ENDIF
    DO CASE
    CASE LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] + ADJWN)
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] + ADJWN_f PICT "&XMC_F"
	  WTANK_F[STP_FN,1] :=1
	  EWN=WDATA(STP_ZN)-2048
	  EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	  XMC_F=A_M_NAME[STP_FN,3]
	  *@  8,A_M_NAME[STP_FN,13]  SAY  EW1	PICT "&XMC_F"
	  *SETCHDATA(STP_ZN,EWN)
	  *SETDLA(0,EWN)
	  EWN=WDATA(1)-2048
	  SETCHDATA(STP_ZN,EWN)
	  STP&STP_FC=4
	endif
	DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
	RETU
      endif
    CASE LCHTYPE=4
      RDDLY(STP_FN,0,A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4])
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	    EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=(EW1)*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    EWN=(EW1+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4])*2048/A_M_NAME[STP_FN,10]
	    SETDLA(0,EWN)
	    STP2=0
	    STP3=1
	  ELSE
	    EWN=WDATA(0)-2048
	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048) -A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4]
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=(EW1)*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    EWN=(EW1+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4])*2048/A_M_NAME[STP_FN,10]
	    SETDLA(0,EWN)
	    STP2=0
	    STP3=1
	  ENDIF
	ENDIF
	RETU
      ENDIF
    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5 .OR. LCHTYPE=30	.OR. LCHTYPE=15  .or. LCHTYPE=21
      RDDLY(STP_FN,0,A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4])
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0) .OR. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+2,1] >0)
	     if  storb_e=1
	       EW1=A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,1]
	       A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	     endif
	    EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=(EW1)*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    EWN=(EW1+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4])*2048/A_M_NAME[STP_FN,10]
	    SETDLA(0,EWN)
	    STP2=0
	    STP3=1
	  ELSE
	    EWN=WDATA(0)-2048
	    if	 storb_e=1
	      EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
	      A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    endif
	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048) -A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4]
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=(EW1)*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    EWN=(EW1+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4])*2048/A_M_NAME[STP_FN,10]
	    SETDLA(0,EWN)
	    STP2=0
	    STP3=1
	  ENDIF
	ENDIF
	RETU
      ENDIF
    ENDCASE
    XMC_F=A_M_NAME[STP_FN,3]
    *MTANK_MARK(6,STP_FN,1)
    IF DSPDATA_A[STP_FN] =1
      @  4,A_M_NAME[STP_FN,13]	SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ ADJWN_f	PICT "&XMC_F"
      SET COLOR TO &C2	/ &C1
      *MTANK_MARK(6,STP_FN,1)
      DSPA_ARROW(STP_FN,1,14)  &&   úD
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
    ELSE
      IF LCHTYPE=14  .OR. LCHTYPE=32
	 IF   (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] = 0 )	.AND. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,8] > 0 )
	   ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,8] * S1_WATER /100)
	   A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,11]=ADJWN_f
	    @  4,A_M_NAME[STP_FN+1,13]	SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,8]+ ADJWN_f  PICT "&XMC_F"
	    SET COLOR TO &C2  / &C1
	    *MTANK_MARK(6,STP_FN,1)
	    DSPA_ARROW(STP_FN+1,1,14)  &&   úD
	    DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
	    GS_CHG=2
	 ENDIF
      ENDIF
    endif
    do case
    CASE LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      SET COLOR TO &C10 / &C1
      *@ 11,7  SAY   "úZúYúYúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
      WEIG_RESCALL(STP_FN)
    CASE LCHTYPE=4
      SET COLOR TO &C10 / &C1
      *@ 11,7  SAY   "úZúYúYúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
      WEIG_RESCALL(STP_FN)
    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30	 .OR. LCHTYPE=8  .OR. LCHTYPE=15 .or.  LCHTYPE=16 .or. LCHTYPE=17  .or. LCHTYPE=26  .or. LCHTYPE=21
      SET COLOR TO &C10 / &C1
      *@ 11,7  SAY   "úZúYúYúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
      WEIG_RESCALL(STP_FN)
    ENDCASE
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
    SET COLOR TO &C7 +/ &C1
    CLEACHMEM(STP_ZN)
    SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]  + ADJWN
    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETOK(STP_ZN)
    DOUT(STP_ZN,1)
    STP2=3
  ENDCASE
CASE STP2=3
  DO CASE
  case	LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
    ADJWN=0
    IF WATER_INPUT=1
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * G2_WATER /100)
    ENDIF
    X=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
    IF	ADJWN	<> X
      ADJW12(STP_ZN,(ADJWN  -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] :=ADJWN
      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * G2_WATER /100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      XMC_F=A_M_NAME[STP_FN,3]
      IF MODY_D1=0
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN_f  PICT "&XMC_F"
      ENDIF
    ENDIF
  ENDCASE
  TST1_LS1(STP_FN)
  IF LS1[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS2(STP_FN)
      IF RDOK2(STP_ZN)=0
	DOUT(STP_ZN,0)
	STOPTM&STP_FC=0
	EWN=CHENDATA(STP_ZN)
	if lchtype=14  .OR. LCHTYPE=32	    .OR.  storb_e=1
	  EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
	  A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	endif
	EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	XMC_F=A_M_NAME[STP_FN,3]
	*@  8,A_M_NAME[STP_FN,13]  SAY	EW1   PICT "&XMC_F"
	SET COLOR TO &C2 / &C1
	*MTANK_MARK(6,STP_FN,0)
	DSPA_ARROW(STP_FN,0,0)	&& EREASE  úD
	SET COLOR TO &C7 +/ &C1
	DO CASE
	CASE LCHTYPE=2	.or. LCHTYPE=6	.or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
	  STP&STP_FC=4
	  WTANK_F[STP_FN,1] :=1
	  *STP2=2
	  *X=EWN
	  *SETDLA(0,X)
	CASE LCHTYPE=8 .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26
	  STP&STP_FC=4
	  WTANK_F[STP_FN-1,1] :=1
	  WTANK_F[STP_FN,1] :=1
	CASE LCHTYPE=4
	  STP2=0
	  DOUT3(0,0)
	  STP3=1
	  EWN=EWN+CHENDATA(0)
	  SETDLA(0,EWN)
	CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30  .OR. LCHTYPE=15  .or. LCHTYPE=21
	  DSPA_ARROW(STP_FN+1,0,0)  && EREASE  úD
	  STP2=0
	  DOUT3(0,0)
	  STP3=1
	  EWN=EWN+CHENDATA(0)
	  SETDLA(0,EWN)
	ENDCASE
      ENDIF
CASE STP2=4  .AND.  (WTANK_F[2,1]=-99)
  IF KOT=1
    IF ( DIN(9)=1 )   .OR.  ( DIN(12)=0)
      RETU
    ENDIF
  ELSE
    IF ( DIN(8)=1) .OR. (DIN(11)=0)
      RETU
    ENDIF
  ENDIF
  IF  TIME1[STP_FN,2] =0
    TIME1[STP_FN,2] :=SECONDS()
  ENDIF
  IF ABS(SECONDS()-TIME1[STP_FN,2]) >=TIME1[STP_FN,1]
    TIME1[STP_FN,2] :=0
    STP2=5
  ENDIF
  IF GS_DROPOK(A_M_NAME[STP_FN,8] +1)<> 1
    IF SPACIAL_0=0
      STP2=4
    ENDIF
  ENDIF
CASE STP2=5
  GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=2
  DO CASE
  CASE	LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
    WTANK_F[2,1]=0
    TOTDR1=TOTDR1-1
    DRTKF=0
    TOTANK1=0
    STP2=6
    if	(A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
      SET COLOR TO &C11 / &C1
      *@ 11,7  SAY   "úLúPúPúKúPúPúO"
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
      SETZERTM(1,PZERTM2)
      SETZEROK(1)
      dout2(A_M_NAME[STP_FN,8],1)
    ENDIF
    TOTANK=1
    SET COLOR TO &C7 +/ &C1
    *SETZER(1,INT(((PZER2/A_M_NAME[2,6]))*PER*2048)+2048)
  CASE	  LCHTYPE=8 .or.  LCHTYPE=16 .or. LCHTYPE=17  .or. LCHTYPE=26
    WTANK_F[1,1]=0
    WTANK_F[2,1]=0
    TOTDR1=TOTDR1-1
    DRTKF=0
    TOTANK1=0
    STP2=6
    do	case
    case   UCHTYPE=16 .or. UCHTYPE=17
      if ( ( A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .AND. ( A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0))
	RETU
      ENDIF
    endcase
    SET COLOR TO &C11 / &C1
    *@ 11,7  SAY   "úLúPúPúKúPúPúO"
    DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    TOTANK=1
    SET COLOR TO &C7 +/ &C1
    SETZERTM(0,PZERTM1)
    *SETZER(1,INT(((PZER2/A_M_NAME[2,6]))*PER*2048)+2048)
    SETZEROK(0)
    dout2(A_M_NAME[STP_FN,8],1)
  ENDCASE
CASE STP2=6
  do case
  case lchtype=16 .or. LCHTYPE=17 .or. LCHTYPE=26
    if ( (A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  <> 0) .OR. (A_PRESS_N0[L_PRESS,1,STP_FN,1] <> 0))
      TST1_LS2(STP_FN)
      IF LS2[STP_FN,2]=1
	RETU
      ENDIF
      TST0_LS1(STP_FN,STP_FN)
    ELSE
      setZokn(A_M_NAME[STP_FN,8],0)
    ENDIF
  otherwise
    if ((LCHTYPE <> 6 .and.  LCHTYPE <> 13)  .OR.  (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0))
      TST1_LS2(STP_FN)
      IF LS2[STP_FN,2]=1
	RETU
      ENDIF
      TST0_LS1(STP_FN,STP_FN)
    ELSE
      setZokn(A_M_NAME[STP_FN,8],0)
    ENDIF
  endcase
  IF  RDZEROK(A_M_NAME[STP_FN,8])=0
    dout2(A_M_NAME[STP_FN,8],0)
    DO	CASE
    CASE  LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      *DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[2,13]  SAY  "    " PICT "&XMC_F"
      A_M_NAME[2,10] := A_M_NAME[2,9]
      A_M_NAME[2,12] := A_M_NAME[2,6]
      CLEACHMEM(1)
      STPN2=STPN2+1
      STP2=7
      SET COLOR TO &C2 / &C1
      *@ 11,7  SAY   "úLúPúPúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[2,2] :=1
      WTANK_F[2,1] :=0
    CASE    LCHTYPE=8 .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26
      *DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[1,13]  SAY	"     " PICT "&XMC_F"
      @  4,A_M_NAME[2,13]  SAY	"     " PICT "&XMC_F"
      A_M_NAME[1,10] := A_M_NAME[1,9]
      A_M_NAME[2,10] := A_M_NAME[2,9]
      A_M_NAME[1,12] := A_M_NAME[1,6]
      CLEACHMEM(0)
      CLEACHMEM(1)
      STPN1=STPN1+1
      STPN2=STPN2+1
      STP2=7
      SET COLOR TO &C2 / &C1
      *@ 11,7  SAY   "úLúPúPúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[1,1] :=0
      WTANK_F[2,1] :=0
      WTANK_F[1,2] :=1
      WTANK_F[2,2] :=1
      setdla(0,0)
    ENDCASE
  ENDIF
CASE STP2=7
  GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=1
  GS_DROPRST()
  DO CASE
  CASE	LCHTYPE=2  .or. LCHTYPE=6   .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP2=1
    ELSE
      stp2=0
      STPN2=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  CASE	 LCHTYPE=8 .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP1=1
      STP2=0
    ELSE
      stp1=0
      STPN1=1
      stp2=0
      STPN2=1
      WTANK_F[STP_FN-1,3] :=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  ENDCASE
ENDCASE
RETU
**------------------------------------------------------------------------------------------------------------
PROCEDURE  STP3
PARAMETERS  P1,P2,P3
STP_ZN=2
STP_FN=3
STP_FC="3"
DO CASE
CASE (STP3=0)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE (LCHTYPE=2 .or. LCHTYPE=6 .or. LCHTYPE=7 .or. LCHTYPE=9 .or. LCHTYPE=10	.or. LCHTYPE=11  .or. LCHTYPE=12  .or. LCHTYPE=13  )  .AND. NEXTOK1=1
    IF (A_PRESS_N0[1,21,STP_FN,1] =77)
      A_PRESS_N0[1,21,STP_FN,1] :=0
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      A_PRESS_N0[1,21,STP_FN,1] :=0
      NEXTOK1=0
      STP&STP_FC=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,ix,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE (LCHTYPE=8  .or.  LCHTYPE=16   .or. LCHTYPE=17  .or. LCHTYPE=26	 )  .AND. NEXTOK1=1  .and.  (stp4=0   )
    IF (A_PRESS_N0[1,21,STP_FN,1] =77)
      A_PRESS_N0[1,21,STP_FN,1] :=0
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN+1)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      IF LCHTYPE=16   .or. LCHTYPE=17  .or. LCHTYPE=26
	a_copy_4(A_PRESS_B0,STP_FN,STP_FN+1)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      A_PRESS_N0[1,21,STP_FN,1] :=0
      A_PRESS_N0[1,21,STP_FN+1,1] :=0
      NEXTOK1=0
      STP&STP_FC=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,ix,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE LCHTYPE=4
  ENDCASE
CASE (STP3=1)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE LCHTYPE=2  .or. LCHTYPE=6 .or. LCHTYPE=7 .or. LCHTYPE=9	 .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
    IF ((A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1))
      IF KOT=1	&&¥þ¤W
	WTANK_F[STP_FN,1] :=77
      ENDIF
      STP&STP_FC=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE LCHTYPE=4
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP3=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE	 LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30  .or. LCHTYPE=8  .OR. LCHTYPE=15 .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26	 .or. LCHTYPE=21
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP3=2

      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  ENDCASE
CASE STP3=2
  DRAF=0
  DO CASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    dspch2_nor=1
    DO CASE
    CASE LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      STP&STP_FC=4
      WTANK_F[STP_FN,1] :=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE LCHTYPE=4
      STP3=0
      STP3=4
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      SETDLA(0,0)
      WTANK_F[1,1] :=1
      WTANK_F[2,1] :=1
      WTANK_F[3,1] :=1
    CASE    LCHTYPE=8  .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26
      STP3=0
      STP4=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      SETDLA(1,0)
 CASE	LCHTYPE=14 .OR. LCHTYPE=32 .OR. LCHTYPE=15 .OR. LCHTYPE=30  .or.  LCHTYPE=5 .or. LCHTYPE=21
      STP3=0
      STP4=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    ENDCASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    dspch2_nor=0
    dspch2_nor=0
    IF	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
      DSPDATA_A[STP_FN] := 1
    ELSE
      DSPDATA_A[STP_FN] := 0
    ENDIF
    ADJWN=0
    ADJWN_f=0
    IF WATER_INPUT=1
       IF UCHTYPE=16 .or. UCHTYPE=17
	 IF GS_ADJW[4]=0
	   XA1=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,1,1] * (GS_ADJ[2] )  /100)
	   XA2=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,2,1] * (GS_ADJ[4] )  /100)
	   XA0=XA1+XA2
	   GS_ADJW[4]=XA0
	 ENDIF
	 IF GS_ADJW[3]=0
	   XA1=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,1,1] * (GS_ADJ[1] )  /100)
	   XA2=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,2,1] * (GS_ADJ[3] )  /100)
	   XA0=XA1+XA2
	 ELSE
	   XA0=GS_ADJW[3]
	 ENDIF
	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] -XA0
       *ELSE
	 *ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * (WATER_INC[STP_FN] ) /100)
	 *ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * (WATER_INC[STP_FN] ) /100)
	 *A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
       ENDIF
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * (S1_WATER  ) /100)
      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * S1_WATER /100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      do  case
      case  lchtype=21
	 ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * WATER_inc[stp_fn]/100)
	 ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * WATER_inc[stp_fn]/100)
	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      endcase
    ELSE
    if	 lchtype <> 4
      ADJWN=-PWATER
      ADJWN_F=-PWATER
    endif
    ENDIF
    DO CASE
    case   uchtype=22
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * WATER_inc[stp_fn]/100)
      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * WATER_inc[stp_fn]/100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
    CASE   LCHTYPE=14 .OR. LCHTYPE=32 .OR. LCHTYPE=5  .OR. LCHTYPE=6 .OR. LCHTYPE=30 .OR.( LCHTYPE>=8 .AND.  LCHTYPE<=13) .OR. LCHTYPE=15 .or.	LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26  .or. LCHTYPE=21
    do case
      CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=6
	XPA1=0
	XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
	ADJWN=	-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
	ADJWN_F=ADJWN
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-2,4] +adjwn
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      case   LCHTYPE=30
	XPA1=0
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-2,4]
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN
      case    LCHTYPE=5 .OR. LCHTYPE=30   .OR. LCHTYPE=15  .OR. LCHTYPE=21
	XPA1=0
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-2,4]
      case   LCHTYPE=16
	XPA1=1
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      case  LCHTYPE=8 .or. LCHTYPE=17 .or. LCHTYPE=26
	SETDLA(A_M_NAME[STP_FN,8],0)
	XPA1=1
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
	ADJWN=-PWATER *XP4/ (XP4 +XP5)
	ADJWN=	INT(ADJWN *A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	ADJWN_F=ADJWN
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+adjwn
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
      case  LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
	XPA1=2
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] + ADJWN
      ENDCASE
      RDDLY(STP_FN,XPA1,XPA2)
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF (XRD=1)
	  XMC_F=A_M_NAME[STP_FN,3]
	  if  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	    X= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]  + ADJWN_f
	    @  4,A_M_NAME[STP_FN,13]  SAY  X PICT "&XMC_F"
	  endif
	  EWN=WDATA(STP_ZN)-2048
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	    DO CASE
	    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5 .OR. LCHTYPE=30  .OR. LCHTYPE=8  .OR. LCHTYPE=15 .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26  .or. LCHTYPE=21
	       if  storb_e=1
		 EW1=A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,1]
		 A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	       endif
	      EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	      EWN=(EW1)*2048/A_M_NAME[STP_FN,10]
	    CASE LCHTYPE=9 .OR. LCHTYPE=10 .OR. LCHTYPE=12   .OR. LCHTYPE=13
	      EWN=WDATA(STP_ZN)-2048
	      EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    ENDCASE
	    XMC_F=A_M_NAME[STP_FN,3]
	    IF DSPDATA_A[STP_FN] =1
	      *@  8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    ENDIF
	    SETCHDATA(STP_ZN,EWN)
	    DO CASE
	    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5 .OR. LCHTYPE=30	.OR. LCHTYPE=15  .OR. LCHTYPE=21

	      SETCHDATA(STP_ZN,EWN)
	      EWN=EWn+CHENDATA(0)+CHENDATA(1)
	      SETDLA(0,EWN)
	      STP3=0
	      STP4=1
	    CASE LCHTYPE=8 .or.  LCHTYPE=16 .or. LCHTYPE=17   .or. LCHTYPE=26
	      SETDLA(1,EWN)
	      STP3=0
	      STP4=1
	    CASE LCHTYPE=13
	      SETDLA(2,0)
	      STP3=3
	    ENDCASE
	  ELSE
	    EWN=WDATA(0)-2048
	    if	 storb_e=1
	      EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
	      A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    endif

	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048) -A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4]-A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-2,4]
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    IF DSPDATA_A[STP_FN] =1
	      *@  8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    endif
	    EWN=(EW1)*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    DO CASE
	    *CASE   LCHTYPE=14 .OR. LCHTYPE=32	.OR. LCHTYPE=5	.OR. LCHTYPE=30  .OR. LCHTYPE=15
	    *  EWN=(EW1+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4])*2048/A_M_NAME[STP_FN,10]
	    *  SETDLA(0,EWN)
	    CASE   LCHTYPE=21 .OR.  LCHTYPE=14 .OR. LCHTYPE=32	.OR. LCHTYPE=5 .OR. LCHTYPE=30	 .OR. LCHTYPE=15
	      EWN=(EW1+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-2,4])*2048/A_M_NAME[STP_FN,10]
	      SETDLA(0,EWN)
	    CASE LCHTYPE=8 .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26
	      SETDLA(1,EWN)
	    ENDCASE
	    STP3=0
	    STP4=1
	  ENDIF
	ENDIF
	RETU
      ENDIF
    ENDCASE
    XMC_F=A_M_NAME[STP_FN,3]
    IF DSPDATA_A[STP_FN] =1
      @  4,A_M_NAME[STP_FN,13]	SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ ADJWN_f	PICT "&XMC_F"
      SET COLOR TO &C2	/ &C1
      *MTANK_MARK(6,STP_FN,1)
      DSPA_ARROW(STP_FN,1,14)  &&   úD
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
    ELSE
      *if LCHTYPE=14
      *   IF   (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] = 0 )	 .AND. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,8] > 0 )
      *     ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,8] * G2_WATER /100)
      *     A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,11]=ADJWN_f
      *      @	4,A_M_NAME[STP_FN-1,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,8]+ ADJWN_f  PICT "&XMC_F"
      *      SET COLOR TO &C2  / &C1
      *      *MTANK_MARK(6,STP_FN,1)
      *      DSPA_ARROW(STP_FN-1,1,14)	&&   úD
      *      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
      *      GS_CHG=3
      *   ENDIF
      *ENDIF
    endif
    do case
    CASE LCHTYPE=9 .or. LCHTYPE=10    .or. LCHTYPE=6 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13  .or. LCHTYPE=14
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
    CASE LCHTYPE=4
      SET COLOR TO &C10 / &C1
      *@ 11,7  SAY   "úZúYúYúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_RESCALL(STP_FN)
    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5	.or. LCHTYPE=8	.OR. LCHTYPE=15 .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26
      SET COLOR TO &C10 / &C1
      *@ 11,7  SAY   "úZúYúYúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_RESCALL(STP_FN)
      SETDLA(1,0)
    ENDCASE
    SET COLOR TO &C7 +/ &C1
    CLEACHMEM(STP_ZN)
    SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] +ADJWN
    x1=PFLOR&STP_FC
    x2=A_M_NAME[STP_FN,10]
    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    x1=ERKG&STP_FC
    x2=A_M_NAME[STP_FN,10]
    SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETOK(STP_ZN)
    DOUT(STP_ZN,1)
    STP3=3
  ENDCASE
CASE STP3=3
  do case
  case LCHTYPE=5 .OR. LCHTYPE=30   .or. LCHTYPE=8 .or. LCHTYPE=13  .OR. LCHTYPE=15   .or. LCHTYPE=17 .or. LCHTYPE=26  .OR.  UCHTYPE_N=618
    XP3=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
    XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
    XP5=XP3
    X=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
    x2=  -INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))
    IF	x2 <> X
      ADJW12(STP_ZN,(-INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))  -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=-INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,11]:=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
      XMC_F=A_M_NAME[STP_FN,3]
      IF MODY_D1=0
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]-INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))   PICT "&XMC_F"
      ENDIF
    ENDIF
  case	 LCHTYPE=14 .OR. LCHTYPE=32  .OR.  LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12
    ADJWN=0
    IF WATER_INPUT=1
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * S1_WATER /100)
      X=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
      IF  ADJWN   <> X
	ADJW12(STP_ZN,(ADJWN  -X)*2048/A_M_NAME[STP_FN,10])
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] :=ADJWN
	ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * S1_WATER /100)
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
	XMC_F=A_M_NAME[STP_FN,3]
	IF MODY_D1=0
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN_f  PICT "&XMC_F"
	ENDIF
      ENDIF
    else
       if    LCHTYPE=14  .OR. LCHTYPE=32
	 XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	 XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
	 ADJWN=  -INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
       endif
       X=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
       IF  ADJWN   <> X
	 ADJW12(STP_ZN,(ADJWN  -X)*2048/A_M_NAME[STP_FN,10])
	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] :=ADJWN
	 ADJWN_f=adjwn
	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
	 XMC_F=A_M_NAME[STP_FN,3]
	 IF MODY_D1=0
	   @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN_f  PICT "&XMC_F"
	 ENDIF
       ENDIF
    ENDIF
  case	 LCHTYPE=16
    ADJWN=0
    IF WATER_INPUT=1
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * (S1_WATER ) /100)
    ENDIF
    X=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
    IF	ADJWN	<> X
      ADJW12(STP_ZN,(ADJWN  -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] :=ADJWN
      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * S1_WATER /100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      XMC_F=A_M_NAME[STP_FN,3]
      IF MODY_D1=0
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN_f  PICT "&XMC_F"
      ENDIF
    ENDIF
  ENDCASE
  TST1_LS1(STP_FN)
  IF LS1[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS2(STP_FN)
      IF RDOK2(STP_ZN)=0
	DOUT(STP_ZN,0)
	STOPTM&STP_FC=0
	EWN=CHENDATA(STP_ZN)
	if lchtype=14  .OR. LCHTYPE=32	     .OR.  storb_e=1
	  EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
	  A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	endif
	EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	XMC_F=A_M_NAME[STP_FN,3]
	*@  8,A_M_NAME[STP_FN,13]  SAY	EW1   PICT "&XMC_F"
	SET COLOR TO &C2 / &C1
	*MTANK_MARK(6,STP_FN,0)
	DSPA_ARROW(STP_FN,0,0)	&& EREASE  úD
	SET COLOR TO &C7 +/ &C1
	DO CASE
	CASE LCHTYPE=2	.or. LCHTYPE=6	 .or. LCHTYPE=7 .or. LCHTYPE=9	 .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
	  STP&STP_FC=4
	  WTANK_F[STP_FN,1] :=1
	  *STP2=2
	  *X=EWN
	  *SETDLA(0,X)
	CASE LCHTYPE=4
	  STP3=4
	  DOUT3(0,0)
	  SETDLA(0,0)
	  IF KOT=1
	    WTANK_F[1,1] :=1
	    WTANK_F[2,1] :=1
	    WTANK_F[3,1] :=1
	  ENDIF
	CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30  .OR. LCHTYPE=15   .OR. LCHTYPE=21
	  DSPA_ARROW(STP_FN-1,0,0)  && EREASE  úD
	  STP3=0
	  STP4=1
	  DOUT3(0,0)
	  EWN=EWN+CHENDATA(0) +  CHENDATA(1)
	  SETDLA(0,EWN)
	CASE LCHTYPE=8	.or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26
	  STP3=0
	  STP4=1
	  DOUT3(0,0)
	  SETDLA(1,EWN)
	ENDCASE
      ENDIF
CASE STP3=4  .AND.  (WTANK_F[3,1]=-99)
  IF KOT=1
    IF ( DIN(9)=1 )   .OR.  ( DIN(12)=0)
      RETU
    ENDIF
  ELSE
    IF ( DIN(8)=1) .OR. (DIN(11)=0)
      RETU
    ENDIF
  ENDIF
  IF  TIME1[STP_FN,2] =0
    TIME1[STP_FN,2] :=SECONDS()
  ENDIF
  IF ABS(SECONDS()-TIME1[STP_FN,2]) >=TIME1[STP_FN,1]
    TIME1[STP_FN,2] :=0
    STP3=5
  ENDIF
  IF GS_DROPOK(A_M_NAME[STP_FN,8] +1)<> 1
    IF SPACIAL_0=0
      STP3=4
    ENDIF
  ENDIF
CASE STP3=5
  GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=2
  DO CAse
  CASE LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
    WTANK_F[3,1]=0
    TOTDR1=TOTDR1-1
    DRTKF=0
    TOTANK1=0
    STP3=6
    IF DSPDATA_A[STP_FN] =1
      SET COLOR TO &C11 / &C1
      *@ 11,7  SAY   "úLúPúPúKúPúPúO"
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    ENDIF
    if	(A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
      SET COLOR TO &C11 / &C1
      *@ 11,7  SAY   "úLúPúPúKúPúPúO"
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
      SETZERTM(2,PZERTM3)
      SETZEROK(2)
      dout2(A_M_NAME[STP_FN,8],1)
    ENDIF
    TOTANK=1
    SET COLOR TO &C7 +/ &C1
  CASE LCHTYPE=4
    WTANK_F[3,1]=0
    TOTDR1=TOTDR1-1
    DRTKF=0
    TOTANK1=0
    STP3=6
    SET COLOR TO &C11 / &C1
    *@ 11,7  SAY   "úLúPúPúKúPúPúO"
    *DSPB_ARROW(1,1,14)  && úD
    DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    TOTANK=1

    if (LCHTYPE <> 6 .OR.   (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0))
      SET COLOR TO &C7 +/ &C1
      SETZERTM(0,PZERTM1)
      *SETZER(0,INT(((PZER1/A_M_NAME[1,6]))*PER*2048)+2048)
      SETZEROK(0)
      dout2(A_M_NAME[STP_FN,8],1)
    ENDIF
    IF LAGDATE=DATE()
      LAGW=LAGW+ A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]
    ELSE
      LAGW=VUSE
      LAGDATE=DATE()
    ENDIF
    SAVE TO LAGDATA9 ALL LIKE LAG*
    @ 0,26 SAY	LAGW   PICT  "9999.9"
    ACT_V=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,6]
    @ 17,12 SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,6]  PICT  "99.9"
  ENDCASE
  SANDCUTW[STP_FN,2] := 0
CASE STP3=6
  if ((LCHTYPE <> 6 .and.  LCHTYPE <> 13)  .OR.   (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0))
    TST1_LS2(STP_FN)
    IF LS2[STP_FN,2]=1
      RETU
    ENDIF
  ELSE
      setZokn(A_M_NAME[STP_FN,8],0)
  ENDIF
  IF SANDCUTW[STP_FN,1] >0
    DO	CASE
    CASE LCHTYPE=6
      IF  ( SANDCUTW[STP_FN,2] =0 )
	 X=INT((WDATA(A_M_NAME[STP_FN,8])-2048)*A_M_NAME[STP_FN,6]/PER/2048)
	 IF X <= SANDCUTW[STP_FN,1]
	   dout2(A_M_NAME[STP_FN,8],0)
	   GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=1
	   SANDCUTW[STP_FN,2] := 1
	   RETU
	 ENDIF
      ELSE
	IF CHK_LASTOUT() >1
	  RETU
	ENDIF
	SANDCUTW[STP_FN,2] := 1
	if  (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
	  dout2(A_M_NAME[STP_FN,8],1)
	ENDIF
      ENDIF
    ENDCASE
  ENDIF
  if  (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
    TST0_LS1(STP_FN,STP_FN)
  ENDIF
  IF  RDZEROK(A_M_NAME[STP_FN,8])=0
    DO CASE
    CASE  LCHTYPE=2 .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      dout2(A_M_NAME[STP_FN,8],0)
      DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[3,13]  SAY  "    " PICT "&XMC_F"
      A_M_NAME[3,10] := A_M_NAME[3,9]
      A_M_NAME[3,12] := A_M_NAME[3,6]
      CLEACHMEM(STP_ZN)
      STPN3=STPN3+1
      STP3=7
      SET COLOR TO &C2 / &C1
      *@ 11,7  SAY   "úLúPúPúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[3,1] :=0
      WTANK_F[3,2] :=1
    CASE  LCHTYPE=4
      dout2(A_M_NAME[STP_FN,8],0)
      DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[1,13]  SAY	"     " PICT "&XMC_F"
      @  4,A_M_NAME[2,13]  SAY	"     " PICT "&XMC_F"
      @  4,A_M_NAME[3,13]  SAY	"     " PICT "&XMC_F"
      A_M_NAME[1,10] := A_M_NAME[1,9]
      A_M_NAME[2,10] := A_M_NAME[2,9]
      A_M_NAME[3,10] := A_M_NAME[3,9]
      A_M_NAME[1,12] := A_M_NAME[1,6]
      CLEACHMEM(0)
      CLEACHMEM(1)
      CLEACHMEM(2)
      STPN1=STPN1+1
      STPN2=STPN2+1
      STPN3=STPN3+1
      STP3=7
      SET COLOR TO &C2 / &C1
      *@ 11,7  SAY   "úLúPúPúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[1,2] :=1
      WTANK_F[2,2] :=1
      WTANK_F[3,2] :=1
      WTANK_F[1,1] :=0
      WTANK_F[2,1] :=0
      WTANK_F[3,1] :=0
    ENDCASE
  ENDIF
CASE STP3=7
  DSPDATA_A[STP_FN] := 1
  IF SANDCUTW[STP_FN,1] =0
    GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=1
  ENDIF
  GS_DROPRST()
  DO CASE
    CASE  LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
	STP3=1
      ELSE
	STP3=0
	STPN3=1
	WTANK_F[STP_FN,3] :=1
      ENDIF
    CASE  LCHTYPE=4
      IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
	STP1=1
      ELSE
	STP1=0
	STPN1=1
	STPN2=1
	STPN3=1
	WTANK_F[STP_FN-2,3] :=1
	WTANK_F[STP_FN-1,3] :=1
	WTANK_F[STP_FN,3] :=1
      ENDIF
      STP3=0
  ENDCASE
ENDCASE
RETU
**------------------------------------------------------------------------------------------------------------
PROCEDURE  STP4
PARAMETERS  P1,P2,P3
STP_ZN=3
STP_FN=4
STP_FC="4"
DO CASE
CASE (STP4=0)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE LCHTYPE=2 .AND. NEXTOK1=1    .and. STP5=0
    IF (A_PRESS_N0[1,21,STP_FN,1] =77)
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN+1)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      NEXTOK1=0
      A_PRESS_N0[1,21,STP_FN,1] :=0
      A_PRESS_N0[1,21,STP_FN+1,1] :=0
      STP&STP_FC=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,ix,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE LCHTYPE=4 .AND. NEXTOK1=1   .and. STP5=0
    IF (A_PRESS_N0[1,21,4,1] =77)
      A_PRESS_N0[1,21,4,1] :=0
      A_PRESS_N0[1,21,5,1] :=0
      a_copy_4(A_PRESS_N0,4,5)
      NEXTOK1=0
      STP4=1
      STP5=0
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
CASE (LCHTYPE=6   .or. LCHTYPE=7 .or. LCHTYPE=9 .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12  .or. LCHTYPE=13  ) .AND. NEXTOK1=1
  IF (A_PRESS_N0[1,21,STP_FN,1] =77)
    A_PRESS_N0[1,21,STP_FN,1] :=0
    a_copy_4(A_PRESS_N0,STP_FN,STP_FN)	&& COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
    A_PRESS_N0[1,21,STP_FN,1] :=0
    NEXTOK1=0
    STP&STP_FC=1
    FOR IX=1 TO (GS_TOT+UWC_TOT)
      IF  A_PRESS_N0[1,21,ix,1] =77
	NEXTOK1=1
      ENDIF
    NEXT
  ENDIF
  ENDCASE
CASE (STP4=1)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE LCHTYPE=2
    IF ((A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1))
      WTANK_F[STP_FN,1] :=77
      WTANK_F[STP_FN+1,1] :=77
      STP&STP_FC=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE LCHTYPE=4
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      IF KOT=1
	WTANK_F[4,1] :=77
	WTANK_F[5,1] :=77
      ENDIF
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
      STP4=2
    ENDIF
  CASE	 LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30   .or.  LCHTYPE=8	.OR. LCHTYPE=15 .or.  LCHTYPE=16 .or. LCHTYPE=17  .or. LCHTYPE=26   .or. LCHTYPE=21
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      WTANK_F[STP_FN,1] :=77
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
      STP4=2
    ENDIF
  CASE	 LCHTYPE=6    .or. LCHTYPE=7 .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      WTANK_F[STP_FN,1] :=77
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
      STP4=2
    ENDIF
  ENDCASE
CASE STP4=2
  DRAF=0
  DO CASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    DO CASE
    CASE LCHTYPE=2
      STP&STP_FC=0
      STP5=1
      WTANK_F[STP_FN,1] :=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE LCHTYPE=4
      STP4=0
      STP5=2
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30	 .OR.  LCHTYPE=6   .or. LCHTYPE=7  .or.  LCHTYPE=8 .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13  .OR. LCHTYPE=15
      STP4=3
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE   LCHTYPE=21
      STP4=0
      STP5=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE     LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26
      STP4=4
      WTANK_F[STP_FN-1,1] :=1
      WTANK_F[STP_FN,1] :=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    ENDCASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    dspch2_nor=0
    IF	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
      DSPDATA_A[STP_FN] := 1
    ELSE
      DSPDATA_A[STP_FN] := 0
    ENDIF
    ADJWN=0
    ADJWN_f=0
    IF WATER_INPUT=1
      IF UCHTYPE=16 .or. UCHTYPE=17
	IF GS_ADJW[3]>0
	  XA0=GS_ADJW[3]
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] -XA0
	ENDIF
      ENDIF
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * (S2_WATER )	/100)
      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * S2_WATER /100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
      *adjwn=adjwn_f
    ENDIF
    DO CASE
    CASE LCHTYPE=2
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
      RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5)))     &&care
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  if  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	    @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5)) PICT  "&XMC_F"
	  endif
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] := -INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
	  DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
	  WTANK_F[STP_FN,1] :=1
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	    EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=EW1*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(A_M_NAME[STP_FN,8],EWN)

	    STP4=0
	    STP5=1
	  ELSE
	    EWN=WDATA(STP_ZN)-2048
	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    *SETCHDATA(STP_ZN,EWN)
	    *SETDLA(0,EWN)
	    STP&STP_FC=0
	    STP5=1
	  ENDIF
	ENDIF
	RETU
      ENDIF
    CASE LCHTYPE=21
       RET_F=0
       do  stp4_2_21
       IF RET_F=1
	  RETURN
       ENDIF
    CASE LCHTYPE=4
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
      RDDLY(STP_FN,1,A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5)))     &&care
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5)) PICT  "&XMC_F"
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] := -INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
	  DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
	  WTANK_F[STP_FN,1] :=1
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	    EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=EW1*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(1,EWN)
	    STP4=0
	    STP5=1
	  ELSE
	    EWN=WDATA(0)-2048
	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(1,EWN)
	    STP4=0
	    STP5=1
	  ENDIF
	ENDIF
	RETU
      endIF
    CASE   LCHTYPE=14 .OR. LCHTYPE=32	.OR. LCHTYPE=30    .OR. ( LCHTYPE >=5  .AND.  LCHTYPE<=13)  .OR. LCHTYPE=15  .or.  LCHTYPE=16 .or. LCHTYPE=17  .or. LCHTYPE=26
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1]
    ENDCASE
    XMC_F=A_M_NAME[STP_FN,3]
    IF WATER_INPUT =0
      ADJWN=  -INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
      ADJWN_F=ADJWN
      if (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]=0)
	  ADJWN_F=0
      endif
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11] := ADJWN_F
    ELSE
	ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * (S2_WATER )  /100)
	ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * S2_WATER /100)
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
    ENDIF
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] := ADJWN
    *adjwn_f=adjwn
    IF	DSPDATA_A[STP_FN]=1
    @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +ADJWN_f PICT "&XMC_F"
    ENDIF
    SET COLOR TO &C2  / &C1
    *MTANK_MARK(6,STP_FN,1)
    IF DSPDATA_A[STP_FN] =1
      DSPA_ARROW(STP_FN,1,14)  &&   úD
      *DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
    ENDIF
    do case
    CASE LCHTYPE=2
      SET COLOR TO &C10 / &C1
      *@ 11,22 SAY   "úZúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_RESCALL(STP_FN)
      SETDLA(A_M_NAME[STP_FN,8],0)
    CASE LCHTYPE=4
      SET COLOR TO &C10 / &C1
      *@ 11,22 SAY   "úZúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_RESCALL(STP_FN)
      SETDLA(A_M_NAME[STP_FN,8],0)
    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30	 .or.  LCHTYPE=8  .OR. LCHTYPE=15 .or.	LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26  .or. LCHTYPE=21
      SET COLOR TO &C10 / &C1
      *@ 11,22 SAY   "úZúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_RESCALL(STP_FN)
    CASE   LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13

      SET COLOR TO &C10 / &C1
      *@ 11,22 SAY   "úZúYúYúYú["
      IF DSPDATA_A[STP_FN] =1
	DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      ENDIF
      WEIG_RESCALL(STP_FN)
      SETDLA(A_M_NAME[STP_FN,8],0)
    ENDCASE
    SET COLOR TO &C7 +/ &C1
    SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] + ADJWN
    IF LCHTYPE =21
    ELSE
      x1=PFLOR&STP_FC-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
      x2=A_M_NAME[STP_FN,10]
      x1=ERKG&STP_FC-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
    ENDIF
    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10] )
    SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETOK(STP_ZN)
    DOUT(STP_ZN,1)
    STP4=3
  ENDCASE
CASE STP4=3
  XP4=0
  XP5=0
  do case
  case (LCHTYPE=4) .OR. ((LCHTYPE=2) .or. LCHTYPE=7  )
    XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
    XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
  case (  LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5 .OR. LCHTYPE=30  .OR.  LCHTYPE=6 .or.  LCHTYPE=8  .or. LCHTYPE=13	 .OR. LCHTYPE=15   .or.  LCHTYPE=16   .or. LCHTYPE=17  .or. LCHTYPE=26	 )
    XP3=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1]
    XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
    XP5=XP3
  ENDCASE
  if  (XP4+XP5 <> 0 )  .AND.   WATER_INPUT =0
    X=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
    IF	-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))   <> X
      ADJW12(STP_ZN,(-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))  -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
      xwf= A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
      if (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]=0)
	  xwf=0
      endif
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,11] :=xwf
      XMC_F=A_M_NAME[STP_FN,3]
      IF ((MODY_D1=0 )	.and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0))

	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))   PICT "&XMC_F"
      ENDIF
    ENDIF
  ENDIF
  DO CASE
  case	LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12  .or. LCHTYPE=21
    ADJWN=0
    IF WATER_INPUT=1
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * S2_WATER /100)
    ENDIF
    X=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
    IF	ADJWN	<> X
      ADJW12(STP_ZN,(ADJWN  -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] :=ADJWN
      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * S2_WATER /100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      XMC_F=A_M_NAME[STP_FN,3]
      IF MODY_D1=0
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN_f  PICT "&XMC_F"
      ENDIF
    ENDIF
  ENDCASE
  TST1_LS1(STP_FN)
  IF LS1[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS2(STP_FN)
  IF RDOK2(STP_ZN)=0
    DOUT(STP_ZN,0)
    STOPTM&STP_FC=0
    EWN=CHENDATA(STP_ZN)
    if lchtype=14  .OR. LCHTYPE=32	  .OR.	storb_e=1
      EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
      A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    endif
    EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
    XMC_F=A_M_NAME[STP_FN,3]
    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
    SET COLOR TO &C2 / &C1
    *MTANK_MARK(6,STP_FN,0)
     DSPA_ARROW(STP_FN,0,0)  && EREASE	úD
    SET COLOR TO &C7 +/ &C1
    DO CASE
    CASE LCHTYPE=2
      STP&STP_FC=0
      STP5=2
      X=EWN
      WTANK_F[STP_FN,1] :=1
      SETDLA(A_M_NAME[STP_FN,8],X)
    CASE   LCHTYPE=21
      STP&STP_FC=0
      STP5=2
      X=EWN
      WTANK_F[STP_FN,1] :=1
      DOUT3(0,0)
      X=EWN+CHENDATA(0) +  CHENDATA(1)	 +  CHENDATA(2)
      SETDLA(A_M_NAME[STP_FN,8],X)
    CASE LCHTYPE=4
      DOUT3(0,0)
      STP4=0
      STP5=2
      X=EWN
      SETDLA(1,X)
    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30	.OR. LCHTYPE=15
      STP4=4
      WTANK_F[1,1] :=1
      WTANK_F[2,1] :=1
      WTANK_F[3,1] :=1
      WTANK_F[4,1] :=1
    CASE LCHTYPE=8 .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26
      STP4=4
      WTANK_F[3,1] :=1
      WTANK_F[4,1] :=1
    CASE LCHTYPE=6 .or. LCHTYPE=7 .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      STP4=4
      WTANK_F[4,1] :=1
    ENDCASE
  ENDIF
CASE STP4=4  .AND.  (WTANK_F[4,1]=-99)
  IF KOT=1
    IF ( DIN(9)=1 )   .OR.  ( DIN(12)=0)
      RETU
    ENDIF
  ELSE
    IF ( DIN(8)=1) .OR. (DIN(11)=0)
      RETU
    ENDIF
  ENDIF
  IF  TIME1[STP_FN,2] =0
    TIME1[STP_FN,2] :=SECONDS()
  ENDIF
  IF ABS(SECONDS()-TIME1[STP_FN,2]) >=TIME1[STP_FN,1]
    TIME1[STP_FN,2] :=0
    STP4=5
  ENDIF
  IF GS_DROPOK(A_M_NAME[STP_FN,8] +1)<> 1
    IF SPACIAL_0=0
      STP4=4
    ENDIF
  ENDIF
CASE STP4=5
  GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=2
  DO CAse
  CASE	 LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5 .OR. LCHTYPE=30    .or.  LCHTYPE=8	.OR. LCHTYPE=15 .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=26
    if	  LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30  .OR. LCHTYPE=15
      WTANK_F[1,1]=0
      WTANK_F[2,1]=0
      WTANK_F[3,1]=0
      WTANK_F[4,5]=0
    else
      WTANK_F[3,1]=0
      WTANK_F[4,1]=0
    endif
    IF	LCHTYPE=16 .or. LCHTYPE=17   .or. LCHTYPE=26
      GS_ADJW[3] :=0
      GS_ADJW[4] :=0
    ENDIF
    TOTDR1=TOTDR1-1
    DRTKF=0
    TOTANK1=0
    STP4=6
    SET COLOR TO &C11 / &C1
    *@ 11,7  SAY   "úLúPúPúKúPúPúO"
    do case
    case  lchtype=32
      if (  A_PRESS_N0[L_PRESS,1,STP_FN-3,1]  != 0) .or. (  A_PRESS_N0[L_PRESS,1,STP_FN-2,1]  != 0) .or. (  A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  != 0) .or. (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  != 0)
	DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
      endif
    otherwise
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    endcase
    TOTANK=1
    SET COLOR TO &C7 +/ &C1
    if lchtype=8  .or. lchtype=16 .or. LCHTYPE=17 .or. LCHTYPE=26

      SETZERTM(1,PZERTM3)
    else
      SETZERTM(0,PZERTM1)
    endif
    *SETZER(2,INT(((PZER3/A_M_NAME[3,6]))*PER*2048)+2048)
    SETZEROK(A_M_NAME[STP_FN,8])
    dout2(A_M_NAME[STP_FN,8],1)
    IF	 LCHTYPE=5
      IF LAGDATE=DATE()
	LAGW=LAGW+ A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]
      ELSE
	LAGW=VUSE
	LAGDATE=DATE()
      ENDIF
      SAVE TO LAGDATA9 ALL LIKE LAG*
      set colo to  w+ /n
      @ 0,26 SAY  LAGW	 PICT  "9999.9"
      ACT_V=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,6]
      @ 17,12 SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,6]  PICT  "99.9"
    ENDIF
  CASE LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
    WTANK_F[4,1]=0
    TOTDR1=TOTDR1-1
    DRTKF=0
    TOTANK1=0
    STP4=6
    IF	DSPDATA_A[STP_FN] =1
      if (LCHTYPE <> 6 .OR.   (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0))
	SET COLOR TO &C11 / &C1
	*@ 11,7  SAY   "úLúPúPúKúPúPúO"
	DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
      ENDIF
    ENDIF
    TOTANK=1
    SET COLOR TO &C7 +/ &C1
      if (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
	SETZERTM(3,PZERTM4)
	*SETZER(2,INT(((PZER3/A_M_NAME[3,6]))*PER*2048)+2048)
	SETZEROK(A_M_NAME[STP_FN,8])
	dout2(A_M_NAME[STP_FN,8],1)
      ENDIF
  ENDCASE
  SANDCUTW[STP_FN,2] := 0
CASE STP4=6
  do  case
  case lchtype=16  .or. lchtype=8 .or. LCHTYPE=17   .or. LCHTYPE=26
    JMPF=0
      if (  A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .and. (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
	JMPF=1
      ENDIF
    IF JMPF=0
      TST1_LS2(STP_FN)
	IF LS2[STP_FN,2]=1
	  RETU
	ENDIF
	TST0_LS1(STP_FN,STP_FN)
      ELSE
	  setZokn(A_M_NAME[STP_FN,8],0)
      ENDIF
   case  lchtype=32
     JMPF=0
     if (  A_PRESS_N0[L_PRESS,1,STP_FN-3,1]  = 0) .and. (  A_PRESS_N0[L_PRESS,1,STP_FN-2,1]  = 0) .and. (  A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .and. (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
	JMPF=1
     endif
     IF JMPF=0
       TST1_LS2(STP_FN)
	 IF LS2[STP_FN,2]=1
	   RETU
	 ENDIF
	 TST0_LS1(STP_FN,STP_FN)
       ELSE
	   setZokn(A_M_NAME[STP_FN,8],0)
       ENDIF
  otherwise
    if ((LCHTYPE <> 6 .and.  LCHTYPE <> 13)  .OR.   (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0))
      TST1_LS2(STP_FN)
      IF LS2[STP_FN,2]=1
	RETU
      ENDIF
    ELSE
      setZokn(A_M_NAME[STP_FN,8],0)
    ENDIF
  endcase
  IF SANDCUTW[STP_FN,1] >0
    DO	CASE
    CASE LCHTYPE=8 .or.  LCHTYPE=16 .or. LCHTYPE=17  .or. LCHTYPE=26

      IF (STP2 <7)  .AND. ( SANDCUTW[STP_FN,2] =0 )
	 X=INT((WDATA(1)-2048)*A_M_NAME[2,6]/PER/2048)
	 IF X <= SANDCUTW[STP_FN,1]
	   dout2(A_M_NAME[STP_FN,8],0)
	   GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=1
	   RETU
	 ENDIF
      ELSE
	SANDCUTW[STP_FN,2] := 1
	if  (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
	  dout2(A_M_NAME[STP_FN,8],1)
	ENDIF
      ENDIF
    CASE LCHTYPE=6
      IF  ( SANDCUTW[STP_FN,2] =0 )
	 X=INT((WDATA(A_M_NAME[STP_FN,8])-2048)*A_M_NAME[STP_FN,6]/PER/2048)
	 IF X <= SANDCUTW[STP_FN,1]
	   dout2(A_M_NAME[STP_FN,8],0)
	   GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=1
	   SANDCUTW[STP_FN,2] := 1
	   RETU
	 ENDIF
      ELSE
	IF CHK_LASTOUT() >1
	  RETU
	ENDIF
	SANDCUTW[STP_FN,2] := 1
	if  (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
	  dout2(A_M_NAME[STP_FN,8],1)
	ENDIF
      ENDIF
    ENDCASE
  ENDIF
  if (lchtype =6 )  .OR.  (lchtype =7 )  .OR.  (lchtype =10)   .OR.  (lchtype =9)  .OR.  (lchtype =11)	 .OR.  (lchtype =12)   .OR.  (lchtype =13)   .OR.  (lchtype =14)   .OR. LCHTYPE=32
    if	 (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
      TST0_LS1(STP_FN,STP_FN)
    ELSE
      *****00000000000000²Ö­p°£¥~000000000000000000000
      if (LCHTYPE <> 5) .and. (LCHTYPE <> 32) .and.( LCHTYPE <> 14)  .and. ( LCHTYPE <> 15)   .and. ( LCHTYPE <> 8) .and. ( LCHTYPE <>26)
	setZokn(A_M_NAME[STP_FN,8],0)
      ENDIF
  ENDIF
  ******************************************
 endif
  IF  RDZEROK(A_M_NAME[STP_FN,8])=0
    DO CASE
    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5  .OR. LCHTYPE=30	.OR. LCHTYPE=15
      dout2(A_M_NAME[STP_FN,8],0)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[1,13]  SAY	"     " PICT "&XMC_F"
      @  4,A_M_NAME[2,13]  SAY	"     " PICT "&XMC_F"
      @  4,A_M_NAME[3,13]  SAY	"     " PICT "&XMC_F"
      @  4,A_M_NAME[4,13]  SAY	"     " PICT "&XMC_F"
      A_M_NAME[1,10] := A_M_NAME[1,9]
      A_M_NAME[2,10] := A_M_NAME[2,9]
      A_M_NAME[3,10] := A_M_NAME[3,9]
      A_M_NAME[4,10] := A_M_NAME[4,9]
      A_M_NAME[1,12] := A_M_NAME[1,6]
      CLEACHMEM(0)
      CLEACHMEM(1)
      CLEACHMEM(2)
      CLEACHMEM(3)
      STPN1=STPN1+1
      STPN2=STPN2+1
      STPN3=STPN3+1
      STPN4=STPN4+1
      STP4=7
      SET COLOR TO &C2 / &C1
      *@ 11,7  SAY   "úLúPúPúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[1,2] :=1
      WTANK_F[2,2] :=1
      WTANK_F[3,2] :=1
      WTANK_F[4,2] :=1
      WTANK_F[1,1] :=0
      WTANK_F[2,1] :=0
      WTANK_F[3,1] :=0
      WTANK_F[4,1] :=0
    CASE  LCHTYPE=8 .or.  LCHTYPE=16 .or. LCHTYPE=17  .or. LCHTYPE=26
      dout2(A_M_NAME[STP_FN,8],0)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[3,13]  SAY	"     " PICT "&XMC_F"
      @  4,A_M_NAME[4,13]  SAY	"     " PICT "&XMC_F"
      A_M_NAME[3,10] := A_M_NAME[3,9]
      A_M_NAME[4,10] := A_M_NAME[4,9]
      A_M_NAME[2,12] := A_M_NAME[2,6]
      CLEACHMEM(2)
      CLEACHMEM(3)
      STPN3=STPN3+1
      STPN4=STPN4+1
      STP4=7
      SET COLOR TO &C2 / &C1
      *@ 11,7  SAY   "úLúPúPúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[3,2] :=1
      WTANK_F[4,2] :=1
      WTANK_F[3,1] :=0
      WTANK_F[4,1] :=0
      setdla(1,0)
    CASE  LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9    .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      dout2(A_M_NAME[STP_FN,8],0)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[4,13]  SAY  "     " PICT "&XMC_F"
      A_M_NAME[4,10] := A_M_NAME[4,9]
      A_M_NAME[4,12] := A_M_NAME[4,6]
      CLEACHMEM(3)
      STPN4=STPN4+1
      STP4=7
      SET COLOR TO &C2 / &C1
      *@ 11,7  SAY   "úLúPúPúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[4,2] :=1
      WTANK_F[4,1] :=0
    ENDCASE
  ENDIF
CASE STP4=7
  GS_CHG=0
  DSPDATA_A[STP_FN] := 1
  IF SANDCUTW[STP_FN,1] =0
    GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=1
  ENDIF
  GS_DROPRST()
  DO CASE
    CASE   LCHTYPE=14 .OR. LCHTYPE=32  .OR. LCHTYPE=5 .OR. LCHTYPE=30	.OR. LCHTYPE=15
      IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
	STP1=1
	STP2=0
	STP3=0
	STP4=0
      ELSE
	LAST_PCS=1
	STP1=0
	STP2=0
	STP3=0
	STP4=0
	STPN1=1
	STPN2=1
	STPN3=1
	STPN4=1
	WTANK_F[STP_FN-3,3] :=1
	WTANK_F[STP_FN-2,3] :=1
	WTANK_F[STP_FN-1,3] :=1
	WTANK_F[STP_FN,3] :=1
      ENDIF
    CASE  LCHTYPE=8 .or.  LCHTYPE=16 .or. LCHTYPE=17   .or. LCHTYPE=26
      IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
	STP3=1
	STP4=0
      ELSE
	STP3=0
	STP4=0
	STPN3=1
	STPN4=1
	WTANK_F[STP_FN-1,3] :=1
	WTANK_F[STP_FN,3] :=1
      ENDIF
    CASE  LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
	STP4=1
      ELSE
	STP4=0
	STPN4=1
	WTANK_F[STP_FN,3] :=1
      ENDIF
  ENDCASE
ENDCASE
RETU
**------------------------------------------------------------------------------------------------------------
PROCEDURE  STP5
PARAMETERS  P1,P2,P3
STP_ZN=4
STP_FN=5
STP_FC="5"
DO CASE
CASE (STP5=0)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE ( NEXTOK1=1   .AND.     (UCHTYPE=5  .or.UCHTYPE =31   .or. weight_type[stp_zn]=77  .OR.	 UCHTYPE=8 .OR. UCHTYPE=9  .OR. UCHTYPE=10 .OR. UCHTYPE=13  .OR. UCHTYPE=15  .OR. UCHTYPE=18  ) )
    IF (A_PRESS_N0[1,21,5,1] =77)
      A_PRESS_N0[1,21,STP_FN,1] := 0
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN)
      a_copy_5(A_PRESS_N0,1,4)
      NEXTOK1=0
      STP5=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE (UCHTYPE=6  .OR.UCHTYPE=22   .OR.UCHTYPE=30 .OR.  UCHTYPE=11  .or. UCHTYPE=12  .or. UCHTYPE=16 .or. UCHTYPE=17 .or. UCHTYPE=19  ) .AND. NEXTOK1=1  .and. STP6=0
    IF (A_PRESS_N0[1,21,6,1] =77)
      A_PRESS_N0[1,21,5,1] :=0
      A_PRESS_N0[1,21,6,1] :=0
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN+1)
      IF LCHTYPE=16 .or. LCHTYPE=17  .or. UCHTYPE=19	   .OR.  storb_e=1
	a_copy_4(A_PRESS_B0,STP_FN,STP_FN+1)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP5=1
      STP6=0
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
CASE (LCHTYPE=7  .OR. LCHTYPE=32  .OR. LCHTYPE=26 ) .AND. NEXTOK1=1
  IF (A_PRESS_N0[1,21,STP_FN,1] =77)
    A_PRESS_N0[1,21,STP_FN,1] :=0
    a_copy_4(A_PRESS_N0,STP_FN,STP_FN)	&& COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
    A_PRESS_N0[1,21,STP_FN,1] :=0
    NEXTOK1=0
    STP&STP_FC=1
    FOR IX=1 TO (GS_TOT+UWC_TOT)
      IF  A_PRESS_N0[1,21,ix,1] =77
	NEXTOK1=1
      ENDIF
    NEXT
  ENDIF
  ENDCASE

CASE (STP5=1)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE LCHTYPE=2
    IF ((A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1))
      WTANK_F[STP_FN,1] :=77
      A_PRESS_N0[1,21,STP_FN,1] :=0
      STP&STP_FC=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE LCHTYPE=4
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP5=2
      CLEACHMEM(STP_ZN)
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE (UCHTYPE >=5  .or.UCHTYPE <=13) .OR.   UCHTYPE=31   .or.   UCHTYPE=22   .OR. UCHTYPE=15	.or. UCHTYPE=16 .or. UCHTYPE=17  .OR. UCHTYPE=18   .or. UCHTYPE=19   .or.LCHTYPE=21
   IF ((A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1))
      WTANK_F[STP_FN,1] :=77
      STP&STP_FC=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  ENDCASE
CASE STP5=2
  WMINX5=0
  WMINSF=0
  DRAF=0
  DO CASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    DO CASE
    CASE LCHTYPE=2
      STP&STP_FC=4
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[STP_FN-1,1] :=1
      WTANK_F[STP_FN,1] :=1
    CASE LCHTYPE=21
      STP&STP_FC=4
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[STP_FN-4,1] :=1
      WTANK_F[STP_FN-3,1] :=1
      WTANK_F[STP_FN-2,1] :=1
      WTANK_F[STP_FN-1,1] :=1
      WTANK_F[STP_FN,1] :=1
    CASE LCHTYPE=4
      STP5=4
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[4,1] :=1
      WTANK_F[5,1] :=1
    CASE (UCHTYPE=5  .OR.   UCHTYPE=31	  .or. weight_type[stp_zn]=77	 .or. UCHTYPE=8 .OR. UCHTYPE=9 .OR. UCHTYPE=10 .OR. UCHTYPE=13	.OR. UCHTYPE=15   .OR. UCHTYPE=18  )
      STP&STP_FC=4
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[STP_FN,1] :=1
    CASE UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22    .OR.  UCHTYPE=11	.or. UCHTYPE=12 .or. UCHTYPE=16 .or. UCHTYPE=17   .or. UCHTYPE=19
      STP5=0
      STP6=1
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE LCHTYPE=7   .OR. LCHTYPE=26  .OR. LCHTYPE=32
      STP&STP_FC=4
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[STP_FN,1] :=1
    ENDCASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
   ADJWN=0
   ADJWN_F=0
    DO CASE
    CASE  UCHTYPE=6   .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR.  UCHTYPE=11 .or. UCHTYPE=12 .or. UCHTYPE=16	  .or. UCHTYPE=17 .or. UCHTYPE=19
      IF WATER_INPUT=1
	 XPN=0
	 XP1=INT(A_PRESS_N0[2,STPN&STP_FC,1,1]	*  G1_WATER/100)
	 XP2=INT(A_PRESS_N0[2,STPN&STP_FC,2,1]	*  G2_WATER/100)
	 XP3=INT(A_PRESS_N0[2,STPN&STP_FC,3,1]	*  S1_WATER/100)
	 XP4=INT(A_PRESS_N0[2,STPN&STP_FC,4,1]	*  S2_WATER/100)
	 IF UCHTYPE=16 .or. UCHTYPE=17
	   XP5=INT(A_PRESS_N0[2,STPN&STP_FC,10,1])
	   XP6=INT(A_PRESS_N0[2,STPN&STP_FC,11,1] )
	   XP7=INT(A_PRESS_N0[2,STPN&STP_FC,12,1])
	 ELSE
	   XP5=0
	   XP6=0
	   XP7=0
	 ENDIF
	 xtmpmw=xp1+XP2+XP3+XP4 +XP5 +XP6 +XP7
	 xtmpw=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] +A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
	 IF  XTMPW  > 0
	   ADJWN=-A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]  * XTMPMW /XTMPW
	   A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] =ADJWN
	 ENDIF
	 XP1=INT(A_PRESS_N0[2,STPN&STP_FC,1,8]	*  G1_WATER/100)
	 XP2=INT(A_PRESS_N0[2,STPN&STP_FC,2,8]	*  G2_WATER/100)
	 XP3=INT(A_PRESS_N0[2,STPN&STP_FC,3,8]	*  S1_WATER/100)
	 XP4=INT(A_PRESS_N0[2,STPN&STP_FC,4,8]	*  S2_WATER/100)
	 IF UCHTYPE=16 .or. UCHTYPE=17
	   XP5=INT(A_PRESS_N0[2,STPN&STP_FC,10,8])
	   XP6=INT(A_PRESS_N0[2,STPN&STP_FC,11,8] )
	   XP7=INT(A_PRESS_N0[2,STPN&STP_FC,12,8])
	 ELSE
	   XP5=0
	   XP6=0
	   XP7=0
	 ENDIF
	 xtmpmw=xp1+XP2+XP3+XP4 +XP5+XP6+XP7
	 xtmpw=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,8]
	 IF  XTMPW  > 0
	   ADJWN_F=-A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]  * XTMPMW /XTMPW
	 ENDIF
	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      ELSE
	XPA1=1
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
	ADJWN=PWATER *XP4/ (XP4 +XP5)
	ADJWN=	INT(ADJWN *A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	ADJWN_F=ADJWN
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+adjwn
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
      ENDIF
     RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+ADJWN)
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +ADJWN_F  PICT "&XMC_F"
	  WTANK_F[STP_FN,1] :=1
	  DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
	  if  storb_e=1
	    EW1=A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,1]
	    A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	  endif
	  EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] +ADJWN
	  EWN=(EW1 * 2048 / A_M_NAME[STP_FN,10])
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	  XMC_F=A_M_NAME[STP_FN,3]
	  *@  8,A_M_NAME[STP_FN,13]  SAY  EW1	PICT "&XMC_F"
	  SETCHDATA(STP_ZN,EWN)
	  SETDLA(A_M_NAME[STP_FN+1,8],EWN)
	  STP&STP_FC=0
	  stp6=1
	  *ENDIF
	ENDIF
	RETU
      ENDIF
    endcase
    XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
    XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1]
    XPN=-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
    ADJWN=XPN
    ADJWN_F=0
    DO CASE
    CASE  LCHTYPE=21
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * WATER_inc[stp_fn]/100)
      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * WATER_inc[stp_fn]/100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
    CASE  UCHTYPE=9  .or. UCHTYPE=31  .or. weight_type[stp_zn]=77   .or.  uchtype=10 .OR. UCHTYPE=13 .OR. UCHTYPE_n=618
      IF WATER_INPUT=1
	XPN=0
	XP1=INT(A_PRESS_N0[2,STPN&STP_FC,1,1]  *  G1_WATER/100)
	XP2=INT(A_PRESS_N0[2,STPN&STP_FC,2,1]  *  G2_WATER/100)
	XP3=INT(A_PRESS_N0[2,STPN&STP_FC,3,1]  *  S1_WATER/100)
	XP4=INT(A_PRESS_N0[2,STPN&STP_FC,4,1]  *  S2_WATER/100)
	ADJWN=-(XP1+XP2+XP3+XP4)

	XP1=INT(A_PRESS_N0[2,STPN&STP_FC,1,8]  *  G1_WATER/100)
	XP2=INT(A_PRESS_N0[2,STPN&STP_FC,2,8]  *  G2_WATER/100)
	XP3=INT(A_PRESS_N0[2,STPN&STP_FC,3,8]  *  S1_WATER/100)
	XP4=INT(A_PRESS_N0[2,STPN&STP_FC,4,8]  *  S2_WATER/100)
	ADJWN_F=-(XP1+XP2+XP3+XP4)
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      else
	ADJWN=PWATER
	ADJWN_F=ADJWN
      ENDIF
    CASE  UCHTYPE=6   .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR.  UCHTYPE=11 .or. UCHTYPE=12 .or. UCHTYPE=16 .or. UCHTYPE=17	.or. UCHTYPE=19
      IF WATER_INPUT=1
	XPN=0
	XP1=INT(A_PRESS_N0[2,STPN&STP_FC,1,1]  *  G1_WATER/100)
	XP2=INT(A_PRESS_N0[2,STPN&STP_FC,2,1]  *  G2_WATER/100)
	XP3=INT(A_PRESS_N0[2,STPN&STP_FC,3,1]  *  S1_WATER/100)
	XP4=INT(A_PRESS_N0[2,STPN&STP_FC,4,1]  *  S2_WATER/100)
	IF UCHTYPE=16 .or. UCHTYPE=17
	  XP5=INT(A_PRESS_N0[2,STPN&STP_FC,10,1])
	  XP6=INT(A_PRESS_N0[2,STPN&STP_FC,11,1] )
	  XP7=INT(A_PRESS_N0[2,STPN&STP_FC,12,1])
	ELSE
	  XP5=0
	  XP6=0
	  XP7=0
	ENDIF
	xtmpmw=xp1+XP2+XP3+XP4 +XP5+XP6+XP7
	xtmpw=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] +A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
	IF  XTMPW  > 0
	  ADJWN=-A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]  * XTMPMW /XTMPW
	ENDIF
	XPN=0
	XP1=INT(A_PRESS_N0[2,STPN&STP_FC,1,8]  *  G1_WATER/100)
	XP2=INT(A_PRESS_N0[2,STPN&STP_FC,2,8]  *  G2_WATER/100)
	XP3=INT(A_PRESS_N0[2,STPN&STP_FC,3,8]  *  S1_WATER/100)
	XP4=INT(A_PRESS_N0[2,STPN&STP_FC,4,8]  *  S2_WATER/100)
	IF UCHTYPE=16 .or. UCHTYPE=17
	  XP5=INT(A_PRESS_N0[2,STPN&STP_FC,10,8])
	  XP6=INT(A_PRESS_N0[2,STPN&STP_FC,11,8] )
	  XP7=INT(A_PRESS_N0[2,STPN&STP_FC,12,8])
	ELSE
	  XP5=0
	  XP6=0
	  XP7=0
	ENDIF
	xtmpmw=xp1+XP2+XP3+XP4 +XP5+XP6+XP7
	xtmpw=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,8]
	IF  XTMPW  > 0
	  ADJWN_F=-A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]  * XTMPMW /XTMPW
	ENDIF
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      ELSE
	XPA1=1
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
	ADJWN=PWATER *XP4/ (XP4 +XP5)
	ADJWN=	INT(ADJWN *A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	ADJWN_F=ADJWN
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+adjwn
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
      ENDIF
    ENDCASE
    A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] := ADJWN
    if	uchtype=13
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,11] := ADJWN
    endif
    *ADJWN_F=ADJWN
    XMC_F=A_M_NAME[STP_FN,3]
    i=	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN_F
    @  4,A_M_NAME[STP_FN,13]  say i PICT "&XMC_F"
    SET COLOR TO &C2  / &C1
    *MTANK_MARK(6,STP_FN,1)
    DSPA_ARROW(STP_FN,1,14)  &&   úD
    *DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
    if ( UCHTYPE=5 .or. UCHTYPE=31.or. LCHTYPE=7  .or. UCHTYPE=8 .OR. UCHTYPE=9 )
	weight_type[stp_zn]=77
    ENDIF
    if	UCHTYPE=10 .OR. UCHTYPE=13 .OR. UCHTYPE=15
	weight_type[stp_zn]=77
    ENDIF
    do case
    CASE LCHTYPE=2  .OR. LCHTYPE=21
      SET COLOR TO &C10 / &C1
      *@ 11,22 SAY   "úZúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_RESCALL(STP_FN)
    CASE LCHTYPE=4
      SET COLOR TO &C10 / &C1
      *@ 11,22 SAY   "úZúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      SET COLOR TO &C7 +/ &C1
      WEIG_RESCALL(STP_FN)
      IF WATER_INPUT =0
	XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1]
	ADJWN=	-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
	ADJWN_F=ADJWN
	XMC_F=A_M_NAME[STP_FN,3]
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] :=ADJWN
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +ADJWN_f PICT "&XMC_F"
      endif
      &&CASE UCHTYPE=5 .or. UCHTYPE=31.or.UCHTYPE=6 .OR.UCHTYPE=30.OR.UCHTYPE=22 .or.LCHTYPE=7.or. UCHTYPE=8 .OR.UCHTYPE=9 .OR. UCHTYPE=10.OR.UCHTYPE=11 .or. UCHTYPE=12 .OR. UCHTYPE=13 .OR. UCHTYPE=15  .or. UCHTYPE=16 .or. UCHTYPE=17␀
      && CASE UCHTYPE=5 .or. UCHTYPE=31 .or. UCHTYPE=33 .or. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22 .or. LCHTYPE=7  .or. UCHTYPE=8 .OR. UCHTYPE=9 &
      &&.OR. UCHTYPE=10   .OR.	UCHTYPE=11 .or. UCHTYPE=12 .OR. UCHTYPE=13 .OR. UCHTYPE=15  .or. UCHTYPE=16 .or. UCHTYPE=17␀
    CASE     weight_type[stp_zn]=77  .or.UCHTYPE=6  .OR.UCHTYPE=30   .OR.UCHTYPE=22   .OR.  UCHTYPE=11 .or. UCHTYPE=12	.or. UCHTYPE=16 .or. UCHTYPE=17
      SET COLOR TO &C10 / &C1
      *@ 11,22 SAY   "úZúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_RESCALL(STP_FN)
    CASE UCHTYPE=26 .OR. LCHTYPE=32  .or. UCHTYPE=32
      SETCHDATA(STP_ZN,0)
      ADJWN=0
      SET COLOR TO &C10 / &C1
      *@ 11,22 SAY   "úZúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_RESCALL(STP_FN)
    ENDCASE
    SET COLOR TO &C7 +/ &C1
    CLEACHMEM(STP_ZN)
    SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+ ADJWN
    WMINX5=(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10]
    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETW2(STP_ZN,WMINX5)
    SETOK(STP_ZN)
    DOUT(STP_ZN,1)
    STP5=3
  ENDCASE
CASE STP5=3
  do case
  case	LCHTYPE=17
    XP3=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
    XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
    XP5=XP3
    X=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
    IF	INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))   <> X
      ADJW12(STP_ZN,(INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))  -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))
      XMC_F=A_M_NAME[STP_FN,3]
      IF MODY_D1=0
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))   PICT "&XMC_F"
      ENDIF
    ENDIF
  case LCHTYPE=21
    XPN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]*WATER_INC[STP_FN]/100)
    X=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
    IF	XPN  <> X
      ADJW12(STP_ZN,(XPN -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=XPN
      XMC_F=A_M_NAME[STP_FN,3]
      IF MODY_D1=0
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +XPN  PICT "&XMC_F"
      ENDIF
    ENDIF
  case (LCHTYPE=4 .OR. LCHTYPE=2 .OR. LCHTYPE=7)
    XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
    XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1]
    IF XP4 +XP5 <>0
      XPN=-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
    ENDIF
    X=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
    IF	XPN  <> X
      ADJW12(STP_ZN,(XPN -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=XPN
      XMC_F=A_M_NAME[STP_FN,3]
      IF MODY_D1=0
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +XPN  PICT "&XMC_F"
      ENDIF
    ENDIF
  case (UCHTYPE=5  .or. UCHTYPE=31 .or. UCHTYPE=8 .OR. UCHTYPE=15   .OR. UCHTYPE=18  )
    X=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
    IF	int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)  <> X
      ADJW12(STP_ZN,(int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol) -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
      XMC_F=A_M_NAME[STP_FN,3]
      IF MODY_D1=0
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)  PICT "&XMC_F"
      ENDIF
    ENDIF
  case UCHTYPE=9   .OR. UCHTYPE=10 .OR. UCHTYPE=13   .OR.  weight_type[stp_zn]=77
    ADJWN=0
    IF WATER_INPUT=1
	XPN=0
	XP1=INT(A_PRESS_N0[2,STPN&STP_FC,1,1]  *  G1_WATER/100)
	XP2=INT(A_PRESS_N0[2,STPN&STP_FC,2,1]  *  G2_WATER/100)
	XP3=INT(A_PRESS_N0[2,STPN&STP_FC,3,1]  *  S1_WATER/100)
	XP4=INT(A_PRESS_N0[2,STPN&STP_FC,4,1]  *  S2_WATER/100)
	ADJWN=-(XP1+XP2+XP3+XP4)
	X=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
      IF  ADJWN   <> X
	ADJW12(STP_ZN,(ADJWN  -X)*2048/A_M_NAME[STP_FN,10])
	A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=ADJWN

	XP1=INT(A_PRESS_N0[2,STPN&STP_FC,1,8]  *  G1_WATER/100)
	XP2=INT(A_PRESS_N0[2,STPN&STP_FC,2,8]  *  G2_WATER/100)
	XP3=INT(A_PRESS_N0[2,STPN&STP_FC,3,8]  *  S1_WATER/100)
	XP4=INT(A_PRESS_N0[2,STPN&STP_FC,4,8]  *  S2_WATER/100)
	ADJWN_F=-(XP1+XP2+XP3+XP4)
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
	XMC_F=A_M_NAME[STP_FN,3]
	IF MODY_D1=0
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN_F  PICT "&XMC_F"
	ENDIF
      ENDIF
    ELSE
	X=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
	X0=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	IF  X0 <> X
	  ADJW12(STP_ZN,(int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol) -X)*2048/A_M_NAME[STP_FN,10])
	  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,11] :=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
	  XMC_F=A_M_NAME[STP_FN,3]
	  IF MODY_D1=0
	    @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)  PICT "&XMC_F"
	  ENDIF
	ENDIF
    ENDIF
  ENDCASE
  TST1_LS1(STP_FN)
  IF LS1[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS2(STP_FN)
  IF RDOK2(STP_ZN)=0
    *WMINX=RDN_DATA(304 +(KLCHN *2) )
    WMINX5=RDN_DATA(304 +(4 *2) )
    DOUT(STP_ZN,0)
    STOPTM&STP_FC=0
    DOUT3(0,0)
    EWN=CHENDATA(STP_ZN)
    wadj5=ewn
    if uchtype=18	.OR.  storb_e=1
      EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
      A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    endif
    EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
    XDSPC=RIGHT(ALLTRIM(A_M_NAME[STP_FN,3]),2)
    IF XDSPC="."
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1 * 10) /10
    ELSE
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    ENDIF
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
    XMC_F=A_M_NAME[STP_FN,3]
    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
    SET COLOR TO &C2 / &C1
    *MTANK_MARK(6,STP_FN,0)
    DSPA_ARROW(STP_FN,0,0)  && EREASE  úD
    SET COLOR TO &C7 +/ &C1
    DO CASE
    CASE LCHTYPE=2
      STP5=4
      WTANK_F[4,1] :=1
      WTANK_F[5,1] :=1
      X=EWN
    CASE LCHTYPE=21
      STP5=4
      WTANK_F[STP_FN,1] :=1
      WTANK_F[STP_FN-1,1] :=1
      WTANK_F[STP_FN-2,1] :=1
      WTANK_F[STP_FN-3,1] :=1
      WTANK_F[STP_FN-4,1] :=1
      X=EWN
    CASE  lchtype=7 .OR. lchtype=26   .OR. LCHTYPE=32
      STP5=4
      WTANK_F[5,1] :=1
      X=EWN
    CASE LCHTYPE=4
      STP5=4
      IF KOT=1
	WTANK_F[4,1] :=1
	WTANK_F[5,1] :=1
      ENDIF
      X=EWN
    CASE (UCHTYPE=5 .OR.  weight_type[stp_zn]=77    .or. UCHTYPE=31 .or. UCHTYPE=8 .OR. UCHTYPE=9 .OR. UCHTYPE=10 .OR. UCHTYPE=13  .OR. UCHTYPE=15   .OR. UCHTYPE=18  )
      STP5=4
      WTANK_F[5,1] :=1
      X=wadj5
    CASE UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22   .OR.  UCHTYPE=11 .or. UCHTYPE=12  .or. UCHTYPE=16 .or. UCHTYPE=17 .or. UCHTYPE=19
      STP5=0
      STP6=1
      WTANK_F[5,1] :=1
      X=EWN
      SETDLA(KLCHN,X)
    ENDCASE
  ENDIF
  WMINSF=0
CASE STP5=4
  IF  (UCHTYPE=5 .OR.  weight_type[stp_zn]=77	 .or. UCHTYPE=31  .OR. UCHTYPE=9 .OR. UCHTYPE=10 .OR.UCHTYPE=12  .OR.  UCHTYPE=18  .OR.  UCHTYPE=13  .OR.  UCHTYPE=15 .or.  UCHTYPE=16	 .or. UCHTYPE=17  )
     IF WMINSF=0
	 X=WDATA(a_m_name[STP_FN,8])-2048
	 IF X <WMINX5
	   WMINSF=1
	   SET COLOR TO &C10 / &C1
	   *@ 11,22 SAY   "úZúYúYúYú["
	   DSPA_ARROW(STP_FN,1,14)  &&	 úD
	   SETOK(STP_ZN)
	   DOUT(STP_ZN,1)
	 ENDIF
     ELSE
	IF RDOK2(STP_ZN)=0
	  WMINSF=0
	  DOUT(STP_ZN,0)
	  SET COLOR TO &C2 / &C1
	  *MTANK_MARK(6,STP_FN,0)
	  DSPA_ARROW(STP_FN,0,0)  && EREASE  úD
	  SET COLOR TO &C7 +/ &C1
	ENDIF
     ENDIF
  ENDIF
  IF   (WTANK_F[5,1]<>-99)
    RETU
  ENDIF
  IF KOT=1
    IF ( DIN(9)=1 )   .OR.  ( DIN(12)=0)
      RETU
    ENDIF
  ELSE
    IF	LCHTYPE =2  .or. lchtype=7   .or. lchtype=26   .OR. LCHTYPE=32
      IF ( DIN(8)=1) .OR. (DIN(11)=0)
	RETU
      ENDIF
    ELSEif  (UCHTYPE =5 .OR.  weight_type[stp_zn]=77	.or. UCHTYPE=31  .or. UCHTYPE=8 .OR. UCHTYPE=10 .OR. UCHTYPE=18  )
      IF ( DIN(9)=1 )	.OR.  ( DIN(12)=0)
	RETU
      ENDIF
    ENDIF
  ENDIF
  IF  TIME1[STP_FN,2] =0
    TIME1[STP_FN,2] :=SECONDS()
  ENDIF
  IF ABS(SECONDS()-TIME1[STP_FN,2]) >=TIME1[STP_FN,1]
    TIME1[STP_FN,2] :=0
    STP5=5
  ENDIF
  if (lchtype=21)
    IF GS_DROPOK(A_M_NAME[STP_FN,8] +1)<> 1
      STP5=4
    ENDIF
  endif
CASE STP5=5
  DOUT(STP_ZN,0)
  SET COLOR TO &C2 / &C1
  *MTANK_MARK(6,STP_FN,0)
  *DSPA_ARROW(STP_FN,0,0)  && EREASE  úD
  SET COLOR TO &C7 +/ &C1
  GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=2
  DO CASE
  CASE LCHTYPE=2
    WTANK_F[5,1]=0
    STP5=6
    SET COLOR TO &C11 / &C1
    *@ 11,22 SAY   "úLúPúKúPúO"
    DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    SET COLOR TO &C7 +/ &C1
    SETZERTM(3,PZERTM4)
    *SETZER(3,INT(((PZER4/A_M_NAME[4,6]))*PER*2048)+2048)
    SETZEROK(3)
    dout2(A_M_NAME[STP_FN,8],1)
  CASE LCHTYPE=21
    WTANK_F[5,1]=0
    STP5=6
    SET COLOR TO &C11 / &C1
    *@ 11,22 SAY   "úLúPúKúPúO"
    DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    SET COLOR TO &C7 +/ &C1
    SETZERTM(0,PZERTM1)
    SETZEROK(0)
    dout2(A_M_NAME[STP_FN,8],1)
  CASE LCHTYPE=4
    WTANK_F[5,1]=0
    STP5=6
    SET COLOR TO &C11 / &C1
    *@ 11,22 SAY   "úLúPúKúPúO"
    *DSPB_ARROW(2,1,14)  && úD
    DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    SET COLOR TO &C7 +/ &C1
    SETZERTM(1,PZERTM2)
    SETZER(1,INT(((PZER4/A_M_NAME[2,6]))*PER*2048)+2048)
    SETZEROK(1)
    dout2(A_M_NAME[STP_FN,8],1)
  CASE (UCHTYPE=5 .OR.	weight_type[stp_zn]=77	  .or. UCHTYPE=31  .or. UCHTYPE=8 .OR. UCHTYPE=9 .OR. UCHTYPE=10 .OR. UCHTYPE=13  .OR. UCHTYPE=15   .OR. UCHTYPE=18  )
    WTANK_F[5,1]=0
  DSPA_ARROW(STP_FN,0,0)  && EREASE  úD
    STP5=6
    do	case
    case   UCHTYPE=13
      if (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
	RETU
      ENDIF
    ENDcase
    SET COLOR TO &C11 / &C1
    *@ 11,22 SAY   "úLúPúKúPúO"
    DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    SET COLOR TO &C7 +/ &C1
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    SETZEROK(A_M_NAME[STP_FN,8])
    dout2(A_M_NAME[STP_FN,8],1)
  CASE LCHTYPE=7  .OR.	LCHTYPE=26  .OR. LCHTYPE=32
    WTANK_F[5,1]=0
    STP5=6
    if	(A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
      SET COLOR TO &C11 / &C1
      *@ 11,22 SAY   "úLúPúKúPúO"
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
      SET COLOR TO &C7 +/ &C1
      xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
      SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
      SETZEROK(A_M_NAME[STP_FN,8])
      dout2(A_M_NAME[STP_FN,8],1)
    ENDIF
  ENDCASE
CASE STP5=6
  JMPF=0
  do case
  case	UCHTYPE=13  .or.  UCHTYPE=32
    if (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
      JMPF=1
    ENDIF
  ENDcase

  if JMPF=0
    TST1_LS2(STP_FN)
    IF LS2[STP_FN,2]=1
      RETU
    ENDIF
    TST0_LS1(STP_FN,STP_FN)
  ELSE
      setZokn(A_M_NAME[STP_FN,8],0)
  ENDIF



  IF  RDZEROK(A_M_NAME[STP_FN,8])=0 .OR.  WATER_OUT=5
    WATER_OUT=0
    DO CASE
    CASE  LCHTYPE=2
      dout2(A_M_NAME[STP_FN,8],0)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[4,13]  SAY	"    " PICT "&XMC_F"
      @  4,A_M_NAME[5,13]  SAY	"    " PICT "&XMC_F"
      *DOUT3(4,0)
      CLEACHMEM(STP_ZN-1)
      CLEACHMEM(STP_ZN)
      STP5=7
      SET COLOR TO &C2 / &C1
      *@ 11,22 SAY   "úLúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      A_M_NAME[4,10] := A_M_NAME[4,9]
      A_M_NAME[5,10] := A_M_NAME[5,9]
      A_M_NAME[4,12] := A_M_NAME[4,6]
      WTANK_F[4,2] :=1
      WTANK_F[5,2] :=1
      WTANK_F[4,1] :=0
      WTANK_F[5,1] :=0
      STPN4=STPN4+1
      STPN5=STPN5+1
      SETDLA(A_M_NAME[STP_FN,8],0)
    CASE  LCHTYPE=21
      dout2(A_M_NAME[STP_FN,8],0)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[1,13]  SAY	"    " PICT "&XMC_F"
      @  4,A_M_NAME[2,13]  SAY	"    " PICT "&XMC_F"
      @  4,A_M_NAME[3,13]  SAY	"    " PICT "&XMC_F"
      @  4,A_M_NAME[4,13]  SAY	"    " PICT "&XMC_F"
      @  4,A_M_NAME[5,13]  SAY	"    " PICT "&XMC_F"
      *DOUT3(4,0)
      CLEACHMEM(STP_ZN-4)
      CLEACHMEM(STP_ZN-3)
      CLEACHMEM(STP_ZN-2)
      CLEACHMEM(STP_ZN-1)
      CLEACHMEM(STP_ZN)
      STP5=7
      SET COLOR TO &C2 / &C1
      *@ 11,22 SAY   "úLúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      A_M_NAME[1,10] := A_M_NAME[1,9]
      A_M_NAME[2,10] := A_M_NAME[2,9]
      A_M_NAME[3,10] := A_M_NAME[3,9]
      A_M_NAME[4,10] := A_M_NAME[4,9]
      A_M_NAME[5,10] := A_M_NAME[5,9]
      A_M_NAME[1,12] := A_M_NAME[1,6]
      WTANK_F[1,2] :=1
      WTANK_F[2,2] :=1
      WTANK_F[3,2] :=1
      WTANK_F[4,2] :=1
      WTANK_F[5,2] :=1
      WTANK_F[1,1] :=0
      WTANK_F[2,1] :=0
      WTANK_F[3,1] :=0
      WTANK_F[4,1] :=0
      WTANK_F[5,1] :=0
      STPN1=STPN1+1
      STPN2=STPN2+1
      STPN3=STPN3+1
      STPN4=STPN4+1
      STPN5=STPN5+1
      SETDLA(A_M_NAME[STP_FN,8],0)
    CASE  LCHTYPE=4
      dout2(A_M_NAME[STP_FN,8],0)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[4,13]  SAY	"     " PICT "&XMC_F"
      @  4,A_M_NAME[5,13]  SAY	"     " PICT "&XMC_F"
      DOUT3(4,0)
      CLEACHMEM(3)
      CLEACHMEM(4)
      STP5=7
      SET COLOR TO &C2 / &C1
      *@ 11,22 SAY   "úLúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      A_M_NAME[4,10] := A_M_NAME[4,9]
      A_M_NAME[5,10] := A_M_NAME[5,9]
      A_M_NAME[2,12] := A_M_NAME[2,6]
      WTANK_F[4,2] :=1
      WTANK_F[5,2] :=1
      WTANK_F[4,1] :=0
      WTANK_F[5,1] :=0
      STPN4=STPN4+1
      STPN5=STPN5+1
      SETDLA(1,0)
    CASE  (UCHTYPE=5 .OR.  weight_type[stp_zn]=77    .or. UCHTYPE=31  .or. UCHTYPE=8 .OR. UCHTYPE=9 .OR. UCHTYPE=10 .OR. UCHTYPE=13  .OR. UCHTYPE=15   .OR. UCHTYPE=18	)
      dout2(A_M_NAME[STP_FN,8],0)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[5,13]  SAY  "     " PICT "&XMC_F"
      STP5=7
      SET COLOR TO &C2 / &C1
      *@ 11,22 SAY   "úLúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      A_M_NAME[5,10] := A_M_NAME[5,9]
      A_M_NAME[A_M_NAME[STP_FN,8],12] := A_M_NAME[A_M_NAME[STP_FN,8],6]
      WTANK_F[5,2] :=1
      WTANK_F[5,1] :=0
      STPN5=STPN5+1
      CLEACHMEM(STP_ZN)
    CASE  LCHTYPE=7 .OR. LCHTYPE=26  .OR. LCHTYPE=32
      dout2(A_M_NAME[STP_FN,8],0)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[5,13]  SAY	"    " PICT "&XMC_F"
      *DOUT3(4,0)
      CLEACHMEM(STP_ZN)
      STP5=7
      SET COLOR TO &C2 / &C1
      *@ 11,22 SAY   "úLúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      A_M_NAME[5,10] := A_M_NAME[5,9]
      A_M_NAME[5,12] := A_M_NAME[4,6]
      WTANK_F[5,2] :=1
      WTANK_F[5,1] :=0
      STPN5=STPN5+1
    ENDCASE
  ENDIF
CASE STP5=7
  GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=1
  GS_DROPRST()
  DO CASE
  CASE ( LCHTYPE=2 .OR. LCHTYPE=4   )
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP4=1
      STP5=0
    ELSE
      STP5=0
      STP4=0
      STPN4=1
      STPN5=1
      WTANK_F[STP_FN-1,3] :=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  CASE ( LCHTYPE=21   )
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP1=1
      STP5=0
    ELSE
      STP5=0
      STP4=0
      STPN1=1
      STPN2=1
      STPN3=1
      STPN4=1
      STPN5=1
      WTANK_F[STP_FN-4,3] :=1
      WTANK_F[STP_FN-3,3] :=1
      WTANK_F[STP_FN-2,3] :=1
      WTANK_F[STP_FN-1,3] :=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  CASE	(UCHTYPE=5 .OR.  weight_type[stp_zn]=77    .or. UCHTYPE=31  .or. UCHTYPE=6 .OR.UCHTYPE=30   .OR.UCHTYPE=22  .or. UCHTYPE=8 .OR. UCHTYPE=10 .or. UCHTYPE=19  )
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP5=1
      IF ((TIME1[10,1] =88) .OR. (TIME1[11,1] =88) )
	DO CASE
	CASE ((TIME1[10,1] =88) .AND. (TIME1[11,1] =88) )
	  IF ((STP10=7) .AND.(STP11=7) )
	    WTANK_F[10,1] :=2
	    WTANK_F[11,1] :=2
	  ENDIF
	CASE TIME1[10,1] =88
	  IF STP10=7
	    WTANK_F[10,1] :=2
	  ENDIF
	CASE TIME1[11,1] =88
	  IF STP11=7
	    WTANK_F[11,1] :=2
	  ENDIF
	ENDCASE
      ENDIF
    ELSE
      STPN5=1
      STP5=0
      WTANK_F[STP_FN,3] :=1
      IF ((TIME1[10,1] =88) .OR. (TIME1[11,1] =88) )
	DO CASE
	CASE ((TIME1[10,1] =88) .AND. (TIME1[11,1] =88) )
	  IF ((STP10=7) .AND.(STP11=7) )
	    WTANK_F[10,1] :=2
	    WTANK_F[11,1] :=2
	  ENDIF
	CASE TIME1[10,1] =88
	  IF STP10=7
	    WTANK_F[10,1] :=2
	  ENDIF
	CASE TIME1[11,1] =88
	  IF STP11=7
	    WTANK_F[11,1] :=2
	  ENDIF
	ENDCASE
      ENDIF
    ENDIF
  CASE	 UCHTYPE=9 .OR. UCHTYPE=13   .OR. UCHTYPE=18
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP5=1
      IF SPACIAL_0 =1
	RETU
      ENDIF
      IF ((TIME1[9,1] =88) .OR. (TIME1[10,1] =88) )
	DO CASE
	CASE ((TIME1[9,1] =88) .AND. (TIME1[10,1] =88) )
	  IF ((STP9=7) .AND.(STP10=7) )
	    WTANK_F[9,1] :=2
	    WTANK_F[10,1] :=2
	  ENDIF
	CASE TIME1[10,1] =88
	  IF STP10=7
	    WTANK_F[10,1] :=2
	  ENDIF
	CASE TIME1[9,1] =88
	  IF STP9=7
	    WTANK_F[9,1] :=2
	    WTANK_F[9,2] :=1
	  ELSE
	    STP5=7
	  ENDIF
	ENDCASE
      ENDIF
    ELSE
      STPN5=1
      STP5=0
      WTANK_F[STP_FN,3] :=1
      IF SPACIAL_0 =1
	RETU
      ENDIF
      IF ((TIME1[9,1] =88) .OR. (TIME1[10,1] =88) )
	DO CASE
	CASE ((TIME1[9,1] =88) .AND. (TIME1[10,1] =88) )
	  IF ((STP9=7) .AND.(STP10=7) )
	    WTANK_F[9,1] :=2
	    WTANK_F[10,1] :=2
	  ENDIF
	CASE TIME1[9,1] =88
	  IF STP9=7
	    WTANK_F[9,1] :=2
	  else
	    stp5=7
	  ENDIF
	CASE TIME1[10,1] =88
	  IF STP10=7
	    WTANK_F[10,1] :=2
	  ENDIF
	ENDCASE
      ENDIF
    ENDIF
  CASE	LCHTYPE=7    .OR.  LCHTYPE=26  .OR. LCHTYPE=32
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP5=1
    ELSE
      STP5=0
      STPN5=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  CASE	 UCHTYPE=15
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP5=1
      IF ((TIME1[8,1] =88) .OR. (TIME1[9,1] =88) )
	DO CASE
	CASE ((TIME1[8,1] =88) .AND. (TIME1[9,1] =88) )
	  IF ((STP8=7) .AND.(STP9=7) )
	    WTANK_F[8,1] :=2
	    WTANK_F[9,1] :=2
	  ENDIF
	CASE TIME1[8,1] =88
	  IF STP8=7
	    WTANK_F[8,1] :=2
	  ENDIF
	CASE TIME1[9,1] =88
	  IF STP9=7
	    WTANK_F[9,1] :=2
	  ENDIF
	ENDCASE
      ENDIF
    ELSE
      STPN5=1
      STP5=0
      WTANK_F[STP_FN,3] :=1
      IF ((TIME1[8,1] =88) .OR. (TIME1[9,1] =88) )
	DO CASE
	CASE ((TIME1[8,1] =88) .AND. (TIME1[9,1] =88) )
	  IF ((STP8=7) .AND.(STP9=7) )
	    WTANK_F[8,1] :=2
	    WTANK_F[9,1] :=2
	  ENDIF
	CASE TIME1[8,1] =88
	  IF STP8=7
	    WTANK_F[8,1] :=2
	  ENDIF
	CASE TIME1[9,1] =88
	  IF STP11=7
	    WTANK_F[9,1] :=2
	  ENDIF
	ENDCASE
      ENDIF
    ENDIF
  ENDCASE
ENDCASE
RETU

**------------------------------------------------------------------------------------------------------------
PROCEDURE  STP6
PARAMETERS  P1,P2,P3
STP_ZN=5
STP_FN=6
STP_FC="6"
DO CASE
CASE (STP6=0)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE (UCHTYPE=1  .OR.  weight_type[stp_zn]=1	  .or.	UCHTYPE=8 .OR. UCHTYPE=10  .OR. UCHTYPE=15   ) .AND. NEXTOK1=1	.and. STP7=0
    IF (A_PRESS_N0[1,21,6,1] =77)
      A_PRESS_N0[1,21,6,1] :=0
      A_PRESS_N0[1,21,7,1] :=0
      a_copy_4(A_PRESS_N0,6,7)
      NEXTOK1=0
      STP6=1
      STP7=0
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE (UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=7 .OR. UCHTYPE=9 .OR. UCHTYPE=13  .OR. UCHTYPE=21   ) .AND. NEXTOK1=1
    IF (A_PRESS_N0[1,21,STP_FN,1] =77)
      A_PRESS_N0[1,21,STP_FN,1] :=0
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN)
      NEXTOK1=0
      STP6=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE (UCHTYPE=18    ) .AND. NEXTOK1=1  .and. STP7=0	  .and. STP8=0
    IF (A_PRESS_N0[1,21,6,1] =77)
      A_PRESS_N0[1,21,6,1] :=0
      A_PRESS_N0[1,21,7,1] :=0
      A_PRESS_N0[1,21,8,1] :=0
      a_copy_4(A_PRESS_N0,6,8)
      NEXTOK1=0
      STP6=1
      STP7=0
      STP8=0
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  ENDCASE
CASE (STP6=1)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE UCHTYPE=21
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP6=2
    ENDIF
  CASE UCHTYPE=1
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP6=2
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
      IF KOT=1
	WTANK_F[6,1] :=77
	WTANK_F[7,1] :=77
	RDDELAY[STP_FN,2] :=SECONDS()
	RDDELAY[STP_FN,3] :=0
      ENDIF
    ENDIF
  CASE UCHTYPE=8  .OR.	weight_type[stp_zn]=1	.OR. UCHTYPE=10 .OR. UCHTYPE=15
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP6=2
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=0
      IF KOT=1
	WTANK_F[6,1] :=77
	WTANK_F[7,1] :=77
	RDDELAY[STP_FN,2] :=SECONDS()
	RDDELAY[STP_FN,3] :=0
      ENDIF
    ENDIF
  CASE UCHTYPE=2 .OR. UCHTYPE=26  .or. UCHTYPE=32   .OR. UCHTYPE=7
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP&STP_FC=2
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
      IF KOT=1
	WTANK_F[STP_FN,1] :=77
	RDDELAY[STP_FN,2] :=SECONDS()
	RDDELAY[STP_FN,3] :=0
      ENDIF
    ENDIF

  CASE	UCHTYPE=5 .OR. UCHTYPE=31  .OR. UCHTYPE=9   .OR. UCHTYPE=13
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP&STP_FC=2
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=0
      IF KOT=1
	WTANK_F[STP_FN,1] :=77
	RDDELAY[STP_FN,2] :=SECONDS()
	RDDELAY[STP_FN,3] :=0
      ENDIF
    ENDIF
  CASE UCHTYPE=6 .OR.UCHTYPE=22  .OR.UCHTYPE=30  .OR.	UCHTYPE=11 .or. UCHTYPE=12 .or. UCHTYPE=16 .or. UCHTYPE=17 .or. UCHTYPE=19
    ADJWN=0
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP6=2
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1]
      IF WATER_INPUT=1
	XPN=0
	XP1=INT(A_PRESS_N0[2,STPN&STP_FC,1,1]  *  G1_WATER/100)
	XP2=INT(A_PRESS_N0[2,STPN&STP_FC,2,1]  *  G2_WATER/100)
	XP3=INT(A_PRESS_N0[2,STPN&STP_FC,3,1]  *  S1_WATER/100)
	XP4=INT(A_PRESS_N0[2,STPN&STP_FC,4,1]  *  S2_WATER/100)
	XP5=INT(A_PRESS_N0[2,STPN&STP_FC,10,1])
	XP6=INT(A_PRESS_N0[2,STPN&STP_FC,11,1] )
	XP7=INT(A_PRESS_N0[2,STPN&STP_FC,12,1])
	IF  A_PRESS_N0[2,STPN&STP_FC,6,1]  > 0
	  IF  A_PRESS_N0[2,STPN&STP_FC,5,1]  > 0
	    ADJWN=-(XP1+XP2+XP3+XP4 +XP5+XP6+XP7 )/2
	  ELSE
	    ADJWN=-(XP1+XP2+XP3+XP4+XP5+XP6+XP7)
	  ENDIF
	else
	    ADJWN=0
	endif
      ELSE
	A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
      ENDIF
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=ADJWN
    ENDIF
  CASE UCHTYPE=18
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP6=2
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
      XP6=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+2,1]
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=0
      IF KOT=1
	WTANK_F[6,1] :=77
	WTANK_F[7,1] :=77
	WTANK_F[8,1] :=77
	RDDELAY[STP_FN,2] :=SECONDS()
	RDDELAY[STP_FN,3] :=0
      ENDIF
    ENDIF
  ENDCASE
CASE STP6=2
  DRAF=0
  DO CASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    DO CASE
    CASE UCHTYPE=1  .OR.  weight_type[stp_zn]=1    .or.  UCHTYPE=8   .OR. UCHTYPE=10 .OR. UCHTYPE=15
      STP6=0
      STP7=2
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
  CASE (UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26  .or. UCHTYPE=32   .OR. UCHTYPE=5 .OR.UCHTYPE=30  .OR. UCHTYPE=6 .OR.UCHTYPE=22  .OR. UCHTYPE=7  .OR. UCHTYPE=9 .OR.  UCHTYPE=11  .or. UCHTYPE=12  .OR. UCHTYPE=13	 .or. UCHTYPE=19  .or. UCHTYPE=21)
      STP&STP_FC=4
      WTANK_F[STP_FN,1] :=1    && 77=­p¶q¤¤,1=­p¶qok,-99=can ¶i®Æ,0=NOTHING
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE ( UCHTYPE=16  .or. UCHTYPE=17	 )
      STP&STP_FC=4
      WTANK_F[STP_FN-1,1] :=1	 && 77=­p¶q¤¤,1=­p¶qok,-99=can ¶i®Æ,0=NOTHING
      WTANK_F[STP_FN,1] :=1    && 77=­p¶q¤¤,1=­p¶qok,-99=can ¶i®Æ,0=NOTHING
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN-1,4]  :=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN-1,7]  :=1
    CASE UCHTYPE=18
      STP6=0
      STP7=2
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    ENDCASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    ADJWN=0
    DO CASE
    CASE UCHTYPE=1
      RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol))
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol) PICT "&XMC_F"
	  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	    EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=EW1*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(A_M_NAME[STP_FN,8],EWN)
	    STP6=0
	    STP7=1
	  ELSE
	    EWN=WDATA(A_M_NAME[STP_FN,8])-2048
	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(A_M_NAME[STP_FN,8],EWN)
	    STP6=0
	    STP7=1
	  ENDIF
	ENDIF
	RETU
      ENDIF
    CASE UCHTYPE=8  .OR.  weight_type[stp_zn]=1     .OR. UCHTYPE=10 .OR. UCHTYPE=15  .OR. UCHTYPE=18
      RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1])
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
	  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=0
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	    EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=EW1*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(A_M_NAME[STP_FN,8],EWN)
	    STP6=0
	    STP7=1
	  ELSE
	    EWN=WDATA(A_M_NAME[STP_FN,8])-2048
	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(A_M_NAME[STP_FN,8],EWN)
	    STP6=0
	    STP7=1
	  ENDIF
	ENDIF
	RETU
      ENDIF
    CASE UCHTYPE=2 .OR. UCHTYPE=26  .or. UCHTYPE=32    .OR. UCHTYPE=7
      RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol))
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol) PICT "&XMC_F"
	  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	  WTANK_F[STP_FN,1] :=1
	  DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
	  EWN=WDATA(A_M_NAME[STP_FN,8])-2048
	  EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	  XMC_F=A_M_NAME[STP_FN,3]
	  *@  8,A_M_NAME[STP_FN,13]  SAY  EW1	PICT "&XMC_F"
	  SETCHDATA(STP_ZN,EWN)
	  SETDLA(A_M_NAME[STP_FN,8],EWN)
	  STP&STP_FC=4
	  *ENDIF
	ENDIF
	RETU
      ENDIF
    CASE UCHTYPE=21
      ADJWN=0
      ADJWN=ADJWN-A_PRESS_N0[L_PRESS,STPN&STP_FC,1,1] * water_inc[1] /100
      ADJWN=ADJWN-A_PRESS_N0[L_PRESS,STPN&STP_FC,2,1] * water_inc[2] /100
      ADJWN=ADJWN-A_PRESS_N0[L_PRESS,STPN&STP_FC,3,1] * water_inc[3] /100
      ADJWN=ADJWN-A_PRESS_N0[L_PRESS,STPN&STP_FC,4,1] * water_inc[4] /100
      ADJWN=ADJWN-A_PRESS_N0[L_PRESS,STPN&STP_FC,5,1] * water_inc[5] /100
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN
      RDDLY(STP_FN,A_M_NAME[STP_FN,8],(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+ADJWN))
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +ADJWN PICT "&XMC_F"
	  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=-ADJWN
	  WTANK_F[STP_FN,1] :=1
	  DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
	  EWN=WDATA(A_M_NAME[STP_FN,8])-2048
	  EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	  XMC_F=A_M_NAME[STP_FN,3]
	  *@  8,A_M_NAME[STP_FN,13]  SAY  EW1	PICT "&XMC_F"
	  SETCHDATA(STP_ZN,EWN)
	  *SETDLA(A_M_NAME[STP_FN,8],EWN)
	  STP&STP_FC=4
	  *ENDIF
	ENDIF
	RETU
      ENDIF
    CASE  UCHTYPE=5 .OR. UCHTYPE=31  .OR. UCHTYPE=9   .OR. UCHTYPE=13
      RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1])
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
	  WTANK_F[STP_FN,1] :=1
	  DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
	  EWN=WDATA(A_M_NAME[STP_FN,8])-2048
	  EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	  XMC_F=A_M_NAME[STP_FN,3]
	  *@  8,A_M_NAME[STP_FN,13]  SAY  EW1	PICT "&XMC_F"
	  SETCHDATA(STP_ZN,EWN)
	  SETDLA(A_M_NAME[STP_FN,8],EWN)
	  STP&STP_FC=4
	  *ENDIF
	ENDIF
	RETU
      ENDIF
    CASE  UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR.  UCHTYPE=11 .or. UCHTYPE=12 .or. UCHTYPE=16   .or. UCHTYPE=17 .or. UCHTYPE=19
      && readme  test ½SºÙdata if > setting  data
      x=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1]
      x= x   +A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,2]
      RDDLY(STP_FN,A_M_NAME[STP_FN,8],x)
      XRD := RDDELAY[STP_FN,3]
      *IF XRD<>0
      IF XRD=1999
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
	  WTANK_F[STP_FN-1,1] :=1
	  WTANK_F[STP_FN,1] :=1
	  DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
	  kx= A_M_NAME[STP_FN,8]  *2
	  EWN=WDATA(A_M_NAME[STP_FN,8]) -RDN_DATA(368 +kx)
	  if   storb_e=1
	    EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
	    A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	  endif
	  EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	  XMC_F=A_M_NAME[STP_FN,3]
	  *@  8,A_M_NAME[STP_FN,13]  SAY  EW1	PICT "&XMC_F"
	  SETCHDATA(STP_ZN,EWN)
	  *SETDLA(A_M_NAME[STP_FN,8],EWN)
	  STP&STP_FC=4
	  *ENDIF
	ENDIF
	RETU
      ENDIF
    ENDCASE
    XMC_F=A_M_NAME[STP_FN,3]
    do case
    CASE (UCHTYPE=1 .OR. UCHTYPE=2 .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=7   )
      @  4,A_M_NAME[STP_FN,13]	SAY  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8]+int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol) PICT "&XMC_F"
    CASE UCHTYPE=21
      @  4,A_M_NAME[STP_FN,13]	SAY  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN  PICT "&XMC_F"
    CASE UCHTYPE=5 .OR.  weight_type[stp_zn]=1	  .OR. UCHTYPE=31   .or.  uchtype=8 .OR. UCHTYPE=9  .OR. UCHTYPE=10 .OR. UCHTYPE=13 .OR. UCHTYPE=15   .OR. UCHTYPE=18
      @  4,A_M_NAME[STP_FN,13]	SAY  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8]  PICT "&XMC_F"
    CASE UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR.  UCHTYPE=11 .or. UCHTYPE=12   .or. UCHTYPE=16 .or. UCHTYPE=17 .or. UCHTYPE=19
      ADJWN=0
      ADJWN_F=0
      IF WATER_INPUT=1
	  XPN=0
	  XP1=INT(A_PRESS_N0[2,STPN&STP_FC,1,1]  *  G1_WATER/100)
	  XP2=INT(A_PRESS_N0[2,STPN&STP_FC,2,1]  *  G2_WATER/100)
	  XP3=INT(A_PRESS_N0[2,STPN&STP_FC,3,1]  *  S1_WATER/100)
	  XP4=INT(A_PRESS_N0[2,STPN&STP_FC,4,1]  *  S2_WATER/100)
	  IF UCHTYPE=16 .or. UCHTYPE=17
	    XP5=INT(A_PRESS_N0[2,STPN&STP_FC,10,1])
	    XP6=INT(A_PRESS_N0[2,STPN&STP_FC,11,1] )
	    XP7=INT(A_PRESS_N0[2,STPN&STP_FC,12,1])
	  ELSE
	    XP5=0
	    XP6=0
	    XP7=0
	  ENDIF
	  xtmpmw=xp1+XP2+XP3+XP4 +XP5+XP6+XP7
	  xtmpw=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1] +A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	  IF  XTMPW  > 0
	    ADJWN=-A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]  * XTMPMW /XTMPW
	  ENDIF
	  XPN=0
	  XP1=INT(A_PRESS_N0[2,STPN&STP_FC,1,8]  *  G1_WATER/100)
	  XP2=INT(A_PRESS_N0[2,STPN&STP_FC,2,8]  *  G2_WATER/100)
	  XP3=INT(A_PRESS_N0[2,STPN&STP_FC,3,8]  *  S1_WATER/100)
	  XP4=INT(A_PRESS_N0[2,STPN&STP_FC,4,8]  *  S2_WATER/100)
	  IF UCHTYPE=16 .or. UCHTYPE=17
	    XP5=INT(A_PRESS_N0[2,STPN&STP_FC,10,8])
	    XP6=INT(A_PRESS_N0[2,STPN&STP_FC,11,8] )
	    XP7=INT(A_PRESS_N0[2,STPN&STP_FC,12,8])
	  ELSE
	    XP5=0
	    XP6=0
	    XP7=0
	  ENDIF
	  ADJWN_F= ADJWN_F
	  xtmpmw=xp1+XP2+XP3+XP4 +XP5+XP6+XP7
	  xtmpw=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,8] +A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]
	  IF  XTMPW  > 0
	    ADJWN_F=-A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]  * XTMPMW /XTMPW
	  ENDIF
	A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=ADJWN
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8]+ ADJWN_F PICT "&XMC_F"
      ELSE
	XPA1=1
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1]
	ADJWN=PWATER *XP4/ (XP4 +XP5)
	ADJWN=	INT(ADJWN *A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	ADJWN_F=ADJWN
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+adjwn
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
	//@  4,A_M_NAME[STP_FN,13]  SAY  XPA2  PICT "&XMC_F"
	XMC_F=A_M_NAME[STP_FN,3]
	i=  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN_F
	@  4,A_M_NAME[STP_FN,13]  say i PICT "&XMC_F"
      ENDIF
    ENDCASE
    IF A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8] >0
      SET COLOR TO &C2	/ &C1
      *MTANK_MARK(6,STP_FN,1)
      DSPA_ARROW(STP_FN,1,14)  && úD
      *DSPB_FMK(KLCHN+1,1)  && "úZúYúYú["
    ENDIF
    do case
    CASE UCHTYPE=1
      SET COLOR TO &C10 / &C1
      *@ 11,36 SAY   "úZúYúYúYú["
      DSPB_FMK(KLCHN+1,1)
      SETDLA(A_M_NAME[STP_FN,8],0)
    CASE UCHTYPE=8 .OR.  weight_type[stp_zn]=1	  .OR. UCHTYPE=10 .OR. UCHTYPE=15  .OR. UCHTYPE=18
      SET COLOR TO &C10 / &C1
      *@ 11,36 SAY   "úZúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      SETDLA(A_M_NAME[STP_FN,8],0)
    CASE (UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=7 .OR. UCHTYPE=9 .OR. UCHTYPE=13 .OR. UCHTYPE=21  )
      IF A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8] >0
	SET COLOR TO &C10 / &C1
	*@ 11,36 SAY   "úZúYúYúYú["
	DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      ENDIF
       SETDLA(A_M_NAME[STP_FN,8],0)
    CASE (UCHTYPE=6 .OR.UCHTYPE=30   .OR.UCHTYPE=22  .OR.  UCHTYPE=11 .or. UCHTYPE=12	.or. UCHTYPE=16   .or. UCHTYPE=17  .or. UCHTYPE=19  )
      SET COLOR TO &C10 / &C1
      *@ 11,36 SAY   "úZúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
    ENDCASE
      CLEACHMEM(STP_ZN)
    SET COLOR TO &C7 +/ &C1
    DO CASE
    CASE (UCHTYPE=1)  .OR. (UCHTYPE=2 .OR. UCHTYPE=26 .or. UCHTYPE=32  )
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
      SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1]+int(PWATER  * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
    CASE UCHTYPE=5 .OR.  weight_type[stp_zn]=1	 .OR. UCHTYPE=31   .or. UCHTYPE=8 .OR. UCHTYPE=9  .OR. UCHTYPE=10 .OR. UCHTYPE=13 .OR. UCHTYPE=15  .OR. UCHTYPE=18
      SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1]
    CASE UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR.  UCHTYPE=11 .or. UCHTYPE=12 .or. UCHTYPE=16 .or. UCHTYPE=17  .or. UCHTYPE=19   .or. UCHTYPE=21
      SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] +ADJWN
    CASE UCHTYPE=7
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
      SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1]+int(PWATER  * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
    ENDCASE
    WMINX= (SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10]
    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETW2(STP_ZN,WMINX)
    SETOK(STP_ZN)
    DOUT(STP_ZN,1)
    STP6=3
  ENDCASE
CASE STP6=3
  do case
  case	LCHTYPE=17
    XP3=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
    XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1]
    XP5=XP3
    X=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
    IF	INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))   <> X
      ADJW12(STP_ZN,(INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))  -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))
      XMC_F=A_M_NAME[STP_FN,3]
      IF MODY_D1=0
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))   PICT "&XMC_F"
      ENDIF
    ENDIF
  case (LCHTYPE=4) .OR. ((LCHTYPE=2) .OR. (UCHTYPE=7) .OR. (UCHTYPE=26) .or. UCHTYPE=32  )
    X=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
    IF	int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)  <> X
      ADJW12(STP_ZN,(int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol) -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
      XMC_F=A_M_NAME[STP_FN,3]
      IF MODY_D1=0
	xtmp= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	@  4,A_M_NAME[STP_FN,13]  SAY  xtmp   PICT "&XMC_F"
      ENDIF
    ENDIF
  ENDCASE
  TST1_LS1(STP_FN)
  IF LS1[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS2(STP_FN)
  IF RDOK2(STP_ZN)=0
    DOUT(STP_ZN,0)
    setokn(STP_ZN,0)
    STOPTM&STP_FC=0
    DOUT3(0,0)
    EWN=CHENDATA(STP_ZN)
    WMINX=RDN_DATA(304 +((5) *2) )
    if uchtype=18	.OR.  storb_e=1
      EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
      A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    endif
    EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
    XDSPC=RIGHT(ALLTRIM(A_M_NAME[STP_FN,3]),2)
    IF XDSPC="."
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1 * 10) /10
    ELSE
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    ENDIF
    A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] := 1
    XMC_F=A_M_NAME[STP_FN,3]
    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
    SET COLOR TO &C2 / &C1
    *MTANK_MARK(6,STP_FN,0)
    DSPA_ARROW(STP_FN,0,0) && EREASE úD
    SET COLOR TO &C7 +/ &C1
    DO CASE
    CASE UCHTYPE=1
      STP6=0
      STP7=1
      X=EWN
      SETDLA(KLCHN,X)
    CASE  UCHTYPE=8  .OR.  weight_type[stp_zn]=1   .OR. UCHTYPE=10 .OR. UCHTYPE=15 .OR. UCHTYPE=18
      STP6=0
      STP7=1
      X=EWN
      SETDLA(A_M_NAME[STP_FN,8],X)



    CASE (UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=7  .OR. UCHTYPE=9 .OR. UCHTYPE=13  .OR. UCHTYPE=21  )
      STP&STP_FC=4
      WTANK_F[STP_FN,1] :=1
      WATER_REST=0
    CASE UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR.  UCHTYPE=11 .or. UCHTYPE=12 .or. UCHTYPE=16 .or. UCHTYPE=17 .or. UCHTYPE=19
      STP&STP_FC=4
      WTANK_F[STP_FN,1] :=1
      WTANK_F[STP_FN-1,1] :=1
    ENDCASE
  ENDIF
  WMINSF=0
CASE STP6=4
  DO CASE
  CASE	(UCHTYPE=2 .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=7  .OR. UCHTYPE=19 )
    IF UCHTYPE=19
      SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1]+A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]+A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN-1,1] +A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN-1,2]
      SW2=(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10]
    ELSE
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
      SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1]+int(PWATER  * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
      SW2=(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10]
    ENDIF
    if	wdata(KLCHN)-2048 <  SW2
      IF  WATER_REST=0
	DSPA_ARROW(STP_FN,1,14)  && úD
	WATER_REST=1
	CLEACHMEM(STP_ZN)
	SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
	SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
	SETOK(STP_ZN)
	DOUT(STP_ZN,1)
      ENDIF
    ELSE
      WATER_REST=0
      DSPA_ARROW(STP_FN,0,0) && EREASE úD
      DOUT(STP_ZN,0)
    ENDIF
    *X=ERKG&STP_FC *2048/A_M_NAME[STP_FN,9]
    *IF RDN_DATA(2*GS_TOT +304) > (WDATA(KLCHN) -2048 + X)
    *  SETOK(STP_ZN)
    *  DOUT(STP_ZN,1)
    *ENDIF
  CASE	(UCHTYPE=21 )
    ADJWN=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
    SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1]+ADJWN
    SW2=(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10]
    if	wdata(KLCHN)-2048 <  SW2
      IF  WATER_REST=0
	DSPA_ARROW(STP_FN,1,14)  && úD
	WATER_REST=1
	CLEACHMEM(STP_ZN)
	IF UCHTYPE <> 19
	  SETDLA(A_M_NAME[STP_FN,8],0)
	ENDIF
	SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
	SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
	SETOK(STP_ZN)
	DOUT(STP_ZN,1)
      ENDIF
    ELSE
      WATER_REST=0
      DSPA_ARROW(STP_FN,0,0) && EREASE úD
      DOUT(STP_ZN,0)
    ENDIF
  CASE	(UCHTYPE=22 )
    if	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]>0
      IF WMINSF=0
	  X=WDATA(KLCHN )-2048 -CHENDATA(GS_TOT)
	  IF X <WMINX
	    WMINSF=1
	    SET COLOR TO &C10 / &C1
	    *@ 11,22 SAY   "úZúYúYúYú["
	    DSPA_ARROW(STP_FN,1,14)  &&   úD
	    SETOK(STP_ZN)
	    DOUT(STP_ZN,1)
	    RETU
	  ENDIF
      ELSE
	 IF RDOK2(STP_ZN)=0
	   WMINSF=0
	   DOUT(STP_ZN,0)
	   SET COLOR TO &C2 / &C1
	   *MTANK_MARK(6,STP_FN,0)
	   DSPA_ARROW(STP_FN,0,0)  && EREASE  úD
	   SET COLOR TO &C7 +/ &C1
	 ENDIF
      ENDIF
    else
      IF WMINSF=0
	  X=WDATA(KLCHN )-2048
	  IF X <WMINX
	   SETDLA(KLCHN,0)
	    WMINSF=1
	    SET COLOR TO &C10 / &C1
	    *@ 11,22 SAY   "úZúYúYúYú["
	    DSPA_ARROW(STP_FN-1,1,14)  &&   úD
	    SETOK(STP_ZN-1)
	    DOUT(STP_ZN-1,1)
	    RETU
	  ENDIF
      ELSE
	 IF RDOK2(STP_ZN-1)=0
	   WMINSF=0
	   DOUT(STP_ZN-1,0)
	   SET COLOR TO &C2 / &C1
	   *MTANK_MARK(6,STP_FN,0)
	   DSPA_ARROW(STP_FN-1,0,0)  && EREASE	úD
	   SET COLOR TO &C7 +/ &C1
	 ENDIF
       ENDIF
     ENDIF
  ENDCASE
  IF   (WTANK_F[STP_FN,1]=-99) .AND. DIN(9)=0	 .AND. DIN(12)=1
    IF	TIME1[STP_FN,2] =0
      TIME1[STP_FN,2] :=SECONDS()
    ENDIF
    IF ABS(SECONDS()-TIME1[STP_FN,2]) >=TIME1[STP_FN,1]
      STP6=5
      TIME1[STP_FN,2] :=0
    ENDIF
  ENDIF
CASE STP6=5   .AND. DIN(9)=0	.AND. DIN(12)=1
  DOUT(STP_ZN,0)
  *DO  CASE
  *CASE (UCHTYPE=2  .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR.UCHTYPE=30  .OR. UCHTYPE=6 .OR.UCHTYPE=22  .OR. UCHTYPE=7  .OR. UCHTYPE=9  .OR.  UCHTYPE=11 .or. UCHTYPE=12  .OR. UCHTYPE=13  .or. UCHTYPE=16	.or. UCHTYPE=17   .or. UCHTYPE=19  .or.
    DSPA_ARROW(STP_FN,0,0) && EREASE úD
    DOUT(STP_ZN,0)
    IF UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=11.OR.UCHTYPE=12.OR. UCHTYPE=16.OR.UCHTYPE=17.OR.UCHTYPE=19.OR.UCHTYPE=22
      DOUT(STP_ZN-1,0)
      DSPA_ARROW(STP_FN-1,0,0)	&& EREASE  úD
    ENDIF
    WTANK_F[STP_FN,1]=0
    STP6=6
    do	case
    case   UCHTYPE=6  .OR.UCHTYPE=30 .OR.UCHTYPE=22	.or. UCHTYPE=19
      if ( ( A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .AND. ( A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0))
	RETU
      ENDIF
    case   UCHTYPE=13
      if (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
	RETU
      ENDIF
    ENDcase
    if	UCHTYPE=16 .or. UCHTYPE=17
      if  ( A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0  .AND.  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
	RETU
      ENDIF
    ENDIF

    DO CASE
    CASE uchtype=16 .or. UCHTYPE=17  .or. A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8] >0
      SET COLOR TO &C11 / &C1
      *@ 11,36 SAY   "úLúPúKúPúO"
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
      SET COLOR TO &C7 +/ &C1
    CASE uchtype=22  .AND. A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN-1,8] >0
      SET COLOR TO &C11 / &C1
      *@ 11,36 SAY   "úLúPúKúPúO"
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
      SET COLOR TO &C7 +/ &C1
    ENDCASE
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    *SETZER(KLCHN,INT(((PZER6/A_M_NAME[KLCHN + 1,6]))*PER*2048)+2048)
    SETZEROK(A_M_NAME[STP_FN,8])
    dout2(A_M_NAME[STP_FN,8],1)
  *ENDCASE
CASE STP6=6
  JMPF=0
  do case
  case	UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22	.OR.  UCHTYPE=16 .or. UCHTYPE=17 .or. UCHTYPE=19
    if ( ( A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .AND. ( A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0))
      JMPF=1
    ENDIF
  case	UCHTYPE=13
    if (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
      JMPF=1
    ENDIF

  ENDcase
  IF JMPF=0
    TST1_LS2(STP_FN)
    IF LS2[STP_FN,2]=1
      RETU
    ENDIF
    TST0_LS1(STP_FN,STP_FN)
  ELSE
      setZokn(A_M_NAME[STP_FN,8],0)
  ENDIF
  IF  RDZEROK(A_M_NAME[STP_FN,8])=0   .OR. WATER_OUT=6
    WATER_OUT=0
    DO CASE
    CASE (UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26 .or. UCHTYPE=32   .OR. UCHTYPE=5 .OR. UCHTYPE=7  .OR. UCHTYPE=9 .OR. UCHTYPE=13 .OR. UCHTYPE=21  )
      X=HEXTODEC("29C")
      &&SET_DB(X+STP_ZN,0)
      dout2(A_M_NAME[STP_FN,8],0)
      SETDLA(A_M_NAME[STP_FN,8],0)
      *DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[6,13]  SAY  "     " PICT "&XMC_F"
      CLEACHMEM(STP_ZN)
      STP6=7
      SET COLOR TO &C2 / &C1
      *@ 11,36 SAY   "úLúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[6,2] :=1
      WTANK_F[6,1] :=0
      STPN6=STPN6+1
    CASE UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR.  UCHTYPE=11 .or. UCHTYPE=12 .or. UCHTYPE=16 .or. UCHTYPE=17 .or. UCHTYPE=19
      X=HEXTODEC("29C")
      &&SET_DB(X+STP_ZN,0)
      dout2(A_M_NAME[STP_FN,8],0)
      SETDLA(A_M_NAME[STP_FN,8],0)
      *DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[5,13]  SAY  "     " PICT "&XMC_F"
      *@  4,A_M_NAME[6,13]  SAY  "     " PICT "&XMC_F"
      CLEACHMEM(STP_ZN)
      STP6=7
      SET COLOR TO &C2 / &C1
      *@ 11,36 SAY   "úLúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[5,1] :=0
      WTANK_F[5,2] :=1
      WTANK_F[6,1] :=0
      WTANK_F[6,2] :=1
      STPN5=STPN5+1
      STPN6=STPN6+1
    ENDCASE
  ENDIF
CASE STP6=7
  DO CASE
  CASE	 UCHTYPE=5  .OR. UCHTYPE=31  .OR. UCHTYPE=9  .OR. UCHTYPE=13
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP6=1
    ELSE
      STP6=0
      STPN6=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  CASE	UCHTYPE=2
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      IF  TIME1[10,1] =88
	IF STP10=7
	  WTANK_F[10,1] :=2
	  STP6=1
	ENDIF
      ENDIF
    ELSE
      IF TIME1[10,1] =88
	IF STP10=7
	  WTANK_F[10,1] :=2
	  STPN6=1
	  STP6=0
	  WTANK_F[STP_FN,3] :=1
	ENDIF
      ENDIF
    ENDIF
  CASE	UCHTYPE=21
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      IF  TIME1[9,1] =88
	IF STP9=7
	  WTANK_F[9,1] :=2
	  STP6=1
	ENDIF
      ENDIF
    ELSE
      IF TIME1[9,1] =88
	IF STP9=7
	  WTANK_F[9,1] :=2
	  STPN6=1
	  STP6=0
	  WTANK_F[STP_FN,3] :=1
	ENDIF
      ENDIF
    ENDIF
  CASE	UCHTYPE=6 .OR.UCHTYPE=30
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      IF ((TIME1[10,1] =88) .OR. (TIME1[11,1] =88) )
	DO CASE
	CASE ((TIME1[10,1] =88) .AND. (TIME1[11,1] =88) )
	  IF ((STP10=7) .AND.(STP11=7) )
	    WTANK_F[10,1] :=2
	    WTANK_F[11,1] :=2
	    STP5=1
	    STP6=0
	  ENDIF
	CASE TIME1[10,1] =88
	  IF STP10=7
	    WTANK_F[10,1] :=2
	    STP5=1
	    STP6=0
	  ENDIF
	CASE TIME1[11,1] =88
	  IF STP11=7
	    WTANK_F[11,1] :=2
	    STP5=1
	    STP6=0
	  ENDIF
	ENDCASE
      ELSE
	STP5=1
	STP6=0
      ENDIF
    ELSE
      STPN5=1
      STP5=0
      STPN6=1
      STP6=0
      WTANK_F[STP_FN,3] :=1
      WTANK_F[STP_FN-1,3] :=1
      IF ((TIME1[10,1] =88) .OR. (TIME1[11,1] =88) )
	DO CASE
	CASE ((TIME1[10,1] =88) .AND. (TIME1[11,1] =88) )
	  IF ((STP10=7) .AND.(STP11=7) )
	    WTANK_F[10,1] :=2
	    WTANK_F[11,1] :=2
	    STPN5=1
	    STP5=0
	    STPN6=1
	    STP6=0
	  ENDIF
	CASE TIME1[10,1] =88
	  IF STP10=7
	    WTANK_F[10,1] :=2
	    STPN5=1
	    STP5=0
	    STPN6=1
	    STP6=0
	  ENDIF
	CASE TIME1[11,1] =88
	  IF STP11=7
	    WTANK_F[11,1] :=2
	    STPN5=1
	    STP5=0
	    STPN6=1
	    STP6=0
	  ENDIF
	ENDCASE
      ENDIF
    ENDIF
  CASE	UCHTYPE=26  .or. UCHTYPE=32
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      IF ((TIME1[10,1] =88) .OR. (TIME1[11,1] =88) )
	DO CASE
	CASE ((TIME1[10,1] =88) .AND. (TIME1[11,1] =88) )
	  IF ((STP10=7) .AND.(STP11=7) )
	    WTANK_F[10,1] :=2
	    WTANK_F[11,1] :=2
	    STP6=1
	  ENDIF
	CASE TIME1[10,1] =88
	  IF STP10=7
	    WTANK_F[10,1] :=2
	    STP6=1
	  ENDIF
	CASE TIME1[11,1] =88
	  IF STP11=7
	    WTANK_F[11,1] :=2
	    STP6=1
	  ENDIF
	ENDCASE
      ELSE
	STP6=1
      ENDIF
    ELSE
      WTANK_F[STP_FN,3] :=1
      IF ((TIME1[10,1] =88) .OR. (TIME1[11,1] =88) )
	DO CASE
	CASE ((TIME1[10,1] =88) .AND. (TIME1[11,1] =88) )
	  IF ((STP10=7) .AND.(STP11=7) )
	    WTANK_F[10,1] :=2
	    WTANK_F[11,1] :=2
	    STPN6=1
	    STP6=0
	  ENDIF
	CASE TIME1[10,1] =88
	  IF STP10=7
	    WTANK_F[10,1] :=2
	    STPN6=1
	    STP6=0
	  ENDIF
	CASE TIME1[11,1] =88
	  IF STP11=7
	    WTANK_F[11,1] :=2
	    STPN6=1
	    STP6=0
	  ENDIF
	ENDCASE
      ENDIF
    ENDIF
  CASE	UCHTYPE=22
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      for x=10	 to 12
	XNC=LTRIM(STR(INT(X),2,0))
	IF STP&XNC <> 7
	   RETU
	ENDIF
	IF TIME1[X,1]=88
	  WTANK_F[X,1] :=2
	ENDIF
      next
      STP5=1
      STP6=0
    ELSE
      STPN5=1
      STP5=0
      STPN6=1
      STP6=0
      WTANK_F[STP_FN,3] :=1
      WTANK_F[STP_FN-1,3] :=1
      for x=10	 to 12
	XNC=LTRIM(STR(INT(X),2,0))
	IF STP&XNC <> 7
	   RETU
	ENDIF
	IF TIME1[X,1]=88
	  WTANK_F[X,1] :=2
	ENDIF
      next
    ENDIF
  CASE	 UCHTYPE=19
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      IF ((TIME1[11,1] =88) .OR. (TIME1[12,1] =88) )
	DO CASE
	CASE ((TIME1[11,1] =88) .AND. (TIME1[12,1] =88) )
	  IF ((STP11=7) .AND.(STP12=7) )
	    WTANK_F[11,1] :=2
	    WTANK_F[12,1] :=2
	    STP5=1
	    STP6=0
	  ENDIF
	CASE TIME1[11,1] =88
	  IF STP11=7
	    WTANK_F[11,1] :=2
	    STP5=1
	    STP6=0
	  ENDIF
	CASE TIME1[12,1] =88
	  IF STP12=7
	    WTANK_F[12,1] :=2
	    STP5=1
	    STP6=0
	  ENDIF
	ENDCASE
      ELSE
	STP5=1
	STP6=0
      ENDIF
    ELSE
      STPN5=1
      STP5=0
      STPN6=1
      STP6=0
      WTANK_F[STP_FN,3] :=1
      WTANK_F[STP_FN-1,3] :=1
      IF ((TIME1[11,1] =88) .OR. (TIME1[12,1] =88) )
	DO CASE
	CASE ((TIME1[11,1] =88) .AND. (TIME1[12,1] =88) )
	  IF ((STP11=7) .AND.(STP12=7) )
	    WTANK_F[11,1] :=2
	    WTANK_F[12,1] :=2
	    STPN5=1
	    STP5=0
	    STPN6=1
	    STP6=0
	  ENDIF
	CASE TIME1[11,1] =88
	  IF STP11=7
	    WTANK_F[11,1] :=2
	    STPN5=1
	    STP5=0
	    STPN6=1
	    STP6=0
	  ENDIF
	CASE TIME1[12,1] =88
	  IF STP12=7
	    WTANK_F[12,1] :=2
	    STPN5=1
	    STP5=0
	    STPN6=1
	    STP6=0
	  ENDIF
	ENDCASE
      ENDIF
    ENDIF
  CASE	UCHTYPE=7
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      IF  TIME1[KLCHN+6,1] =88
	IF STP11=7
	  WTANK_F[11,1] :=2
	  STP6=1
	ENDIF
      ENDIF
    ELSE
      IF TIME1[KLCHN+6,1] =88
	IF STP11=7
	  WTANK_F[11,1] :=2
	  STPN6=1
	  STP6=0
	  WTANK_F[STP_FN,3] :=1
	ENDIF
      ENDIF
    ENDIF
  CASE	UCHTYPE=11
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      IF SPACIAL_0=1
	STP5=1
	STP6=0
      ELSE
	IF  TIME1[KLCHN+6,1] =88
	  IF STP10=7
	    WTANK_F[10,1] :=2
	    STP5=1
	    STP6=0
	  ENDIF
	ENDIF
      ENDIF
    ELSE
      IF TIME1[KLCHN+6,1] =88
	IF STP10=7
	  WTANK_F[10,1] :=2
	  STPN5=1
	  STP5=0
	  STPN6=1
	  STP6=0
	  WTANK_F[STP_FN,3] :=1
	  WTANK_F[STP_FN-1,3] :=1
	ENDIF
      ENDIF
    ENDIF
  CASE	UCHTYPE=12
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      IF SPACIAL_0=1
	STP5=1
	STP6=0
      ELSE
	IF  TIME1[KLCHN+6,1] =88
	  IF STP11=7
	    WTANK_F[10,1] :=2
	    WTANK_F[11,1] :=2
	    STP5=1
	    STP6=0
	  ENDIF
	ELSE
	  STP5=1
	  STP6=0
	ENDIF
      ENDIF
    ELSE
      IF TIME1[KLCHN+6,1] =88
	IF STP11=7
	  WTANK_F[10,1] :=2
	  WTANK_F[11,1] :=2
	  STPN5=1
	  STP5=0
	  STPN6=1
	  STP6=0
	  WTANK_F[STP_FN,3] :=1
	  WTANK_F[STP_FN-1,3] :=1
	ENDIF
      else
	STPN5=1
	STP5=0
	STPN6=1
	STP6=0
	WTANK_F[STP_FN,3] :=1
	WTANK_F[STP_FN-1,3] :=1
      ENDIF
    ENDIF
  CASE	UCHTYPE=16 .or. UCHTYPE=17
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      IF ((TIME1[10,1] =88) .OR. (TIME1[11,1] =88)  .OR. (TIME1[12,1] =88) )
	IF (TIME1[10,1] =88)
	  IF  STP10  <> 7
	    RETU
	  ENDIF
	ENDIF
	IF (TIME1[11,1] =88)
	  IF  STP11  <> 7
	    RETU
	  ENDIF
	ENDIF
	IF (TIME1[12,1] =88)
	  IF  STP12  <> 7
	    RETU
	  ENDIF
	ENDIF
	STP5=1
	STP6=0
	IF (TIME1[10,1] =88)
	  WTANK_F[10,1] :=2
	ENDIF
	IF (TIME1[11,1] =88)
	  WTANK_F[11,1] :=2
	ENDIF
	IF (TIME1[12,1] =88)
	  WTANK_F[12,1] :=2
	ENDIF
      ELSE
	STP5=1
	STP6=0
      ENDIF
    ELSE
      WTANK_F[STP_FN,3] :=1
      WTANK_F[STP_FN-1,3] :=1
      IF ((TIME1[10,1] =88) .OR. (TIME1[11,1] =88)  .OR. (TIME1[12,1] =88) )
	  IF (TIME1[10,1] =88)
	    IF	STP10  <> 7
	      RETU
	    ENDIF
	  ENDIF
	  IF (TIME1[11,1] =88)
	    IF	STP11  <> 7
	      RETU
	    ENDIF
	  ENDIF
	  IF (TIME1[12,1] =88)
	    IF	STP12  <> 7
	      RETU
	    ENDIF
	  ENDIF
	  STPN5=1
	  STP5=0
	  STPN6=1
	  STP6=0
	  IF (TIME1[10,1] =88)
	    WTANK_F[10,1] :=2
	  ENDIF
	  IF (TIME1[11,1] =88)
	    WTANK_F[11,1] :=2
	  ENDIF
	  IF (TIME1[12,1] =88)
	    WTANK_F[12,1] :=2
	  ENDIF
      ELSE
	STPN5=1
	STPN6=1
	STP5=0
	STP6=0
      ENDIF
    ENDIF
  ENDCASE
ENDCASE
RETU
**------------------------------------------------------------------------------------------------------------
PROCEDURE  STP7
PARAMETERS  P1,P2,P3
STP_ZN=6
STP_FN=7
STP_FC="7"
DO CASE
CASE (STP7=0)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE (UCHTYPE=2 .OR. UCHTYPE=26 .or. UCHTYPE=32   .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR. UCHTYPE=7 .OR.  UCHTYPE=11  .or. UCHTYPE=12  .or. UCHTYPE=16  .or. UCHTYPE=17   ) .AND. NEXTOK1=1
    IF (A_PRESS_N0[1,21,STP_FN,1] =77)
      A_PRESS_N0[1,21,STP_FN,1] :=0
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN)
      IF LCHTYPE=16 .or. LCHTYPE=17	  .OR.	storb_e=1
	a_copy_4(A_PRESS_B0,STP_FN,STP_FN)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP7=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE	(UCHTYPE=9 .OR. UCHTYPE=13  .OR. UCHTYPE=19.OR. UCHTYPE=21).AND. NEXTOK1=1  .AND.  STP8=0
    IF (A_PRESS_N0[1,21,STP_FN,1] =77)
      A_PRESS_N0[1,21,STP_FN,1] :=0
      A_PRESS_N0[1,21,STP_FN+1,1] :=0
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN+1)  && ²Ö­p +1
      IF UCHTYPE=19
	a_copy_4(A_PRESS_B0,STP_FN,STP_FN+1)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP7=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE	(UCHTYPE=31).AND. NEXTOK1=1  .AND.  STP8=0   .AND.  STP9=0
    IF (A_PRESS_N0[1,21,STP_FN,1] =77)
      A_PRESS_N0[1,21,STP_FN,1] :=0
      A_PRESS_N0[1,21,STP_FN+1,1] :=0
      A_PRESS_N0[1,21,STP_FN+2,1] :=0
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN+2)  && ²Ö­p +2
      IF UCHTYPE=31
	a_copy_4(A_PRESS_B0,STP_FN,STP_FN+1)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP7=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  ENDCASE
CASE (STP7=1)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE UCHTYPE=1  .OR.	weight_type[stp_zn]=2	 .or.  UCHTYPE=8    .OR. UCHTYPE=10 .OR. UCHTYPE=15
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP7=2
    ENDIF
  CASE (UCHTYPE=2 .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR. UCHTYPE=7 .OR.  UCHTYPE=11 .or. UCHTYPE=12  .or. UCHTYPE=16  .or. UCHTYPE=17   )
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP&STP_FC=2
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      IF KOT=1
	WTANK_F[STP_FN,1] :=77
	RDDELAY[STP_FN,2] :=SECONDS()
	RDDELAY[STP_FN,3] :=0
      ENDIF
    ENDIF

  CASE	 UCHTYPE=9  .OR. UCHTYPE=31  .OR. UCHTYPE=13   .OR. UCHTYPE=18 .OR. UCHTYPE=19.OR. UCHTYPE=21
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP&STP_FC=2
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
    ENDIF
  ENDCASE
CASE STP7=2
  DRAF=0
  DO CASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    DO CASE
    CASE UCHTYPE=1
      STP&STP_FC=4
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[6,1] :=1
      WTANK_F[7,1] :=1
    CASE   UCHTYPE=8  .OR.  weight_type[stp_zn]=2    .OR. UCHTYPE=10 .OR. UCHTYPE=15
      STP&STP_FC=4
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[6,1] :=1
      WTANK_F[7,1] :=1
    CASE   UCHTYPE=9  .OR. UCHTYPE=31  .OR. UCHTYPE=13	.OR. UCHTYPE=18 .OR. UCHTYPE=19.OR. UCHTYPE=21
      SETDLA(A_M_NAME[STP_FN,8],0)
      STP7=0
      STP8=2
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
     CASE (UCHTYPE=2 .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR. UCHTYPE=7 .OR.  UCHTYPE=11 .or. UCHTYPE=12   .or. UCHTYPE=16	.or. UCHTYPE=17  )
      STP&STP_FC=4
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[7,1] :=1
    ENDCASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    IF	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
      DSPDATA_A[STP_FN] := 1
    ELSE
      DSPDATA_A[STP_FN] := 0
    ENDIF
    XMC_F=A_M_NAME[STP_FN,3]
    @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
    *MTANK_MARK(6,STP_FN,1)
    IF DSPDATA_A[STP_FN]=1
      SET COLOR TO &C2	/ &C1
      DSPA_ARROW(STP_FN,1,14)  && úD
      *DSPB_FMK(KLCHN+2,1)  && "úZúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
    else
      if   A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN+1,8] > 0
	@  4,A_M_NAME[STP_FN+1,13]  SAY  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN+1,8] PICT "&XMC_F"
	SET COLOR TO &C2  / &C1
	 DSPA_ARROW(STP_FN+1,1,14)  && úD
	 *DSPB_FMK(KLCHN+2,1)  && "úZúYúYú["
	 DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
      endif
    ENDIF
    do case
    CASE UCHTYPE=1 .OR.  weight_type[stp_zn]=2	 .or.  UCHTYPE=8   .OR. UCHTYPE=10 .OR. UCHTYPE=15
      SET COLOR TO &C10 / &C1
      *@ 11,36 SAY   "úZúYúYúYú["
      DSPB_FMK(KLCHN+1,1)
      EWN=CHENDATA(STP_ZN-1)
      SETDLA(A_M_NAME[STP_FN,8],EWN)
    CASE (UCHTYPE=2 .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR. UCHTYPE=7 .OR.  UCHTYPE=11 .or. UCHTYPE=12  .or. UCHTYPE=16  .or. UCHTYPE=17  )
      SET COLOR TO &C10 / &C1
      *@ 11,36 SAY   "úZúYúYúYú["
      IF DSPDATA_A[STP_FN]=1
	DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      ENDIF
      SETDLA(A_M_NAME[STP_FN,8],0)
    CASE UCHTYPE=9 .OR. UCHTYPE=31  .OR. UCHTYPE=13   .OR. UCHTYPE=18 .OR. UCHTYPE=19.OR. UCHTYPE=21
      SETDLA(A_M_NAME[STP_FN,8],0)
      IF UCHTYPE=18
	RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1])
      ELSE
	RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1])
      ENDIF
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	SET COLOR TO &C2 / &C1
	*MTANK_MARK(6,STP_FN,0)
	DSPA_ARROW(STP_FN,0,0)	&& EREASE  úD
	SET COLOR TO &C7 +/ &C1
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
	  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=0
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	    EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=EW1*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    IF UCHTYPE=18
	      EWN=EWN +CHENDATA(5)
	    ENDIF
	    SETDLA(A_M_NAME[STP_FN,8],EWN)
	    STP7=0
	    STP8=1
	  ELSE
	    IF UCHTYPE=18
	      EWN=WDATA(A_M_NAME[STP_FN,8])-CHENDATA(5)-2048
	    ELSE
	      EWN=WDATA(A_M_NAME[STP_FN,8])-2048
	    ENDIF
	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    IF UCHTYPE=18
	      SETDLA(A_M_NAME[STP_FN,8],EWN +CHENDATA(5))
	    ELSE
	      SETDLA(A_M_NAME[STP_FN,8],EWN)
	    ENDIF
	    SETCHDATA(STP_ZN,EWN)
	    STP7=0
	    STP8=1
	  ENDIF
	ENDIF
	RETU
      ENDIF
    ENDCASE
    SET COLOR TO &C7 +/ &C1
*   CLEACHMEM(STP_ZN)
    SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1]
    XWMINX=(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10]
    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETW2(STP_ZN,XWMINX)
    SETOK(STP_ZN)
    DOUT(STP_ZN,1)
    STP7=3
  ENDCASE
CASE STP7=3
  TST1_LS1(STP_FN)
  IF LS1[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS2(STP_FN)
  IF RDOK2(STP_ZN)=0
    DOUT(STP_ZN,0)
    SETOKN(STP_ZN,0)
    STOPTM&STP_FC=0
    EWN=CHENDATA(STP_ZN)
    if uchtype=18	  .OR.	storb_e=1
      EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
      A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    endif
    EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
    A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] := 1
    XMC_F=A_M_NAME[STP_FN,3]
    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
    SET COLOR TO &C2 / &C1
    *MTANK_MARK(6,STP_FN,0)
    DSPA_ARROW(STP_FN,0,0)  && EREASE  úD
    SET COLOR TO &C7 +/ &C1
    DO CASE
    CASE UCHTYPE=1 .OR.  weight_type[stp_zn]=2	  .OR.	  UCHTYPE=8   .OR. UCHTYPE=10 .OR. UCHTYPE=15
      STP7=4
      DOUT3(0,0)
      X=EWN
      IF KOT=1
	WTANK_F[6,1] :=1
	WTANK_F[7,1] :=1
      else
	WTANK_F[STP_FN-1,1] :=1
	WTANK_F[STP_FN,1] :=1
      ENDIF
    CASE (UCHTYPE=2 .OR. UCHTYPE=26 .or. UCHTYPE=32  ) .OR. (UCHTYPE=5) .OR. (UCHTYPE=6) .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR.(UCHTYPE=7).OR.(UCHTYPE=11).or.(UCHTYPE=12).or.(UCHTYPE=16).or.(UCHTYPE=17)
      STP7=4
      X=EWN
      WTANK_F[STP_FN,1] :=1
    CASE UCHTYPE=9 .OR. UCHTYPE=31  .OR. UCHTYPE=13 .OR. UCHTYPE=19.OR. UCHTYPE=21
      STP7=0
      STP8=1
      X=EWN
      SETDLA(A_M_NAME[STP_FN,8],X)
    CASE UCHTYPE=18
      STP7=0
      STP8=1
      X=EWN  + chendata(5)
      SETDLA(A_M_NAME[STP_FN,8],X)
    ENDCASE
  ENDIF
CASE STP7=4
  DO CASE
  CASE	(UCHTYPE=1   )
    *A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
    SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN-1,1]+int(PWATER  * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
    SW2=SW1+A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1]
    if	wdata(KLCHN)-2048 <  (SW2-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10]
      IF  WATER_REST=0
	DSPA_ARROW(STP_FN-1,1,14)  && úD
	WATER_REST=1
	CLEACHMEM(STP_ZN-1)
	SW2=CHENDATA(STP_ZN)
	SETDLA(A_M_NAME[STP_FN-1,8],SW2)
	SETW1(STP_ZN-1,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
	SETW2(STP_ZN-1,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
	SETOK(STP_ZN-1)
	DOUT(STP_ZN-1,1)
      ENDIF
    ELSE
      WATER_REST=0
      DSPA_ARROW(STP_FN-1,0,0) && EREASE úD
      DOUT(STP_ZN-1,0)
    ENDIF
    *X=ERKG&STP_FC *2048/A_M_NAME[STP_FN,9]
    *IF RDN_DATA(2*GS_TOT +304) > (WDATA(KLCHN) -2048 + X)
    *  SETOK(STP_ZN)
    *  DOUT(STP_ZN,1)
    *ENDIF
  ENDCASE
  IF  (WTANK_F[7,1]=-99) .AND. (DIN(9)=0)    .AND. (DIN(12)=1 )
    IF	TIME1[STP_FN,2] =0
      TIME1[STP_FN,2] :=SECONDS()
    ENDIF
    IF ABS(SECONDS()-TIME1[STP_FN,2]) >=TIME1[STP_FN,1]
      STP7=5
      TIME1[STP_FN,2] :=0
    ENDIF
  ENDIF

CASE STP7=5   .AND. DIN(9)=0	.AND. DIN(12)=1
  IF   (UCHTYPE=15  .or. UCHTYPE=10 .or.  UCHTYPE=8    )
     weight_type[stp_zn]=2
  ENDIF
  IF  (UCHTYPE=2 .or.UCHTYPE=32 .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30 .OR.UCHTYPE=22 .OR. UCHTYPE=7  .OR.  UCHTYPE=11 .or. UCHTYPE=12  .or. UCHTYPE=16 .or. UCHTYPE=17 )
     weight_type[stp_zn]=77
  ENDIF
  DO  CASE
  CASE UCHTYPE=1
    IF	 WATER_REST =1
      SETOKN(STP_ZN-1,0)
      DOUT(STP_ZN-1,0)
      WATER_REST=0
      DSPA_ARROW(STP_FN-1,0,0) && EREASE úD
    ENDIF
    WTANK_F[7,1]=0
    STP7=6
    SET COLOR TO &C11 / &C1
    *@ 11,36 SAY   "úLúPúKúPúO"
    DSPB_ARROW(KLCHN+1,1,14)  && úD
    SET COLOR TO &C7 +/ &C1
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    SETZER(KLCHN,INT(((PZER6/A_M_NAME[KLCHN + 1,6]))*PER*2048)+2048)
    SETZEROK(KLCHN)
    dout2(A_M_NAME[STP_FN,8],1)
  &CASE (UCHTYPE=2 .OR. UCHTYPE=26.or.UCHTYPE=32 .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30 .OR.UCHTYPE=22 .OR. UCHTYPE=7.OR. UCHTYPE=8 .OR. UCHTYPE=10 .OR.	UCHTYPE=11 .or. UCHTYPE=12  .or. UCHTYPE=16  .OR. UCHTYPE=15  .or. UCHTYPE=17 )
   CASE   weight_type[stp_zn]=2 .OR. weight_type[stp_zn]=77 .OR. UCHTYPE=26
    WTANK_F[STP_FN,1]=0
    STP7=6
    DO CASE
    CASE  WTANK_F[STP_FN,1]=77	.OR. UCHTYPE=6 .OR.UCHTYPE=30	.OR.UCHTYPE=22	.or.  UCHTYPE=7  .or. UCHTYPE=16    .or. UCHTYPE=17
      if  ( A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
	RETU
      ENDIF
    CASE  weight_type[stp_zn]=2 .OR. WTANK_F[STP_FN,1]=2  .OR. UCHTYPE=10
      if  (( A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .AND.   ( A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)  )
	RETU
      ENDIF
     ENDCASE
    SET COLOR TO &C11 / &C1
    IF DSPDATA_A[STP_FN]=1
      *@ 11,36 SAY   "úLúPúKúPúO"
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    ENDIF
    SET COLOR TO &C7 +/ &C1
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    *SETZER(KLCHN,INT(((PZER6/A_M_NAME[KLCHN + 1,6]))*PER*2048)+2048)
    SETZEROK(A_M_NAME[STP_FN,8])
    dout2(A_M_NAME[STP_FN,8],1)
  ENDCASE
CASE STP7=6
  JMPF=0
  DO CASE
  CASE	UCHTYPE=6  .OR.UCHTYPE=30   .OR.UCHTYPE=22  .or. UCHTYPE=7   .or. UCHTYPE=16 .or. UCHTYPE=17  .or. UCHTYPE=26  .or. UCHTYPE=32
    if (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
      JMPF=1
    ENDIF
  CASE	weight_type[stp_zn]=2 .OR. WTANK_F[STP_FN,1]=2	.OR. UCHTYPE=10
    if	(( A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .AND.   ( A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)  )
      JMPF=1
    ENDIF
  ENDCASE
  IF JMPF=0
  TST1_LS2(STP_FN)
    IF LS2[STP_FN,2]=1
      RETU
    ENDIF
    TST0_LS1(STP_FN,STP_FN)
  ELSE
      setZokn(A_M_NAME[STP_FN,8],0)
  ENDIF
  DO  CASE
  CASE	UCHTYPE=1
    IF	RDZEROK(KLCHN)=0   .OR. T=-7
      X=HEXTODEC("29C")
      &&SET_DB(X+STP_ZN,0)
      dout2(A_M_NAME[STP_FN,8],0)
      SETDLA(A_M_NAME[STP_FN,8],0)
      DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[6,13]  SAY	"     " PICT "&XMC_F"
      @  4,A_M_NAME[7,13]  SAY	"     " PICT "&XMC_F"
      CLEACHMEM(5)
      CLEACHMEM(6)
      STP7=7
      SET COLOR TO &C2 / &C1
      *@ 11,36 SAY   "úLúPúPúPúO"
      DSPB_FMK(KLCHN+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[6,2] :=1
      WTANK_F[7,2] :=1
      WTANK_F[6,1] :=0
      WTANK_F[7,1] :=0
      STPN6=STPN6+1
      STPN7=STPN7+1
    ENDIF
  CASE	weight_type[stp_zn]=2 .OR. WTANK_F[STP_FN,1]=2	.OR. UCHTYPE=8	 .OR. UCHTYPE=10    .OR. UCHTYPE=15
    IF	RDZEROK(A_M_NAME[STP_FN,8])=0
      X=HEXTODEC("29C")
      &&SET_DB(X+STP_ZN,0)
      dout2(A_M_NAME[STP_FN,8],0)
      SETDLA(A_M_NAME[STP_FN,8],0)
      DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[6,13]  SAY	"     " PICT "&XMC_F"
      @  4,A_M_NAME[7,13]  SAY	"     " PICT "&XMC_F"
      CLEACHMEM(5)
      CLEACHMEM(6)
      STP7=7
      SET COLOR TO &C2 / &C1
      *@ 11,36 SAY   "úLúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[6,2] :=1
      WTANK_F[7,2] :=1
      WTANK_F[6,1] :=0
      WTANK_F[7,1] :=0
      STPN6=STPN6+1
      STPN7=STPN7+1
    ENDIF
  CASE	(UCHTYPE=2 .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR. UCHTYPE=7 .OR.	UCHTYPE=11 .or. UCHTYPE=12 .or. UCHTYPE=16  .or. UCHTYPE=17   )
    IF	RDZEROK(A_M_NAME[STP_FN,8])=0
      X=HEXTODEC("29C")
      &&SET_DB(X+STP_ZN,0)
      dout2(A_M_NAME[STP_FN,8],0)
      SETDLA(A_M_NAME[STP_FN,8],0)
      *DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[7,13]  SAY  "     " PICT "&XMC_F"
      CLEACHMEM(STP_ZN)
      STP7=7
      SET COLOR TO &C2 / &C1
      *@ 11,36 SAY   "úLúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[7,2] :=1
      WTANK_F[7,1] :=0
      STPN7=STPN7+1
    ENDIF
  ENDCASE
CASE STP7=7
  DSPDATA_A[STP_FN] := 1
  DO  CASE
  CASE	UCHTYPE=1
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      IF ((TIME1[11,1] =88) .OR. (TIME1[12,1] =88) )
	DO CASE
	CASE ((TIME1[11,1] =88) .AND. (TIME1[12,1] =88) )
	  IF ((STP11=7) .AND.(STP12=7) )
	    WTANK_F[11,1] :=2
	    WTANK_F[12,1] :=2
	    STP7=0
	    STP6=1
	  ENDIF
	CASE TIME1[11,1] =88
	  IF STP11=7
	    WTANK_F[11,1] :=2
	    STP7=0
	    STP6=1
	  ENDIF
	CASE TIME1[12,1] =88
	  IF STP12=7
	    WTANK_F[12,1] :=2
	    STP7=0
	    STP6=1
	  ENDIF
	ENDCASE
      ELSE
	STP7=0
	STP6=1
      ENDIF
    ELSE
      IF ((TIME1[11,1] =88) .OR. (TIME1[12,1] =88) )
	SKIPX7=1
	DO CASE
	CASE ((TIME1[11,1] =88) .AND. (TIME1[12,1] =88) )
	  IF ((STP11=7) .AND.(STP12=7) )
	    SKIPX7=0
	    WTANK_F[11,2] :=1
	    WTANK_F[12,2] :=1
	  ENDIF
	CASE TIME1[11,1] =88
	  IF STP11=7
	    WTANK_F[11,2] :=1
	    SKIPX7=0
	  ENDIF
	CASE TIME1[12,1] =88
	  IF STP12=7
	    WTANK_F[12,2] :=1
	    SKIPX7=0
	  ENDIF
	ENDCASE
      ENDIF
      IF SKIPX7=1
	RETU
      ENDIF
      STPN6=1
      STP6=0
      STP7=0
      STPN7=1
      WTANK_F[STP_FN-1,3] :=1
      WTANK_F[STP_FN,3] :=1
      IF ((TIME1[11,1] =88) .OR. (TIME1[12,1] =88) )
	DO CASE
	CASE ((TIME1[11,1] =88) .AND. (TIME1[12,1] =88) )
	  IF ((STP11=7) .AND.(STP12=7) )
	    WTANK_F[11,1] :=2
	    WTANK_F[12,1] :=2
	  ENDIF
	CASE TIME1[11,1] =88
	  IF STP11=7
	    WTANK_F[11,1] :=2
	  ENDIF
	CASE TIME1[12,1] =88
	  IF STP12=7
	    WTANK_F[12,1] :=2
	  ENDIF
	ENDCASE
      ENDIF
    ENDIF
  CASE	(UCHTYPE=2 .OR. UCHTYPE=26 .or. UCHTYPE=32   .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .OR. UCHTYPE=7 .OR.	UCHTYPE=11 .or. UCHTYPE=12 .or. UCHTYPE=16   .or. UCHTYPE=17   )
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP7=1
    ELSE
      STP7=0
      STPN7=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  CASE weight_type[stp_zn]=2 .OR. WTANK_F[STP_FN,1]=2  .OR.  UCHTYPE=8 .OR. UCHTYPE=10	.OR. UCHTYPE=15
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP6=1
      STP7=0
    ELSE
      STP6=0
      STPN6=1
      STP7=0
      STPN7=1
      WTANK_F[STP_FN-1,3] :=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  ENDCASE
ENDCASE
RETU

**------------------------------------------------------------------------------------------------------------
PROCEDURE  STP8
PARAMETERS  P1,P2,P3
STP_ZN=7
STP_FN=8
STP_FC="8"
if  ( UCHTYPE=2 .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30	.OR.UCHTYPE=22	.or.UCHTYPE=8  .OR. UCHTYPE=10	.OR.  UCHTYPE=11  .or. UCHTYPE=12   )
   weight_type[stp_zn]=1
endif
DO CASE
CASE (STP8=0)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE (UCHTYPE=1 .or.UCHTYPE=7  .or.UCHTYPE=15 .or. UCHTYPE=16  .or. UCHTYPE=17  ) .AND. NEXTOK1=1
    IF (A_PRESS_N0[1,21,8,1] =77)
      A_PRESS_N0[1,21,8,1] :=0
      a_copy_4(A_PRESS_N0,8,8)
      IF LCHTYPE=16 .or. LCHTYPE=17
	a_copy_4(A_PRESS_B0,STP_FN,STP_FN)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP8=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  &&CASE ( WTANK_F[STP_FN,1]=2	.OR. UCHTYPE=2 .OR. UCHTYPE=26	.or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .OR. UCHTYPE=10  .OR.  UCHTYPE=11  .or. UCHTYPE=12   ) .AND. NEXTOK1=1	  .AND.  STP9=0
  CASE	 weight_type[stp_zn]=1	.AND. NEXTOK1=1      .AND.  STP9=0
    IF (A_PRESS_N0[1,21,STP_FN,1] =77)
      A_PRESS_N0[1,21,STP_FN,1] :=0
      A_PRESS_N0[1,21,STP_FN+1,1] :=0
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN+1)
      IF  STORB_E=1
	a_copy_4(A_PRESS_B0,STP_FN,STP_FN+1)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP8=1
      STP9=0
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  ENDCASE
CASE (STP8=1)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE UCHTYPE=1 .or.UCHTYPE=7	 .or.UCHTYPE=15 .or. UCHTYPE=16    .or. UCHTYPE=17
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP8=2
      IF KOT=1
	WTANK_F[8,1] :=77
      ENDIF
    ENDIF
  CASE (weight_type[stp_zn]=1 .or.  UCHTYPE=2 .OR. UCHTYPE=26  .or. UCHTYPE=32	.OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .OR. UCHTYPE=10  .OR.  UCHTYPE=11	.or. UCHTYPE=12    )
    IF ((A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1))
      IF KOT=1	&&¥þ¤W
	WTANK_F[STP_FN,1] :=77
      ENDIF
      STP&STP_FC=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE UCHTYPE=9 .OR. UCHTYPE=31  .OR. UCHTYPE=13   .OR. UCHTYPE=18 .OR. UCHTYPE=19.OR. UCHTYPE=21
    IF ((A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1))
      STP&STP_FC=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  ENDCASE
CASE STP8=2
  DRAF=0
  DO CASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    DO CASE
    CASE UCHTYPE=1  .or.UCHTYPE=7   .or.UCHTYPE=15 .or. UCHTYPE=16  .or. UCHTYPE=17
      STP8=4
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[8,1] :=1
   CASE UCHTYPE=9 .OR. UCHTYPE=13 .OR. UCHTYPE=19.OR. UCHTYPE=21
     STP8=4
     A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]  :=0
     A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]  :=1
     WTANK_F[7,1] :=1
     WTANK_F[8,1] :=1
    CASE (weight_type[stp_zn]=1 .or.  UCHTYPE=2   .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .OR. UCHTYPE=10  .OR.	UCHTYPE=11  .or. UCHTYPE=12   )
      STP8=0
      STP9=1
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[8,1] :=1
      SETDLA(A_M_NAME[STP_FN,8],0)
    CASE  UCHTYPE=31
      STP8=0
      STP9=1
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[8,1] :=1
      *SETDLA(A_M_NAME[STP_FN,8],0)
    CASE  UCHTYPE=18
      STP8=4
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[6,1] :=1
      WTANK_F[7,1] :=1
      WTANK_F[8,1] :=1
    ENDCASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    XMC_F=A_M_NAME[STP_FN,3]
    IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
      @  4,A_M_NAME[STP_FN,13]	SAY  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
      SET COLOR TO &C2	/ &C1
      *MTANK_MARK(6,STP_FN,1)
      DSPA_ARROW(STP_FN,1,14)  && úD
    ENDIF
    do case
    CASE UCHTYPE=1 .or.UCHTYPE=7  .or.UCHTYPE=15 .or. UCHTYPE=16   .or. UCHTYPE=17
      SETDLA(A_M_NAME[STP_FN,8],0)
      SET COLOR TO &C10 / &C1
      *@ 11,46 SAY   "úZúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
      WEIG_URESCALL(STP_FN)
      SETDLA(A_M_NAME[STP_FN,8],0)
      CLEACHMEM(STP_ZN)
    CASE (weight_type[stp_zn]=1 .or. UCHTYPE=2 .OR. UCHTYPE=31	.OR. UCHTYPE=26 .or. UCHTYPE=32   .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30	.OR.UCHTYPE=22	.or.UCHTYPE=8  .OR. UCHTYPE=10	.OR.  UCHTYPE=11  .or. UCHTYPE=12  )
      if   UCHTYPE=31
	RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1])
      else
	SETDLA(A_M_NAME[STP_FN,8],0)
	RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1])
      endif
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
	  DO CASE
	  CASE (weight_type[stp_zn]=1 .or. UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26  .or. UCHTYPE=32	.OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .OR. UCHTYPE=10   .OR.  UCHTYPE=11  .or. UCHTYPE=12  )
	    IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	      DSPA_ARROW(STP_FN,0,0)  && úD
	      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
	    ENDIF
	    *A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	       if  storb_e=1
		 EW1=A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,1]
		 A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	       endif
	      EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	      XMC_F=A_M_NAME[STP_FN,3]
	      *@  8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	      EWN=EW1*2048/A_M_NAME[STP_FN,10]
	      WTANK_F[STP_FN,1]=1
	      SETCHDATA(STP_ZN,EWN)
	      IF UCHTYPE=18 .or.  UCHTYPE=31
		SETDLA(A_M_NAME[STP_FN,8],EWN +CHENDATA(STP_ZN-1))
	      ELSE
		  SETDLA(A_M_NAME[STP_FN,8],EWN)
	      ENDIF
	      STP8=0
	      STP9=1
	    ELSE
	      WTANK_F[STP_FN,1] :=1
	      EWN=WDATA(A_M_NAME[STP_FN,8])-2048
	      if   storb_e=1
		EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
		A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	      endif
	      EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	      XMC_F=A_M_NAME[STP_FN,3]
	      *@  8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	      SETCHDATA(STP_ZN,EWN)
	      IF UCHTYPE=18
		SETDLA(A_M_NAME[STP_FN,8],EWN +CHENDATA(STP_ZN-1))
	      ELSE
		SETDLA(A_M_NAME[STP_FN,8],EWN)
	      ENDIF
	      STP&STP_FC=0
	      STP9=1
	    ENDIF
	  ENDCASE
	ENDIF
	RETU
      ENDIF
      SET COLOR TO &C10 / &C1
      *@ 11,46 SAY   "úZúYú["
      IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      ENDIF
      WEIG_URESCALL(STP_FN)
    CASE UCHTYPE=9  .OR. UCHTYPE=13   .OR. UCHTYPE=18 .OR. UCHTYPE=19.OR. UCHTYPE=21
      *RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]]
       RDDELAY[STP_FN,3] := 0
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
      ENDIF
      SET COLOR TO &C10 / &C1
      *@ 11,46 SAY   "úZúYú["
      IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      ENDIF
      WEIG_URESCALL(STP_FN)
    ENDCASE
    do case
    CASE weight_type[stp_zn]=1 .or. UCHTYPE=8  .OR. UCHTYPE=10
      SET COLOR TO &C10 / &C1
      *@ 11,36 SAY   "úZúYúYúYú["
      SETDLA(A_M_NAME[STP_FN,8],0)
    ENDCASE
    SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1]
    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETOK(STP_ZN)
    DOUT(STP_ZN,1)
    STP8=3
    SET COLOR TO &C7 +/ &C1
  ENDCASE
CASE STP8=3
  TST1_LS1(STP_FN)
  IF LS1[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS2(STP_FN)
  IF RDOK2(STP_ZN)=0
    DOUT(STP_ZN,0)
    STOPTM&STP_FC=0
    DOUT3(0,0)
    EWN=CHENDATA(STP_ZN)
    if uchtype=18	.OR.  storb_e=1
      EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
      A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    endif
    EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
    A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] := 1
    XMC_F=A_M_NAME[STP_FN,3]
    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
    SET COLOR TO &C2 / &C1
    *MTANK_MARK(6,STP_FN,0)
    DSPA_ARROW(STP_FN,0,0)  && úD
    SET COLOR TO &C7 +/ &C1
    DO CASE
    CASE UCHTYPE=1
      STP8=4
      DOUT3(0,0)
      X=EWN
      IF KOT=1
	WTANK_F[8,1] :=1
      ENDIF
    CASE UCHTYPE=7  .or.UCHTYPE=15 .or. UCHTYPE=16  .or. UCHTYPE=17
      STP8=4
      DOUT3(0,0)
      X=EWN
      IF  TIME1[STP_FN,1] <>88
	WTANK_F[8,1] :=1
      ENDIF
    CASE UCHTYPE=9 .OR. UCHTYPE=13 .OR. UCHTYPE=19.OR. UCHTYPE=21
      STP8=4
      WTANK_F[STP_FN-1,1] :=1
      WTANK_F[STP_FN,1] :=1
    CASE (weight_type[stp_zn]=1 .or. UCHTYPE=2 .OR. UCHTYPE=26 .or. UCHTYPE=32	 .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .OR. UCHTYPE=10 .OR.  UCHTYPE=11	.or. UCHTYPE=12  )

      EW1 =A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]
      IF EW1 > 1.5 * (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] )
	IF  RDDATA_ERR[STP_FN] > 0
	  STP8=3
	  X=HEXTODEC("1B0")
	  SETOK(STP_ZN)
	  *SET_DB(X+STP_ZN,1)
	  RDDATA_ERR[STP_FN]=RDDATA_ERR[STP_FN]-1
	ELSE
	  RDDATA_ERR[STP_FN] =3
	  STP8=0
	  STP9=1
	  X=EWN
	  SETDLA(A_M_NAME[STP_FN,8],X)
	  WTANK_F[STP_FN,1] :=1
	ENDIF
      ELSE
	RDDATA_ERR[STP_FN] =3
	STP8=0
	STP9=1
	X=EWN
	SETDLA(A_M_NAME[STP_FN,8],X)
	WTANK_F[STP_FN,1] :=1
      ENDIF

    CASE  UCHTYPE=18
      STP8=4
      WTANK_F[STP_FN-2,1] :=1
      WTANK_F[STP_FN-1,1] :=1
      WTANK_F[STP_FN,1] :=1
    CASE UCHTYPE=31
      STP8=0
      STP9=1
      X=EWN  + chendata(STP_ZN-1)
      SETDLA(A_M_NAME[STP_FN,8],X)
    ENDCASE
  ENDIF
CASE STP8=4  .AND.  ( TIME1[STP_FN,1]=88  )
   IF  DIN(9)=0    .AND. DIN(12)=1  .AND.   SPACIAL_0=0
     STP8=5
   ENDIF
CASE STP8=4  .AND.  (WTANK_F[8,1]=-99)	.AND. DIN(9)=0	  .AND. DIN(12)=1
  IF  TIME1[STP_FN,2] =0
    TIME1[STP_FN,2] :=SECONDS()
  ENDIF
  IF ABS(SECONDS()-TIME1[STP_FN,2]) >=TIME1[STP_FN,1]
    TIME1[STP_FN,2] :=0
    STP8=5
  ENDIF
CASE STP8=5   .AND. DIN(9)=0	.AND. DIN(12)=1
  IF UCHTYPE=1 .or.UCHTYPE=7  .or.UCHTYPE=9 .OR. UCHTYPE=13 .or.UCHTYPE=15 .or. UCHTYPE=16   .or. UCHTYPE=17   .or. UCHTYPE=18 .OR. UCHTYPE=19.OR. UCHTYPE=21
    WTANK_F[8,1]=0
    *DOUT2(1,0)
    STP8=6
    do	case
    case   UCHTYPE=13 .OR. UCHTYPE=19
      SETZER(A_M_NAME[STP_FN,8],INT(((PZER7/A_M_NAME[KLCHN + 3,6]))*PER*2048)+2048)
      if ( ( A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .AND. ( A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0))
	RETU
      ENDIF
    case    UCHTYPE=21
      SETZER(A_M_NAME[STP_FN,8],INT(((PZER7/A_M_NAME[KLCHN + 2,6]))*PER*2048)+2048)
      if ( ( A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .AND. ( A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0))
	RETU
      ENDIF
    case   UCHTYPE=18
      if ( ( A_PRESS_N0[L_PRESS,1,STP_FN-2,1]  = 0) .AND.( A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .AND. ( A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0))
	RETU
      ENDIF
      SETZER(A_M_NAME[STP_FN,8],INT(((PZER6/A_M_NAME[KLCHN + 2,6]))*PER*2048)+2048)
    case   UCHTYPE=7   .or.  UCHTYPE=9 .or.UCHTYPE=15	.or. UCHTYPE=18
      *SETZER(A_M_NAME[STP_FN,8],INT(((PZER7/A_M_NAME[KLCHN + 3,6]))*PER*2048)+2048)
      if (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
	RETU
      ENDIF
    case   UCHTYPE=16	.or. UCHTYPE=17
      SETZER(A_M_NAME[STP_FN,8],INT(((PZER7/A_M_NAME[KLCHN + 3,6]))*PER*2048)+2048)
      if (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
	RETU
      ENDIF
    otherwise
      SETZER(A_M_NAME[STP_FN,8],INT(((PZER8/A_M_NAME[KLCHN + 2,6]))*PER*2048)+2048)
    ENDcase
    *IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0 ) .OR.( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,8] >0 )
      SET COLOR TO &C11 / &C1
      *@ 11,46 SAY   "úLúKúO"
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
      SET COLOR TO &C7 +/ &C1
    *endif
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    SETZEROK(A_M_NAME[STP_FN,8])
    dout2(A_M_NAME[STP_FN,8],1)
  ENDIF
CASE STP8=6
  JMPF=0
  do  case
  case	 UCHTYPE=13 .OR. UCHTYPE=19.OR. UCHTYPE=21
    if ( ( A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .AND. ( A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0))
      JMPF=1
    ENDIF
  case	 UCHTYPE=16 .or. UCHTYPE=17  .or. UCHTYPE=7
    if (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
      JMPF=1
    ENDIF
  ENDcase
  IF JMPF=0
    TST1_LS2(STP_FN)
    IF LS2[STP_FN,2]=1
      RETU
    ENDIF
    TST0_LS1(STP_FN,STP_FN)
  ELSE
      setZokn(A_M_NAME[STP_FN,8],0)
  ENDIF
  IF  RDZEROK(A_M_NAME[STP_FN,8])=0
    DO	CASE
    CASE UCHTYPE=1 .OR.  UCHTYPE=7  .or.UCHTYPE=15 .or. UCHTYPE=16  .or. UCHTYPE=17
      DOUT3(4,0)
      dout2(A_M_NAME[STP_FN,8],0)
      CLEACHMEM(STP_ZN)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[8,13]  SAY	"     " PICT "&XMC_F"
      STP8=7
      SET COLOR TO &C2 / &C1
      *@ 11,46 SAY   "úLúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      A_M_NAME[8,10] := A_M_NAME[8,9]
      A_M_NAME[A_M_NAME[STP_FN,8]+1,12] := A_M_NAME[A_M_NAME[STP_FN,8]+1,6]
      WTANK_F[8,2] :=1
      WTANK_F[8,1] :=0
      IF TIME1[STP_FN,1]=88
	WTANK_F[STP_FN,1] :=1
      ENDIF
      STPN8=STPN8+1
    CASE UCHTYPE=9 .OR. UCHTYPE=13 .OR. UCHTYPE=19 .OR. UCHTYPE=21
      X=HEXTODEC("29C")
      &&SET_DB(X+STP_ZN,0)
      dout2(A_M_NAME[STP_FN,8],0)
      SETDLA(A_M_NAME[STP_FN,8],0)
      DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[6,13]  SAY  "     " PICT "&XMC_F"
      *@  4,A_M_NAME[7,13]  SAY  "     " PICT "&XMC_F"
      CLEACHMEM(6)
      CLEACHMEM(7)
      STP8=7
      SET COLOR TO &C2 / &C1
      *@ 11,36 SAY   "úLúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[7,2] :=1
      WTANK_F[8,2] :=1
      WTANK_F[7,1] :=0
      WTANK_F[8,1] :=0
      STPN7=STPN7+1
      STPN8=STPN8+1
    CASE  UCHTYPE=18
      X=HEXTODEC("29C")
      &&SET_DB(X+STP_ZN,0)
      dout2(A_M_NAME[STP_FN,8],0)
      SETDLA(A_M_NAME[STP_FN,8],0)
      *DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[6,13]  SAY  "     " PICT "&XMC_F"
      *@  4,A_M_NAME[7,13]  SAY  "     " PICT "&XMC_F"
      CLEACHMEM(STP_ZN-2)
      CLEACHMEM(STP_ZN-1)
      CLEACHMEM(STP_ZN)
      STP8=7
      SET COLOR TO &C2 / &C1
      *@ 11,36 SAY   "úLúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[STP_FN-2,1] :=0
      WTANK_F[STP_FN-1,1] :=0
      WTANK_F[STP_FN,1] :=0
      WTANK_F[STP_FN-2,2] :=1
      WTANK_F[STP_FN-1,2] :=1
      WTANK_F[STP_FN,2] :=1
      *WTANK_F[7,2] :=1
      *WTANK_F[8,2] :=1
      *WTANK_F[7,1] :=0
      *WTANK_F[8,1] :=0
      STPN6=STPN6+1
      STPN7=STPN7+1
      STPN8=STPN8+1
    ENDCASE
  ENDIF

CASE (STP8=7   ) .AND. (WTANK_F[STP_FN,1]=2 .OR.TIME1[STP_FN,1] <>88  )
  DO CASE
  CASE UCHTYPE=1 .or.UCHTYPE=7	.or.UCHTYPE=15 .or. UCHTYPE=16	  .or. UCHTYPE=17
     if TIME1[STP_FN,1] =88
       WTANK_F[STP_FN,1] :=2
       WTANK_F[STP_FN,2] :=1
     endif
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP8=1
    ELSE
      STP8=0
      STPN8=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  CASE	UCHTYPE=9 .OR. UCHTYPE=13 .OR. UCHTYPE=19 .OR. UCHTYPE=21
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP7=1
      STP8=0
    ELSE
      STP7=0
      STPN7=1
      STP8=0
      STPN8=1
      WTANK_F[STP_FN-1,3] :=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  CASE	UCHTYPE=18
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP6=1
      STP7=0
      STP8=0
    ELSE
      STP6=0
      STPN6=1
      STP7=0
      STPN7=1
      STP8=0
      STPN8=1
      WTANK_F[STP_FN-2,3] :=1
      WTANK_F[STP_FN-1,3] :=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
   ENDCASE
ENDCASE
RETU
**------------------------------------------------------------------------------------------------------------
PROCEDURE  STP9
PARAMETERS  P1,P2,P3
STP_ZN=8
STP_FN=9
STP_FC="9"
DO CASE
CASE (STP9=0)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE (UCHTYPE=1 .OR. UCHTYPE=7  .OR. UCHTYPE=9  .OR. UCHTYPE=19   ) .AND. NEXTOK1=1	.and. STP10=0
    IF (A_PRESS_N0[1,21,9,1] =77)
      A_PRESS_N0[1,21,9,1] :=0
      A_PRESS_N0[1,21,10,1] :=0
      a_copy_4(A_PRESS_N0,9,10)
      IF UCHTYPE=19
	a_copy_4(A_PRESS_B0,STP_FN,STP_FN+1)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP9=1
      STP10=0
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE (UCHTYPE=91 .OR. UCHTYPE=13 .OR. UCHTYPE=15  .or. UCHTYPE=16  .or. UCHTYPE=17  .OR. UCHTYPE=18 .OR. UCHTYPE=21	 ) .AND. NEXTOK1=1
    IF (A_PRESS_N0[1,21,STP_FN,1] =77)
      A_PRESS_N0[1,21,STP_FN,1] :=0
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN)
      IF LCHTYPE=16 .or. LCHTYPE=17
	a_copy_4(A_PRESS_B0,STP_FN,STP_FN)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP9=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  ENDCASE
CASE (STP9=1)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE UCHTYPE=1  .OR. UCHTYPE=7 .OR. UCHTYPE=9 .OR. UCHTYPE=19
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP9=2
      IF KOT=1
	WTANK_F[9,1] :=77
	WTANK_F[10,1] :=77
	RDDELAY[STP_FN,2] :=SECONDS()
	RDDELAY[STP_FN,3] :=0
      ENDIF
    ENDIF
  CASE (weight_type[stp_zn]=1 .or. UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26  .or. UCHTYPE=32	.OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .OR. UCHTYPE=10  .OR.  UCHTYPE=11	.or. UCHTYPE=12   )
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP9=2
      IF KOT=1
	WTANK_F[9,1] :=77
	RDDELAY[STP_FN,2] :=SECONDS()
	RDDELAY[STP_FN,3] :=0
      ENDIF
    ENDIF
  CASE UCHTYPE=91   .OR. UCHTYPE=13 .OR. UCHTYPE=15   .or. UCHTYPE=16	 .or. UCHTYPE=17      .OR. UCHTYPE=18.OR. UCHTYPE=21
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP9=2
      IF KOT=1
	WTANK_F[9,1] :=77
      ENDIF
    ENDIF
  ENDCASE
CASE STP9=2
  DRAF=0
  DO CASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    DO CASE
    CASE UCHTYPE=1 .or. UCHTYPE=7 .OR. UCHTYPE=9 .OR. UCHTYPE=19
      STP9=0
      STP10=2
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE (weight_type[stp_zn]=1 .or. UCHTYPE=2	.OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6  .OR.UCHTYPE=30 .OR.UCHTYPE=22	.or.UCHTYPE=8  .OR. UCHTYPE=10	.OR.  UCHTYPE=11  .or. UCHTYPE=12  )
      STP9=4
      WTANK_F[STP_FN-1,1] :=1
      WTANK_F[STP_FN,1] :=1
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE  UCHTYPE=31
      STP9=4
      WTANK_F[STP_FN-2,1] :=1
      WTANK_F[STP_FN-1,1] :=1
      WTANK_F[STP_FN,1] :=1
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE UCHTYPE=91 .OR. UCHTYPE=13 .OR. UCHTYPE=15 .or. UCHTYPE=16	.or. UCHTYPE=17 .OR. UCHTYPE=18.OR. UCHTYPE=21
      STP9=4
      WTANK_F[STP_FN,1] :=1
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    ENDCASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    DO CASE
    CASE UCHTYPE=1 .OR. UCHTYPE=7 .OR. UCHTYPE=9 .OR. UCHTYPE=19
      RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1])
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	    EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=EW1*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(A_M_NAME[STP_FN,8],EWN)
	    STP9=0
	    STP10=1
	  ELSE
	    EWN=WDATA(A_M_NAME[STP_FN,8])-2048
	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(A_M_NAME[STP_FN,8],EWN)
	    STP9=0
	    STP10=1
	  ENDIF
	ENDIF
	RETU
      ENDIF
    CASE (weight_type[stp_zn]=1 .or. UCHTYPE=2 .OR. UCHTYPE=31	.OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30	.OR.UCHTYPE=22	.or.UCHTYPE=8  .OR. UCHTYPE=10	.OR.  UCHTYPE=11  .or. UCHTYPE=12    )
      *RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1])
      RDDELAY[STP_FN,3] :=0
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
	  *IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	  *  EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	  *  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	  *  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	  *  XMC_F=A_M_NAME[STP_FN,3]
	  *  @	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	  *  EWN=EW1*2048/A_M_NAME[STP_FN,10]
	  *  SETCHDATA(STP_ZN,EWN)
	  *  SETDLA(A_M_NAME[STP_FN,8],EWN)
	  *  STP9=0
	  *  STP10=1
	  *ELSE
	  EWN=WDATA(A_M_NAME[STP_FN,8])-2048-CHENDATA(STP_ZN-1)
	  EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	  XMC_F=A_M_NAME[STP_FN,3]
	  *@  8,A_M_NAME[STP_FN,13]  SAY  EW1	PICT "&XMC_F"
	  *SETCHDATA(STP_ZN,EWN)
	  *SETDLA(A_M_NAME[STP_FN,8],EWN)
	  STP9=4
	  *ENDIF
	ENDIF
	RETU
      ENDIF
    CASE UCHTYPE=91  .OR. UCHTYPE=13 .OR. UCHTYPE=15 .or. UCHTYPE=16	.or. UCHTYPE=17  .OR. UCHTYPE=18 .OR. UCHTYPE=21
      *RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1])
      RDDELAY[STP_FN,3] :=0
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
	  EWN=WDATA(A_M_NAME[STP_FN,8])-2048-CHENDATA(STP_ZN-1)
	  EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	  XMC_F=A_M_NAME[STP_FN,3]
	  *@  8,A_M_NAME[STP_FN,13]  SAY  EW1	PICT "&XMC_F"
	  STP9=4
	ENDIF
	RETU
      ENDIF
    ENDCASE
    XMC_F=A_M_NAME[STP_FN,3]
    IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
      @  4,A_M_NAME[STP_FN,13]	SAY  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
      SET COLOR TO &C2	/ &C1
      *MTANK_MARK(6,STP_FN,1)
      DSPA_ARROW(STP_FN,1,14)  && úD
    ENDIF
    SET COLOR TO &C2  / &C1
    do case
    CASE UCHTYPE=1
      SET COLOR TO &C10 / &C1
      IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	*@ 11,53 SAY   "úZúYúYúYúYú["
	DSPB_FMK(KLCHN+3,1)
      endif
      WEIG_URESCALL(STP_FN)
      SETDLA(KLCHN+2,0)
    CASE  UCHTYPE=7 .OR. UCHTYPE=19
      SET COLOR TO &C10 / &C1
      *@ 11,53 SAY   "úZúYúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_URESCALL(STP_FN)
      SETDLA(A_M_NAME[STP_FN,8],0)
    CASE   UCHTYPE=9
      SET COLOR TO &C10 / &C1
      *@ 11,53 SAY   "úZúYúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      SETDLA(A_M_NAME[STP_FN,8],0)
      WEIG_URESCALL(STP_FN)
    CASE (weight_type[stp_zn]=1 .or. UCHTYPE=2 .OR. UCHTYPE=26 .or. UCHTYPE=32	 .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .OR. UCHTYPE=10  .OR.  UCHTYPE=11  .or. UCHTYPE=12  )
      SET COLOR TO &C10 / &C1
      *@ 11,53 SAY   "úZúYúYúYúYú["
      IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      ENDIF
      EWN=CHENDATA(STP_ZN-1)
      SETDLA(A_M_NAME[STP_FN,8],EWN)
      WEIG_URESCALL(STP_FN)
    CASE UCHTYPE=91  .OR. UCHTYPE=31  .OR. UCHTYPE=13 .OR. UCHTYPE=15	.or. UCHTYPE=16    .or. UCHTYPE=17 .OR. UCHTYPE=18.OR. UCHTYPE=21
      SET COLOR TO &C10 / &C1
      *@ 11,53 SAY   "úZúYúYúYúYú["
      IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      ENDIF
      WEIG_URESCALL(STP_FN)
    ENDCASE
    SET COLOR TO &C7 +/ &C1
    CLEACHMEM(STP_ZN)
    SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1]
    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETOK(STP_ZN)
    DOUT(STP_ZN,1)
    STP9=3
  ENDCASE
CASE STP9=3
  TST1_LS1(STP_FN)
  IF LS1[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS2(STP_FN)
  IF RDOK2(STP_ZN)=0
    DOUT(STP_ZN,0)
    STOPTM&STP_FC=0
    DOUT3(0,0)
    EWN=CHENDATA(STP_ZN)
    if uchtype=18	.OR.  storb_e=1
      EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
      A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] :=  EW1
    endif
    EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
    XMC_F=A_M_NAME[STP_FN,3]
    if val(XMC_F) >=999
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    else
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4] := EW1
    endif
    A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] := 1
    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
    SET COLOR TO &C2 / &C1
    *MTANK_MARK(6,STP_FN,0)
    DSPA_ARROW(STP_FN,0,0)  && úD
    SET COLOR TO &C7 +/ &C1
    DO CASE
    CASE UCHTYPE=1
      STP9=0
      STP10=2
      X=EWN
      SETDLA(KLCHN+2,X)
    CASE  UCHTYPE=7
      STP9=0
      STP10=2
      X=EWN
      SETDLA(KLCHN+3,X)
    CASE  UCHTYPE=19
      STP9=0
      STP10=2
      X=EWN
      SETDLA(KLCHN+2,X)
    CASE (weight_type[stp_zn]=1 .or. UCHTYPE=2 .OR. UCHTYPE=26	.or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .OR. UCHTYPE=10 .OR.  UCHTYPE=11	.or. UCHTYPE=12   )
      STP9=4
      WTANK_F[STP_FN-1,1] :=1
      WTANK_F[STP_FN,1] :=1
      *X=EWN
      *SETDLA(KLCHN+2,X)
    CASE UCHTYPE=31
      STP9=4
      WTANK_F[STP_FN-2,1] :=1
      WTANK_F[STP_FN-1,1] :=1
      WTANK_F[STP_FN,1] :=1
      *X=EWN
      *SETDLA(KLCHN+2,X)
    CASE UCHTYPE=91   .OR. UCHTYPE=13 .OR. UCHTYPE=15 .or. UCHTYPE=16  .or. UCHTYPE=17 .OR. UCHTYPE=18.OR. UCHTYPE=21
      STP9=4
      IF  TIME1[STP_FN,1] <>88
	WTANK_F[STP_FN,1] :=1
      ENDIF
    ENDCASE
  ENDIF
CASE STP9=4  .AND.  ( TIME1[STP_FN,1]=88  )
  IF  DIN(9)=0	  .AND. DIN(12)=1  .AND.   SPACIAL_0=0
    STP9=5
  ENDIF
CASE STP9=4 .AND. ( UCHTYPE=15 ) .AND.	( TIME1[STP_FN,1]=99  )

    IF	(WTANK_F[9,1]=-99  )   .AND.  (TANKSTP>=5)  .AND. (DIN(9)=1)
      STP9=5
    ENDIF



CASE STP9=4  .AND.  (WTANK_F[9,1]=-99)	.AND. DIN(9)=0	  .AND. DIN(12)=1
  if uchtype=91 .OR. UCHTYPE=13 .or. UCHTYPE=16  .or. UCHTYPE=17  .OR. UCHTYPE=15 .OR. UCHTYPE=18.OR. UCHTYPE=21
    if spacial_0=1
      STP9=5
      retu
    endif
  endif
  IF  TIME1[STP_FN,2] =0
    TIME1[STP_FN,2] :=SECONDS()
  ENDIF
  IF ABS(SECONDS()-TIME1[STP_FN,2]) >=TIME1[STP_FN,1]
    TIME1[STP_FN,2] :=0
    STP9=5
  ENDIF
CASE STP9=5   .AND. (DIN(9)=0 .OR.  TIME1[STP_FN,1]=99	  )   .AND. (DIN(12)=1	.or. uchtype=15)
  DO  CASE
  CASE (weight_type[stp_zn]=1 .or. UCHTYPE=2 .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .OR. UCHTYPE=10  .OR.  UCHTYPE=11	.or. UCHTYPE=12  )
    WTANK_F[STP_FN-1,1]=0
    WTANK_F[STP_FN,1]=0
    *DOUT2(1,0)
    STP9=6
    SET COLOR TO &C11 / &C1
    *@ 11,46 SAY   "úLúKúO"
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0 ) .OR.( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,8] >0 )
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    ENDIF
    SET COLOR TO &C7 +/ &C1
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    *SETZER(KLCHN+1,INT(((PZER8/A_M_NAME[KLCHN + 2,6]))*PER*2048)+2048)
    SETZEROK(A_M_NAME[STP_FN,8])
    dout2(A_M_NAME[STP_FN,8],1)
  CASE UCHTYPE=31
    WTANK_F[STP_FN-2,1]=0
    WTANK_F[STP_FN-1,1]=0
    WTANK_F[STP_FN,1]=0
    *DOUT2(1,0)
    STP9=6
    SET COLOR TO &C11 / &C1
    *@ 11,46 SAY   "úLúKúO"
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0 ) .OR.( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,8] >0 )   .OR.( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-2,8] >0 )
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    ENDIF
    SET COLOR TO &C7 +/ &C1
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    *SETZER(KLCHN+1,INT(((PZER8/A_M_NAME[KLCHN + 2,6]))*PER*2048)+2048)
    SETZEROK(A_M_NAME[STP_FN,8])
    dout2(A_M_NAME[STP_FN,8],1)
  CASE UCHTYPE=91  .OR. UCHTYPE=13 .OR. UCHTYPE=15 .or. UCHTYPE=16 .or. UCHTYPE=17 .OR. UCHTYPE=18.OR. UCHTYPE=21
    WTANK_F[STP_FN,1]=66
    *DOUT2(1,0)
    STP9=6
    do case
    case   UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22    .OR. UCHTYPE=10
      if ( ( A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .AND. ( A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0))
	RETU
      ENDIF
    case  UCHTYPE=13 .OR. UCHTYPE=15   .OR. UCHTYPE=16 .or. UCHTYPE=17 .OR. UCHTYPE=18.OR. UCHTYPE=21
      if (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
	RETU
      ENDIF
    endcase
    SET COLOR TO &C11 / &C1
    *@ 11,46 SAY   "úLúKúO"
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0  )
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    ENDIF
    SET COLOR TO &C7 +/ &C1
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    *SETZER(KLCHN+1,INT(((PZER8/A_M_NAME[KLCHN + 2,6]))*PER*2048)+2048)
    SETZEROK(A_M_NAME[STP_FN,8])
    dout2(A_M_NAME[STP_FN,8],1)
  ENDCASE
CASE STP9=6
  JMPF=0
  do case
  case	weight_type[stp_zn]=1 .or. UCHTYPE=6  .OR.UCHTYPE=30  .OR.UCHTYPE=22   .OR. UCHTYPE=26 .or. UCHTYPE=32	 .OR. UCHTYPE=10
    if ( ( A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .AND. ( A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0))
      JMPF=1
    ENDIF
  case	UCHTYPE=31
    if ( ( A_PRESS_N0[L_PRESS,1,STP_FN-1,1]  = 0) .AND. ( A_PRESS_N0[L_PRESS,1,STP_FN-2,1]  = 0) .AND. ( A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0))
      JMPF=1
    ENDIF
  case	UCHTYPE=13   .OR. UCHTYPE=16 .or. UCHTYPE=17 .OR. UCHTYPE=18.OR. UCHTYPE=21
    if (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
      JMPF=1
    ENDIF
    IF DIN(9)=0
      dout2(A_M_NAME[STP_FN,8],0)
    ELSE
      dout2(A_M_NAME[STP_FN,8],1)
    ENDIF
  case	 UCHTYPE=15
    if (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
      JMPF=1
    ENDIF


  ENDcase
  IF JMPF=0
    TST1_LS2(STP_FN)
    IF LS2[STP_FN,2]=1
      RETU
    ENDIF
    TST0_LS1(STP_FN,STP_FN)
  ELSE
      setZokn(A_M_NAME[STP_FN,8],0)
  ENDIF
  IF  RDZEROK(A_M_NAME[STP_FN,8])=0
    DO CASE
    CASE  (weight_type[stp_zn]=1 .or. UCHTYPE=2 .OR. UCHTYPE=26 .or. UCHTYPE=32   .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30	.OR.UCHTYPE=22	.or.UCHTYPE=8  .OR. UCHTYPE=10	.OR.  UCHTYPE=11  .or. UCHTYPE=12    )
      STP9=7
      *DOUT3(4,0)
      dout2(A_M_NAME[STP_FN,8],0)
      CLEACHMEM(STP_ZN-1)
      CLEACHMEM(STP_ZN)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[8,13]  SAY  "     " PICT "&XMC_F"
      *@  4,A_M_NAME[9,13]  SAY  "     " PICT "&XMC_F"
      SET COLOR TO &C2 / &C1
      *@ 11,46 SAY   "úLúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      A_M_NAME[STP_FN-1,10] := A_M_NAME[STP_FN-1,9]
      A_M_NAME[STP_FN,10] := A_M_NAME[STP_FN,9]
      A_M_NAME[A_M_NAME[STP_FN,8],12] := A_M_NAME[A_M_NAME[STP_FN,8],6]
      WTANK_F[8,1] :=0
      WTANK_F[8,2] :=1
      WTANK_F[9,1] :=0
      WTANK_F[9,2] :=1

      STPN8=STPN8+1
      STPN9=STPN9+1
    CASE  UCHTYPE=31
      STP9=7
      *DOUT3(4,0)
      dout2(A_M_NAME[STP_FN,8],0)
      CLEACHMEM(STP_ZN-2)
      CLEACHMEM(STP_ZN-1)
      CLEACHMEM(STP_ZN)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[8,13]  SAY  "     " PICT "&XMC_F"
      *@  4,A_M_NAME[9,13]  SAY  "     " PICT "&XMC_F"
      SET COLOR TO &C2 / &C1
      *@ 11,46 SAY   "úLúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      A_M_NAME[STP_FN-2,10] := A_M_NAME[STP_FN-2,9]
      A_M_NAME[STP_FN-1,10] := A_M_NAME[STP_FN-1,9]
      A_M_NAME[STP_FN,10] := A_M_NAME[STP_FN,9]
      A_M_NAME[A_M_NAME[STP_FN,8],12] := A_M_NAME[A_M_NAME[STP_FN,8],6]
      WTANK_F[7,1] :=0
      WTANK_F[7,2] :=1
      WTANK_F[8,1] :=0
      WTANK_F[8,2] :=1
      WTANK_F[9,1] :=0
      WTANK_F[9,2] :=1

      STPN7=STPN7+1
      STPN8=STPN8+1
      STPN9=STPN9+1
    CASE  UCHTYPE=91  .OR. UCHTYPE=13 .OR. UCHTYPE=15 .or. UCHTYPE=16 .or. UCHTYPE=17 .OR. UCHTYPE=18.OR. UCHTYPE=21
      STP9=7
      *DOUT3(4,0)
      dout2(A_M_NAME[STP_FN,8],0)
      CLEACHMEM(STP_ZN)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[9,13]  SAY  "     " PICT "&XMC_F"
      SET COLOR TO &C2 / &C1
      *@ 11,46 SAY   "úLúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      A_M_NAME[STP_FN,10] := A_M_NAME[STP_FN,9]
      A_M_NAME[A_M_NAME[STP_FN,8],12] := A_M_NAME[A_M_NAME[STP_FN,8],6]
      WTANK_F[9,1] :=0
      WTANK_F[9,2] :=1
      IF TIME1[STP_FN,1]=88
	WTANK_F[STP_FN,1] :=1
      ENDIF
      IF SPACIAL_0 =1
	WTANK_F[9,1] :=2
      ENDIF
      STPN9=STPN9+1
    ENDCASE
  ENDIF
CASE STP9=7 .AND. (WTANK_F[STP_FN,1]=2 .OR.TIME1[STP_FN,1] <>88  )
  DO CASE
  CASE	(weight_type[stp_zn]=1 .or. UCHTYPE=2 .OR. UCHTYPE=26 .or. UCHTYPE=32	.OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .OR. UCHTYPE=10  .OR.  UCHTYPE=11	.or. UCHTYPE=12   )
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP8=1
      STP9=0
    ELSE
      STP8=0
      STPN8=1
      STP9=0
      STPN9=1
      WTANK_F[STP_FN-1,3] :=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  CASE	UCHTYPE=31
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP7=1
      STP8=0
      STP9=0
    ELSE
      STP7=0
      STPN7=1
      STP8=0
      STPN8=1
      STP9=0
      STPN9=1
      WTANK_F[STP_FN-2,3] :=1
      WTANK_F[STP_FN-1,3] :=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  CASE	UCHTYPE=91  .OR. UCHTYPE=13 .OR. UCHTYPE=15 .or. UCHTYPE=16 .or. UCHTYPE=17 .OR. UCHTYPE=18.OR. UCHTYPE=21
    if TIME1[STP_FN,1] =88
      WTANK_F[STP_FN,1] :=2
      WTANK_F[STP_FN,2] :=1
    endif
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP9=1
    ELSE
      STP9=0
      STPN9=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  ENDCASE
ENDCASE
RETU
**------------------------------------------------------------------------------------------------------------
PROCEDURE  STP10
PARAMETERS  P1,P2,P3
STP_ZN=9
STP_FN=10
STP_FC="10"
DO CASE
CASE (STP10=0)	 .and. (din(14)=1) .AND. (DIN(15)=1)	&&AUTO ,NO PAUSE
  DO  CASE
  CASE (UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .or.UCHTYPE=91  .OR. UCHTYPE=10  .OR.  UCHTYPE=11  .or. UCHTYPE=16  .or. UCHTYPE=17) .AND. NEXTOK1=1
    IF (A_PRESS_N0[1,21,STP_FN,1] =77)
      A_PRESS_N0[1,21,STP_FN,1] :=0
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN)
      IF LCHTYPE=16 .or. LCHTYPE=17	  .OR.	storb_e=1
	a_copy_4(A_PRESS_B0,STP_FN,STP_FN)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP10=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE ( UCHTYPE=12  ) .AND. NEXTOK1=1	 .and. STP11=0
    IF (A_PRESS_N0[1,21,10,1] =77)
      SETDLA(A_M_NAME[STP_FN,8],0)
      A_PRESS_N0[1,21,10,1] :=0
      A_PRESS_N0[1,21,11,1] :=0
      a_copy_4(A_PRESS_N0,10,11)
      NEXTOK1=0
      STP10=1
      STP11=0
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  ENDCASE
CASE (STP10=1)	 .and. (din(14)=1) .AND. (DIN(15)=1)	&&AUTO ,NO PAUSE
  DO  CASE
  CASE UCHTYPE=1 .OR. UCHTYPE=7 .OR. UCHTYPE=9 .OR. UCHTYPE=19
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP10=2
    ENDIF
  CASE UCHTYPE=2 .OR. UCHTYPE=26 .or. UCHTYPE=32
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP10=2
    ENDIF
  CASE	UCHTYPE=5  .OR. UCHTYPE=31  .OR. UCHTYPE=6  .OR.UCHTYPE=30 .OR.UCHTYPE=22    .or.UCHTYPE=8 .or. UCHTYPE=16  .or. UCHTYPE=17  .or.UCHTYPE=91 .OR. UCHTYPE=10  .OR.  UCHTYPE=11  .or. UCHTYPE=12
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP10=2
      WTANK_F[10,1] :=77
    ENDIF
  ENDCASE
CASE STP10=2
  SET COLOR TO &C7 +/ &C1
  DRAF=0
  DO CASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    DO CASE
    CASE UCHTYPE=1 .OR. UCHTYPE=7 .OR. UCHTYPE=9 .OR. UCHTYPE=19
      STP10=4
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[9,1] :=1
      WTANK_F[10,1] :=1
    CASE (UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .or. UCHTYPE=16  .or. UCHTYPE=17  .or.UCHTYPE=91  .OR. UCHTYPE=10	.OR.  UCHTYPE=11    )
      STP10=4
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[10,1] :=1
    CASE UCHTYPE=12
      STP10=0
      STP11=2
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      CLEACHMEM(STP_ZN)
      CLEACHMEM(STP_ZN +1)
    ENDCASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    do case
    CASE ( UCHTYPE=12	)
      SETDLA(A_M_NAME[STP_FN,8],0)
      RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1])
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
	  DO CASE
	  CASE	UCHTYPE=12
	    IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	      DSPA_ARROW(STP_FN,0,0)  && úD
	      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
	    ENDIF
	    *A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=int(PWATER * A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	      EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	      XMC_F=A_M_NAME[STP_FN,3]
	      *@  8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	      EWN=EW1*2048/A_M_NAME[STP_FN,10]
	      WTANK_F[STP_FN,1]=1
	      SETCHDATA(STP_ZN,EWN)
	      SETDLA(A_M_NAME[STP_FN,8],EWN)
	      STP10=0
	      STP11=2
	    ELSE
	      WTANK_F[STP_FN,1] :=1
	      EWN=WDATA(A_M_NAME[STP_FN,8])-2048
	      EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	      XMC_F=A_M_NAME[STP_FN,3]
	      *@  8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	      SETCHDATA(STP_ZN,EWN)
	      SETDLA(A_M_NAME[STP_FN,8],EWN)
	      STP&STP_FC=0
	      STP11=2
	    ENDIF
	  ENDCASE
	ENDIF
	RETU
      ENDIF
      SET COLOR TO &C10 / &C1
      *@ 11,46 SAY   "úZúYú["
      IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      ENDIF
      WEIG_URESCALL(STP_FN)
    ENDCASE
    SET COLOR TO W+   / &C1
    XMC_F=A_M_NAME[STP_FN,3]
    IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
    @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
      SET COLOR TO &C2	/ &C1
      *MTANK_MARK(6,STP_FN,1)
      DSPA_ARROW(STP_FN,1,14)  && úD
    endif
    SET COLOR TO &C2  / &C1
    do case
    CASE UCHTYPE=1
      SET COLOR TO &C10 / &C1
      IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	*@ 11,53 SAY   "úZúYúYúYúYú["
	DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
      endif
      A_M_NAME[KLCHN+3,12] :=  A_M_NAME[KLCHN+3,6]
      CLEACHMEM(STP_ZN)
    CASE  UCHTYPE=7 .OR. UCHTYPE=9 .OR. UCHTYPE=19
      SET COLOR TO &C10 / &C1
      *@ 11,53 SAY   "úZúYúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
      A_M_NAME[KLCHN+4,12] :=  A_M_NAME[KLCHN+4,6]
      CLEACHMEM(STP_ZN)
    CASE (UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26 .or. UCHTYPE=32   .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .or. UCHTYPE=16 .or. UCHTYPE=17   .or.UCHTYPE=91  .OR. UCHTYPE=10	.OR.  UCHTYPE=11  .or. UCHTYPE=12  )
      SETDLA(A_M_NAME[STP_FN,8],0)
      IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	SET COLOR TO &C10 / &C1
	*@ 11,53 SAY   "úZúYúYúYúYú["
	DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      endif
      A_M_NAME[KLCHN+3,12] :=  A_M_NAME[KLCHN+3,6]
    ENDCASE
    SET COLOR TO &C7 +/ &C1
    SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1]
    X=(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10]
    SETW1(STP_ZN,X)
    X=(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10]
    SETW2(STP_ZN,X)
    SETOK(STP_ZN)
    DOUT(STP_ZN,1)
    STP10=3
  ENDCASE
CASE STP10=3
  TST1_LS1(STP_FN)
  IF LS1[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS2(STP_FN)
  IF RDOK2(STP_ZN)=0
    DOUT(STP_ZN,0)
    STOPTM&STP_FC=0
    EWN=CHENDATA(STP_ZN)
    if uchtype=18	 .OR.  storb_e=1
      if  uchtype=30   .OR. UCHTYPE=31
	EW1=int(EWN*A_M_NAME[STP_FN,9] * 100/PER/2048)/100
      else
	EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
      endif
	A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] :=  EW1
    endif
    if	uchtype=30   .OR. UCHTYPE=31
      EW1=int(EWN*A_M_NAME[STP_FN,10] *100 /PER/2048)/100
    else
      EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
    endif
    A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4] := EW1
    A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] := 1
    XMC_F=A_M_NAME[STP_FN,3]
    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
    SET COLOR TO &C2 / &C1
    *MTANK_MARK(6,STP_FN,0)
    IF A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
      DSPA_ARROW(STP_FN,0,0)  && úD
    endif
    SET COLOR TO &C7 +/ &C1
    DO CASE
    CASE UCHTYPE=1
      STP10=4
      DOUT3(0,0)
      X=EWN
      IF KOT=1
	WTANK_F[9,1] :=1
	WTANK_F[10,1] :=1
      ENDIF
    CASE  UCHTYPE=7 .OR. UCHTYPE=9 .OR. UCHTYPE=19
      STP10=4
      DOUT3(0,0)
      X=EWN
      WTANK_F[9,1] :=1
      WTANK_F[10,1] :=1
    CASE (UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .or. UCHTYPE=16  .or. UCHTYPE=17  .or.UCHTYPE=91   .OR. UCHTYPE=10	.OR.  UCHTYPE=11   )
      STP10=4
      X=EWN
      WTANK_F[10,1] :=1
    CASE UCHTYPE=12
      STP10=0
      STP11=2
      X=EWN
      SETDLA(A_M_NAME[STP_FN,8],x)
    ENDCASE
  ENDIF
CASE STP10=4  .AND.    TIME1[STP_FN,1]=88   .and.    SPACIAL_0=0
    STP10=5
CASE STP10=4  .AND.  (WTANK_F[10,1]=-99   )  .AND. DIN(9)=0    .AND. DIN(12)=1
  if ( uchtype=9    .OR.      uchtype=11      )
    if spacial_0=1
      STP10=5
      retu
    endif
  endif
  IF  TIME1[STP_FN,2] =0
    TIME1[STP_FN,2] :=SECONDS()
  ENDIF
  IF ABS(SECONDS()-TIME1[STP_FN,2]) >=TIME1[STP_FN,1]
    STP10=5
    TIME1[STP_FN,2] :=0
  ENDIF
CASE STP10=5	.AND.  ( ( TIME1[STP_FN,1]=88  )  .OR.	( DIN(9)=0    .AND. DIN(12)=1  ))
  DO CASE
  CASE UCHTYPE=1
    WTANK_F[10,1]=0
    *DOUT2(1,0)
    STP10=6
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    SETZER(KLCHN+2,INT(((PZER9/A_M_NAME[KLCHN + 3,6]))*PER*2048)+2048)
    SETZEROK(KLCHN+2)
    SET COLOR TO &C11 / &C1
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0)  .or.  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,8] >0)
      *@ 11,53 SAY   "úLúPúPúKúPúO"
      DSPB_ARROW(KLCHN+3,1,14)	&& úD
    endif
    SET COLOR TO &C7 +/ &C1
    dout2(A_M_NAME[STP_FN,8],1)
  CASE UCHTYPE=7 .OR. UCHTYPE=9
    WTANK_F[10,1]=0
    *DOUT2(1,0)
    STP10=6
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    SETZER(KLCHN+3,INT(((PZER9/A_M_NAME[KLCHN + 4,6]))*PER*2048)+2048)
    SETZEROK(KLCHN+3)
    SET COLOR TO &C11 / &C1
    *@ 11,53 SAY   "úLúPúPúKúPúO"
    DSPB_ARROW(KLCHN+4,1,14)  && úD
    SET COLOR TO &C7 +/ &C1
    dout2(A_M_NAME[STP_FN,8],1)
  CASE	UCHTYPE=19
    WTANK_F[10,1]=0
    *DOUT2(1,0)
    STP10=6
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    SETZER(KLCHN+2,INT(((PZER9/A_M_NAME[KLCHN + 3,6]))*PER*2048)+2048)
    SETZEROK(KLCHN+2)
    SET COLOR TO &C11 / &C1
    *@ 11,53 SAY   "úLúPúPúKúPúO"
    DSPB_ARROW(KLCHN+3,1,14)  && úD
    SET COLOR TO &C7 +/ &C1
    dout2(A_M_NAME[STP_FN,8],1)
  CASE (UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .or. UCHTYPE=16  .or. UCHTYPE=17  .or.UCHTYPE=91   .OR. UCHTYPE=10  .OR.  UCHTYPE=11	 )
    DO CASE
    CASE UCHTYPE=2 .OR. UCHTYPE=26  .or. UCHTYPE=32
      if UCHTYPE=2 .OR. UCHTYPE=26 .or. UCHTYPE=32
	WTANK_F[10,1]=0
      else
	WTANK_F[10,1]=66
	WTANK_F[10,2]=0
      endif
    CASE UCHTYPE=8    .OR. UCHTYPE=10 .or. UCHTYPE=16	 .or. UCHTYPE=17
       IF   (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] =0 )
	 STP10=7
	 STPN10=STPN10+1
	 WTANK_F[10,2] :=1
	 RETU
       ENDIF
    ENDCASE
    IF TIME1[STP_FN,1]=88
      WTANK_F[STP_FN,1] :=66
    ENDIF
    *DOUT2(1,0)
    STP10=6
    *SETZERTM(KLCHN+2,PZERTM9)
    *SETZER(KLCHN+2,INT(((PZER9/A_M_NAME[KLCHN + 3,6]))*PER*2048)+2048)
     xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
     SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    SETZEROK(A_M_NAME[STP_FN,8])
    IF	 (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] >0 )
      IF A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8] >0
	SET COLOR TO &C11 / &C1
	*@ 11,53 SAY   "úLúPúPúKúPúO"
	DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
	SET COLOR TO &C7 +/ &C1
      endif
      dout2(A_M_NAME[STP_FN,8],1)
    ENDIF
  ENDCASE
CASE STP10=6
  JMPF=0
  if UCHTYPE=6 .OR. UCHTYPE=31	.OR.UCHTYPE=30	.OR.UCHTYPE=22	.or.  UCHTYPE=16 .or. UCHTYPE=17 .or. UCHTYPE=26   .or. UCHTYPE=32
    if (  A_PRESS_N0[L_PRESS,1,STP_FN,1]  = 0)
      JMPF=1
    ENDIF
  ENDIF
  IF JMPF=0
    IF	 (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] >0 )
      TST1_LS2(STP_FN)
      IF LS2[STP_FN,2]=1
	RETU
      ENDIF
      TST0_LS1(STP_FN,STP_FN)
    endif
  ELSE
      setZokn(A_M_NAME[STP_FN,8],0)
  ENDIF
  IF  RDZEROK(A_M_NAME[STP_FN,8])=0
    DO CASE
    CASE  UCHTYPE=1
      DOUT3(4,0)
      SETDLA(A_M_NAME[STP_FN,8],0)
      dout2(A_M_NAME[STP_FN,8],0)
      CLEACHMEM(8)
      CLEACHMEM(9)
      STP10=7
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[10,13]  SAY  "     " PICT "&XMC_F"
      @  4,A_M_NAME[9,13]  SAY	"     " PICT "&XMC_F"
      SET COLOR TO &C2 / &C1
      *@ 11,54 SAY   "úLúPúPúPúPúO"
      DSPB_FMK(KLCHN+3,0)
      SET COLOR TO &C7 +/ &C1
      A_M_NAME[9,10] := A_M_NAME[9,9]
      A_M_NAME[KLCHN+3,12] := A_M_NAME[KLCHN+3,6]
      WTANK_F[9,2] :=1
      WTANK_F[10,2] :=1
      WTANK_F[9,1] :=0
      WTANK_F[10,1] :=0
      STPN9=STPN9+1
      STPN10=STPN10+1
    CASE  UCHTYPE=7 .OR. UCHTYPE=9
      DOUT3(4,0)
      SETDLA(A_M_NAME[STP_FN,8],0)
      dout2(A_M_NAME[STP_FN,8],0)
      CLEACHMEM(8)
      CLEACHMEM(9)
      STP10=7
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[10,13]  SAY  "     " PICT "&XMC_F"
      @  4,A_M_NAME[9,13]  SAY	"     " PICT "&XMC_F"
      SET COLOR TO &C2 / &C1
      *@ 11,54 SAY   "úLúPúPúPúPúO"
      DSPB_FMK(KLCHN+4,0)
      SET COLOR TO &C7 +/ &C1
      A_M_NAME[9,10] := A_M_NAME[9,9]
      A_M_NAME[KLCHN+4,12] := A_M_NAME[KLCHN+4,6]
      WTANK_F[9,2] :=1
      WTANK_F[10,2] :=1
      WTANK_F[9,1] :=0
      WTANK_F[10,1] :=0
      STPN9=STPN9+1
      STPN10=STPN10+1
    CASE  UCHTYPE=19
      DOUT3(4,0)
      SETDLA(A_M_NAME[STP_FN,8],0)
      dout2(A_M_NAME[STP_FN,8],0)
      CLEACHMEM(8)
      CLEACHMEM(9)
      STP10=7
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[10,13]  SAY  "     " PICT "&XMC_F"
      @  4,A_M_NAME[9,13]  SAY	"     " PICT "&XMC_F"
      SET COLOR TO &C2 / &C1
      *@ 11,54 SAY   "úLúPúPúPúPúO"
      DSPB_FMK(KLCHN+3,0)
      SET COLOR TO &C7 +/ &C1
      A_M_NAME[9,10] := A_M_NAME[9,9]
      A_M_NAME[KLCHN+3,12] := A_M_NAME[KLCHN+3,6]
      WTANK_F[9,2] :=1
      WTANK_F[10,2] :=1
      WTANK_F[9,1] :=0
      WTANK_F[10,1] :=0
      STPN9=STPN9+1
      STPN10=STPN10+1
    CASE  (UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26 .or. UCHTYPE=32	.OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .or. UCHTYPE=16 .or. UCHTYPE=17   .or.UCHTYPE=91  .OR. UCHTYPE=10	 .OR.  UCHTYPE=11    )
      SETDLA(A_M_NAME[STP_FN,8],0)
      dout2(A_M_NAME[STP_FN,8],0)
      CLEACHMEM(STP_ZN)
      STP10=7
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[10,13]  SAY  "     " PICT "&XMC_F"
      SET COLOR TO &C2 / &C1
      *@ 11,54 SAY   "úLúPúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      A_M_NAME[STP_FN,10] := A_M_NAME[STP_FN,9]
      A_M_NAME[A_M_NAME[STP_FN,8],12] := A_M_NAME[A_M_NAME[STP_FN,8],6]
      WTANK_F[10,2] :=1
      WTANK_F[10,1] :=0
      IF TIME1[STP_FN,1]=88
	WTANK_F[STP_FN,1] :=1
      ENDIF
      IF UCHTYPE=91  .AND. SPACIAL_0 =1
	WTANK_F[10,1] :=2
      ENDIF
      STPN10=STPN10+1
    ENDCASE
  ENDIF
CASE STP10=7 .AND. (WTANK_F[STP_FN,1]=2 .OR.TIME1[STP_FN,1] <>88 .OR. SPACIAL_0=1  )
  DO  CASE
  CASE	UCHTYPE=1 .OR. UCHTYPE=7 .OR. UCHTYPE=9 .OR. UCHTYPE=19
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP9=1
    ELSE
      STP9=0
      STPN9=1
      STPN10=1
      WTANK_F[STP_FN-1,3] :=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
    STP10=0
  CASE	(UCHTYPE=2 .OR. UCHTYPE=31  .OR. UCHTYPE=26  .or. UCHTYPE=32  .OR. UCHTYPE=5 .OR. UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22  .or.UCHTYPE=8  .or. UCHTYPE=16 .or. UCHTYPE=17   .or.UCHTYPE=91 .OR. UCHTYPE=10   .OR.  UCHTYPE=11	   )
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP10=1
    ELSE
      STP10=0
      STPN10=1
      WTANK_F[STP_FN,1] :=0
      WTANK_F[STP_FN,3] :=1
    ENDIF
  ENDCASE
ENDCASE
RETU

**------------------------------------------------------------------------------------------------------------
PROCEDURE  STP11
PARAMETERS  P1,P2,P3
STP_ZN=10
STP_FN=11
STP_FC="11"
DO CASE
CASE (STP11=0)	 .and. (din(14)=1) .AND. (DIN(15)=1)	&&AUTO ,NO PAUSE
  DO  CASE
  CASE (UCHTYPE=1 .OR. UCHTYPE=31  .OR.UCHTYPE=5 .OR.UCHTYPE=7 .or.UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22    .or.UCHTYPE=8  .or. UCHTYPE=16  .or. UCHTYPE=17	.OR. UCHTYPE=26     .or. UCHTYPE=19  ) .AND. NEXTOK1=1

    IF (A_PRESS_N0[1,21,11,1] =77)
      A_PRESS_N0[1,21,11,1] :=0
      a_copy_4(A_PRESS_N0,11,11)
      IF LCHTYPE=16 .or. LCHTYPE=17   .or. UCHTYPE=19	    .OR.  storb_e=1
	a_copy_4(A_PRESS_B0,STP_FN,STP_FN)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP11=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  ENDCASE
CASE (STP11=1)	 .and. (din(14)=1) .AND. (DIN(15)=1)	&&AUTO ,NO PAUSE
  DO  CASE
  CASE (UCHTYPE=1 .OR. UCHTYPE=31  .OR.UCHTYPE=5 .or.UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22	 .OR.UCHTYPE=7 .or.UCHTYPE=8 .or. UCHTYPE=16  .or. UCHTYPE=17  .OR. UCHTYPE=26	  .or. UCHTYPE=19    )
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP11=2

      IF KOT=1
	WTANK_F[11,1] :=77
      ENDIF
    ENDIF
  ENDCASE
CASE STP11=2
  DRAF=0
  DO CASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    DO CASE
    CASE (UCHTYPE=1 .OR. UCHTYPE=31  .OR.UCHTYPE=5 .or.UCHTYPE=6 .OR.UCHTYPE=30   .OR.UCHTYPE=22   .OR.UCHTYPE=7 .or.UCHTYPE=8	.or. UCHTYPE=16 .or. UCHTYPE=17  .OR. UCHTYPE=26     .or. UCHTYPE=19   )
      STP11=4
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[11,1] :=1
    CASE (UCHTYPE=12 )
      STP11=4
      WTANK_F[10,1] :=1
      WTANK_F[11,1] :=1
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    ENDCASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    XMC_F=A_M_NAME[STP_FN,3]
    @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
    IF A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8] >0
      SET COLOR TO &C2	/ &C1
      *MTANK_MARK(6,STP_FN,1)
      DSPA_ARROW(STP_FN,1,14)  && úD
    endif
    do case
    CASE (UCHTYPE=1 .OR. UCHTYPE=31  .OR.UCHTYPE=5 .or.UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22    .OR.UCHTYPE=7 .or.UCHTYPE=8 .or. UCHTYPE=16	.or. UCHTYPE=17  .OR. UCHTYPE=26      .or.UCHTYPE=12 .or. UCHTYPE=19 )
      IF A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8] >0
	SET COLOR TO &C10 / &C1
	*@ 11,67 SAY   "úZúYú["
	DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
    endif
    ENDCASE
    SET COLOR TO &C7 +/ &C1
    CLEACHMEM(STP_ZN)
    SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1]
    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETOK(STP_ZN)
    DOUT(STP_ZN,1)
    STP11=3
  ENDCASE
CASE STP11=3
  TST1_LS1(STP_FN)
  IF LS1[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS2(STP_FN)
      IF RDOK2(STP_ZN)=0
	DOUT(STP_ZN,0)
	STOPTM&STP_FC=0
	DOUT3(0,0)
	EWN=CHENDATA(STP_ZN)
	if uchtype=18	    .OR.  storb_e=1
	  if uchtype=30  .OR. UCHTYPE=31
	    EW1=int(EWN*A_M_NAME[STP_FN,9]*100/PER/2048)/100
	  else
	    EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
	  endif
	  A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] :=  EW1
	endif
	if uchtype=30  .OR. UCHTYPE=31
	  EW1=int(EWN*A_M_NAME[STP_FN,10]*100/PER/2048)/100
	else
	  EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
	endif
	A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4] := EW1
	A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] := 1
	XMC_F=A_M_NAME[STP_FN,3]
	*@  8,A_M_NAME[STP_FN,13]  SAY	EW1   PICT "&XMC_F"
	SET COLOR TO &C2 / &C1
	*MTANK_MARK(6,STP_FN,0)
	DSPA_ARROW(STP_FN,0,0)	&& úD
	SET COLOR TO &C7 +/ &C1
	DO CASE
	CASE (UCHTYPE=1 .OR. UCHTYPE=31  .OR.UCHTYPE=5 .or.UCHTYPE=6 .OR.UCHTYPE=30   .OR.UCHTYPE=22   .OR.UCHTYPE=7 .or.UCHTYPE=8  .or. UCHTYPE=16  .or. UCHTYPE=17  .OR. UCHTYPE=26	  .or. UCHTYPE=19  )
	  STP11=4
	  X=EWN
	  IF TIME1[STP_FN,1] <>88
	    WTANK_F[11,1] :=1
	  ENDIF
	CASE (UCHTYPE=1 .OR. UCHTYPE=31  .OR.UCHTYPE=5 .or.UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22    .OR.UCHTYPE=7 .or.UCHTYPE=8  .or. UCHTYPE=16  .or. UCHTYPE=17  .OR. UCHTYPE=26	 .or.UCHTYPE=12 .or. UCHTYPE=19 )
	  STP11=4
	  X=EWN
	  WTANK_F[10,1] :=1
	  WTANK_F[11,1] :=1
	ENDCASE
      ENDIF
CASE STP11=4  .AND. TIME1[STP_FN,1]=88	.and.	 SPACIAL_0=0
    STP11=5
CASE STP11=4  .AND.  ((WTANK_F[11,1]=-99)  )  .AND. DIN(9)=0	.AND. DIN(12)=1
  if ( uchtype=12      )
    if spacial_0=1
      STP11=5
      retu
    endif
  endif
  IF  TIME1[STP_FN,2] =0
    TIME1[STP_FN,2] :=SECONDS()
  ENDIF
  IF  STPN11 <=STPN7
    IF (ABS(SECONDS()-TIME1[STP_FN,2]) >=TIME1[STP_FN,1] ) .OR. (TIME1[STP_FN,1]=88 )
      STP11=5
      TIME1[STP_FN,2] :=0
    ENDIF
  ENDIF
CASE STP11=5 .AND.  ( ( TIME1[STP_FN,1]=88  )  .OR.  ( DIN(9)=0    .AND. DIN(12)=1  ))
  DO  CASE
  CASE UCHTYPE=12
  OTHER
  IF   (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    STP11=7
    STPN11=STPN11+1
    WTANK_F[11,2] :=1
    RETU
  ENDIF
  ENDCASE
  do  case

  case (UCHTYPE=1 .OR. UCHTYPE=31  .OR.UCHTYPE=5 .or.UCHTYPE=6 .OR.UCHTYPE=30  .OR.UCHTYPE=22	 .OR.UCHTYPE=7 .or.UCHTYPE=8  .or. UCHTYPE=16  .or. UCHTYPE=17	.OR. UCHTYPE=26   .or.UCHTYPE=12  )
    *WTANK_F[11,1]=0
    IF	TIME1[STP_FN,1]=88
      WTANK_F[11,1]=66
    ENDIF
    *DOUT2(1,0)
    STP11=6
    IF A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8] >0
      SET COLOR TO &C11 / &C1
      *@ 11,67 SAY   "úLúKúO"
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
      SET COLOR TO &C7 +/ &C1
    endif
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    XZ=INT(((PZER11/A_M_NAME[KLCHN + 4,6]))*PER*2048)+2048
    *SETZER(KLCHN+3,XZ)
    SETZEROK(A_M_NAME[STP_FN,8])
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] >0 )
      dout2(A_M_NAME[STP_FN,8],1)
    endif
  case UCHTYPE=19
    *WTANK_F[11,1]=0
    IF	TIME1[STP_FN,1]=88
      WTANK_F[11,1]=1
    ENDIF
    *DOUT2(1,0)
    STP11=6
    SET COLOR TO &C11 / &C1
    *@ 11,67 SAY   "úLúKúO"
    DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    SET COLOR TO &C7 +/ &C1
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    XZ=INT(((PZER11/A_M_NAME[KLCHN + 4,6]))*PER*2048)+2048
    SETZER(KLCHN+3,XZ)
    SETZEROK(A_M_NAME[STP_FN,8])
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] >0 )
      dout2(A_M_NAME[STP_FN,8],1)
    endif
  ENDcase
CASE STP11=6
  IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] >0 )
    TST1_LS2(STP_FN)
    IF LS2[STP_FN,2]=1
      RETU
    ENDIF
  else
    if	 UCHTYPE=26
      setZokn(A_M_NAME[STP_FN,8],0)
    endif
  ENDIF
  TST0_LS1(STP_FN,STP_FN)
  IF  RDZEROK(A_M_NAME[STP_FN,8])=0
      DOUT3(4,0)
      dout2(A_M_NAME[STP_FN,8],0)
      STP11=7
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[11,13]  SAY  "     " PICT "&XMC_F"
      SET COLOR TO &C2 / &C1
      *@ 11,67 SAY   "úLúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      IF TIME1[STP_FN,1]=88
	WTANK_F[STP_FN,1] :=1
      ENDIF
    do	case
    case (UCHTYPE=1 .OR. UCHTYPE=31  .OR.UCHTYPE=5 .or.UCHTYPE=6 .OR.UCHTYPE=30   .OR.UCHTYPE=22   .OR.UCHTYPE=7 .or.UCHTYPE=8 .or. UCHTYPE=16	 .or. UCHTYPE=17  .OR. UCHTYPE=26   .or. UCHTYPE=19  )
      STPN11=STPN11+1
      CLEACHMEM(10)
      WTANK_F[11,2] :=1
    case (UCHTYPE=12 )
      CLEACHMEM(10)
      CLEACHMEM(11)
      WTANK_F[11,2] :=1
      WTANK_F[10,2] :=1
      WTANK_F[11,1] :=0
      WTANK_F[10,1] :=0
      STPN11=STPN11+1
      STPN10=STPN11
      IF TIME1[STP_FN,1]=88
	WTANK_F[10,1] :=1
	WTANK_F[11,1] :=1
	WTANK_F[STP_FN,1] :=1
      ENDIF
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[10,13]  SAY  "     " PICT "&XMC_F"
      @  4,A_M_NAME[11,13]  SAY  "     " PICT "&XMC_F"
    endcase
  ENDIF
CASE STP11=7 .AND. (WTANK_F[11,1] =2  .OR. TIME1[STP_FN,1] <>88  .OR. SPACIAL_0=1   )
  do case
  case	(UCHTYPE=1 .OR. UCHTYPE=31  .OR.UCHTYPE=5 .or.UCHTYPE=6 .OR.UCHTYPE=30	 .OR.UCHTYPE=22   .OR.UCHTYPE=7 .or.UCHTYPE=8 .or. UCHTYPE=16  .or. UCHTYPE=17 .OR. UCHTYPE=26	   .or. UCHTYPE=19  )
    WTANK_F[11,1] :=0
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
	STP11=1
    else
       STP11=0
       STPN11=1
       WTANK_F[STP_FN,3] :=1
    endif
  CASE	UCHTYPE=12
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP10=1
      STP11=0
    ELSE
      STP10=0
      STP11=0
      STPN10=1
      STPN11=1
      WTANK_F[STP_FN-1,3] :=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  endcase
ENDCASE
RETU

**------------------------------------------------------------------------------------------------------------
PROCEDURE  STP12
PARAMETERS  P1,P2,P3
STP_ZN=11
STP_FN=12
STP_FC="12"
DO CASE
CASE (STP12=0)	 .and. (din(14)=1) .AND. (DIN(15)=1)	&&AUTO ,NO PAUSE
  DO  CASE
  CASE (UCHTYPE=1 .or. UCHTYPE=16 .OR.UCHTYPE=22  .or. UCHTYPE=19  ) .AND. NEXTOK1=1
    IF (A_PRESS_N0[1,21,12,1] =77)
      A_PRESS_N0[1,21,12,1] :=0
      a_copy_4(A_PRESS_N0,12,12)
      IF LCHTYPE=16 .or. LCHTYPE=17    .or. UCHTYPE=19
	a_copy_4(A_PRESS_B0,STP_FN,STP_FN)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP12=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  ENDCASE
CASE (STP12=1)	 .and. (din(14)=1) .AND. (DIN(15)=1)	&&AUTO ,NO PAUSE
  DO  CASE
  CASE UCHTYPE=1  .or. UCHTYPE=16 .OR.UCHTYPE=22  .or. UCHTYPE=19
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      STP12=2
      IF KOT=1
	WTANK_F[12,1] :=77
      ENDIF
    ENDIF
  ENDCASE
CASE STP12=2
  DRAF=0
  DO CASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    DO CASE
    CASE UCHTYPE=1   .or. UCHTYPE=16 .OR.UCHTYPE=22  .or. UCHTYPE=19
      STP12=4
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      WTANK_F[12,1] :=1
    ENDCASE
  CASE (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    XMC_F=A_M_NAME[STP_FN,3]
    @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,8] PICT "&XMC_F"
    SET COLOR TO &C2  / &C1
    *MTANK_MARK(6,STP_FN,1)
    DSPA_ARROW(STP_FN,1,14)  && úD
    do case
    CASE UCHTYPE=1 .or. UCHTYPE=19
      SET COLOR TO &C10 / &C1
      *@ 11,73 SAY   "úZúYú["
      DSPB_FMK(KLCHN+5,1)
    CASE  UCHTYPE=16  .OR.UCHTYPE=22
      SET COLOR TO &C10 / &C1
      *@ 11,73 SAY   "úZúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
    ENDCASE
    SET COLOR TO &C7 +/ &C1
    CLEACHMEM(STP_ZN)
    SW1=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1]
    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETOK(STP_ZN)
    DOUT(STP_ZN,1)
    STP12=3
  ENDCASE
CASE STP12=3
  TST1_LS1(STP_FN)
  IF LS1[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS2(STP_FN)
      IF RDOK2(STP_ZN)=0
	DOUT(STP_ZN,0)
	STOPTM&STP_FC=0
	DOUT3(0,0)
	EWN=CHENDATA(STP_ZN)
	if uchtype=18	     .OR.  storb_e=1
	  EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
	  A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] :=  EW1
	endif
	EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
	A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,4] := EW1
	A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,7] := 1
	XMC_F=A_M_NAME[STP_FN,3]
	*@  8,A_M_NAME[STP_FN,13]  SAY	EW1   PICT "&XMC_F"
	SET COLOR TO &C2 / &C1
	*MTANK_MARK(6,STP_FN,0)
	DSPA_ARROW(STP_FN,0,0)	&& úD
	SET COLOR TO &C7 +/ &C1
	TIME1[STP_FN,2] :=0
	DO CASE
	CASE UCHTYPE=1 .or. UCHTYPE=16 .OR.UCHTYPE=22  .or. UCHTYPE=19
	  STP12=4
	  X=EWN
	  IF  TIME1[STP_FN,1] <>88
	    WTANK_F[12,1] :=1
	  ENDIF
	CASE UCHTYPE=14
	  STP12=4
	  X=EWN
	  WTANK_F[12,1] :=1
      ENDCASE
      ENDIF
CASE UCHTYPE=16 .OR.UCHTYPE=22	.AND. STP12=4  .AND.   TIME1[STP_FN,1]=88
      STP12=5
CASE STP12=4  .AND.  ((WTANK_F[12,1]=-99) .OR. TIME1[STP_FN,1]=88  )   .AND. DIN(9)=0	 .AND. DIN(12)=1
  IF  TIME1[STP_FN,2] =0
    TIME1[STP_FN,2] :=SECONDS()
  ENDIF
  IF  (DIN(9)=0)   .AND.  (STPN12 <= STPN7 )
    IF (ABS(SECONDS()-TIME1[STP_FN,2]) >=TIME1[STP_FN,1] ) .OR. (TIME1[STP_FN,1]=88 )
      STP12=5
      TIME1[STP_FN,2] :=0
    ENDIF
  ENDIF
CASE STP12=5	.AND. DIN(12)=1
  IF   (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    STP12=7
    STPN12=STPN12+1
    WTANK_F[12,2] :=1
    RETU
  ENDIF
  IF UCHTYPE=1	 .or. UCHTYPE=16 .OR.UCHTYPE=22    .or. UCHTYPE=17    .or. UCHTYPE=19
    *WTANK_F[12,1]=0
    IF	TIME1[STP_FN,1]=88
      WTANK_F[12,1]=66
    ENDIF
    *DOUT2(1,0)
    STP12=6
    SET COLOR TO &C11 / &C1
    *@ 11,73 SAY   "úLúKúO"
    *DSPB_ARROW(KLCHN+5,1,14)  && úD
    DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    SET COLOR TO &C7 +/ &C1
    xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))
    SETZERTM(A_M_NAME[STP_FN,8],PZERTM&xc)
    SETZER(KLCHN+4,INT(((PZER12/A_M_NAME[KLCHN + 5,6]))*PER*2048)+2048)
    SETZEROK(A_M_NAME[STP_FN,8])
    IF (A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,1] >0 )
      dout2(A_M_NAME[STP_FN,8],1)
    ENDIF
  ENDIF
CASE STP12=6
  TST1_LS2(STP_FN)
  IF LS2[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS1(STP_FN,STP_FN)
  DO CASE
  CASE UCHTYPE=1 .or. UCHTYPE=19
    IF	RDZEROK(KLCHN+4)=0
      DOUT3(4,0)
      dout2(A_M_NAME[STP_FN,8],0)
      WTANK_F[12,2] :=1
      CLEACHMEM(11)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[12,13]  SAY  "     " PICT "&XMC_F"
      STP12=7
      SET COLOR TO &C2 / &C1
      *@ 11,73 SAY   "úLúPúO"
      DSPB_FMK(KLCHN+5,0)
      SET COLOR TO &C7 +/ &C1
      STPN12=STPN12+1
    ENDIF
  CASE UCHTYPE=22
    IF	RDZEROK(KLCHN+5)=0
      DOUT3(4,0)
      dout2(A_M_NAME[STP_FN,8],0)
      WTANK_F[12,2] :=1
      CLEACHMEM(11)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[12,13]  SAY  "     " PICT "&XMC_F"
      STP12=7
      SET COLOR TO &C2 / &C1
      *@ 11,73 SAY   "úLúPúO"
      DSPB_FMK(KLCHN+6,0)
      SET COLOR TO &C7 +/ &C1
      STPN12=STPN12+1
      IF TIME1[STP_FN,1]=88
	WTANK_F[STP_FN,1] :=1
      ENDIF
    ENDIF
  CASE UCHTYPE=16    .or. UCHTYPE=17
    IF	RDZEROK(KLCHN+6)=0
      DOUT3(4,0)
      dout2(A_M_NAME[STP_FN,8],0)
      WTANK_F[12,2] :=1
      CLEACHMEM(11)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[12,13]  SAY  "     " PICT "&XMC_F"
      STP12=7
      SET COLOR TO &C2 / &C1
      *@ 11,73 SAY   "úLúPúO"
      *DSPB_FMK(KLCHN+5,0)
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      STPN12=STPN12+1
    ENDIF
  ENDCASE
CASE STP12=7 .AND. (WTANK_F[12,1] =2  .OR. TIME1[STP_FN,1] <>88  )
  WTANK_F[12,1] :=0
  IF  UCHTYPE=1 .or. UCHTYPE=16 .OR.UCHTYPE=22	.or. UCHTYPE=17   .or. UCHTYPE=19
    IF	(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
      STP12=1
    ELSE
      STP12=0
      STPN12=1
      WTANK_F[STP_FN,3] :=1
    ENDIF
  ENDIF
ENDCASE
RETU

**------------------------------------------------------------------------------------------------------------
PROCEDURE  TANKSTPAU  &&¥þ¤W
PARAMETERS  P1,P2,P3
DO CASE
CASE   TANKSTP=0
  STORTIME=TIME()
  IF (KOT=1).AND. (DIN(12)=1) .AND. (DIN(15)=1)
    FOR XF=1 TO (GS_TOT+UWC_TOT)
      TANKSTP=1
      IF PLOT_E=1
	BMP_SN[2] :=SECONDS()
	DO PLOT_MIXAS
      ENDIF
      UPOV=0
      DNOV=0
      IF (WTANK_F[XF,1]<>1)
	IF (TIME1[XF,1] <>88)
	  TANKSTP=0
	  UPOV=0
	  DNOV=0
	  EXIT
	ELSE
	  IF WTANK_F[XF,1]=77
	    TANKSTP=0
	  ENDIF
	ENDIF
      ENDIF
    NEXT
    IF TANKSTP=1
      IF DIN(9)=1
	SET COLOR TO  R   / &C1
	@ 18,40 SAY "úLúPúPúPúPúPúPúPúPúPúPúPúPúPúPúPúPúPúO "
	SET COLOR TO &C7 +/ &C1
	TANKSTP=0
      ENDIF
    ENDIF
    IF (TANKSTP=1)   .AND.  (MIX_ERR=1)
      TANKSTP=0
    ENDIF
    IF TANKSTP=1
      FOR  I=1	TO  10
	WTANK_F[I,1] :=0
	WTANK_F[I,2] :=0
      NEXT
      IF TIME1[11,1] <>88
	WTANK_F[11,1] :=0
	WTANK_F[11,2] :=0
      ENDIF
      IF TIME1[12,1] <>88
	WTANK_F[12,1] :=0
	WTANK_F[12,2] :=0
      ENDIF
      if spacial_0=0
	if lchtype >= 5
	  IF LAGDATE=DATE()
	    LAGW=LAGW+ A_PRESS_N0[U_PRESS,stpn6,6,5]
	  ELSE
	    LAGW=VUSE
	    LAGDATE=DATE()
	  ENDIF
	  SAVE TO LAGDATA9 ALL LIKE LAG*
	  @ 0,26 SAY  LAGW   PICT  "9999.9"
	  ACT_V  = A_PRESS_N0[U_PRESS,stpn6,6,6]    &&4/6/2004
	  @ 17,12 SAY  A_PRESS_N0[U_PRESS,stpn6,6,6]  PICT  "99.9"
	endif
      endif
      X=_Tot_d_a[20,4] +2
      @ 15,12 say _Tot_d_a[18,X]  PICT	"9999"
      @ 16,12 say _Tot_d_a[10,X]  PICT	"99.9"
      IF STPN1=1
	@ 23,13 SAY ASCANO  PICT "99999"
	@ 23,25 SAY ACARNO
	@ 23,42 SAY ARATNO  PICT "9999"
	@ 23,52 SAY AVUSE   PICT "99.9"
	@ 23,61 SAY ATANDO  PICT "9999"
	@ 23,75 SAY ACALW_REP  PICT "99"
	E_STORE = 1
	X=_TOT_D_A[20,4] +2
	IF _TOT_D_A[2,X]=0
	  E_STORE = 0
	ENDIF
	IF  E_STORE =1
	   DO  PNT_TIT
	ENDIF
      ENDIF
      IF (HDOK=1) .AND.( FILE("C:\LUW1.DBF")=.T.)  .and.(INT(DISKSPACE( DAA )/1024) >250 )
	E_STORE = 1
	X=_TOT_D_A[20,4] +2
	IF _TOT_D_A[2,X]=0
	  E_STORE = 0
	ENDIF
	IF   E_STORE = 1
	  sele 1
	  APPE BLAN
	  REPL LUTIME  WITH STORTIME,LUDATE WITH DATE(),LAG_VUSE WITH A_PRESS_N0[2,STPN1,1,6]
	  X=_TOT_D_A[20,4] +2
	  REPL SCANO WITH _TOT_D_A[2,X],CARNO WITH _TOT_D_A[13,X],TVUSE  WITH A_PRESS_N0[2,STPN1,1,5] ,RATNO WITH _TOT_D_A[18,X],LTANDO WITH _TOT_D_A[14,X]
	  *REPL PAN_NO	WITH  STPN1,LAGNO1 WITH LAG_PNO
	  REPL PAN_NO  WITH  STPN1,LAGNO1 WITH _TOT_D_A[19,X]
	  IF COM_E=1
	    REPL    SCANO2  WITH  _TOT_D_A[17,X]     && S_MAX
	  ENDIF
	  IF  STORAB_D=1
	    sele 19
	    APPE BLAN
	    REPL LUTIME  WITH  STORTIME,LUDATE WITH DATE(),LAG_VUSE WITH A_PRESS_N0[3,STPN1,1,6]
	    X=_TOT_D_A[20,4] +2
	    REPL SCANO WITH _TOT_D_A[2,X],CARNO WITH _TOT_D_A[13,X],TVUSE  WITH A_PRESS_N0[3,STPN1,1,5] ,RATNO WITH _TOT_D_A[18,X],LTANDO WITH _TOT_D_A[14,X]
	    REPL PAN_NO  WITH  STPN1,LAGNO1 WITH  _TOT_D_A[19,X]     && LAG_PNO
	    IF COM_E=1
	      REPL    SCANO2  WITH  _TOT_D_A[17,X]     && S_MAX
	    ENDIF
	  ENDIF

	ENDIF
      ELSE
	ACTIME=TIME()
	HDOK=0
      ENDIF
      XTW=0
      DO OUTDATA_RST
      IF (HDOK=1) .AND.( FILE("C:\LUW1.DBF")=.T.)  .and.(INT(DISKSPACE( DAA )/1024) >250 )
	IF   E_STORE = 1
	  IF  STORAB_D=1
	    sele 19
	    FOR X=1 TO (GS_TOT+UWC_TOT)
	      XMC_F=A_M_NAME[X,3]
	      IF LCHTYPE=1411
		XTW=XTW+A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,11]
	      ELSE
		XTW=XTW+A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,2]
	      ENDIF
	      XMC1=ALLTRIM(STR(X,2,0))
	      IF LCHTYPE=1411
		repl TM&XMC1 WITH A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,11]
	      ELSE
		repl TM&XMC1 WITH A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,2]
	      ENDIF
	    NEXT
	    if	lchtype=14  .and. (pnt_water=1 )
	     *	repl adjTM1 WITH  G1_WATER
	     *	repl adjTM2 WITH  G2_WATER
	     *	repl adjTM3 WITH  S1_WATER
	     *	repl adjTM4 WITH  S2_WATER
	    endif
	 ENDIF
	  sele 1
	  FOR X=1 TO (GS_TOT+UWC_TOT)
	    XMC_F=A_M_NAME[X,3]
	    IF W0DBF=1
	      *A_PRESS_N0[2,STPN1,X,1] =A_PRESS_N0[2,STPN1,X,8]
	    ENDIF
	    IF LCHTYPE=1411
	      XTW=XTW+A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,11]
	    ELSE
	      IF W0DBF=1
		XTW=XTW+A_PRESS_N0[2,STPN1,X,8]+A_PRESS_N0[2,STPN1,X,2]
	      ELSE
		XTW=XTW+A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,2]
	      ENDIF
	    ENDIF
	    XMC1=ALLTRIM(STR(X,2,0))
	    IF LCHTYPE=1411
	      repl TM&XMC1 WITH A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,11]
	    ELSE
	      IF W0DBF=1
		repl TM&XMC1 WITH A_PRESS_N0[2,STPN1,X,8]+A_PRESS_N0[2,STPN1,X,2]
	      ELSE
		repl TM&XMC1 WITH A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,2]
	      ENDIF
	    ENDIF
	  NEXT
	  if  lchtype=14  .and. (pnt_water=1 )
	   *  repl adjTM1 WITH	G1_WATER
	   *  repl adjTM2 WITH	G2_WATER
	   *  repl adjTM3 WITH	S1_WATER
	   *  repl adjTM4 WITH	S2_WATER
	  endif
	ENDIF
      ELSE
	HDOK=0
      ENDIF
      IF ERROR_LINK=0
	C1_DATA=""
	FOR X=1 TO (GS_TOT+UWC_TOT)
	  XMC_F=A_M_NAME[X,3]
	  IF LCHTYPE=1411
	    XTW=XTW+A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,11]
	  ELSE
	    XTW=XTW+A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,2]
	  ENDIF
	  XMC1=ALLTRIM(STR(X,2,0))
	  IF LCHTYPE=1411
	    C1_DATA=C1_DATA + TM&XMC1 + " " +  STR(A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,11],6,2) + " "
	  ELSE
	    C1_DATA=C1_DATA + TM&XMC1 + " " +  STR(A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,2],6,2) + " "
	  ENDIF
	NEXT
	X=STR(LEN(C1_DATA),100)
	C1_DAT=X + " " + C1_DATA
	COM_SEND(0,C1_DATA)
      ENDIF
      IF (HDOK=1) .AND.( FILE("C:\LUW1.DBF")=.T.)  .and.(INT(DISKSPACE( DAA )/1024) >250 )
	IF   E_STORE = 1
	  sele 1
	  APPE BLANK
	  X=_TOT_D_A[20,4] +2
	  REPL LUTIME  WITH STORTIME,LUDATE WITH DATE(),LAGNO1 WITH  _TOT_D_A[19,X]	&&LAG_PNO
	  IF COM_E=1
	    REPL    SCANO2  WITH  _TOT_D_A[17,X]     && S_MAX
	  ENDIF
	  FOR X=1 TO (GS_TOT+UWC_TOT)
	    XMC_F=A_M_NAME[X,3]

	    IF LCHTYPE=1411
	      XTW=XTW+A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,11]
	    ELSE
	      XTW=XTW+A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,2]
	    ENDIF
	    sele 1
	    XMC1=ALLTRIM(STR(X,2,0))
	    repl TM&XMC1 WITH A_PRESS_N0[2,STPN1,X,4]
	  NEXT
	  IF  STORAB_D=1
	    sele 19
	    APPE BLANK
	    X=_TOT_D_A[20,4] +2
	    REPL LUTIME  WITH STORTIME,LUDATE WITH DATE(),LAGNO1 WITH  _TOT_D_A[19,X]	  &&LAG_PNO
	    IF COM_E=1
	      REPL    SCANO2  WITH  _TOT_D_A[17,X]     && S_MAX
	    ENDIF
	    FOR X=1 TO (GS_TOT+UWC_TOT)
	      XMC_F=A_M_NAME[X,3]

	      IF LCHTYPE=1411
		XTW=XTW+A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,11]
	      ELSE
		XTW=XTW+A_PRESS_N0[2,STPN1,X,1]+A_PRESS_N0[2,STPN1,X,2]
	      ENDIF
	      XMC1=ALLTRIM(STR(X,2,0))
	      *repl TM&XMC1 WITH A_PRESS_N0[2,STPN1,X,4]
	      if uchtype=18
		repl TM&XMC1 WITH A_PRESS_b0[2,STPN1,X,4]
	      else
		repl TM&XMC1 WITH A_PRESS_N0[2,STPN1,X,4]
	      endif
	    NEXT
	  ENDIF
	ENDIF
      ELSE
	HDOK=0
      ENDIF
      XTW=0
      FOR X=1 TO (GS_TOT+UWC_TOT)
	XMC_F=A_M_NAME[X,3]
	XTW=XTW+A_PRESS_N0[2,STPN1,X,4]
      NEXT
      IF A_PRESS_N0[2,STPN1+1,1,5]  =0
	XTWA=0
	XTWBA=0
	IF (HDOK=1) .AND.( FILE("C:\SA.DBF")=.T.)  .and.(INT(DISKSPACE( DAA )/1024) >250 )
	  IF   E_STORE = 1
	    SELE 7
	    APPEN BLAN
	    COMMIT
	    IF STORAB=1
	      SELE 18
	      APPEN BLAN
	      COMMIT
	    ENDIF
	  ENDIF
	ELSE
	  HDOK=0
	ENDIF
	FOR X=1 TO (GS_TOT+UWC_TOT)
	  XMC_F="9"+A_M_NAME[X,3]
	  XTW=0
	  XTWB=0
	  FOR XN1=1 TO STPN1
	    XTW=XTW+A_PRESS_N0[2,XN1,X,4]
	    XTWB=XTWB+A_PRESS_N0[2,XN1,X,10]
	  NEXT
	  IF (HDOK=1) .AND.( FILE("C:\SA.DBF")=.T.)  .and.(INT(DISKSPACE( DAA )/1024) >250 )
	    IF	 E_STORE = 1
	      SELE 7
	      XMC1=ALLTRIM(STR(X,2,0))
	      REPL TOTM&XMC1 WITH XTW
	      COMMIT
	      IF (STORAB=1)
		 SELE 18
		 REPL TOTM&XMC1 WITH XTWB
		 COMMIT
	      ENDIF
	    ENDIF
	  ELSE
	    HDOK=0
	  ENDIF
	  XTWA=XTWA+XTW
	  XTWBA=XTWBA+XTWB
	NEXT
	SET DEVI TO SCRE
	IF (HDOK=1) .AND.( FILE("C:\SA.DBF")=.T.)  .and.(INT(DISKSPACE( DAA )/1024) >250 )
	  IF   E_STORE = 1
	    SELE 7
	    REPL TOTW WITH XTWA
	    X=_TOT_D_A[20,4] +2
	    REPL SCANO WITH _TOT_D_A[2,X],CARDRV WITH _TOT_D_A[15,X],US2 WITH _TOT_D_A[16,X],LAGTTW WITH _TOT_D_A[11,X],TANDO WITH _TOT_D_A[14,X]
	    repl  p1702  with  _TOT_D_A[4,X],TOTVUSE WITH A_PRESS_N0[2,STPN1,1,6]
	    REPL LUDATE WITH DATE(),LUTIME WITH STORTIME,RATNO WITH  _TOT_D_A[18,X]
	    repl  U_PRICE WITH _TOT_D_A[21,X],CARNO WITH _TOT_D_A[13,X]
	    COMMIT
	    IF STORAB=1
	      IC_X="1"
	      SELE 18
	      REPL TOTW WITH XTWBA
	      REPL SCANO WITH _TOT_D_A[2,X],CARDRV WITH _TOT_D_A[15,X],US2 WITH _TOT_D_A[16,X],LAGTTW WITH _TOT_D_A[11,X],TANDO WITH _TOT_D_A[14,X]
	      repl  p1702  with  _TOT_D_A[4,X],TOTVUSE WITH A_PRESS_N0[2,STPN&IC_X,1,6]
	      REPL LUDATE WITH DATE(),LUTIME WITH STORTIME,RATNO WITH  _TOT_D_A[18,X]
	      repl  U_PRICE WITH _TOT_D_A[21,X],CARNO WITH _TOT_D_A[13,X],LAGNO1 WITH  _TOT_D_A[19,X]  &&LAG_PNO
	      IF COM_E=1
		REPL	SCANO2	WITH  _TOT_D_A[17,X]	 && S_MAX
	      ENDIF
	      COMMIT
	    ENDIF
	  ENDIF
	ELSE
	  HDOK=0
	ENDIF
	kont=0
	PRINTERTST=0
	DO  PRINTERTST	 WITH	BPORT
	IF PRINTERTST=1 .AND. (NSCANO2<>0)   .AND. (VAL(C_PRT_REP) <>0 )
	  SET CONS Off
	  do case
	  case bport="1"
	    set print to lpt1
	    ? chr(27) + "sp1;"
	  case bport="2"
	    set print to lpt2
	    ? chr(27) + "sp2;"
	  case bport="3"
	    set print to lpt3
	    ? chr(27) + "sp3;"
	  endcase
	  SET CONS ON
	  SET DEVI TO PRINT
	  @ PROW(),0 say    "~I;"
	  @ PROW(),0 say   "~X12;"
	  DO REP_&C_PRT_REP
	  SET DEVI TO SCRE
	  *SET CONS Off
	ENDIF
      ENDIF
      PRINTERTST=0
      DO  PRINTERTST	 WITH	APORT
      IF (PRINTERTST=1 )  .AND.  (E_STORE = 1)
	SET CONS Off
	do case
	case aport="1"
	  set print to lpt1
	  ? chr(27) + "SP1;"
	case aport="2"
	  set print to lpt2
	  ? chr(27) + "SP2;"
	case aport="3"
	  set print to lpt3
	  ? chr(27) + "SP3;"
	endcase
	SET CONS On
	SET DEVI TO PRINT
	@ PROW(),0   say  "~I;"
	@ PROW(),0 say	 "~X12;"
	@ PROW(),6  SAY  STPN1	PICT "99"
	@ PROW(),10    SAY  TIME()
	@ PROW(),18    SAY  A_PRESS_N0[2,STPN1,1,5]  PICT "99.9"
	@ PROW(),25    SAY  A_PRESS_N0[2,STPN1,1,6]  PICT "99.9"
	@ PROW()+1,1  SAY  " "
	IF   (UCHTYPE=13) .and.  (pnt_water=1)
	  @ PROW(),65  SAY   "°t¤ñ"
	  XTW=0
	  FOR  X=1 TO GS_TOT+UWC_TOT
	    XMC_F=A_M_NAME[X,3]
	    XTW=XTW+A_PRESS_N0[2,STPN1,X,8]
	    @ PROW(),6*(X-1)+2	SAY   A_PRESS_N0[2,STPN1,X,8]	PICT "&XMC_F"
	  NEXT
	  @ PROW(),74  SAY   XTW  PICT "99999"
	  @ PROW()+1,1	SAY  " "
	endif
	IF  ((UCHTYPE=13) .and.  (pnt_water=1)) .or. (UCHTYPE <> 13) .or. ((LCHTYPE =14) .AND.	  (UCHTYPE = 13) )
	  XTW=0
	  FOR  X=1 TO GS_TOT+UWC_TOT
	    XMC_F=A_M_NAME[X,3]
	    IF LCHTYPE=14
	      XTW=XTW+A_PRESS_N0[2,STPN1,X,8]+A_PRESS_N0[2,STPN1,X,11]
	    ELSE
	      XTW=XTW+A_PRESS_N0[2,STPN1,X,8]+A_PRESS_N0[2,STPN1,X,2]
	    ENDIF
	    IF LCHTYPE=14
	      @ PROW(),6*(X-1)+2  SAY	A_PRESS_N0[2,STPN1,X,8]+A_PRESS_N0[2,STPN1,X,11]   PICT "&XMC_F"
	    ELSE
	      @ PROW(),6*(X-1)+2  SAY	A_PRESS_N0[2,STPN1,X,8]+A_PRESS_N0[2,STPN1,X,2]   PICT "&XMC_F"
	    ENDIF
	  NEXT
	  @ PROW(),74  SAY   XTW  PICT "99999"
	  @ PROW()+1,1	SAY  " "
	endif
	IF   (UCHTYPE=13) .and.  (pnt_water=1)
	  sele 1
	  skip -1
	  FOR  X=1 TO  GS_TOT
	    IC_X=ALLTRIM(STR(x,2,0))
	    xperc= INT(A_PRESS_N0[2,STPN&IC_X,X,2]*1000/A_PRESS_N0[2,STPN&IC_X,X,1])/10
	    *xperc= adjtm&ic_x
	    repl  adjtm&ic_x   with    xperc
	    @ PROW(),6*(X-1)+1	SAY   xperc  PICT "999.9"
	  NEXT
	  @ PROW(),75  SAY   "§t¤ô²v¢H"
	  @ PROW()+1,1	SAY  " "
	  skip
	ENDIF

	XTW=0


	FOR  X=1 TO GS_TOT+UWC_TOT
	  XMC_F=A_M_NAME[X,3]
	  XTW=XTW+A_PRESS_N0[2,STPN1,X,4]
	  @ PROW(),6*(X-1)+2  SAY   A_PRESS_N0[2,STPN1,X,9]  PICT "&XMC_F"
	NEXT
	@ PROW(),74  SAY   XTW	PICT "99999"
	@ PROW()+1,1  SAY  " "
	IF A_PRESS_N0[2,STPN1+1,1,5]  =0
	  @ PROW(),1 SAY   "-----------------------------------------------------------------------------"
	  @ PROW()+1,1	SAY  " "
	  XTWA=0
	  FOR  X=1 TO GS_TOT+UWC_TOT
	    XMC_F="9"+A_M_NAME[X,3]
	    XTW=0
	    FOR XN1=1 TO STPN1
	      XTW=XTW+A_PRESS_N0[2,XN1,X,9]
	    NEXT
	    @ PROW(),6*(X-1)+1	SAY   XTW   PICT "&XMC_F"
	    XTWA=XTWA+XTW
	  NEXT
	  @ PROW(),73  SAY   XTWA  PICT "999999"
	  @ PROW()+1,1	SAY   " "
	ENDIF
	SET CONS On
	SET DEVI TO SCRE
      endif
      IF A_PRESS_N0[2,STPN1+1,1,5]  =0
	x=1
	IF X=1
	  X=_TOT_D_A[20,3]
	  IF X=0
	    _TOT_D_A[20,4] :=0
	  ELSE
	    _TOT_D_A[20,4] :=X
	    _TOT_D_A[20,3] :=0
	  ENDIF
	ENDIF

      ENDIF
      SET CONS ON
    ENDIF
    SET COLOR TO &C5 +/ &C1
    *@ 14,52 SAY "²V¦X   ²V¦X   ¶}ªù   §t¤ô"
    *@ 15,0 SAY "1.³]©w°t¤ñ:              "
    *@ 16,0 SAY "2.³]©w¦Ì¼Æ:              "
    *@ 17,0 SAY "3.°õ¦æ¦Ì¼Æ:              "
    *@ 18,0 SAY "4.ºÏºÐ®e¶q:      ,000    "
    *@ 17,48  SAY
    SET COLOR TO &C2 / &C1
  ENDIF
CASE  TANKSTP=1 .AND. (DIN(9)=0)   .AND. (DIN(12)=1)
  TANKSTP=2
  FOR  I=1  TO	10
    WTANK_F[I,1] :=-99
    WTANK_F[I,2] :=-99
  NEXT
  IF TIME1[11,1] <>88
    WTANK_F[11,1] :=-99
    WTANK_F[11,2] :=-99
  ENDIF
  IF TIME1[12,1] <>88
    WTANK_F[12,1] :=-99
    WTANK_F[12,1] :=-99
  ENDIF
  IF (UCHTYPE=15) .AND. (TIME1[9,1] =99)
    WTANK_F[9,1] :=0
  ENDIF
  SET COLOR TO &C10 / &C1
  @ 18,40 SAY "úZúYúYúYúYúYúYúYúYúYúYúYúYúYúYúYúYúYú["
  SET COLOR TO &C7 +/ &C1
  MIXTM=0
  MIXTM_S=SECONDS()
  PAUSE_TM=0
  @ 17,64 SAY "   "
CASE  TANKSTP=2
  *@ 17,23 SAY "¢u¢w¢w¢t¢u¢w¢w¢t¢x  ¹ê»Ú­È    ¬í     ¢Ï     ¬í      KG¢x"
  *PMIXTM
  IF DIN(15)=0	 && PAUSE
    MIXTM_S=SECONDS()
  ELSE
    IF ABS(SECONDS()-MIXTM_S)>=1
      MIXTM=MIXTM+1
      MIXTM_S=SECONDS()
    ENDIF
  ENDIF
  X=0
  IF PLOT_ACT=1
    X=1
  ENDIF
  @ 17+X,51 SAY MIXTM  PICT "999"
  IF  MIXTM>=PMIXTM
    TANKSTP=3
  ENDIF
CASE  TANKSTP=3
  TANKSTP=4
  FOR XF=1 TO (GS_TOT+UWC_TOT)
    IF (WTANK_F[XF,2]<>1) .AND. ( TIME1[XF,1]<>99  )
      TANKSTP=3
      EXIT
    ENDIF
  NEXT
  IF TANKSTP=4
    FOR I=1 TO (GS_TOT+UWC_TOT)
      WTANK_F[I,2] :=0
    NEXT
    IF TIME1[11,1] =88
      *WTANK_F[11,1] :=-99
      *WTANK_F[11,2] :=-99
    ENDIF
    IF TIME1[12,1] =88
      *WTANK_F[12,1] :=-99
      *WTANK_F[12,2] :=-99
    ENDIF
  ENDIF
  IF DIN(15)=0	 && PAUSE
    MIXTM_S=SECONDS()
  ELSE
    IF ABS(SECONDS()-MIXTM_S)>=1
      MIXTM=MIXTM+1
      MIXTM_S=SECONDS()
    ENDIF
  ENDIF
  X=0
  IF PLOT_ACT=1
    X=1
  ENDIF
  @ 17+X,51 SAY MIXTM  PICT "999"
  IF  (UCHTYPE=15 )  .AND. (TIME1[9,1] =99  )
      WTANK_F[9,1] :=-99
   ENDIF
CASE  TANKSTP=4 .AND.DIN(15)=1
  IF INT((MIXA()-2048)*MAIN_AMP/2048)<=PMIXA
    TANKSTP=5
    IF PLOT_E=1
      DO  TANK_DSP
    ENDIF
    DROPTM_S=SECONDS()
    DROPTM=0
    X=1
    FOR IX=1 TO (GS_TOT+UWC_TOT)
      IF (WTANK_F[IX,3]=0)  .AND. (TIME1[IX,1] <> 88)
	X=0
	BEEP=0
	EXIT
      ENDIF
    NEXT
    IF X=1
      BEEP=1
      &&DOUT(12,1)
      ALMTM[1,2] := 0
      ALMTM[2,2] := 0
    ENDIF
  ENDIF
  IF DIN(15)=0	 && PAUSE
    MIXTM_S=SECONDS()
  ELSE
    IF ABS(SECONDS()-MIXTM_S)>=1
      MIXTM=MIXTM+1
      MIXTM_S=SECONDS()
    ENDIF
  ENDIF
  X=0
  IF PLOT_ACT=1
    X=1
  ENDIF
  @ 17,51 SAY MIXTM  PICT "999"
CASE  TANKSTP=5
  IF DIN(13)=1
    SET COLOR TO &C10 / &C1
    @ 18,40 SAY "úLúPúPúPúPúPúPúPúKúPúPúPúPúPúPúPúPúPúO"
  ELSE
    DOUT(15,0)
    DOUT(12,0)
    ALMTM[1,2] := 0
    ALMTM[2,2] := 0
    DROPTM_S=SECONDS()
    DROPTM=0
    SET COLOR TO R+   / &C1
    @ 18,40 SAY "úLúPúPúPúPúPúPúPúKúPúPúPúPúPúPúPúPúPúO"
    RETU
  ENDIF
  IF (BEEP=1)
    IF	(ALMTM[1,2] >0 )
      IF (SECONDS()-ALMTM[1,2]) >= ALMTM[1,1]
	 DOUT(12,0)
	 ALMTM[1,2] =0
	 ALMTM[2,2] := SECONDS()
      ENDIF
    ELSE
      IF (SECONDS()-ALMTM[2,2]) >= ALMTM[2,1]
	 DOUT(12,1)
	 ALMTM[1,2] := SECONDS()
	 ALMTM[2,2] =0
      ENDIF
    ENDIF
  ENDIF
  SET COLOR TO &C7 +/ &C1
  IF DIN(15)=0	 && PAUSE
    DROPTM_S=SECONDS()
    DROPTM=0
    DOUT(15,0)
    DOUT(12,0)
  ELSE
    IF DIN(13)=1
      IF DIN(9)=0   && PAUSE
	DROPTM_S=SECONDS()
	DROPTM=0
	DOUT(15,0)
     ENDIF
      IF ABS(SECONDS()-DROPTM_S)>=1
	DROPTM=DROPTM+1
	DROPTM_S=SECONDS()
      ENDIF
      DOUT(15,1)
    ELSE
      DROPTM_S=SECONDS()
      DROPTM=0
      DOUT(15,0)
    ENDIF
  ENDIF
  IF (DROPTM >=PMIXOP)
    IF UCHTYPE=15  .AND.  ( TIME1[9,1]=99  )
      IF STP9 <=5
	TANKSTP=6
      ENDIF
    ELSE
      TANKSTP=6
    ENDIF
  ENDIF
  @ 17,64 SAY  DROPTM	PICT  "999"
CASE  TANKSTP=6
  DOUT(15,0)  &&MAIN M/C DOOR
  DOUT(12,0)  && LAST ALARM
  X=1
  FOR IX=1 TO (GS_TOT+UWC_TOT)
    IF WTANK_F[IX,3]=0
      X=0
      EXIT
    ENDIF
  NEXT
  IF X=1
    FOR IX=1 TO (GS_TOT+UWC_TOT)
      WTANK_F[IX,3] :=0
    NEXT
    ACT_V=-1
    @ 15,12 SAY "    "
    @ 16,12 SAY "    "
    @ 17,12 SAY "    "
  ENDIF
  SET COLOR TO &C2 / &C1
  @ 18,40 SAY "úLúPúPúPúPúPúPúPúPúPúPúPúPúPúPúPúPúPúO"
  SET COLOR TO &C7 +/ &C1
  @ 17,64 SAY  "   "
  @ 17,51 SAY "   "
  TANKSTP=0
ENDCASE

**-----------------------------------------------------------------------------
PROCEDURE  STPSTARN
PARAMETERS  P1,P2,P3
IF LCHTYPE <> 14
  LAST_PCS=1
ENDIF
IF   (AVUSE<>0) .AND. (LAST_PCS=1) .AND. (ARATNO <>0)  .AND.  (nextOK1=0 )  .and. (_tot_d_a[20,3]=0  .or.  _tot_d_a[20,4]=0 )
  xtmp_vu=AVUSE
  GET_DATA(1)
  IF DISCVOL >0
    IF xtmp_vu > 5
      FOR XPAN=1  TO 20
	IF  A_PRESS_N0[1,XPAN,1,5]=0
	  EXIT
	ELSE
	  FOR X=1  TO 12
	    DISAA=DISCVOL   /xtmp_vu
	    A_PRESS_N0[1,XPAN,X,1]=A_PRESS_N0[1,XPAN,X,1]  * (1-DISAA)
	  NEXT
	ENDIF
      NEXT
    ENDIF
  ENDIF
  L_PRESS=2
  U_PRESS=2
ENDIF
RETU
**-----------------------------------------------------------------------------
PROCEDURE  REP_2  &&¬°©÷
PARAMETERS  P1,P2,P3
*PNT2_OK=PNT2_OK("N")
PNT2_OK=1
IF PNT2_OK=1
   @ PROW(),2  SAY  CHR(27)+"C"+CHR(33)
  SETPRC(0,PCOL())
  XZ=_TOT_D_A[20,4] +2
  REP_2N=_TOT_D_A[20,2]
  REP_XN=_TOT_D_A[20,4] +2
  *@ 7,8 SAY "¬°©÷¼t"
  rep_2c=_TOT_D_A[1,5]
  XX=DTOC(_TOT_D_A[1,REP_XN])
  xy=val(substr(XX,7,2))-11
  if  XY <0
    XY=100 +XY
  ENDIF

  XY=STR(XY,2,0)
  @ _TOT_D_A[1,1],_TOT_D_A[1,2]  SAY	XY
  @ _TOT_D_A[1,1],_TOT_D_A[1,2]+6  SAY	   substr(XX,1,2)
  @ _TOT_D_A[1,1],_TOT_D_A[1,2]+11  SAY    substr(XX,4,2)
  rep_2c=_TOT_D_A[2,5]
  @ _TOT_D_A[2,1],_TOT_D_A[2,2]  SAY	_TOT_D_A[2,REP_XN]   PICT   "&REP_2C"
  rep_2c=_TOT_D_A[3,5]
  @ _TOT_D_A[3,1],_TOT_D_A[3,2]  SAY	_TOT_D_A[3,REP_XN]   PICT   "&REP_2C"
  rep_2c=_TOT_D_A[4,5]
  @ _TOT_D_A[4,1],_TOT_D_A[4,2]  SAY	_TOT_D_A[4,REP_XN]   PICT   "&REP_2C"
  rep_2c=_TOT_D_A[10,5]
  @ _TOT_D_A[10,1],_TOT_D_A[10,2]  SAY	  _TOT_D_A[10,REP_XN]	PICT   "&REP_2C"
  rep_2c=_TOT_D_A[12,5]
  @ _TOT_D_A[12,1],_TOT_D_A[12,2]  SAY	  _TOT_D_A[12,REP_XN]	PICT  "9999"
  rep_2c=_TOT_D_A[14,5]
  @ _TOT_D_A[14,1],_TOT_D_A[14,2]  SAY	  _TOT_D_A[14,REP_XN]
  rep_2c=_TOT_D_A[17,5]
  @ _TOT_D_A[17,1],_TOT_D_A[17,2]  SAY	  _TOT_D_A[17,REP_XN]	PICT   "&REP_2C"
  rep_2c=_TOT_D_A[13,5]
  @ _TOT_D_A[13,1],_TOT_D_A[13,2]  SAY	  _TOT_D_A[13,REP_XN]	PICT   "&REP_2C"
  rep_2c=_TOT_D_A[8,5]
  @ _TOT_D_A[8,1],_TOT_D_A[8,2]  SAY	_TOT_D_A[8,REP_XN]   PICT   "&REP_2C"
  rep_2c=_TOT_D_A[9,5]
  @ _TOT_D_A[9,1],_TOT_D_A[9,2]  SAY	_TOT_D_A[9,REP_XN]   PICT   "&REP_2C"
  rep_2c=_TOT_D_A[11,5]
  @ _TOT_D_A[11,1],_TOT_D_A[11,2]  SAY	  _TOT_D_A[11,REP_XN]	PICT   "&REP_2C"
  rep_2c=_TOT_D_A[5,5]
  @ _TOT_D_A[5,1],_TOT_D_A[5,2]  SAY	(_TOT_D_A[6,REP_XN]+_TOT_D_A[7,REP_XN])   PICT	 "&REP_2C"
  rep_2c=_TOT_D_A[6,5]
  @ _TOT_D_A[6,1],_TOT_D_A[6,2]  SAY	_TOT_D_A[6,REP_XN]   PICT   "&REP_2C"
  rep_2c=_TOT_D_A[7,5]
  @ _TOT_D_A[7,1],_TOT_D_A[7,2]  SAY	_TOT_D_A[7,REP_XN]   PICT   "&REP_2C"
  rep_2c=_TOT_D_A[15,5]
  @ _TOT_D_A[15,1],_TOT_D_A[15,2]  SAY	  _TOT_D_A[15,REP_XN]	PICT   "&REP_2C"
  EJEC
endif
RETU
**-----------------------------------------------------------------------------
PROCEDURE  REP_61  &&¤j³°
PARAMETERS  P1,P2,P3
*PNT2_OK=1
  @ PROW(),2  SAY  CHR(27)+"C"+CHR(21)
  SETPRC(0,PCOL())
  XZ=_TOT_D_A[20,4] +2
  REP_2N=_TOT_D_A[20,2]
  REP_XN=_TOT_D_A[20,4] +2
  rep_2c=_TOT_D_A[2,5]
  @ _TOT_D_A[2,1],_TOT_D_A[2,2]  SAY	_TOT_D_A[2,REP_XN]   PICT   "&REP_2C"
  rep_2c=_TOT_D_A[1,5]
  @ _TOT_D_A[1,1],_TOT_D_A[1,2]  SAY	_TOT_D_A[1,REP_XN]   PICT   "&REP_2C"
  rep_2c=_TOT_D_A[8,5]
  @ _TOT_D_A[8,1],_TOT_D_A[8,2]  SAY	_TOT_D_A[8,REP_XN]   PICT   "&REP_2C"
  rep_2c=_TOT_D_A[13,5]
  @ _TOT_D_A[13,1],_TOT_D_A[13,2]  SAY	  _TOT_D_A[13,REP_XN]	PICT   "&REP_2C"
  rep_2c=_TOT_D_A[4,5]
  @ _TOT_D_A[4,1],_TOT_D_A[4,2]  SAY	SUBSTR(_TOT_D_A[4,REP_XN],1,10)
  @ PROW()+1,_TOT_D_A[4,2]  SAY    substr(_TOT_D_A[4,REP_XN],11,10)
  rep_2c=_TOT_D_A[10,5]
  @ _TOT_D_A[10,1],_TOT_D_A[10,2]  SAY	  _TOT_D_A[10,REP_XN]	PICT   "&REP_2C"
  rep_2c=_TOT_D_A[3,5]
  @ _TOT_D_A[3,1],_TOT_D_A[3,2]  SAY	SUBSTR(_TOT_D_A[3,REP_XN],1,10)
  @ PROW()+1,_TOT_D_A[3,2]  SAY    SUBSTR(_TOT_D_A[3,REP_XN],11,10)
  rep_2c=_TOT_D_A[18,5]
  @ _TOT_D_A[18,1],_TOT_D_A[18,2]  SAY	  _TOT_D_A[18,REP_XN]	PICT   "&REP_2C"
  rep_2c=_TOT_D_A[11,5]
  @ _TOT_D_A[11,1],_TOT_D_A[11,2]  SAY	  _TOT_D_A[11,REP_XN]	PICT   "&REP_2C"
  rep_2c=_TOT_D_A[14,5]
  @ _TOT_D_A[14,1],_TOT_D_A[14,2]  SAY	  _TOT_D_A[14,REP_XN]
  rep_2c=_TOT_D_A[9,5]
  @ _TOT_D_A[9,1],_TOT_D_A[9,2]  SAY	_TOT_D_A[9,REP_XN]   PICT   "&REP_2C"
  @ prow()+7,1 say " "
  @ prow()+1,1 say " "
RETU
**-----------------------------------------------------------------------------
FUNCTION _SEND_D
PARAMETERS  _SLN,SD0,SD1,SD2,SD3,SD4,SD5,SD6,SD7,SD8,SD9,SD10
DO CASE
CASE _SLN=0
  X=CHR(2)+CHR(32)+SUBSTR(DTOC(SD0),7,2)+SUBSTR(DTOC(SD0),1,2)+SUBSTR(DTOC(SD0),4,2)
  X=X+CHR(32)+_NTO00C(SD1,4,0)
CASE _SLN=1
  X=CHR(32)+SD0
  X=X+CHR(32)+_NTO00C(SD1,5,0)+CHR(32)+_NTO00C(SD2,5,0)+CHR(32)+_NTO00C(SD3,5,0)+CHR(32)+_NTO00C(SD4,5,0)+CHR(32)+_NTO00C(SD5,5,0)+CHR(32)+_NTO00C(SD6,5,0)
  X=X+CHR(32)+_NTO00C(SD7,5,0)+CHR(32)+_NTO00C(SD8,6,2)+CHR(32)+_NTO00C(SD9,6,2)
CASE _SLN=2
  X=CHR(32)+_NTO00C(SD0,4,1)
  X=X+CHR(32)+_NTO00C(SD1,5,0)+CHR(32)+_NTO00C(SD2,5,0)+CHR(32)+_NTO00C(SD3,5,0)+CHR(32)+_NTO00C(SD4,5,0)+CHR(32)+_NTO00C(SD5,5,0)+CHR(32)+_NTO00C(SD6,5,0)
  X=X+CHR(32)+_NTO00C(SD7,5,0)+CHR(32)+_NTO00C(SD8,5,0)+CHR(32)+_NTO00C(SD9,6,2)+CHR(32)+_NTO00C(SD10,5,0)
CASE _SLN=3
  X=CHR(10)+CHR(32)
  X=X+_NTO00C(SD0,5,0)+CHR(32)+_NTO00C(SD1,5,0)+CHR(32)+_NTO00C(SD2,5,0)+CHR(32)+_NTO00C(SD3,5,0)+CHR(32)+_NTO00C(SD4,5,0)+CHR(32)+_NTO00C(SD5,5,0)+CHR(32)+_NTO00C(SD6,5,0)
  X=X+CHR(32)+_NTO00C(SD7,6,2)+CHR(32)+_NTO00C(SD8,5,0) +CHR(32)+_NTO00C(SD9,5,0)+CHR(13)
ENDCASE
XN_L=LEN(X)
FOR XN=1 TO XN_L
  XC=SUBSTR(X,XN,1)
  A=COM_WRITE(0,XC)
NEXT
RETU
**-----------------------------------------------------------------------------
PROCEDURE  REP_77  &&ANYWHERE
PARAMETERS  P1,P2,P3


REP_XN=_TOT_D_A[20,4] +2
IF  C_MINK<>0
  X_DA=_TOT_D_A[1,REP_XN]
  x_blk=space(c_mink)
  _TOT_D_A[1,REP_XN] := SUBSTR(STR(YEAR(X_DA)-1911,4,0),3,2)  + x_blk + SUBSTR(DTOC(X_DA),1,2)+ x_blk  +SUBSTR(DTOC(X_DA),4,2)
ENDIF
TEMP_A :=ACLONE(_TOT_D_A)
ASORT(TEMP_A,1,18,{|X,Y| X[1] <= Y[1]})
*@ PROW(),3 say "~y3" + chr(27) + chr(67) + chr(21) + ";"
@ PROW(),2  SAY  "~y3" + CHR(27)+"C"+CHR(P_LENGTH)  &&PRINT PAPER LENGTH  SET TO LINE  33 LINE
SETPRC(0,PCOL())
XZ=_TOT_D_A[20,4] +2
REP_2N=_TOT_D_A[20,2]
REP_XN=_TOT_D_A[20,4] +2
X_REPN=1
DO WHILE  X_REPN <=18
  do while  TEMP_A[X_REPN,1] <0
    X_REPN=X_REPN +1
  ENDdo
  IF   X_REPN <=18
    if VALTYPE(TEMP_A[X_REPN,REP_XN]) ="C"
      IF  TEMP_A[X_REPN,1] <>0
	@ TEMP_A[X_REPN,1],TEMP_A[X_REPN,2]  SAY    ALLTRIM(TEMP_A[X_REPN,REP_XN])
      ENDIF
    ELSE
      rep_2c=TEMP_A[X_REPN,5]
	IF  TEMP_A[X_REPN,1] <>0
	  @ TEMP_A[X_REPN,1],TEMP_A[X_REPN,2]  SAY    TEMP_A[X_REPN,REP_XN]   PICT   "&REP_2C"
	endif
    ENDIF
    X_REPN=X_REPN +1
  ENDIF
ENDDO
@ prow()+1,1 say " "
EJECT
RETU
