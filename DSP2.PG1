&&  2019/7/18-----------------------------------------------------------------------------

FUNCTION      LAG_TP10_5
PARAMETERS  X_STP_FN,X_STPN
dd1=0
dd2=0
dd3=0
dd4=0
dd5=0
DDY1[X_STP_FN] =dd1
DDY1[X_STP_FN+1] =dd2
DDY1[X_STP_FN+2] =dd3
DDY1[X_STP_FN+3] =dd4
DDY1[X_STP_FN+4] =dd5
IF (STP_a[X_STP_FN] =0) .and. (STP_a[X_STP_FN+1] =0) ;
     .and. (STP_a[X_STP_FN+2] =0)  .and. (STP_a[X_STP_FN+3] =0) ;
     .and. (STP_a[X_STP_FN+4] =0)
  retu
endif
for i2=x_stp_fn to  x_stp_fn +4
  ic_x=alltrim(str(i2,2,0))
  xw1=A_PRESS_N0[2,STPN&IC_X,I2,1]+A_PRESS_N0[2,STPN&IC_X,I2,2]
  IF  xw1>0
    xw8=A_PRESS_N0[2,STPN&IC_X,I2,8]+A_PRESS_N0[2,STPN&IC_X,I2,11]
    A_M_NAME[I2,10]=A_M_NAME[I2,9] * xw8/xw1
  ELSE
    A_M_NAME[I2,10]=A_M_NAME[I2,9]
  ENDIF
next
DD1=INT((CHENDATA(x_stp_fn-1))*A_M_NAME[x_stp_fn,10]/PER/2048)
DD2=INT((CHENDATA(x_stp_fn))*A_M_NAME[x_stp_fn+1,10]/PER/2048)
DD3=INT((CHENDATA(x_stp_fn+1))*A_M_NAME[x_stp_fn+2,10]/PER/2048)
DD4=INT((CHENDATA(x_stp_fn+2))*A_M_NAME[x_stp_fn+3,10]/PER/2048)
DD5=INT((CHENDATA(x_stp_fn+3))*A_M_NAME[x_stp_fn+4,10]/PER/2048)


DDY1[X_STP_FN] =dd1
DDY1[X_STP_FN+1] =dd2
DDY1[X_STP_FN+2] =dd3
DDY1[X_STP_FN+3] =dd4
DDY1[X_STP_FN+4] =dd5



RETU
&&-----------------------------------------------------------------------------
#ifdef	dfLNK_EN

&&-----------------------------------------------------------------------------
PROCEDURE   LNK_FULI   &&¥xªd ->old fuli
PARAMETERS  P1,P2,P3
if  sio2_fault=0
  IF OUT_REP >0
    R_LONG=SIO_GETCH(S2_PORT)
    #ifdef   _dfDebug
       R_LONG=6
    #endif
    IF OUT_REP>5
      IF  R_LONG =6
	OUT_REP=5
      ELSE
	IF ABS(SECONDS()-OUT_DELAY)>3
	  SIO_PUTB(S2_PORT,C_GETF)
	  OUT_REP=OUT_REP-1
	  OUT_DELAY=SECONDS()
	ENDIF
      ENDIF
    ELSE
      #ifdef   _dfDebug
	 R_LONG=-4
      #endif

      IF  R_LONG =6
	xx=SIO_PUTCH(S2_PORT,4)
	R_BUF2=R_BUF2+RTRIM(R_BUF)
	R_BUF=SPACE(100)
	OUT_REP=0
       else
	 IF ABS(SECONDS()-OUT_DELAY)>3
	  SIO_PUTB(S2_PORT,O_BUF)
	  OUT_REP=OUT_REP-1
	  OUT_DELAY=SECONDS()

	  if show_sio2=70 .and. f3_run <>1
	    @ 19,0  CLEA TO 19,79
	    @ 19,1 SAY	"TRans len="
	    @ 19,13 SAY  LEN(o_BUF)   pict "999"
	    @ 19,18 SAY  "Send Count:"
	    @ 19,30 SAY 5-OUT_REP     pict "99"

	    if len(o_buf) <40
	      @ 19,17 say  o_buf
	    else
	      @ 20,0  CLEA TO 22,79
	      @ 20,0 say  substr(o_buf,1,80)
	      @ 21,0 say  substr(o_buf,81,160)
	      @ 22,0 say  substr(o_buf,161,240)
	    endif
	  endif

	ENDIF
      ENDIF
    ENDIF
  ELSE
    R_LONG=4095-r_free
    IF R_LONG=0
       RETU
    ENDIF
    R1_BUF=space(R_LONG +1)
     R_LONG=sio_line_t(S2_PORT,R1_BUF,CHR(255))
     if r_long =-2
       R_LONG=sio_read(S2_PORT,R1_BUF)
     else
       r_long=0
     endif
     IF (R_LONG>0)
	R_BUF=R1_BUF
	if (show_sio2=77 .or. show_sio2=66  )
	  @ 19,0  CLEA TO 19,24
	  @ 19,0 SAY "Rx2:"
	  @ 19,4 SAY R_BUF
	ENDIF
	&& do  ChkReadBuff
	if R_LONG=3
	  IF R_BUF=C_GETF

	    if	(AVUSE=0  .OR. EMPTY(ARATNO)=.T.  )
	      SIO_PUTCH(S2_PORT,6)
	    else
	      SIO_PUTCH(S2_PORT,7)  &&¦£¸L¤¤
	    ENDIF

	  ENDIF
	  RETU

	ELSE IF  R_LONG=51
	   IF SUBSTR(R_BUF,1,1)=CHR(2)	 .AND. SUBSTR(R_BUF,1,50)=CHR(3)
	     BCC=0
	     FOR XLOOP=2  TO 50    &&  INCLUDE ETX
	       XASC=ASC(SUBSTR(R_BUF,XLOOP,1))
	       BCC=NXOR(BCC,XASC)
	     ENDDO
	     XASC=ASC(SUBSTR(R_BUF,51,1))
	     IF BCC=XASC
		SIO_PUTCH(S2_PORT,6)
		ACARNO=SUBSTR(R_BUF1,14,3)+"   "
		ARATNO="        "+ALLTRIM(UPPER(SUBSTR(R_BUF1,2,8)))
		XARA=LEN(ARATNO)
		ARATNO=SUBSTR(ARATNO,XARA-7,8)
		AVUSE=VAL(SUBSTR(R_BUF1,10,3))/10
		SET COLOR TO &C7 +/ &C1
		DSP_L23(ASCANO,ACARNO,ARATNO,AVUSE,ATANDO)
		*@ 23,16 SAY ASCANO  PICT "9999"
		*@ 23,28 SAY ACARNO
		*@ 23,46 SAY ARATNO
		*@ 23,64 SAY AVUSE   PICT "99.9"
		*@ 23,74 SAY ATANDO  PICT "9999"
		IF X>0
		  R_BUF1=SUBSTR(R_BUF1,2,X)
		ELSE
		  R_BUF1=""
		ENDIF
		EXIT












	     ENDIF

	   ENDIF

	ELSE

	ENDIF
    ENDIF






    R_LONG=SIO_GETCH(S2_PORT)
    && IF  R_LONG >=0
    IF	R_LONG >0
      && R_BUF1=R_BUF1+RTRIM(R_BUF)
      R_BUF1=R_BUF1+chr(R_long)
      if  pnt_rx=1
	@ 20,0	 say RTRIM(R_BUF)
	@ 21,0	 say R_BUF1
      endif
      R_BUF2=R_BUF2+RTRIM(R_BUF)
      R_BUF=SPACE(100)
      x=len(R_BUF1)
      IF F_DATA=0
	DO WHILE X >=3
	  IF SUBSTR(R_BUF1,1,3)=C_GETF
	    SIO_PUTCH(S2_PORT,6)
	    F_DATA=1
	    delay_reset=seconds()
	    X=X-3
	    IF X>0
	      R_BUF1=SUBSTR(R_BUF1,4,X)
	    ELSE
	      R_BUF1=""
	    ENDIF
	    EXIT
	  ELSE
	    X=X-1
	    R_BUF1=SUBSTR(R_BUF1,2,X)
	  ENDIF
	ENDDO
      ELSE
	if abs(seconds()-delay_reset) >5
	    F_DATA=0
	endif
	DO WHILE X >=18
	  IF (SUBSTR(R_BUF1,1,1)=CHR(2)).AND.(SUBSTR(R_BUF1,17,1)=CHR(3))
	    X1=1
	    BCC=0
	    DO	WHILE  X1 <=16
	      X2=ASC(SUBSTR(R_BUF1,X1+1,1))
	      BCC=NXOR(BCC,X2)
	      X1=X1+1
	    ENDDO
	    X2=ASC(SUBSTR(R_BUF1,18,1))
	    IF BCC=X2
	      F_DATA=0
	      SIO_PUTCH(S2_PORT,6)
	      X=X-18
	      ACARNO=SUBSTR(R_BUF1,14,3)+"   "
	      ARATNO="        "+ALLTRIM(UPPER(SUBSTR(R_BUF1,2,8)))
	      XARA=LEN(ARATNO)
	      ARATNO=SUBSTR(ARATNO,XARA-7,8)
	      AVUSE=VAL(SUBSTR(R_BUF1,10,3))/10
	      SET COLOR TO &C7 +/ &C1
	      DSP_L23(ASCANO,ACARNO,ARATNO,AVUSE,ATANDO)
	      *@ 23,16 SAY ASCANO  PICT "9999"
	      *@ 23,28 SAY ACARNO
	      *@ 23,46 SAY ARATNO
	      *@ 23,64 SAY AVUSE   PICT "99.9"
	      *@ 23,74 SAY ATANDO  PICT "9999"
	      IF X>0
		R_BUF1=SUBSTR(R_BUF1,2,X)
	      ELSE
		R_BUF1=""
	      ENDIF
	      EXIT
	    ELSE
	      IF SUBSTR(R_BUF1,1,3)=C_GETF
		SIO_PUTCH(S2_PORT,6)
	      ENDIF
	     X=X-1
	     R_BUF1=SUBSTR(R_BUF1,2,X)
	    ENDIF
	  ELSE
	    X=X-1
	    R_BUF1=SUBSTR(R_BUF1,2,X)
	  ENDIF
	ENDDO
      ENDIF
    ENDIF
  ENDIF
endif
RETU
* -----------------------------------------------------------------------------
FUNCTION DSP_L23
PARAMETERS  NOX1,CARNOX1,RATNOX1,AVUSEX1,ATANDOX1
@ 23,PX_SCANO SAY NOX1	PICT "99999999"
@ 23,PX_CARNO SAY CARNOX1
@ 23,PX_RATNO SAY RATNOX1
@ 23,PX_VUSE  SAY AVUSEX1   PICT "99.9"
@ 23,PX_TANDO  SAY ATANDOX1  PICT "9999"
RETU
* -----------------------------------------------------------------------------
PROCEDURE   transceive
PARAMETERS  P1,P2,P3
  &&IF (ABS(SECONDS()-O_SEC) >TransDlyS )   xTxDlays
  IF (ABS(SECONDS()-O_SEC) >  xTxDlays	)
    if	EMPTY(O_BUF0) = .F.
       IF (SUBSTR(O_BUF0,3,1)<>ETX)
	 S_SEC=SECONDS()-xTxDlays -1
	 O_BUF=STX + "D" + ETX
	 O_BUF0=O_BUF + O_BUF0
	 O_BUF=""
	 trans_err=0
       ELSE
	 XLN=LEN(O_BUF0)
	 O_BUF=SUBSTR(O_BUF0,4,XLN-3)
	 *XRND=STR(INT(MOD(RAND() +SECONDS(),10)),1,0)
	 *XL=LEN(O_BUF)
	 *O_BUF=SUBSTR(1,5) +XRND + SUBSTR(O_BUF,7,XL-6)
       ENDIF
       trans_e=1
    elseif  (AVUSE=0  .OR. EMPTY(ARATNO)=.T. .or. (star<>f_start)  )
       if  (AVUSE=0  .OR. EMPTY(ARATNO)=.T.  )

	   b_idle=0
	   && FOR	xloop=1  TO (GS_TOT+UWC_TOT)
	   &&	if  stp_a[xloop]>0   .or.	tankstp >0  .or. NEXTOK1=1
	   &&	  b_idle=0
	   &&	  xloop=30
	   &&	else
	   &&	  b_idle=1
	   &&	endif
	   &&  next
	   FOR	xloop=1  TO (GS_TOT)
	     if  stp_a[xloop]>0 .or. UPTKSTP >0  .or.	CNVSTP >0  .or. NEXTOK1=1
	       b_idle=0
	       xloop=30
	     else
	       b_idle=1
	     endif
	    next




	  if b_idle=1
	    if	LNK_UP=77 .or. LNK_UP=1
	      O_BUF=STX+"R1" +ETX  && R1=¬Ü¥Ø¼t,R2=®H¨½¼t
	      trans_e=1
	    else   && =2
	      O_BUF=STX+"R2" +ETX  && R1=¬Ü¥Ø¼t,R2=®H¨½¼t
	      trans_e=1

	    endif
	  endif
       endif
       if (star<>f_start)  && .or. fack_start=-1
	 f_start=star
	 fack_start=-1
	 if star=0
	   O_BUF=O_BUF + STX+"H" +ETX
	 else
	   O_BUF=O_BUF + STX+"A" +ETX
	 ENDIF
	 trans_e=1
       endif



    ENDIF
  ENDIF
  if (trans_e=1).AND.(EMPTY(O_BUF)=.F.)
      XO_LEN=SIO_write(S2_PORT,O_BUF)
      if len(o_buf) >30  .and. len(o_buf) <>525
	    x=1
      endif

      if (show_sio2=77 .or. show_sio2=66  ) .and. f3_run <>1
	if len(o_buf) <40
	@ 19,0	CLEA TO 19,24
	  @ 19,1 SAY  "¦¸¼Æ:"
	  @ 19,6 SAY  TRANS_ERR   pict "99"
	  @ 19,10 SAY  "len="
	  @ 19,14 SAY  LEN(o_BUF)   pict "999"
	  @ 19,19 say  o_buf
	else
	  @ 19,25 SAY  "¦¸"
	  @ 19,27 SAY  TRANS_ERR   pict "99"
	  @ 19,30 SAY  "len="
	  @ 19,34 SAY  LEN(o_BUF)   pict "999"

	  @ 20,0  CLEA TO 22,79
	  @ 20,0 say  substr(o_buf,1,80)
	  @ 21,0 say  substr(o_buf,81,160)
	  @ 22,0 say  substr(o_buf,161,240)
	endif
      endif

      if show_sio2=66
	if len(o_buf) >30
	  x= RDLPT(VAL(APORT)-1)
	  IF (x =144)  .or. (x=pnt_redy_code)
	    SET  CONS  On
	    set print to lpt&APORT
	    SET DEVI TO PRINT
	    xlen=60
	    xindex=1
	    do while   xindex <= len(o_buf)
	      if len(o_buf)-xindex < 60
		xlen=len(o_buf)-xindex
	      endif
	      @ PROW()+1,0 say	 substr(O_BUF,xindex,xlen)

		xindex=xindex +60
	    enddo
	    SET DEVI TO scre
	  endif
	endif

      endif
      O_SEC=SECONDS()

      IF O_BUF= STX + "D" + ETX
	O_SEC=SECONDS()-xTxDlays +3	&&
      ENDIF

      XO_LEN=0
      trans_e=0
      o_buf=""
      xo_len=1000
      trans_err=trans_err + 1
      if (trans_err >TransMax)
	o_buf0=""
      endif
  else
    *R_LONG=SIO_GETCH(S2_PORT)
    xr_free=sio_ifree(S2_PORT)
    && testkk
    &&	   DO ChkReadBuff

    if (xr_free<4095)
      if (xr_free <> r_free )
	 r_free=xr_free
      else
	IF R_ISNEW=0
	   R_SEC=SECONDS()
	   R_ISNEW=1
	   RETU
	ENDIF
	IF SECONDS()-R_SEC <1
	   RETU
	ENDIF
	R_ISNEW=0
	R1_BUF=space(4095-r_free+1)
	*R_LONG=sio_read(S2_PORT,R1_BUF)
	R_LONG=sio_line_t(S2_PORT,R1_BUF,"ÿ")
	if r_long =-2
	  R_LONG=sio_read(S2_PORT,R1_BUF)
	else
	  r_long=0
	endif
	IF (R_LONG>0)
	   *R_BUF=R_BUF +substr(R1_BUF,1,r_long)
	   R_BUF=R1_BUF
	   r_free=4095
	   DO ChkReadBuff
	ENDIF
      endif
    endif
  endif
RETU


#enif  &&#ifdef  dfLNK_EN
