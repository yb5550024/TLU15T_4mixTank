RETURN

PROCEDURE  FIND_ADD_
PARAMETERS  P1,P2,P3
SetColor( "&c12 / &c11" )
RET_X1=SPACE(4)
RET_X2=SPACE(50)
DO  D_add_DATA WITH  "N"
IF RET_X1 <>  SPACE(10)

  XADDR_NO=FSUBSTR(RET_X2,10," ")
  CHRN=XADDR_NO
  XUS2_2=RET_X2
  IF  EMPTY(RET_A[4])=.T.
    RET_A[4] := 0
  ENDIF
  XU_PRICE=RET_A[4]
    DevPos( _A_DSPy[7], _A_DSPX[7] ) ; DevOut( XADDR_NO )

    IF    LU_COUNT=1
      DevPos( 22, _A_DSPX[13] ) ; DevOutPict( XU_PRICE, "99999" )
    ENDIF
ENDIF
RETU

PROCEDURE  x_pno
PARAMETERS  P1,P2,P3
SetKey( 5, NIL )
SetKey( 24, NIL )
SetCursor( if(Upper("On") == "ON", 1, 0) )
SetColor( "&c7 + /&c1,gr+/w+" )
Scroll( 22, 4, 22, 30 ) ; SetPos( 22, 4 )
Scroll( 23, 1, 23, 79 ) ; SetPos( 23, 1 )
DevPos( 22, 3 ) ; DevOut( "編號:" )
DevPos( 23, 3 ) ; DevOut( "Date:" )
DevPos( 23, 20 ) ; DevOut( "Time:" )
DevPos( 23, 35 ) ; DevOut( "存檔列印:" )
x_no=lag_pno
fx_date=date()
fx_time=time()
fx_h=substr(fx_time,1,2)
fx_m=substr(fx_time,4,2)
fx_s=substr(fx_time,7,2)
X_NO=XSCANO
SetPos( 22, 8 ) ; AAdd( GetList, _GET_( x_no, "x_no", "XXXXXXXXXXXXXX",, ):display() )
fx_date=date()
SetPos( 23, 8 ) ; AAdd( GetList, _GET_( fx_date, "fx_date",,, ):display() )

SetPos( 23, 25 ) ; AAdd( GetList, _GET_( fx_h, "fx_h", "99",, ):display() )
DevPos( 23, 27 ) ; DevOut( ":" )
SetPos( 23, 28 ) ; AAdd( GetList, _GET_( fx_m, "fx_m", "99",, ):display() )
DevPos( 23, 30 ) ; DevOut( ":" )
SetPos( 23, 31 ) ; AAdd( GetList, _GET_( fx_s, "fx_s", "99",, ):display() )
SetPos( 23, 44 ) ; AAdd( GetList, _GET_( usave, "usave", "Y",, ):display() )
ReadModal(GetList) ; GetList := {}
fx_time=fctoTime(fx_h,fx_m,fx_s)
DevPos( 23, 25 ) ; DevOut( fx_time )

IF (USAVE ="YA"  .OR. USAVE ="yA" )
     pnt0_en=1
else
     pnt0_en=0
endif
_TOT_D_A[20,4] =1
X=_TOT_D_A[20,4] +2
_TOT_D_A[2,X]  :=x_no
_TOT_D_A[19,X]    :=x_no

_TOT_D_A[1,X]  :=fx_date
_TOT_D_A[8,X]  :=fx_time
Scroll( 22, 9, 22, 30 ) ; SetPos( 22, 9 )
_FIELD->cdate := fx_date
_FIELD->CHOUR := VAL(SUBSTR(fx_time,1,2)); _FIELD->CMIN := VAL(SUBSTR(fx_time,4,2)); _FIELD->CSEC := VAL(SUBSTR(fx_time,7,2))
_FIELD->scano := x_no
SetCursor( if(Upper("OFF") == "ON", 1, 0) )
RETU
