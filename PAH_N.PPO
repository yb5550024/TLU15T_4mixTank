  DevPos( TY, 40 ) ; DevOut( P12100 )
  DevPos( TY, 52 ) ; DevOut( P12101 )
  DevPos( TY, 62 ) ; DevOut( P12102 )
  DevPos( TY, 72 ) ; DevOut( P12103 )
  dbSkip(1)
  TY=TY+1
  TNO=TNO+1
  IF  EOF() .OR. TY>=24
    TY=TY-1
    TNO=TNO-1
    dbSkip( -1 )
    XDADA=ALLTRIM(STR(TNO))
    XDATA6_0=P12101
    XDATA6=P12100
    XDATA6_1=P12102
    XDATA6_2=P12103
    SetColor( "W+ / R+" )
    DevPos( TY, 37 ) ; DevOut( "                                     " )

    DevPos( TY, 40 ) ; DevOut( XDATA6 )
    DevPos( TY, 52 ) ; DevOut( XDATA6_0 )
    DevPos( TY, 62 ) ; DevOut( XDATA6_1 )
    DevPos( TY, 72 ) ; DevOut( XDATA6_2 )
    SetColor( "W+ / BL" )
    T=0
    while T<>13 .AND. T<>27 .AND. (! EOF())  .AND. T<>18 .AND. T<>3 .AND. T<>7
      T=0
      SetCursor( if(Upper("off") == "ON", 1, 0) )
      while T<>5 .AND. T<>24  .AND. T<>27  .AND. T<>13  .AND. T<>18  .AND. T<>3 .AND. T<>7
    IF (T0A <>0)  .AND.  DSP_SCALL=1
      T=T0A
      T0A=0
    ELSE
      T=INKEY()
    ENDIF
    IF  DSP_SCALL=1
      DO DSP2
      IF T0A=0
        DO LUSTP
      ENDIF
    ENDIF
      ENDDO

      SetColor( "W+ / BL" )
      dbSelectArea( "10" )
      SetCursor( if(Upper("on") == "ON", 1, 0) )
      DO CASE
      CASE T=5
    IF  TNO<>1

      DevPos( TY, 37 ) ; DevOut( "                                     " )
      DevPos( TY, 40 ) ; DevOut( XDATA6 )
      DevPos( TY, 52 ) ; DevOut( XDATA6_0 )
      DevPos( TY, 62 ) ; DevOut( XDATA6_1 )
      DevPos( TY, 72 ) ; DevOut( XDATA6_2 )
      dbSkip( -1 )
      TY=TY-1
      IF TY<=19
        TY=20
        SCROLL(20,52,23,77,-1)
      ENDIF
      TNO=TNO-1
      XDADA=ALLTRIM(STR(TNO))
      XDATA6_0=P12101
      XDATA6=P12100
      XDATA6_1=P12102
      XDATA6_2=P12103
      SetColor( "W+ / R+" )

      DevPos( TY, 37 ) ; DevOut( "                                     " )
      DevPos( TY, 40 ) ; DevOut( XDATA6 )
      DevPos( TY, 52 ) ; DevOut( XDATA6_0 )
      DevPos( TY, 62 ) ; DevOut( XDATA6_1 )
      DevPos( TY, 72 ) ; DevOut( XDATA6_2 )
      SetColor( "W+ / BL" )
      T=0
    ENDIF
      CASE T=24
    dbSkip(1)
    IF  ! EOF()

      DevPos( TY, 37 ) ; DevOut( "                                     " )
      DevPos( TY, 40 ) ; DevOut( XDATA6 )
      DevPos( TY, 52 ) ; DevOut( XDATA6_0 )
      DevPos( TY, 62 ) ; DevOut( XDATA6_1 )
      DevPos( TY, 72 ) ; DevOut( XDATA6_2 )
      TY=TY+1
      TNO=TNO+1
      IF TY>=24
        TY=23
        SCROLL(20,52,23,77,1)
      ENDIF
      XDADA=ALLTRIM(STR(TNO))
      XDATA6_0=P12101
      XDATA6=P12100
      XDATA6_1=P12102
      XDATA6_2=P12103
      SetColor( "W+ / R+" )

      DevPos( TY, 37 ) ; DevOut( "                                     " )
      DevPos( TY, 40 ) ; DevOut( XDATA6 )
      DevPos( TY, 52 ) ; DevOut( XDATA6_0 )
      DevPos( TY, 62 ) ; DevOut( XDATA6_1 )
      DevPos( TY, 72 ) ; DevOut( XDATA6_2 )
      SetColor( "W+ / BL" )
      T=0
    ENDIF
      CASE T=18
    IF  TNO > TY-2
      dbSkip( -(TY-2) )
      TNO=TNO-TY+2
    ELSE
      dbSkip( -(TNO-1) )
      TNO=1
    ENDIF
    TY=20
    IF BOF()
      dbGoTop()
    ENDIF
    SCROLL(20,52,23,77,0)
      CASE T=7
    dbDelete()
    __dbPack()
    dbGoBottom()
    dbSkip( 5 )
      CASE T=3
    dbSkip(1)
    TY=20
    TNO=TNO+1
    SCROLL(20,52,23,77,0)
      CASE T=13
    XCARNO = substr(XDATA6,1,7)
    CHRN   =substr(XDATA6,1,7)
    xcardrv=XDATA6_1
    XCARW=XDATA6_2
    dbGoBottom()
    dbSkip( 1 )
      CASE T=27
    dbGoBottom()
    dbSkip( 5 )
      ENDCASE
    ENDDO
  ENDIF
ENDDO
dbClearFilter(NIL)
RESTSCREEN(19,0,24,79,XPRTSCR)
SetColor( "&C1 / &C7 +" )
DevPos( _A_DSPY[2], _A_DSPX[2] ) ; DevOut( XCARNO )


