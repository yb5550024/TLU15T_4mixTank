         DevPos( y1, x1+xp ) ; DevOut( substr(chrn,XP+1,1) )
         SetColor( "&C1 / &C7 +" )
      CASE T=13
         FGETNO=GETNO+1
           T1=233
      CASE T=5
        IF GETNO>1
        FGETNO=GETNO+1
        T1=233
        ELSE
        FGETNO=3
        T1=233
        ENDIF
      CASE T=27
         T1=233
         GETNO=6
