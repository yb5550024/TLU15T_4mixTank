        SetColor( "gr + * /bl" )
        DevPos( y1, x1+xp ) ; DevOut( substr(chrn,XP+1,1) )
        SetColor( "&C1 / &C7 +" )
      CASE     T=46 .OR.T=32 .OR. T=48 .OR.T=49 .OR.T=50 .OR.T=51 .OR.T=52 .OR.T=53 .OR.T=54 .OR.T=55 .OR.T=56 .OR.T=57
         XP=XP+1
         IF TN1=0 .AND. XP=1
         TN1=1
         CHRN="      "
