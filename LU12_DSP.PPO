PROCEDURE   D_REMOTE
PARAMETERS  P1,P2,P3
DevPos( 21, 78 ) ; DevOutPict( REMOTE[11], "99" )
while T=0
  T=INKEY( )
  if t >0
    DO    CASE
    CASE T=23
      EXIT
    CASE T=4
      REMOTE[11]=REMOTE[11]+1
      IF REMOTE[11] >10
    REMOTE[11]=1
      ENDIF
      DevPos( 21, 78 ) ; DevOutPict( REMOTE[11], "99" )
    CASE T=19
      REMOTE[11]=REMOTE[11]-1
      IF REMOTE[11] <1
    REMOTE[11]=10
      ENDIF
      DevPos( 21, 78 ) ; DevOutPict( REMOTE[11], "99" )
    CASE T=27
    x=REMOTE[11]
    REMOTE[x]=0
    OTHERWISE
      EXIT
    ENDCASE
  endif
  x= din(14)
  if x <> remote[12]
    remote[12]=x
    if x=1
       x=remote[11]
       remote[x]=remote[x] + 1
    endif
  endif
  x= din(11)
  if x <> remote[13]
    remote[13]=x
    if x=1
       x=remote[11]
       remote[x]=remote[x] - 1
    endif
  endif
  DO DSP2
  T=0
ENDDO
RETU

