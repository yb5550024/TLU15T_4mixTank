M_TANK(MTX1,MTY1,MTX2,MTY2,MCOLO,PA6,x_plus[6],H_MTB,X_MTB)
IF PA7 <> 0
  M_TANK(MTX1,MTY1,MTX2,MTY2,MCOLO,PA7,x_plus[7],H_MTB,X_MTB)
endif
IF PA8 <> 0
  M_TANK(MTX1,MTY1,MTX2,MTY2,MCOLO,PA8,x_plus[8],H_MTB,X_MTB)
endif
IF PA9 <> 0
  M_TANK(MTX1,MTY1,MTX2,MTY2,MCOLO,PA9,x_plus[9],H_MTB,X_MTB)
endif
IF PA10 <> 0
  M_TANK(MTX1,MTY1,MTX2,MTY2,MCOLO,PA10,x_plus[10],H_MTB,X_MTB)
endif
IF PA11 <> 0
  M_TANK(MTX1,MTY1,MTX2,MTY2,MCOLO,PA11,x_plus[11],H_MTB,X_MTB)
ENDIF
IF PA12 <>0
  M_TANK(MTX1,MTY1,MTX2,MTY2,MCOLO,PA12,x_plus[12],H_MTB,X_MTB)
ENDIF
IF PA13 <>0
  M_TANK(MTX1,MTY1,MTX2,MTY2,MCOLO,PA13,x_plus[13],H_MTB,X_MTB)
ENDIF
IF PA14 <>0
  M_TANK(MTX1,MTY1,MTX2,MTY2,MCOLO,PA14,x_plus[14],H_MTB,X_MTB)
ENDIF
IF PA15 <>0
  M_TANK(MTX1,MTY1,MTX2,MTY2,MCOLO,PA15,x_plus[15],H_MTB,X_MTB)
ENDIF
IF PA16 <>0
  M_TANK(MTX1,MTY1,MTX2,MTY2,MCOLO,PA16,x_plus[16],H_MTB,X_MTB)
ENDIF
RETU

FUNCTION MAT_TANK
PARAMETERS  P1,P2

dbGoto(36)
SetColor( "&C5 +/ &C1" )
IF PA1 >16
  DevPos( 4, 0 ) ; DevOut( "³]©w­È" )
ELSE
  DevPos( 3, 0 ) ; DevOut( "³]" )
  DevPos( 4, 0 ) ; DevOut( "©w" )
ENDIF
  SetColor( "&C2 / &C1" )
dbGoto(35)
MTX1=PA1
MTY1=PA2
MTX2=PA3
MTY2=PA4
MCOLO=PA5
x_plus1=PA6
h_MTB=PA7
X_MTB=PA8
x_CAP :=array(15)
x_plus :=array(15)
tank_tot= gs_tot +uwc_tot
for xn=1 to tank_tot
  dbGoto(50)
  xc=alltrim(str(xn,2,0))
  x_plus[xn]=PA&XC
  dbGoto(36)
  x_CAP[xn]=PA&XC
next
X_OFFSET=0
W_BASE=MTX2-MTX1+2
Y_OFFSET=0
h_plus=0
h_plus_S=55
A_M_NAME[7,18]= A_M_NAME[3,18] + h_plus_S
for xn=1 to  tank_tot





  Y_OFFSET=0
  if xn >1
    X_OFFSET= X_CAP[XN]
  else
    X_OFFSET= X_CAP[XN]
  endif
  h_plus=h_plus_S
  tmpx0=MTX1 +    X_OFFSET
  A_M_NAME[xn,2] :=int((tmpx0+4)/8)   
  TMPY0=MTY1 + Y_OFFSET
  MAT_POSX0[xn,1] :=TMPX0
  tmp_w=w_base + x_plus[XN]
  A_M_NAME[xn,23] :=int((TMPY0+3)/18)    
  SetColor( "&C5 +/ &C1" )
  DevPos( A_M_NAME[XN,23]-1, A_M_NAME[XN,2] ) ; DevOut( A_M_NAME[XN,1] )
  SetColor( "&C2 / &C1" )
  A_M_NAME[xn,13] :=int(INT((tmpx0 + (tmp_w/2)+3)-(len(alltrim(A_M_NAME[xn,3]))*4))/8)
  A_M_NAME[xn,19] :=int(tmpx0 + (tmp_w/2))
  MAT_POSX0[xn,2] := x_plus[XN]
  Y_OFFSET=0
  if xn >1
    X_OFFSET= X_CAP[XN]
  else
    X_OFFSET= X_CAP[XN]
  endif
  M_TANK(MTX1,TMPY0,MTX2,MTY2 + h_plus + Y_OFFSET,MCOLO,X_OFFSET,x_plus[XN] ,H_MTB,X_MTB)








  Y_OFFSET=0
next
retu

FUNCTION DSP_TITL0
PARAMETERS  P1,P2
SetColor( "&C5 +/ &C1" )
FOR  I=1  TO gs_tot+uwc_tot
  IF EMPTY(A_M_NAME[I,1]) <> .T.
    DevPos( A_M_NAME[I,23]-1, A_M_NAME[I,2] ) ; DevOut( A_M_NAME[I,1] )
  ENDIF
NEXT
SetColor( "&C2 / &C1" )
retu

FUNCTION WEI_TANK
  PARAMETERS  WEICH0,WEICH1
  divn :=ARRAY(14)
  dbGoto(60)
  FOR I=1 TO  14
    IX_C=ALLTRIM(STR(I,2,0))
    DIVN[I] :=PA&IX_C
    IF DIVN[I] <=0
      DIVN[I] :=1
    ENDIF
  NEXT
  dbGoto(36)
  SetColor( "&C2 / &C1" )
  SetColor( "&C5 +/ &C1" )
  IF PA1 >16

    DevPos( 8, 0 ) ; DevOut( "¹ê»Ú­È" )
    DevPos( 10, 0 ) ; DevOut( "½S¯¯­È" )
  ELSE
    DevPos( 7, 0 ) ; DevOut( "¹ê" )
    DevPos( 8, 0 ) ; DevOut( "»Ú" )
    DevPos( 10, 0 ) ; DevOut( "½S" )
    DevPos( 11, 0 ) ; DevOut( "¯¯" )
  ENDIF
  dbGoto(35)


  MTX1=PA1
  MTX2=PA3
  W_BASE=PA3-PA1
  MCOLO=PA5
  x_plus0=PA6
  h_MTB=PA7
  X_MTB=PA8
  dbGoto(37)
  MTY1=PA2
  MTY2=PA4
  dbGoto(50)
  x_plus :=array(15)
  for xn=1 to  15
   xc=alltrim(str(xn,2,0))
   x_plus[xn]=PA&XC
  next
  SetColor( "&C4 / &C1" )
  dbGoto(38)
  XRST=PA1
  dbGoto(36)
  Y=0
  XN=1
  HLineLow_y=10*18 +8
  HLineMid_y=9*18-1
  FOR I=1 TO  KLCHN+KUCHN
    IX_E=ALLTRIM(STR(I,2,0))
    IX_C=ALLTRIM(STR(I+Y,2,0))
    Y=Y+DIVN[I]-1
    IX_D=ALLTRIM(STR(I+Y,2,0))
    X_PLUS0=MAT_POSX0[XN,1]






    TANK_W=w_base + (MAT_POSX0[XN + 2,1]-MAT_POSX0[XN,1])+MAT_POSX0[XN+2,2]
    tmp_w=  TANK_W
    A_M_NAME[I,16] :=int(INT((MAT_POSX0[XN,1] + (tmp_w/2)+3)-(len(alltrim(A_M_NAME[I,5]))*4))/8)
    A_M_NAME[I,20] :=int(MAT_POSX0[XN,1] + (tmp_w/2))
    A_M_NAME[I,22] :=tmp_w

    M_TANK(MAT_POSX0[XN,1],MTY1,W_BASE + MAT_POSX0[XN,1],MTY2,MCOLO,0,TANK_W,H_MTB,X_MTB)
    LINE(MAT_POSX0[XN,1],HLineLow_y,MAT_POSX0[XN,1] + tmp_w,HLineLow_y,MCOLO)
    DO CASE
    CASE    WSCALE_TYPE[I]=1
    XN=XN+1
    CASE    WSCALE_TYPE[I]=2
    LINE(MAT_POSX0[XN,1],HLineMid_y,MAT_POSX0[XN,1] + tmp_w,HLineMid_y,MCOLO)
    XN=XN+2
    CASE    WSCALE_TYPE[I]=3
    x_tmp= MAT_POSX0[XN,1] +(tmp_w/2)
    LINE(x_tmp,MTY1,x_tmp,HLineLow_y,MCOLO)
    LINE(MAT_POSX0[XN,1],HLineMid_y,x_tmp,HLineMid_y,MCOLO)
    XN=XN+3
    ENDCASE










  NEXT
  SetColor( "&C4 / &C1" )
RETU

PROCEDURE   dsp_rcp
PARAMETERS  P1,P2,P3
SetColor( "&C7 +/ &C1" )
DevPos( 23, 25 ) ; DevOut( ACARNO )
DevPos( 23, 37 ) ; DevOut( ARATNO )
DevPos( 23, 52 ) ; DevOutPict( AVUSE, "99.9" )
DevPos( 23, 61 ) ; DevOutPict( ATANDO, "9999" )
DevPos( 23, 71 ) ; DevOut( substr(space(10)+alltrim(APOSITION),-9,9) )
RETU


PROCEDURE    show_siopic 
PARAMETERS  xpos,xindex
   SetColor( "w+ /&c1" )
   if xindex=0
     DevPos( 0, xpos ) ; DevOut( "" )
   else

   endif
SetColor( "&C2 / &C1" )
RETU
