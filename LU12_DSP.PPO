  FUNCTION WEI_TANK_OLD
  PARAMETERS  WEICH0,WEICH1
  divn :=ARRAY(14)
  dbGoto(60)
  FOR I=1 TO  14
    IX_C=ALLTRIM(STR(I,2,0))
    DIVN[I] :=PA&IX_C
    IF DIVN[I] <=0
      DIVN[I] :=1
    ENDIF
  NEXT
  dbGoto(36)
  SetColor( "&C2 / &C1" )
  SetColor( "&C5 +/ &C1" )
  IF PA1 >16
    DevPos( 4, 0 ) ; DevOut( "³]©w­È" )
    DevPos( 8, 0 ) ; DevOut( "¹ê»Ú­È" )
    DevPos( 10, 0 ) ; DevOut( "½S¯¯­È" )
  ELSE
    DevPos( 7, 0 ) ; DevOut( "¹ê" )
    DevPos( 8, 0 ) ; DevOut( "»Ú" )
    DevPos( 10, 0 ) ; DevOut( "½S" )
    DevPos( 11, 0 ) ; DevOut( "¯¯" )
  ENDIF
  dbGoto(35)
  MTX1=PA1
  MTX2=PA3
  W_BASE=PA3-PA1
  MCOLO=PA5
  x_plus0=PA6
  h_MTB=PA7
  X_MTB=PA8
  dbGoto(37)
  MTY1=PA2
  MTY2=PA4
  dbGoto(50)
  x_plus :=array(15)
  for xn=1 to  15
   xc=alltrim(str(xn,2,0))
   x_plus[xn]=PA&XC
  next
  SetColor( "&C4 / &C1" )
  dbGoto(38)
  XRST=PA1
  dbGoto(36)
  Y=0
  ya=0
  FOR I=1 TO  KLCHN+KUCHN
    XN=I
    IX_E=ALLTRIM(STR(I,2,0))
    IX_C=ALLTRIM(STR(I+Y,2,0))
    Y=Y+DIVN[I]-1
    IX_D=ALLTRIM(STR(I+Y,2,0))
    X_PLUS0=PA&IX_D -PA&IX_C + X_PLUS[I+y]
    M_TANK(MTX1,MTY1,MTX2,MTY2,MCOLO,PA&IX_C,x_plus0,H_MTB,X_MTB)
    LINE((MTX1+PA&IX_C),(MTY1+MTY2)/2,(MTX2+PA&IX_C+x_plus0),(MTY1+MTY2)/2,MCOLO)







    TANK_W=w_base + X_PLUS0
    tmp_w=  TANK_W
    A_M_NAME[I,16] :=int(INT((MAT_POSX0[ya+1,1] + (tmp_w/2)+3)-(len(alltrim(A_M_NAME[I,5]))*4))/8)
    A_M_NAME[I,20] :=int(MAT_POSX0[ya+1,1] + (tmp_w/2))
    A_M_NAME[I,22] :=tmp_w
    Ya=Ya+DIVN[I]

    IF (XRST <= 0)
      X_N1=PA&IX_C
      dbGoto(38)
      _FIELD->PA&IX_E := X_N1
      dbGoto(51)
      _FIELD->PA&IX_E := X_PLUS0
      dbGoto(36)
    ENDIF

    IF DIVN[I] >1
      XP= +(MTX2-MTX1+x_plus0)/DIVN[I]
      XP0=PA&IX_C + MTX1
      FOR J=1 TO  (DIVN[I]-1)
    LINE(XP * J + XP0 ,MTY1,XP * J + XP0,(MTY2+MTY1)/2,MCOLO)
      NEXT
    ENDIF
  NEXT
  SetColor( "&C4 / &C1" )
RETU

