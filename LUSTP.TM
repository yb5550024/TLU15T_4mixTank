IF LS2[A_M_NAME[TST_M1,8]+1,1]=1
  IF DIX(DI_ADS3,A_M_NAME[TST_M1,8])=1 .AND. RDOK2(TST_M1-1)=1
    IF LS2[A_M_NAME[TST_M1,8]+1,2]=0
      DOUT(TST_M1-1,0)
      LS2[A_M_NAME[TST_M1,8]+1,2] :=1
      DO CASE
      CASE LCHTYPE=4 .OR. UCHTYPE=1
	SET COLOR TO R * / &C1
	DO CASE
