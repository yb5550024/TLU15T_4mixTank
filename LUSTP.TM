	CASE TST_M1=10
	  @ 11,53 SAY	"úLúPúPúKúPúO"
	CASE TST_M1=11
	  @ 11,67 SAY	"úLúKúO"
	CASE TST_M1=12
	  @ 11,73 SAY	"úLúKúO"
	ENDCASE
	SET COLOR TO &C7  / &C1
      ENDCASE
    ENDIF
    RETU
  ELSE
    IF LS2[A_M_NAME[TST_M1,8]+1,2]=1
      LS2[A_M_NAME[TST_M1,8]+1,2] :=0
      dout2(A_M_NAME[TST_M1,8],1)
      SET COLOR TO &C2	/ &C1
      DO CASE
      CASE LCHTYPE=4 .OR. UCHTYPE=1
	DO CASE
	CASE TST_M1=3
	  @ 11,7  SAY	"úLúPúPúKúPúPúO"
	CASE TST_M1=5
	  @ 11,22 SAY	"úLúPúKúPúO"
	CASE TST_M1=7
	  @ 11,36 SAY	"úLúPúKúPúO"
	CASE TST_M1=8
	  @ 11,46 SAY	"úLúKúO"
	CASE TST_M1=10
	  @ 11,53 SAY	"úLúPúPúKúPúO"
	CASE TST_M1=11
	  @ 11,67 SAY	"úLúKúO"
	CASE TST_M1=12
	  @ 11,73 SAY	"úLúKúO"
	ENDCASE
      ENDCASE
      SET COLOR TO &C7	/ &C1
    ENDIF
  ENDIF
ENDIF
RETU
**-----------------------------------------------------------------------------
FUNCTION TST0_LS2
