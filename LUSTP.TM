**-----------------------------------------------------------------------------
FUNCTION WEIG_RESCALL
PARAMETERS  DSM_FN
SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
IF  SW1 >0
  DSN_WX=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,3]
  MNX_W=SW1/(SW1+DSN_WX) *A_M_NAME[STP_FN,9]
  A_M_NAME[STP_FN,10] := MNX_W
  DO CASE
  CASE LCHTYPE=4
    IF DSM_FN <=3
      A_M_NAME[1,12] := MNX_W
    ELSE
      A_M_NAME[2,12] := MNX_W
    ENDIF
  ENDCASE
ENDIF
RETU
**-----------------------------------------------------------------------------
FUNCTION WEIG_URESCALL
PARAMETERS  DSM_FN
SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
IF  SW1 >0
  DSN_WX=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,3]
  MNX_W=SW1/(SW1-DSN_WX) *A_M_NAME[STP_FN,9]
  A_M_NAME[STP_FN,10] := MNX_W
  DO CASE
  CASE UCHTYPE=1
    DO CASE
    CASE DSM_FN=8
      A_M_NAME[KLCHN+2,12] := MNX_W
    CASE DSM_FN=9
      A_M_NAME[KLCHN+3,12] := MNX_W
    ENDCASE
  ENDCASE
ENDIF
RETU
**-----------------------------------------------------------------------------
PROCEDURE  CONVEYER
PARAMETERS  P1,P2,P3
DO CASE
CASE   CNVSTP=0
  FOR XF=1  TO GS_TOT
    CNVSTP=1
    UPOV=0
    DNOV=0
    IF WTANK_F[XF,1]<>1
      CNVSTP=0
      UPOV=0
      DNOV=0
      EXIT
    ENDIF
  NEXT
  IF CNVSTP=1
    FOR  I=1  TO  GS_TOT
      WTANK_F[I,1] :=0
      WTANK_F[I,2] :=0
    NEXT
    X=_Tot_d_a[20,4] +2
    @ 15,12 say _Tot_d_a[18,X]	PICT  "9999"
    @ 16,12 say _Tot_d_a[10,X]	PICT  "99.9"
    IC_X=ALLTRIM(STR(GS_TOT+1,2,0))
    IF STPN&ic_x=1
      @ 23,15 SAY ASCANO  PICT "9999"
      @ 23,25 SAY ACARNO
      @ 23,42 SAY ARATNO  PICT "9999"
      @ 23,52 SAY AVUSE   PICT "99.9"
      @ 23,61 SAY ATANDO  PICT "9999"
      @ 23,75 SAY ACALW_REP  PICT "99"
      E_STORE = 1
      X=_TOT_D_A[20,4] +2
      IF _TOT_D_A[17,X]=0
	E_STORE = 0
      ENDIF
      IF E_STORE =1
	DO  PNT_TIT
      ENDIF
    ENDIF
    SET CONS ON
  ENDIF
  SET COLOR TO &C5 +/ &C1
  *@ 14,52 SAY "²V¦X   ²V¦X   ¶}ªù   §t¤ô"
  *@ 15,0 SAY "1.³]©w°t¤ñ:              "
  *@ 16,0 SAY "2.³]©w¦Ì¼Æ:              "
  *@ 17,0 SAY "3.°õ¦æ¦Ì¼Æ:              "
  *@ 18,0 SAY "4.ºÏºÐ®e¶q:      ,000    "
  *@ 17,48  SAY
  SET COLOR TO &C2 / &C1
CASE  (CNVSTP=1 .AND. DIN(8)=0	.AND. DIN(10)=1    .AND.  DIN(11)=1 .AND.  DIN(15)=1)  &&DIN0.08=0  STORE TANK	DOOR CLOSE ,DIN0.11 °©§÷¶i®Æ
  CNVSTP=2
  IF UPTKSTP =0
    SET COLOR TO B+ / &C1
    @ 13,UPTANK[5,1]-2 SAY "ú^ú]ú_"
    SET COLOR TO &C2 / &C1
  ENDIF
  A_STOR_4(A_PRESS_N0,1,GS_TOT)
  FOR  I=1  TO	GS_TOT
    WTANK_F[I,1] :=-99
    WTANK_F[I,2] :=-99
    SET  COLO TO W+   /&C1
    @  4,UPTANK[5,1]   say  UPTANK[4,1]  PICT "99"
    SET COLOR TO &C2 / &C1
  NEXT
CASE CNVSTP=2
  CNVSTP=3
  UPTANK[4,2]=SECONDS()
  FOR  I=1  TO	GS_TOT
    IF	WTANK_F[I,2] <>1
      CNVSTP=2
      EXIT
    ENDIF
  NEXT
CASE CNVSTP=3
  IF  DIN(15)=0
    UPTANK[4,2]=SECONDS()
    SET COLOR TO R +/ &C1
    @  3,UPTANK[5,1]-6	SAY "¢z¢s¢w¢w¢{"
    @  4,UPTANK[5,1]-6	SAY "¢x¢x    ¢x"
    @  5,UPTANK[5,1]-6	SAY "¢x¢u¢w¢w¢}"
    @  6,UPTANK[5,1]-6	SAY "úUúV"
    @  7,UPTANK[5,1]-6	SAY "¢x¢x"
    @  8,UPTANK[5,1]-6	SAY "¢x¢x"
    @  9,UPTANK[5,1]-6	SAY "¢x¢x"
    @ 10,UPTANK[5,1]-6	SAY "¢x¢x"
    @ 11,UPTANK[5,1]-6	SAY "úUúV"
    @ 12,UPTANK[5,1]-6	SAY "¢x¢x"
    @ 13,UPTANK[5,1]-6	SAY "    "
    @ 13,UPTANK[5,1]-38  SAY "¢z¢w¢wúR¢w¢w¢w¢w¢w¢w¢wúR¢w¢w¢w¢w¢q¢t"
    @ 14,UPTANK[5,1]-38  SAY "¢|¢w¢wúQ¢w¢w¢w¢w¢w¢w¢wúQ¢w¢w¢w¢w¢r¢}"
    @  4,UPTANK[5,1]   say  UPTANK[4,1]  PICT "99"
    SET COLOR TO &C2 / &C1
  ELSE
    X=SECONDS()-UPTANK[4,2]
    IF X<0
      X=86399+SECONDS()-UPTANK[4,2]
    ENDIF
    X=UPTANK[4,1]-X
    IF	X<=0
      X=0
    ENDIF
    SET  COLO TO GR+ /&C1
    @  4,UPTANK[5,1]   say  X  PICT "99"
    SET  COLO TO &C2 /&C1
  ENDIF
  IF  X<=0
    SET  COLO TO GR+  /&C1
    @  4,UPTANK[5,1]   say  X  PICT "99"
    CNVSTP=4
  ENDIF
CASE CNVSTP=4
  IF UPTKSTP=0
    UPTKSTP=4
    SET COLOR TO B+ / &C1
    @ 13,UPTANK[5,1]-2 SAY "ú^ú]ú_"
    SET COLOR TO &C2 / &C1
  ENDIF
ENDCASE
RETU
**-----------------------------------------------------------------------------
PROCEDURE  UPTANK
PARAMETERS  P1,P2,P3
DO CASE
CASE UPTKSTP=4	   .AND. (DIN(12)=1) .AND. (DIN(15)=1 ) .AND.  (TANKSTP=0)
  UPTKSTP=5
  FOR XF=GS_TOT + 1  TO GS_TOT + UWC_TOT
    IF WTANK_F[XF,1]<>1
      UPTKSTP=4
      EXIT
    ENDIF
  NEXT
CASE (UPTKSTP=5)  .AND. (DIN(12)=1) .AND. (DIN(15)=1 ) .AND.  (TANKSTP=0)
  TANKSTP=1
  UPTKSTP=6
  A_STOR_4(A_PRESS_N0,GS_TOT+1,GS_TOT+UWC_TOT)
  IF DIN(9)=1
    TANKSTP=0
    UPTKSTP=5
    SET COLOR TO R / &C1
    @ 18,40 SAY "úZúYúYúYúYúYúYúYúYúYúYúYúYúYúYúYúYúYú[ "
    SET COLOR TO &C2 / &C1
  ENDIF
  IF  UPTKSTP=6
    SET COLOR TO B+ / &C1
    @ 18,40 SAY "úZúYúYúYúYúYúYúYúYúYúYúYúYúYúYúYúYúYú[ "
    SET COLOR TO &C2 / &C1
    UPTANK[1,2]=SECONDS()
    SET COLOR TO GR +/ &C1
    @ 13,UPTANK[5,1]-2 SAY "újúKúk"
    DOUT(14,1)
    SET COLOR TO &C2 / &C1
    FOR XF=GS_TOT + 1  TO GS_TOT + UWC_TOT
      IF TIME1[XF,1] <>88
	WTANK_F[XF,1] :=-99
	WTANK_F[XF,2] :=-99
      ENDIF
    NEXT
  ENDIF
CASE UPTKSTP=6
  UPTKSTP=7
  IF (HDOK=1) .AND.( FILE("C:\LUW1.DBF")=.T.)  .and.(INT(DISKSPACE( DAA )/1024) >250 )
    E_STORE = 1
    X=_TOT_D_A[20,4] +2
    IF _TOT_D_A[17,X]=0
      E_STORE = 0
    ENDIF
    IF (E_STORE =1)
      IC_X=ALLTRIM(STR(GS_TOT+1,2,0))
      sele 1
      APPE BLAN
      REPL LUTIME  WITH TIME(),LUDATE WITH DATE(),LAG_VUSE WITH A_PRESS_N0[3,STPN&ic_x,1,6]
      X=_TOT_D_A[20,4] +2
      REPL SCANO WITH _TOT_D_A[17,X],CARNO WITH _TOT_D_A[13,X],TVUSE  WITH A_PRESS_N0[3,STPN&ic_x,1,5] ,RATNO WITH _TOT_D_A[18,X],LTANDO WITH _TOT_D_A[14,X]
      REPL PAN_NO  WITH  STPN&ic_x
    ENDIF
  ELSE
    ACTIME=TIME()
    HDOK=0
  ENDIF
  XTW=0
  IF (HDOK=1) .AND.( FILE("C:\LUW1.DBF")=.T.)  .and.(INT(DISKSPACE( DAA )/1024) >250 )
    IF (E_STORE =1)
      IC_X=ALLTRIM(STR(GS_TOT+1,2,0))
      sele 1
      FOR  X=1 TO (GS_TOT+UWC_TOT)
	XMC_F=A_M_NAME[X,3]
	IF W0DBF=1
	  A_PRESS_N0[3,STPN&ic_x,X,1] =A_PRESS_N0[3,STPN&ic_x,X,8]
	  *A_PRESS_N0[2,STPN&ic_x,X,1] =A_PRESS_N0[3,STPN&ic_x,X,8]
	ENDIF
	XTW=XTW+A_PRESS_N0[3,STPN&ic_x,X,1]+A_PRESS_N0[3,STPN&ic_x,X,2]
	XMC1=ALLTRIM(STR(X,2,0))
	repl TM&XMC1 WITH A_PRESS_N0[3,STPN&IC_X,X,1]+A_PRESS_N0[3,STPN&IC_X,X,2]
      NEXT
    ENDIF
  ELSE
    HDOK=0
  ENDIF
  IF (HDOK=1) .AND.( FILE("C:\LUW1.DBF")=.T.)  .and.(INT(DISKSPACE( DAA )/1024) >250 )
    IF (E_STORE =1)
      IC_X=ALLTRIM(STR(GS_TOT+1,2,0))
      APPE BLANK
      REPL LUTIME  WITH TIME(),LUDATE WITH DATE()
      FOR  X=1 TO (GS_TOT+UWC_TOT)
	XMC_F=A_M_NAME[X,3]
	XTW=XTW+A_PRESS_N0[3,STPN&IC_X,X,1]+A_PRESS_N0[3,STPN&IC_X,X,2]
	sele 1
	XMC1=ALLTRIM(STR(X,2,0))
	IF W0DBF=1
	  IF STANDW_ERR[X] > 0
	    IF A_PRESS_N0[3,STPN&IC_X,X,8] =0
	      A_PRESS_N0[3,STPN&IC_X,X,4]=0
	      A_PRESS_N0[2,STPN&IC_X,X,4]=0
	    ELSE
	      XF_DATA=A_PRESS_N0[3,STPN&IC_X,X,1]+A_PRESS_N0[3,STPN&IC_X,X,2]
	      IF (VAL(A_M_NAME[X,3])- INT( VAL(A_M_NAME[X,3]))) >0 && 99.99
		XF_DATA1=- STANDW_ERR[X]*100 + MOD(RAND(),(STANDW_ERR[X] * 200) +1)
		XF_DATA1=XF_DATA1/100
	      ELSE
		XF_DATA1=- STANDW_ERR[X] + MOD(RAND(),(STANDW_ERR[X] * 2) +1)
	      ENDIF
	      A_PRESS_N0[3,STPN&IC_X,X,4]=XF_DATA+XF_DATA1
	      A_PRESS_N0[2,STPN&IC_X,X,4]=XF_DATA+XF_DATA1
	    ENDIF

	  ENDIF
	ENDIF
	repl TM&XMC1 WITH A_PRESS_N0[3,STPN&IC_X,X,4]
      NEXT
    ENDIF
  ELSE
    HDOK=0
  ENDIF
  XTW=0
  IC_X=ALLTRIM(STR(GS_TOT+1,2,0))
  FOR  X=1 TO (GS_TOT+UWC_TOT)
    XMC_F=A_M_NAME[X,3]
    XTW=XTW+A_PRESS_N0[3,STPN&IC_X,X,4]
  NEXT
  IF A_PRESS_N0[3,STPN&IC_X+1,1,5]  =0
    XTWA=0
    IF (HDOK=1) .AND.( FILE("C:\SA.DBF")=.T.)  .and.(INT(DISKSPACE( DAA )/1024) >250 )
      IF (E_STORE =1)
	SELE 7
	APPEN BLAN
	COMMIT
      ENDIF
    ELSE
      HDOK=0
    ENDIF
    FOR  X=1 TO (GS_TOT+UWC_TOT)
      XMC_F="9"+A_M_NAME[X,3]
      XTW=0
      FOR XN1=1 TO STPN&IC_X
	XTW=XTW+A_PRESS_N0[3,XN1,X,4]
      NEXT
      IF (HDOK=1) .AND.( FILE("C:\SA.DBF")=.T.)  .and.(INT(DISKSPACE( DAA )/1024) >250 )
	IF (E_STORE =1)
	  SELE 7
	  XMC1=ALLTRIM(STR(X,2,0))
	  REPL TOTM&XMC1 WITH XTW
	  COMMIT
	ENDIF
      ELSE
	HDOK=0
      ENDIF
      XTWA=XTWA+XTW
    NEXT
    SET DEVI TO SCRE
    IF (HDOK=1) .AND.( FILE("C:\SA.DBF")=.T.)  .and.(INT(DISKSPACE( DAA )/1024) >250 )
      IF (E_STORE =1)
	IC_X=ALLTRIM(STR(GS_TOT+1,2,0))
	SELE 7
	REPL TOTW WITH XTWA
	X=_TOT_D_A[20,4] +2
	REPL SCANO WITH _TOT_D_A[17,X],CARDRV WITH _TOT_D_A[15,X],US2 WITH _TOT_D_A[16,X],LAGTTW WITH _TOT_D_A[11,X],TANDO WITH _TOT_D_A[14,X]
	repl  p1702  with  _TOT_D_A[4,X],TOTVUSE WITH A_PRESS_N0[3,STPN&IC_X,1,6]
	REPL LUDATE WITH DATE(),LUTIME WITH TIME(),RATNO WITH  _TOT_D_A[18,X]
	repl  U_PRICE WITH _TOT_D_A[21,X],CARNO WITH _TOT_D_A[13,X]
	COMMIT
      ENDIF
    ELSE
      HDOK=0
    ENDIF
  ENDIF

  IF (RDLPT(val(aport)-1)=144) .AND. (E_STORE =1)
    SET CONS OFF
    do case
    case aport="1"
      set print to lpt1
      ? chr(27) + "SP1;"
    case aport="2"
      set print to lpt2
      ? chr(27) + "SP2;"
    case aport="3"
      set print to lpt3
      ? chr(27) + "sp3;"
    endcase
    IC_X=ALLTRIM(STR(GS_TOT+1,2,0))
    SET DEVI TO PRINT
    @ PROW(),6	SAY  STPN&IC_X	PICT "99"
    @ PROW(),10    SAY	TIME()
    @ PROW(),18    SAY	A_PRESS_N0[3,STPN&IC_X,1,5]  PICT "99.9"
    @ PROW(),25    SAY	A_PRESS_N0[3,STPN&IC_X,1,6]  PICT "99.9"
    @ PROW()+1,1  SAY  " "
    XTW=0
    FOR  X=1 TO (GS_TOT+UWC_TOT)
      XMC_F=A_M_NAME[X,3]
      XTW=XTW+A_PRESS_N0[3,STPN&IC_X,X,1]+A_PRESS_N0[3,STPN&IC_X,X,2]
      @ PROW(),6*(X-1)+2  SAY	A_PRESS_N0[3,STPN&IC_X,X,1]+A_PRESS_N0[3,STPN&IC_X,X,2]   PICT "&XMC_F"
    NEXT
    @ PROW(),74  SAY   XTW  PICT "99999"
    @ PROW()+1,1  SAY  " "
    XTW=0
    FOR  X=1 TO (GS_TOT+UWC_TOT)
      XMC_F=A_M_NAME[X,3]
      XTW=XTW+A_PRESS_N0[3,STPN&IC_X,X,4]
      @ PROW(),6*(X-1)+2  SAY	A_PRESS_N0[3,STPN&IC_X,X,4]  PICT "&XMC_F"
    NEXT
    @ PROW(),74  SAY   XTW  PICT "99999"
    @ PROW()+1,1  SAY  " "
    IF A_PRESS_N0[3,STPN&IC_X+1,1,5]  =0
      @ PROW(),1 SAY   "-----------------------------------------------------------------------------"
      @ PROW()+1,1  SAY  " "
      XTWA=0
      FOR  X=1 TO (GS_TOT+UWC_TOT)
	XMC_F="9"+A_M_NAME[X,3]
	XTW=0
	FOR XN1=1 TO STPN&IC_X
	  XTW=XTW+A_PRESS_N0[3,XN1,X,4]
	NEXT
	@ PROW(),6*(X-1)+1  SAY   XTW	PICT "&XMC_F"
	XTWA=XTWA+XTW
      NEXT
      @ PROW(),73  SAY	 XTWA  PICT "999999"
      @ PROW()+1,1  SAY   " "
    ENDIF
    SET DEVI TO SCRE
  endif
  IC_X=ALLTRIM(STR(GS_TOT+1,2,0))
  IF A_PRESS_N0[3,STPN&IC_X + 1,1,5]  =0
    x=1
    IF X=1
      X=_TOT_D_A[20,3]
      IF X=0
	_TOT_D_A[20,4] :=0
      ELSE
	_TOT_D_A[20,4] :=X
	_TOT_D_A[20,3] :=0
      ENDIF
    ENDIF

  ENDIF
  SET CONS ON
CASE UPTKSTP=7
  IF  DIN(15)=0
    DOUT(14,0)
    UPTANK[1,2]=SECONDS()
    SET COLOR TO R +/ &C1
    @  7,UPTANK[5,1]   say  UPTANK[1,1]  PICT "99"
    @ 13,UPTANK[5,1]-2 SAY "újúKúk"
    SET COLOR TO &C2 / &C1
  ELSE
    X=SECONDS()-UPTANK[1,2]
    IF X<0
      X=86399+SECONDS()-UPTANK[1,2]
    ENDIF
    X=UPTANK[1,1]-X
    IF	X<=0
      X=0
    ENDIF
    SET  COLO TO GR+ /&C1
    @  7,UPTANK[5,1]   say  X  PICT "99"
    SET  COLO TO &C2 /&C1
  ENDIF
  IF  X<=0
    UPTKSTP=8
    UPTANK[2,2]=SECONDS()
    SET  COLO TO W+ /&C1
    @  7,UPTANK[5,1]   say  UPTANK[1,1]  PICT "99"
    SET COLOR TO B+ / &C1
    @ 13,UPTANK[5,1]-2 SAY "ú^ú]ú_"
    SET COLOR TO &C2 / &C1
    DOUT(14,0)
  ENDIF
CASE UPTKSTP=8
  IF  DIN(15)=0
    DOUT(14,0)
    UPTANK[2,2]=SECONDS()
    SET COLOR TO R +/ &C1
    @  9,UPTANK[5,1]   say  UPTANK[2,1]  PICT "99"
    @ 13,UPTANK[5,1]-2 SAY "ú^ú]ú_"
    SET COLOR TO &C2 / &C1
  ELSE
    X=SECONDS()-UPTANK[2,2]
    IF X<0
      X=86399+SECONDS()-UPTANK[2,2]
    ENDIF
    X=UPTANK[2,1]-X
    IF	X<=0
      X=0
    ENDIF
    SET  COLO TO GR+ /&C1
    @  9,UPTANK[5,1]   say  X  PICT "99"
    SET  COLO TO &C2 /&C1
  ENDIF
  IF  X<=0
    DO	CASE
    CASE UCHTYPE=5   .OR. UCHTYPE=6    .OR. UCHTYPE=7  .or.  UCHTYPE=8
      CNVSTP=0
    ENDCASE
    SET  COLO TO W+ /&C1
    UPTANK[3,2]=SECONDS()
    @  9,UPTANK[5,1]   say  UPTANK[2,1]  PICT "99"
    UPTKSTP=9
    SET COLOR TO GR +/ &C1
    @ 13,UPTANK[5,1]-2 SAY "újúKúk"
    SET COLOR TO &C2 / &C1
    DOUT(14,1)
  ENDIF
CASE UPTKSTP=9
  IF  DIN(15)=0
    DOUT(14,0)
    UPTANK[3,2]=SECONDS()
    SET COLOR TO R +/ &C1
    @ 11,UPTANK[5,1]   say  UPTANK[3,1]  PICT "99"
    @ 13,UPTANK[5,1]-2 SAY "újúKúk"
    SET COLOR TO &C2 / &C1
  ELSE
    X=SECONDS()-UPTANK[3,2]
    IF X<0
      X=86399+SECONDS()-UPTANK[3,2]
    ENDIF
    X=UPTANK[3,1]-X
    IF	X<=0
      X=0
    ENDIF
    SET  COLO TO GR+ /&C1
    @  11,UPTANK[5,1]	say  X	PICT "99"
    SET  COLO TO &C2 /&C1
  ENDIF
  IF  X<=0
    SET  COLO TO W+ /&C1
    @  11,UPTANK[5,1]	say  UPTANK[3,1]  PICT "99"
    UPTKSTP=10
    SET COLOR TO W  / &C1
    @ 13,UPTANK[5,1]-2	SAY "úG--úH"
    IF CNVSTP=0
      SET  COLO TO W+	/&C1
      @  4,UPTANK[5,1]	 say  UPTANK[4,1]  PICT "99"
      SET COLOR TO &C2 / &C1
    ENDIF
    DOUT(14,0)
  ENDIF
CASE UPTKSTP=10
  UPTKSTP=11
  DOUT(14,0)
  FOR XF=GS_TOT + 1  TO GS_TOT + UWC_TOT
    IF WTANK_F[XF,2]<>1
      UPTKSTP=11
      EXIT
    ENDIF
  NEXT
CASE UPTKSTP=11
   DO  CASE
   CASE (UCHTYPE=1) .OR.  (UCHTYPE=2)
     CNVSTP=0
   ENDCASE
   UPTKSTP=0
ENDCASE
RETU
**-----------------------------------------------------------------------------
PROCEDURE  TANKSTP0
PARAMETERS  P1,P2,P3
DO CASE
CASE   TANKSTP=0
CASE  TANKSTP=1 .AND. (DIN(9)=0)   .AND. (DIN(12)=1)
  tankstp=2
  SET COLOR TO &C7 +/ &C1
  MIXTM=0
  MIXTM_S=SECONDS()
  PAUSE_TM=0
  @ 17,64 SAY "   "
  if lchtype >= 5
    IF LAGDATE=DATE()
      LAGW=LAGW+ A_PRESS_N0[U_PRESS,stpn6,6,5]
    ELSE
      LAGW=VUSE
      LAGDATE=DATE()
    ENDIF
    SAVE TO LAGDATA9 ALL LIKE LAG*
    @ 0,26 SAY	LAGW   PICT  "9999.9"
    ACT_V  =LAGW+ A_PRESS_N0[U_PRESS,stpn6,6,6]
    @ 17,12 SAY  A_PRESS_N0[U_PRESS,stpn6,6,6]	PICT  "99.9"
  endif
CASE  TANKSTP=2
  *@ 17,23 SAY "¢u¢w¢w¢t¢u¢w¢w¢t¢x  ¹ê»Ú­È    ¬í     ¢Ï     ¬í      KG¢x"
  *PMIXTM
  IF DIN(15)=0	 && PAUSE
    MIXTM_S=SECONDS()
  ELSE
    IF ABS(SECONDS()-MIXTM_S)>=1
      MIXTM=MIXTM+1
      MIXTM_S=SECONDS()
    ENDIF
  ENDIF
  SET COLO TO  GR+ /&C1
  @ 17,51 SAY MIXTM  PICT "999"
  SET COLO TO  &C2 /&C1
  IF  MIXTM>=PMIXTM
    TANKSTP=3
  ENDIF
  FOR XF=GS_TOT+1  TO (GS_TOT +UWC_TOT)
    IF TIME1[XF,1] <>88
      IF WTANK_F[XF,2]<>1
	TANKSTP=2
	EXIT
      ENDIF
    ENDIF
  NEXT
  IF TANKSTP=3
    FOR  I=GS_TOT+1  TO (GS_TOT +UWC_TOT)
      WTANK_F[I,2] :=0
    NEXT
  ENDIF
  IF DIN(15)=0	 && PAUSE
    MIXTM_S=SECONDS()
  ELSE
    IF ABS(SECONDS()-MIXTM_S)>=1
      MIXTM=MIXTM+1
      MIXTM_S=SECONDS()
    ENDIF
  ENDIF
  SET COLO TO  GR+ /&C1
  @ 17,51 SAY MIXTM  PICT "999"
  SET COLO TO  &C2 /&C1
CASE  TANKSTP=3
  TANKSTP=4
CASE  TANKSTP=4 .AND.DIN(15)=1
  IF INT((MIXA()-2048)*MAIN_AMP/2048)<=PMIXA
    TANKSTP=5
    DROPTM_S=SECONDS()
    DROPTM=0
    X=1
    FOR IX=(GS_TOT+1) TO (GS_TOT+UWC_TOT)
      IF WTANK_F[IX,3]=0
	X=0
	EXIT
      ENDIF
    NEXT
    IF X=1
     &&DOUT(12,1)
      BEEP=1
      FOR IX=(GS_TOT+1) TO (GS_TOT+UWC_TOT)
	WTANK_F[IX,3]=0
      NEXT
    ELSE
      BEEP=0
    ENDIF
  ENDIF
  IF DIN(15)=0	 && PAUSE
    MIXTM_S=SECONDS()
  ELSE
    IF ABS(SECONDS()-MIXTM_S)>=1
      MIXTM=MIXTM+1
      MIXTM_S=SECONDS()
    ENDIF
  ENDIF
  SET COLO TO  GR+ /&C1
  @ 17,51 SAY MIXTM  PICT "999"
  SET COLO TO  &C2 /&C1
CASE  TANKSTP=5
  IF DIN(13)=1
    SET COLOR TO &C10 / &C1
    @ 18,40 SAY "úLúPúPúPúPúPúPúPúKúPúPúPúPúPúPúPúPúPúO"
  ELSE
    SET COLOR TO R+   / &C1
    @ 18,40 SAY "úLúPúPúPúPúPúPúPúKúPúPúPúPúPúPúPúPúPúO"
  ENDIF
  SET COLOR TO &C7 +/ &C1
  IF DIN(15)=0	 && PAUSE
    DROPTM_S=SECONDS()
    DROPTM=0
    DOUT(15,0)
  ELSE
    IF DIN(13)=1
      IF DIN(9)=0
	DROPT_S=SECONDS()
	DROPTM=0
	DOUT(12,0)
      ELSE
	IF BEEP=1
	  DOUT(12,1)
	ENDIF
      ENDIF
      IF ABS(SECONDS()-DROPTM_S)>=1
	DROPTM=DROPTM+1
	DROPTM_S=SECONDS()
      ENDIF
      DOUT(15,1)
    ELSE
      DROPTM_S=SECONDS()
      DROPTM=0
      DOUT(15,0)
    ENDIF
  ENDIF
  IF DROPTM >=PMIXOP
    TANKSTP=6
  ENDIF
  SET COLO TO  W + /&C1
  @ 17,64 SAY  DROPTM	PICT  "999"
  SET COLO TO  &C2 /&C1
CASE  TANKSTP=6
  DOUT(15,0)  &&MAIN M/C DOOR
  DOUT(12,0)  && LAST ALARM
  X=1
  FOR IX=1 TO 12
    IF WTANK_F[IX,3]=0
      X=0
      EXIT
    ENDIF
  NEXT
  IF X=1
    FOR IX=1 TO 12
      WTANK_F[IX,3] :=0
    NEXT
    ACT_V=-1
    @ 15,12 SAY "    "
    @ 16,12 SAY "    "
    @ 17,12 SAY "    "
  ENDIF
  SET COLOR TO &C2 / &C1
  @ 18,40 SAY "úLúPúPúPúPúPúPúPúPúPúPúPúPúPúPúPúPúPúO"
  SET COLOR TO &C7 +/ &C1
  @ 17,64 SAY  "   "
  @ 17,51 SAY "   "
  TANKSTP=0
ENDCASE

**-----------------------------------------------------------------------------
PROCEDURE  OUTDATA_RST
PARAMETERS  P1,P2,P3
** <<<<<¥þ¤W«¬±M¥Î>>>>>    XF_DATA=A_PRESS_N0[3,STPN&IC_X,X,1]+A_PRESS_N0[3,STPN&IC_X,X,2]
DRSTX=STPN7
FOR  X=1  TO (GS_TOT+UWC_TOT)
  A_PRESS_N0[2,DRSTX,X,9]=A_PRESS_N0[2,DRSTX,X,4]
  IC_X=NTOC(X)
  *IF (W0DBF=1)
  *  ntmp1= A_PRESS_N0[2,DRSTX,X,1]
  *  A_PRESS_N0[2,DRSTX,X,1]= A_PRESS_N0[2,DRSTX,X,8]
  * *  A_PRESS_N0[2,DRSTX,X,8]= ntmp1
  *ENDIF
  IF STANDW_ERR[X] > 0
    IF A_PRESS_N0[2,DRSTX,X,8] =0
      A_PRESS_N0[2,DRSTX,X,9]=0
    ELSE
      XF_DATA=A_PRESS_N0[2,DRSTX,X,8]+A_PRESS_N0[2,DRSTX,X,2]
      IF (VAL(A_M_NAME[X,3])- INT( VAL(A_M_NAME[X,3]))) >0 && 99.99
	XF_DATA1=- STANDW_ERR[X]*100 + MOD(RAND(),(STANDW_ERR[X] * 200) +1)
	XF_DATA1=XF_DATA1/100
      ELSE
	XF_DATA1=- STANDW_ERR[X] + MOD(RAND(),(STANDW_ERR[X] * 2) +1)
      ENDIF
      IF   ABS(XF_DATA-A_PRESS_N0[2,DRSTX,X,4]) > STANDW_ERR[X]
	A_PRESS_N0[2,DRSTX,X,9]=XF_DATA+XF_DATA1
      ENDIF
    ENDIF
  ENDIF
  NEXT
RETU
