  dbGoto(X_CKBN)
ENDIF
retu

PROCEDURE  CHKREP_PNT
PARAMETERS  P1,P2,P3
X_CKBN=RECNO()
dbSelectArea( "7" )
XN_FILT := 0 ; DBEval( {|| XN_FILT := XN_FILT + 1},,,,, .F. )
X_PREGET := 0 ; DBEval( {|| X_PREGET := X_PREGET + TTVUSE *U_PRICE},,,,, .F. )
IF  XN_FILT  <=0
  XN_FILT  =1
ENDIF
XNA_FILT=1
dbGoTop()
while !    EOF()
  KK="PNT_OK&BPORT"+ "()"
  KK=&KK
  x= RDLPT(VAL(bPORT)-1)
  IF (x =144)  .OR. (x=pnt_redy_code)
      Set( 17, "On" )
    Set( 24, "lpt&BPORT", .F. )
    QOut( chr(27) + "sp&BPORT;" )
      Set( 17, "ON" )
    Set( 20, "PRINTER" )
    SetPntWx("5")
    DevPos( PROW(), 2 ) ; DevOut( CHR(27)+"C"+CHR(33) )
    SETPRC(0,PCOL())
    DevPos( 1, 5 ) ; DevOut( XMAKER_2 )
    DevPos( 2, 5 ) ; DevOut( XMAKER_3 )
    DevPos( 2, 31 ) ; DevOut( SDATE )
    DevPos( 2, 52 ) ; DevOut( EDATE )
    DevPos( 2, 73 ) ; DevOutPict( XNA_FILT, "999" )
    DevPos( 2, 76 ) ; DevOut( "/" )
    DevPos( 2, 77 ) ; DevOut( LTRIM(STR(INT((XN_FILT/10)+0.9),3,0)) )
    XN_LINE=1
      DevPos( PROW()+2, 3 ) ; DevOut( " " )
    while (! EOF()) .AND. XN_LINE <=10
      DevPos( PROW()+2, 1 ) ; DevOut( SUBSTR(DTOC(LUDATE),1,5) )
      DevPos( PROW(), 10 ) ; DevOutPict( INT(RATNO/10), "9999" )
      DevPos( PROW(), 19 ) ; DevOutPict( TTVUSE, "99.9" )
      DevPos( PROW(), 27 ) ; DevOutPict( U_PRICE, "9999" )
      DevPos( PROW(), 35 ) ; DevOutPict( TTVUSE *U_PRICE, "999999" )
      DevPos( PROW(), 47 ) ; DevOutPict( 1, "9" )
      DevPos( PROW(), 51 ) ; DevOut( SUBSTR(ALLTRIM(P1702),1,20) )
      DevPos( PROW(), 70 ) ; DevOut( "00" +LTRIM(STR(LAGNO1,6,0)) )
      dbSkip(1)
      XN_LINE=XN_LINE+1
    ENDDO
    DevPos( 26, 12 ) ; DevOutPict( XN_PREGET, "99999999" )
    DevPos( 26, 57 ) ; DevOutPict( XN_FILT, "999" )
    DevPos( 28, 12 ) ; DevOutPict( XN_LSTBIL, "99999999" )
    DevPos( 28, 40 ) ; DevOutPict( X_PREGET, "99999999" )
    DevPos( 28, 64 ) ; DevOutPict( (X_PREGET -XN_PREGET +XN_LSTBIL), "99999999" )
    __Eject()
  ELSE
    EXIT
  ENDIF
ENDDO
Set( 20, "SCREEN" )
dbGoto(X_CKBN)
retu


PROCEDURE  CHKREPALL_PNT
PARAMETERS  P1,P2,P3
dbSelectArea( "9" )
dbCreateIndex( "US2", "US2", {|| US2}, if( .T., .T., NIL ) )
if !.F. ; ordListClear() ; end; ordListAdd( "US2" )
dbGoTop()
while !EOF()
  XMAKER=US2
  X_P1501=XMAKER
  IF EMPTY(X_P1501)=.F.
    dbSelectArea( "11" )
    __dbLocate( {||    alltrim(P1501)==alltrim(X_P1501)},,,, .F. )
    IF    !  EOF()
      XMAKER_2=SUBSTR(LTRIM(P1502),1,22)
      XMAKER_3=P1503
    ELSE
      XMAKER_2="                      "
    ENDIF
  ENDIF
  dbSelectArea( "15" )
  XN_PREGET := 0 ; DBEval( {|| XN_PREGET := XN_PREGET + PRE_GET}, {|| (LUDATE >= SDATE ) .AND. (LUDATE <= EDATE ) .AND. US2=XMAKER},,,, .F. )
  XN_LSTBIL := 0 ; DBEval( {|| XN_LSTBIL := XN_LSTBIL + LST_BILL}, {|| (LUDATE >= SDATE ) .AND. (LUDATE <= EDATE ) .AND. US2=XMAKER},,,, .F. )
  dbSelectArea( "7" )
  dbSetFilter( {||    (LUDATE >= SDATE ) .AND. (LUDATE <= EDATE ) .AND. (US2=XMAKER    )}, "(LUDATE >= SDATE ) .AND. (LUDATE <= EDATE ) .AND. (US2=XMAKER    )" )
  dbGoTop()
  x= RDLPT(VAL(BPORT)-1)
  IF (x =144)  .OR. (x=pnt_redy_code)
    DO    CHKREP_PNT
  ELSE
    EXIT
  ENDIF
  dbSelectArea( "9" )
  dbSkip(1)
ENDDO
if !.F. ; ordListClear() ; end

