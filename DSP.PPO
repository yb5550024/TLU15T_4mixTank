PROCEDURE  MONI_INI
PARAMETERS  P1,P2,P3
PUBLIC    I00,I01,I02,I03,I04,I05,I06,I07,I08,I09,I010,I011,I012,I013,I014,I015
PUBLIC    ACT_W1,ACT_W2,ACT_W3,ACT_W4,ACT_W5   
PUBLIC    DB_1,DB_2,DB_3,DB_4,DB_5   
PUBLIC    DBTIME_1,DBTIME_2,DBTIME_3,DBTIME_4,DBTIME_5
PUBLIC    ZERTIME_1,ZERTIME_2,ZERTIME_3
PUBLIC    W_ZERO1,W_ZERO2,W_ZERO3,W_ZERO4,W_ZERO5  
PUBLIC    W_1,W_2,W_3,W_4,W_5  
PUBLIC    F_IN1,F_IN2,F_IN3,F_IN4,F_IN5
PUBLIC    F_OUT1,F_OUT2,F_OUT3,F_DROW
PUBLIC    FUL_W1,FUL_W2,FUL_W3,FUL_W4,FUL_W5
PUBLIC    ZER_W1,ZER_W2,ZER_W3,CRT_DSP_ALL,MMOVKG1,MMOVKG2,MMOVKG3,MMOVKG4,MNIDSP
I00 := I01 := I02 := I03 := I04 := I05 := I06 := I07 := I08 := I09 := I010 := I011 := I012 := I013 := I014 := I015 := 0
ACT_W1 := ACT_W2 := ACT_W3 := ACT_W4 := ACT_W5 := 0   
DB_1 := DB_2 := DB_3 := DB_4 := DB_5 := 0   
DBTIME_1 := DBTIME_2 := DBTIME_3 := DBTIME_4 := DBTIME_5 := 0
ZERTIME_1 := ZERTIME_2 := ZERTIME_3 := MNIDSP := 0
W_ZERO1 := W_ZERO2 := W_ZERO3 := W_ZERO4 := W_ZERO5 := 0  
W_1 := W_2 := W_3 := W_4 := W_5 := 0  
F_IN1 := F_IN2 := F_IN3 := F_IN4 := F_IN5 := 0
F_OUT1 := F_OUT2 := F_OUT3 := F_DROW := 0
FUL_W1 := FUL_W2 := FUL_W3 := FUL_W4 := FUL_W5 := 0
ZER_W1 := ZER_W2 := ZER_W3 := CRT_DSP_ALL := 0
MMOVKG1=SMOVKG5
MMOVKG2=SMOVKG6
MMOVKG3=SMOVKG6
RETU

FUNCTION  D_READ
PARAMETERS  XN
XCN=ALLTRIM(STR(INT(XN),1,0))
PN=XN-1
XCP=ALLTRIM(STR(INT(XN-1),1,0))
IF DIN2(PN)=1
  DB_&XCN=1
  F_IN&XCN=1
  XX=STR(INT((XN+1)/2),1,0)
  DBTIME_&XCN=SECONDS()
  IF F_OUT&XX=1
    F_OUT&XX=0
    W_ZERO&XX=W_&XX
  ENDIF
ELSE
  IF DB_&XCN=1
    IF ABS(SECONDS()-DBTIME_&XCN) >=RDT_&XCN
      DBTIME_&XCN=SECONDS()
      _CAL_M&XCN=1
      DB_&XCN=0
      IF XN=3
      DB_2=0
      FUL_W2=1
      ENDIF
      FUL_W&XCN=1
    ENDIF
  ELSE
    DBTIME_&XCN=SECONDS()
    DB_&XCN=0
  ENDIF
ENDIF
IF  DB_&XCN=1
  DO CASE
  CASE XN=1
      ACT_W1=W_1 -W_ZERO1
  CASE XN=2
    IF FUL_W2=0
      ACT_W&XCN=W_2-W_ZERO2
    ELSE
      ACT_W2=ACT_W2 +(W_2 -W_ZERO2-ACT_W2-ACT_W3)
    ENDIF
  CASE XN=3
    IF FUL_W3=0
      ACT_W3=W_2 -ACT_W2-W_ZERO2
    ELSE
      ACT_W3=ACT_W3 +(W_2 -W_ZERO2-ACT_W2-ACT_W3)
    ENDIF
  ENDCASE
  IF MNIDSP=1
    DSPB_DATA(XN)
  ENDIF
ENDIF
RETU

FUNCTION  OUT_READ
PARAMETERS  XN

XCN=ALLTRIM(STR(INT(XN),1,0))
PN=XN-1
XCP=ALLTRIM(STR(INT(XN-1),1,0))
IF DIN2(PN+9)=1
  DO CASE
  CASE    XN=1 .AND. F_IN1=1
    DB_1=0
    IF    F_IN1=1  .AND. (ACT_W1 >=1 )
      IF DIN2(15)=0
    dbSelectArea( "6" )
    dbGoBottom()
    IF (TCO1 >0 )  .OR. BOF()
      dbAppend()
      _FIELD->LUDATE := DATE(); _FIELD->LUTIME := TIME()
    ENDIF
    IF   (TCO2 =0) .AND. (TCO3 =0)
      _FIELD->LUDATE := DATE(); _FIELD->LUTIME := TIME()
    ENDIF
    _FIELD->TCO1 := ACT_W1
    dbCommitAll()
      ENDIF
    ENDIF
    ACT_W1=0
    F_IN1=0
    FUL_W1=0
    IF MNIDSP=1
      DSPB_DATA(1)
    ENDIF
  CASE    XN=2 .AND. (F_IN2=1   .OR. F_IN3=1)
    DB_2=0
    DB_3=0
    IF    F_IN2=1  .AND. (ACT_W2 >=1 )
      IF DIN2(15)=0
    dbSelectArea( "6" )
    dbGoBottom()
    IF (TCO2 >0)   .OR. BOF()
      dbAppend()
      _FIELD->LUDATE := DATE(); _FIELD->LUTIME := TIME()
    ENDIF
    IF   (TCO1 =0) .AND. (TCO3 =0)
      _FIELD->LUDATE := DATE(); _FIELD->LUTIME := TIME()
    ENDIF
    _FIELD->TCO2 := ACT_W2
      ENDIF
    ENDIF
    IF    F_IN3=1  .AND. (ACT_W3 >=1 )
      IF DIN2(15)=0
    dbSelectArea( "6" )
    dbGoBottom()
    IF (TCO3 >0)   .OR. BOF()
      dbAppend()
      _FIELD->LUDATE := DATE(); _FIELD->LUTIME := TIME()
    ENDIF
    IF   (TCO1 =0) .AND. (TCO2 =0)
      _FIELD->LUDATE := DATE(); _FIELD->LUTIME := TIME()
    ENDIF
    _FIELD->TCO3 := ACT_W3
      ENDIF
    ENDIF
      dbCommitAll()
    F_IN2=0
    F_IN3=0
    FUL_W2=0
    FUL_W3=0
    ACT_W2=0
    ACT_W3=0
    IF MNIDSP=1
      DSPB_DATA(2)
      DSPB_DATA(3)
    ENDIF
  ENDCASE
  F_OUT&XCN=1
  ZERTIME_&XCN=SECONDS()
ELSE
  IF F_OUT&XCN=1   .AND. (ABS(SECONDS()-ZERTIME_&XCN)>=Z_RDT_&XCN)
    F_OUT&XCN=0
    W_ZERO&XCN=W_&XCN
  ENDIF
ENDIF
RETU

FUNCTION  DSPB_DATA
PARAMETERS  XM
XCS=ALLTRIM(STR(INT(XM),1,0))
XN=INT(XM-1)
X=ALLTRIM(STR(INT(XM+4),1,0))
X_DATA=ACT_W&XCS
XC_DATA=STR(X_DATA,5,0)
DevPos( 1, 20+9*xm ) ; DevOut( xc_data )
SetColor( "&C7 +/ &C1" )
RETU X_DATA

PROCEDURE  MONI
PARAMETERS  P1,P2,P3
XS=1
FOR XS=1 TO 3    STEP 1
  D_READ(XS)
NEXT
XS=1
FOR XS=1 TO 2    STEP 1
  OUT_READ(XS)
NEXT
IF DIN2(14)=1
  IF  F_DROW=0
    F_DROW=1
    dbSelectArea( "6" )
    dbGoBottom()
    IF    (TCO1 <>0) .OR. (TCO2 <>0) .OR. (TCO3 <>0)   .OR. BOF()
       dbAppend()
    ENDIF
  ENDIF
ELSE
  F_DROW=0
ENDIF
RETU

FUNCTION SER_NO
PARAMETERS  XM
T_SER=""
XS=1
XN=7
SER_STP=1
while (SER_STP <=XM)  .AND. (T <>13)
  T=0
  while T =0
    T=INKEY()
  ENDDO
  IF  T <>13
    T_SER=T_SER +UPPER(CHR(T))
  ENDIF
  SER_STP=SER_STP +1
ENDDO
RETU T_SER

FUNCTION SER_OK_DEL
SER_X1=SUBSTR(DTOC(DATE()),1,2)+SUBSTR(DTOC(DATE()),4,2)
SER_X2="YB0246"
SER_X3="24652268"
SER_OK=0
  SER_C=""
FOR  XN=1 TO  8
  T=0
  while T =0
    T=INKEY()
  ENDDO
  IF  T<>13
    SER_C=SER_C+CHR(T)
  ELSE
    XN=99
  ENDIF
NEXT
IF  (ALLTRIM(SER_C)=SER_X1) .OR. (ALLTRIM(SER_C)=SER_X2)   .OR. (ALLTRIM(SER_C)=SER_X3)
  SER_OK=1
ENDIF
RETU SER_OK


