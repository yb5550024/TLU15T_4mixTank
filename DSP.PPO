FUNCTION READ_A
PARAMETERS  RDY1,RDX1,PX,D_TYPE,LONG,N_DASH,TNSTP,C_FUNC,RisDatachg   


RisDatachg=0
last_key=0
XPX=pX
RDX1=RDX1
SetColor( "0/7+" )
DO CASE
CASE   D_TYPE="N"
  IF ((N_DASH=0 )  .AND. (XPX -INT(XPX) <>0) )
    CHRN=LTRIM(STR(XPX,LONG+3,2))
    XLN1=LEN(CHRN)
    IF XLN1 < LONG
      CHRN=SUBSTR("       ",1,LONG-XLN1) + CHRN
    ELSE
      CHRN=SUBSTR(CHRN,1,LONG)
    ENDIF
  ELSE
    CHRN=STR(XPX,LONG,N_DASH)
  ENDIF
CASE   D_TYPE="C"
  CHRN=SUBSTR(XPX,1,LONG)
CASE   D_TYPE="D"
  CHRN=DTOC(XPX)
  LONG=10
ENDCASE
SetColor( "0 + /7" )
DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
XP=0
t=0
SetColor( "W+  / R" )
DevPos( RDY1, (RDX1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
SetColor( "7/0" )
XX1=RDX1+XP
YY1=RDY1
T1=0
TN1=0
while T1<>233
  T=0
  dbSelectArea( LUDBF )
  while T=0
    IF (T0A <>0) .AND. (DSP_SCALL=1) .AND. (LUSTP_EN=1)
      T=T0A
      T0A=0
    ELSE
      T=INKEY()
    ENDIF
    IF (DLA_DSP=1)  .AND.  (DSP_SCALL=1)
      DO DSP2
    ENDIF
    IF (T0A=0    ) .AND. (LUSTP_EN=1)
       DO LUSTP
    ENDIF
  ENDDO
  dbSelectArea( LUDBF )
  _LASTKEY=T
  last_key=t
  DO CASE
  CASE T=-4
    IF    EMPTY(F5_FUNC) =.F.
      F5_ACT=1
      IF F5_FUNC <>"0"
    DO &F5_FUNC
      ELSE
    T1=233
    TNSTP=99
      ENDIF
      F5_ACT=0
    ENDIF
  CASE T=-6
    IF    EMPTY(F7_FUNC) =.F.
      F7_ACT=1
      IF F7_FUNC <>"0"
    DO &F7_FUNC  with  -6
      ELSE
    T1=233
    TNSTP=99
      ENDIF
      F7_ACT=0
    ENDIF
  CASE T=-7
    IF    EMPTY(F8_FUNC) =.F.
      F7_ACT=0
      IF F8_FUNC <>"0"
    DO &F8_FUNC  with  -7
      ELSE
    T1=233
    TNSTP=99
      ENDIF
    ENDIF
  CASE T=-8
    IF    EMPTY(F9_FUNC) =.F.
      F7_ACT=0
      IF F9_FUNC <>"0"
    RET_DNX ={0,0,0} 
    DO &F9_FUNC  with  -8,@RET_DNX
    T1=233
    TNSTP=99
    IF RET_DNX[3] <>0
      T=RET_DNX[3]
      TNSTP=98
    ENDIF
      ELSE
    T1=233
    TNSTP=99
      ENDIF
    ENDIF
  CASE    T=28 .AND. ( C_FUNC <> " ")
    DO &C_FUNC
    T=0
    XP=0
    SetColor( "0/7 +" )
    DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
    SetColor( "&C1 +/ 7 +" )
    DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
    SetColor( "W+  / R" )
    DevPos( RDY1, (RDX1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
  case    T=7
    RisDatachg=1
      DO CASE
      CASE  D_TYPE <> "D"
    CHRN=SUBSTR(CHRN,1,XP) +SUBSTR(CHRN,XP+2,LONG-XP-1) + " "
      ENDCASE
      SetColor( "0/7 +" )
      DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
      SetColor( "W+  / R" )
      DevPos( RDY1, (RDX1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
      SetColor( "&C7 +/ &C1" )
      XX1=RDX1+XP
      YY1=RDY1
   CASE T=-9 .AND. _modi="YY"
    RisDatachg=1
     dbSelectArea( N_SELE )
     dbDelete()
     __dbPack()
     dbGoto(N_REC)
     IF  EOF()
       dbSkip( -1 )
       N_YN=N_YN  -1
       IF N_YN < Y1_N
     N_YN=Y1_N
       ENDIF
     ENDIF
     IF  BOF()
       dbGoto(1)
       N_YN=Y1_N
     ENDIF
     IF  EOF()
       dbAppend()
       N_YN=Y1_N
     ENDIF
     N_YNO=N_YN
     N_REC=RECNO()
     N_RECO=N_REC
     dbSkip( - (N_YN -Y1_N  ) )
     SetColor( "W+ / BL" )
     DO _DSP_ALL
     SetColor( "b / W+" )
     N_REC=N_RECO
     dbGoto(N_REC)
     N_YN=N_YNO
     _REC_DSP(N_YN)
     N_REC=N_RECO
     N_YN=N_YNO
     dbGoto(N_REC)
     _DATA_MODIFY =1



     R_CB=ARR_REC_NAME[tnstp]
     XPX = &R_CB
     DO CASE
     CASE   D_TYPE="N"
       CHRN=STR(XPX,LONG,N_DASH)
     CASE   D_TYPE="C"
       CHRN=SUBSTR(XPX,1,LONG)
     CASE   D_TYPE="D"
       CHRN=DTOC(XPX)
       LONG=10
     ENDCASE
     px=chrn
     T=0
     rdy1=n_yn
  case    T=19
    IF XP>=1
      XP=XP-1
      DO CASE
      CASE  D_TYPE="D"
    IF XP=2 .OR.  XP=5
      XP=XP-1
    ENDIF
      ENDCASE
      SetColor( "0/7 +" )
      DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
      SetColor( "W+  / R" )
      DevPos( RDY1, (RDX1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
      SetColor( "&C7 +/ &C1" )
      XX1=RDX1+XP
      YY1=RDY1
    ENDIF
  CASE    T=4
    IF XP<=LONG-2
      XP=XP+1
      DO CASE
      CASE  D_TYPE="D"
    IF XP=2 .OR.  XP=5
      XP=XP+1
    ENDIF
      ENDCASE
      SetColor( "0/7 +" )
      DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
      SetColor( "&C1 +/ 7 +" )
      DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
      SetColor( "W+  / R" )
      DevPos( RDY1, (RDX1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
      SetColor( "&C7 +/ &C1" )
      XX1=RDX1+XP
      YY1=RDY1
    ENDIF
  CASE     T>=32
    RisDatachg=1
    XP=XP+1
    IF TN1=0 .AND. XP=1
      TN1=1
      DO CASE
      CASE  D_TYPE <> "D"
    CHRN=SPACE(LONG)
      ENDCASE
    ENDIF
    IF XP<LONG
      CHRN=SUBSTR(CHRN,1,XP-1)+CHR(T)+SUBSTR(CHRN,XP+1,LONG-XP)
      DO CASE
      CASE  D_TYPE="D"
    IF XP=2 .OR.  XP=5
      XP=XP+1
    ENDIF
      ENDCASE
      SetColor( "0/7    +" )
      DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
      SetColor( "7/0" )

      SetColor( "0/7 +" )
      DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
      SetColor( "W+  / R" )
      DevPos( RDY1, (RDX1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
      SetColor( "&C7 +/ &C1" )
      XX1=RDX1+XP
      YY1=RDY1
    ELSE
      CHRN=SUBSTR(CHRN,1,XP-1)+CHR(T)
      SetColor( "0/7+" )
      DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
      SetColor( "7/0" )
      XP=XP-1
      SetColor( "0/7 +" )
      DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
      SetColor( "W+  / R" )
      DevPos( RDY1, (RDX1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
      SetColor( "&C7 +/ &C1" )

      XX1=RDX1+XP
      YY1=RDY1
    ENDIF
  CASE T=13   .OR. T=23 .OR. T=5 .OR. T=24.OR. t=2   .OR. T=3  .OR. T=18 .OR. T=1 .OR. T=6
    IF    T=28 .AND. ( C_FUNC <> " ")
      DO &C_FUNC
      T=13
    ENDIF
    T1=233
    DO CASE
    CASE   D_TYPE="N"
      XPX=VAL(CHRN)
    CASE   D_TYPE="C"
      XPX=CHRN
    CASE   D_TYPE="D"
      XPX=CTOD(CHRN)
    ENDCASE

    PX=XPX
    SetColor( "0/7+" )
    DevPos( RDY1, RDX1 ) ; DevOut( CHRN )



    DO CASE
    CASE T=5
      IF TNSTP=1
    T1=233
    TNSTP=99
      ENDIF
      IF TNSTP>1
    TNSTP=TNSTP-1
    LAST_PRESS=5
      ENDIF
    CASE T=3
      T1=233
    TNSTP=98
    CASE T=18    .OR.  T=1 .OR.  T=6
      T1=233
    TNSTP=98
    CASE T=24
      T1=233
      TNSTP=98
    CASE T=13
      TNSTP=TNSTP+1

    ENDCASE
    IF T=23 .OR. t=2
      TNSTP=99
    ENDIF
  CASE T=27
    SetColor( "0/7 +" )
    DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
    XPX=PX
    DO CASE
    CASE   D_TYPE="N"
      XPX=VAL(CHRN)
    CASE   D_TYPE="C"
      XPX=CHRN
    CASE   D_TYPE="D"
      XPX=CTOD(CHRN)
    ENDCASE
    PX=XPX
    SetColor( "7/0" )
    XP=0
    t=0
    XX1=RDX1+XP
    YY1=RDY1
    T1=233
    TNSTP=99
  ENDCASE
ENDDO
_act_px=PX
RETU   TNSTP














































































































































































































































































































































