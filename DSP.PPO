FUNCTION _GET_VBROW
PARAMETERS  Y1_N,X1_N,XW_N,TIT_N,ARR_TITLE,ARR_REC_NAME,ARR_TYPE,P_FUNC,N_SELE,_MODI,MDYPAGE,DELREC
YL_N=INT(80/XW_N) -1
IF _MODI="Y"
  FIST_REC := LAST_REC := 0
ENDIF
_DATA_MODIFY =0
X_G_B=SAVESCREEN(Y1_N-1,0,Y1_N+TIT_N+1,79)
XCOR=SETCOLOR()
XXP=LEN(C_TOP2)+1
IF EMPTY(C_TOP2)=.T.
  XXP=0
ENDIF
ARR_DSPN=ARRAY(1)
XX=X1_N+XXP +1+LEN(ARR_TITLE[1])
ARR_DSPN[1] :=XX -1-LEN(ARR3[1])
X=2

D_C=ALLTRIM(C_TOP2) +" "
D_C=D_C +ARR_TITLE[1]+" "
while X <=    TIT_N

  xp=1
  xspace=" "
  if ( LEN(ARR_TITLE[X]) > len(arr_type[x]))  .AND. x <> gs_tot+2
    xp=0
  xspace=""
  endif
  XX=XX+xp+LEN(ARR_TITLE[X])
  AADD(ARR_DSPN,XX -LEN(ARR3[X])-1)

  D_C=D_C +ARR_TITLE[X]
  X=X+1
  IF X <= TIT_N
    D_C=D_C +xspace
  ENDIF
ENDDO









DC_L=LEN(D_C)
Set( 20, "SCREEN" )
X_C2=" Pg-Wown Up¤W¤U­¶ Enter¿ï¾Ü "
IF  (_MODI="Y") .OR. (_MODI="K")
  X_C1="¡ô¡õ¤W¤Uµ§ F10-§R°£ Esc¸õÂ÷"
ELSE
  X_C1="¡ô¡õ¤W¤Uµ§          Esc¸õÂ÷ "
ENDIF
IF (FIST_REC<>0).AND. (FIST_REC=LAST_REC)
  X_C1=" ¡ô¡õ-­×§ï  Esc¸õÂ÷ "
  X_C2=""
ENDIF
IF EMPTY(C_TOP1)= .F.
  x_c2=c_top1 +x_c2
ENDIF
X=LEN(X_C1)
IF X>DC_L
  XX=INT((X-DC_L)/2)
ELSE
  XX=0
ENDIF
SetColor( "GR+ / BL" )
Scroll( Y1_N-1, X1_N-2-XX, Y1_N+TIT_N+1, X1_N + DC_L +2 +XX ) ; SetPos( Y1_N-1, X1_N-2-XX )
BOX_S(Y1_N-1,X1_N-2-XX,Y1_N+TIT_N+1,X1_N + DC_L+XX)
SetColor( "GR+ / R" )

FOR  X =1 TO   TIT_N
  XBLK=""
  BLKN=xw_n-1-LEN(ARR_TITLE[X])
  IF BLKN>0
     XBLK=SUBSTR("        ",1,BLKN)
  ENDIF
  DevPos( Y1_N+X-1, X1_N ) ; DevOut( XBLK +    ARR_TITLE[X] )
NEXT


IF  DC_L>LEN(X_C1)+LEN(X_C2)+1
  X=LEN(X_C1)+LEN(X_C2)
  DevPos( Y1_N+TIT_N+1, (X1_N +INT((DC_L*0.5) -(X *.5)))-1 ) ; DevOut( X_C2+" "+X_C1 )
ELSE
  DevPos( Y1_N+TIT_N, (X1_N +INT((DC_L*0.5) -(X *.5)))-1 ) ; DevOut( X_C1 )
  DevPos( Y1_N+TIT_N+1, (X1_N +INT((DC_L*0.5) -(X *.5)))-1 ) ; DevOut( X_C2 )
ENDIF
IF EMPTY(C_TOP1)= .F.
  DevPos( Y1_N+TIT_N+1, X1_N ) ; DevOut( C_TOP1 )
ENDIF
dbSelectArea( N_SELE )
N_YN=Y1_N
N_COL=1
N_REC=1

SetColor( "W+ / BL" )
DO _DSPV_ALL
N_REC=RECNO()


SetColor( "GR+ / W+" )

MDY_X=X1_N+XW_N
_REC_DSPV(Y1_N,MDY_X)
_LOOP_BR=1
T=0
while _LOOP_BR =1
  IF _MODI="P"
    T=-992
    _MODI="Y"
  ENDIF
  while T=0
    IF T0A <>0
      T=T0A
      T0A=0
    ELSE
      T=INKEY()
    ENDIF
    IF DLA_DSP=1
      DO DSP2
    ENDIF
    IF T0A=0
      DO LUSTP
    ENDIF
  ENDDO
  dbSelectArea( N_SELE )
  DO CASE
  CASE T=-2
    IF    EMPTY(F3_FUNC) =.F.
      DO &F3_FUNC
    ENDIF
    T=0
  CASE T=-6
    F7_ACT=1
    IF    EMPTY(F7_FUNC) =.F.
      F7_ACT=1
      DO &F7_FUNC
    ENDIF
    T=0
  CASE T=-7
    IF    EMPTY(F8_FUNC) =.F.
      DO &F8_FUNC
    ENDIF
    T=0
  CASE T=-992    .AND. (_MODI="Y"  .OR.    _MODI="K"  .OR.    _MODI="1"  )

    _GET_STP=1
    while ( _GET_STP >=0 )  .AND. ( _GET_STP <=TIT_N )
       R_C=ARR_REC_NAME[_GET_STP]
       T_C=ARR_TYPE[_GET_STP]
       _D_TYPE=TYPE("&R_C")
       C_L=LEN(ARR_TYPE[_GET_STP])
       SetColor( "&12 /&11" )
       xplus0=XW_N -len(T_C)
       DevPos( N_YN+_GET_STP-1, X1_N +N_COL*XW_N+xplus0 ) ; DevOutPict( &R_C, "&T_C" )
       GET_STPC=ALLTRIM(STR(_GET_STP,2,0))

       p_func=" "
       X_GETSTP=_GET_STP
       SetColor( "gr + /w" )
       _REC_DSPV(N_YN,X1_N +N_COL*XW_N)

      LAST_PRESS=0
      _GET_STP=READ_A(N_YN+_GET_STP-1,X1_N+N_COL*XW_N+xplus0,&R_C,"&_D_TYPE",C_L,ARR4[_GET_STP],_GET_STP,"&P_FUNC")
      IF _GET_STP=99
    _LOOP_BR=0
      ENDIF
      IF T_C="!" .AND. (VALTYPE(_ACT_PX)="C")
    _ACT_PX=UPPER(_ACT_PX)
      ELSE
    IF  T_C="9" .AND.  (_ACT_PX >INT(VAL(ARR3[X_GETSTP])) )
      _ACT_PX =INT(VAL(ARR3[X_GETSTP]))
    ENDIF
      ENDIF
      T_C=ARR_TYPE[X_GETSTP]



      dbSelectArea( N_SELE )
      IF SUBSTR(T_C,1,1)<>"9"
      _ACT_PX=ALLTRIM(_ACT_PX)
      ENDIF
      _FIELD->&R_C := _ACT_PX
      IF  (EMPTY(ARR_PCS[X_GETSTP]) =.F.)  .AND.  (_GET_STP<20)
    PCSV_CF(N_YN+1,X1_N+(N_COL*XW_N)+(xw_n-4),&R_C,_GET_STP,RECNO())
      ENDIF
      IF   (_GET_STP<20)
    IF ARR_REC_NAME[_GET_STP] ="0"
        IF LAST_PRESS=5
          _GET_STP =_GET_STP-1
        ELSE
          _GET_STP =_GET_STP+1
        ENDIF
    ENDIF
      ENDIF
    ENDDO
    SetColor( "gr + /w" )

     _REC_DSPV(N_YN,X1_N +N_COL*XW_N)
    _DATA_MODIFY=1
    IF (_GET_STP <>98)
      T=0
    ENDIF
  CASE T=5
    IF    (_MODI <> "1")
      UPV_DSP1(-1,xw_n)
    ENDIF
    T=-992
  CASE T=24
    IF    (_MODI <> "1")
      UPV_DSP1(1,xw_n)
    ENDIF
    T=-992
  CASE T=7 .AND.  DELREC=.T.
    dbDelete()
    __dbPack()
    IF    EOF()
      dbSkip( -1 )
      IF  EOF()
    dbAppend()
      ENDIF
    ENDIF
    N_REC=RECNO()
    N_YN=Y1_N
    SetColor( "W+ / BL" )
    DO _DSPV_ALL
    SetColor( "GR+ / W+" )
    dbGoto(N_REC)


    _DATA_MODIFY =1
    T=0
  CASE T=18   .AND.  MDYPAGE=.T.
    dbSkip( -(YL_N +(N_YN-Y1_N)) )
    IF BOF()
      dbGoTop()
    ENDIF
    N_REC=RECNO()
    N_YN=Y1_N
    n_col=1
    SetColor( "W+ / BL" )
    DO _DSPV_ALL
    SetColor( "GR+ / W+" )
    dbGoto(N_REC)

    _REC_DSPV(N_YN,X1_N +N_COL*XW_N)
    T=0
  CASE T=3    .AND.  MDYPAGE=.T.
    dbSkip( ((Y1_N+YL_N-N_YN)) )
    IF EOF()
      dbGoBottom()
    ENDIF
    N_REC=RECNO()
    N_YN=Y1_N
    n_col=1
    SetColor( "W+ / BL" )
    DO _DSPV_ALL
    dbGoto(N_REC)
    SetColor( "GR+ / W+" )

     _REC_DSPV(N_YN,X1_N +N_COL*XW_N)
    T=0
  CASE T=13
    X=1
    while X <=TIT_N
      R_C=ARR_REC_NAME[X]
      XK=ALLTRIM(STR(X,2,0))
      RET_X&XK=&R_C
      RET_A[X]=&R_C
      X=X+1
    ENDDO
    _LOOP_BR=0
    T=0
  CASE T=23 .OR. T=27
    _LOOP_BR=0
    T=0
  otherwise
    T=0
  ENDCASE
ENDDO
T=0
SetColor( "&XCOR" )
MODI_PAGE= .T.
RESTSCREEN(Y1_N-1,0,Y1_N+YL_N+1,79,X_G_B)
RETU

PROCEDURE    _DSPV_ALL
PARAMETERS  P1,P2,P3
XAL=1
Y_X=Y1_N
X1_N2=X1_N +XW_N
Scroll( Y1_N, X1_N2, Y1_N+TIT_N-1, 79 ) ; SetPos( Y1_N, X1_N2 )
IF ! BOF()
  while (XAL <=YL_N)  .AND. (! EOF())
    _REC_DSPV(Y_X,X1_N2)
    dbSkip(1)

    X1_N2=X1_N2 +XW_N
    XAL=XAL+1
  ENDDO


ENDIF
dbGoto(n_rec)
RETU

FUNCTION   _REC_DSPV
PARAMETERS  YD_N,XD_N
X=1
YD_N0=YD_N
while X <=TIT_N
  R_CB=ARR_REC_NAME[X]
  T_CB=ARR_TYPE[X]
  XPLUS=XW_N-LEN(T_CB)
  _XN1=&R_CB
  IF (VALTYPE(_XN1)="N") .AND. ( T_CB="9999")
     IF ( _XN1-INT(_XN1) <>0 )
       _XN1=LTRIM(STR(_XN1,7,2))
       XLEN=LEN(_XN1)
       IF XLEN <4
     _XN1=SUBSTR("    ",1,4-XLEN) + _XN1
       ELSE
     _XN1=SUBSTR(_XN1,1,4)
       ENDIF
       DevPos( YD_N, XD_N+XPLUS ) ; DevOut( _XN1 )
     ELSE
       DevPos( YD_N, XD_N+XPLUS ) ; DevOutPict( &R_CB, "&T_CB" )
     ENDIF
  ELSE
    DevPos( YD_N, XD_N+XPLUS ) ; DevOutPict( &R_CB, "&T_CB" )
  ENDIF
  IF  (x=tit_n) .AND. (EMPTY(ARR_PCS[X]) =.F.)
    PCSV_CF(YD_N0+1,XD_N+XW_N-4,&R_CB,X,RECNO())
  ENDIF
  YD_N=YD_N +1
  X=X+1
ENDDO
RETU

FUNCTION PCSV_CF
PARAMETERS  Y_POSI,X_POS,X_DATA,XFUNC_NO,XN_RECNO
XDO_F=ARR_PCS[XFUNC_NO]
DO &XDO_F    WITH  X_POS
RETU

PROCEDURE  DSPV_TOTW
PARAMETERS  P1,P2,P3
c_color=SETCOLOr()
SetColor( "GR+ / BL" )

XTOT=0
FOR I=1 TO gs_tot + uwc_tot
  IX_C=ALLTRIM(STR(I,2,0))
  XTOT=XTOT +  M&IX_C
NEXT

DevPos( Y_POSI, P1 ) ; DevOutPict( XTOT, "9999" )
SetColor( "&c_color" )
retu

FUNCTION   UPV_DSP1
PARAMETERS  DIREC,w_col
REFRESH=0
SetColor( "W+ / BL" )
_REC_DSPV(Y1_N,X1_N +N_COL*w_col)
dbSkip( DIREC )
IF (DIREC >0)
   IF EOF()
      dbGoBottom()
     IF  _MODI="Y"    .AND. (_MODI <> "1")
     dbAppend()
     endif
     dbGoBottom()
   ENDIF
    IF N_COL =YL_N
      REFRESH=1
    ELSE
       N_COL=N_COL+1
    ENDIF
ELSE
   IF N_COL =1
      REFRESH=1
     IF BOF()
    dbGoTop()
     ENDIF
   ELSE
       N_COL=N_COL-1
   ENDIF
ENDIF
N_REC=RECNO()
IF REFRESH=1
    dbSkip( -(N_COL-1) )
    DO _DSPV_ALL
ENDIF
dbGoto(N_REC)


SetColor( "GR+ / W+" )
_REC_DSPV(Y1_N,X1_N +N_COL*w_col)
N_REC=RECNO()
RETU

