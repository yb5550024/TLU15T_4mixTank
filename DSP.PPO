    XN_PRE=XN_PRE+ PRE_GET
    XN_LST=XN_LST+LST_BILL
    dbSkip(1)
  ENDDO
  DevPos( PROW()+1, 5 ) ; DevOut( "-------------------------------------------------------------------" )
  DevPos( PROW()+1, 45 ) ; DevOutPict( XN_PRE, "99999999" )
  DevPos( PROW(), 54 ) ; DevOutPict( XN_LST, "99999999" )
  DevPos( PROW()+3, 5 ) ; DevOut( "  " )
  DevPos( PROW()+1, 5 ) ; DevOut( "  " )
