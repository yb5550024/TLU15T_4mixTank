  FUNCTION HEXTODEC
  PARAMETERS  X
  X=UPPER(X)
  A=SUBSTR(X,1,1)
  B=SUBSTR(X,2,1)
  C=SUBSTR(X,3,1)
  DO CASE
  CASE A="A"
       A=10*256
  CASE A="B"
       A=11*256
  CASE A="C"
       A=12*256
  CASE A="D"
       A=13*256
  CASE A="E"
       A=14*256
  CASE A="F"
       A=15*256
  OTHERWISE
  A=VAL(A)*256
  ENDCASE
  DO CASE
  CASE B="A"
       B=10*16
  CASE B="B"
       B=11*16
  CASE B="C"
       B=12*16
  CASE B="D"
       B=13*16
  CASE B="E"
       B=14*16
  CASE B="F"
       B=15*16
  OTHERWISE
  B=VAL(B) *16
  ENDCASE
  DO CASE
  CASE C="A"
       C=10
  CASE C="B"
       C=11
  CASE C="C"
       C=12
  CASE C="D"
       C=13
  CASE C="E"
       C=14
  CASE C="F"
       C=15
  OTHERWISE
  C=VAL(C)
  ENDCASE
  TDECX=A+B+C
  RETU    TDECX

FUNCTION  ET3D
PARAMETERS   TROW,TCOL,TGAP,TRX,TRY,STRING
DevPos( 1, 0 ) ; DevOut( "" )
TROW1=STR(TROW)
TCOL1=STR(TCOL)
TROW2=STR(TROW+1)
TCOL2=STR(TCOL+1)
TROW3=STR(TROW+2)
TCOL3=STR(TCOL+2)
TROW4=STR(TROW+3)
TCOL4=STR(TCOL+3)
TGAP=STR(TGAP)
TRX=STR(TRX)
TRY=STR(TRY)
TRXY=TRX+"/"+TRY
QOut( CHR(27),"T24,&TROW1,&TCOL1,&TGAP,&TRXY,O;&STRING" )
QOut( CHR(27),"T24,&TROW2,&TCOL2,&TGAP,&TRXY,O;&STRING" )
QOut( CHR(27),"T24,&TROW3,&TCOL3,&TGAP,&TRXY,O;&STRING" )
RETURN ""

