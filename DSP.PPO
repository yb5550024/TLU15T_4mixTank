  for xlop=1  to   gs_tot+uwc_tot
    CN=ALLTRIM(STR(XLOP,2,0))
    CX=ALLTRIM(PA&CN)
    XLEN= LEN(CX)
    IF     XLEN<3
       CX="9999"
    ENDIF
    ARR3[XLOP+1]=CX
    IF VAL(ARR3[XLOP+1])-INT(VAL(ARR3[XLOP+1])) =0
      ARR4[XLOP+1]=0
    ELSE
      ARR4[XLOP+1]=2
    ENDIF
