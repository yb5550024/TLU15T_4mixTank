if (star=1)  .AND.  (L_PRESS >0)
  FOR XN=1 TO (GS_TOT +UWC_TOT)

    STP_FC=alltrim(str(XN,2,0))
    XMC_F=A_M_NAME[xn,3]
    if p1=8
      xadj=11
    else
      xadj=2
    endif

    DevPos( A_M_NAME[xn,23], A_M_NAME[xn,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&STP_FC,XN,P1] + A_PRESS_N0[L_PRESS,STPN&STP_FC,XN,xadj], "&XMC_F" )
