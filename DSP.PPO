   PROCEDURE  PNT_RATEN


   PARAMETERS  xActNo,KEY_NO,xRET_DNX ,P3
   IF EMPTY(xActNo)=.T.
     xActNo="2"
   ENDIF
     ActNo_N =VAL(xActNo)
   x= RDLPT(val(aport)-1)
   if      (x= 128 )  .OR. (x= 144 ) .OR. (x= pnt_redy_code )
     SETETSP(APORT)
     SetPntWx("3")
     DevPos( PROW(), 0 ) ; DevOut( "~L12;" )
     DevPos( PROW()+3, 3 ) ; DevOut( "¤é´Á:" )
     DevPos( PROW(), 8 ) ; DevOut( DATE() )



     XTIT=fsubstr("°t¤ñ¥N¸¹  ",-ratno_wid," ",0)
     ARR1 :=ARRAY(15+3)
     ARR2 :=ARRAY(15+3)
     ARR1[1]="NO.      "
     XN_TITL=0
     ARR2[1]=1
     FOR I=1 TO gs_tot + uwc_tot
       IF EMPTY(A_M_NAME[I,3]) =  .F.
     ARR1[I+1] = A_M_NAME[I,17]
     IF (LEN(ARR1[I+1]) < LEN(A_M_NAME[I,3]) )
       ARR1[I+1]=SPACE(LEN(A_M_NAME[I,3])-LEN(ARR1[I+1]))+ARR1[I+1]
     ENDIF
     ARR2[I+1]=ARR2[I] + LEN(ARR1[I]) +1
     IF  I=GS_TOT
       ARR1[I+1] :=ARR1[I+1] + " Á`­« "
     ENDIF

     IF  I=GS_TOT  +1
       ARR2[15+2]=ARR2[I+1]-7  


     ENDIF
     XTIT=XTIT +" " + ARR1[I+1]
       ENDIF
     NEXT
     titlen=len( XTIT)
     DevPos( PROW()+1, 1 ) ; DevOut( XTIT )
     DevPos( PROW()+1, 1 ) ; DevOut( "----------------------------------------------------------------------------------------------------" )

     dbSelectArea( ActNO_N )
     REC_OLD=RECNO()
     if F7_ACT=1
       dbGoTop()
     endif
     while ! EOF()
       XN_TOTW=0
       XCNR="1"
       DevPos( PROW()+1, 1 ) ; DevOutPict( RATNO, "XXXXXXXXXX" )
       for i=1    to    gs_tot +uwc_tot
     XMC_F=A_M_NAME[I,3]
     xcnr=alltrim(str(I,0))
     DevPos( PROW(), ARR2[I+1] ) ; DevOutPict( M&XCNR, "&XMC_F" )
     XN_TOTW=XN_TOTW + M&XCNR
       next
       DevPos( PROW(), ARR2[15+2] ) ; DevOutPict( XN_TOTW, "99999" )
       DevPos( PROW()+1, 1 ) ; DevOut( "--------------------------------------------------------------------------------------------------" )


















































       if F7_ACT=1
     dbSkip(1)
       else
     exit
       endif
     ENDDO


     DevPos( PROW()+1, 1 ) ; DevOut( " " )
     DevPos( PROW()+1, 1 ) ; DevOut( " " )
     Set( 20, "SCREEN" )
     dbGoto(REC_OLD)
     Set( 17, "ON" )
     F7_ACT=0
   ENDIF
   RETU




















































































































































































































FUNCTION   CHG_WADJ_CN
PARAMETERS  INDEX,K_CODE,NMIN,NMAX
  INDEX_S=INDEX
  WAdjCur(water_input,INDEX,0)
  IF K_CODE=19
     INDEX=INDEX -1
     IF INDEX <  NMIN
       INDEX=NMAX
     ENDIF
  ELSEIF K_CODE=4
     INDEX=INDEX +1
     IF INDEX >  NMAX
       INDEX=NMIN
     ENDIF
  ENDIF
  IF  INDEX_S <>  INDEX
    xd_wno=fSelectNo()
    dbSelectArea( "5" )
    dbGoto(33)
    icx=alltrim(str(gs_tot+1,2,0))
    _FIELD->pa&icx := INDEX
    dbCommitAll()
    dbSelectArea( xd_wno )
  ENDIF
  WAdjCur(water_input,INDEX,14)
  SetColor( "W+ / &C1" )
  DevPos( 4, A_M_NAME[INDEX,13] ) ; DevOutPict( WATER_INC[INDEX], "99.9" )
  SetColor( "&C2 / &C1" )
RETU   INDEX

FUNCTION   CHG_WATER_INC
PARAMETERS  INDEX,K_CODE,_WATER_INC,Min
   if water_input =0
       return
   endif
   DO  CASE
   CASE  K_CODE= 43
     _WATER_INC[INDEX] = _WATER_INC[INDEX] +  0.1
   CASE  K_CODE= 95
     _WATER_INC[INDEX] = _WATER_INC[INDEX] -  0.1
   CASE  K_CODE= 61
     _WATER_INC[INDEX] = _WATER_INC[INDEX] +  0.1
   CASE  K_CODE= 45
     _WATER_INC[INDEX] = _WATER_INC[INDEX] -  0.1
   ENDCASE
   IF      _WATER_INC[INDEX] < Min 
     _WATER_INC[INDEX] = Min 
   ELSEIF    _WATER_INC[INDEX] >30
     _WATER_INC[INDEX] = 30
   ENDIF
   xd_wno=fSelectNo()
   dbSelectArea( "5" )
   dbGoto(33)
   icx=alltrim(str(INDEX,2,0))
   _FIELD->pa&icx := _WATER_INC[INDEX]
   dbCommitAll()
   dbSelectArea( xd_wno )
   SetColor( "W+ / &C1" )
   DevPos( 4, A_M_NAME[INDEX,13] ) ; DevOutPict( _WATER_INC[INDEX], "99.9" )
   SetColor( "&C2 / &C1" )
   SHOW_W_ADJ(INDEX,_WATER_INC )
RETURN

FUNCTION   SHOW_W_ADJ
PARAMETERS  INDEX_sw,sw_WATER_INC
  if star=1
    sw_stp=stp_a[INDEX_sw]
    _chc=alltrim(str(index_sw,2,0))
    IF    (A_PRESS_N0[L_PRESS,STPN&_chc,index_sw,8] >0)
      w11=int(A_PRESS_N0[L_PRESS,STPN&_chc,index_sw,8] * sw_WATER_INC[INDEX_sw]/100)
      XMC_F=A_M_NAME[index_sw,3]
      SetColor( "w / &C1" )
      DevPos( A_M_NAME[INDEX_sw,23], A_M_NAME[INDEX_sw,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&_chc,index_sw,8] +W11, "&XMC_F" )
      SetColor( "&C2 / &C1" )
      WATER_CHG=1
    ENDIF


  endif
RETURN

FUNCTION   S_GET_MIX_DATA
PARAMETERS  P1
   mix_data :=ARRAY(gs_tot + uwc_tot + 1)
   XOK= GET_MIX_DATA(ARATNO,AVUSE,@mix_data )

   if xok>0
      xok=1
      for xloop=1   to     gs_tot +uwc_tot
     if (stp_a[xloop])>0
        xok=0
        exit
     endif
      next
      if xok=1
     SetColor( "gr+ /   &c1" )
     for xloop=1   to   gs_tot +uwc_tot
       XN2=A_M_NAME[xloop,3]
       DevPos( A_M_NAME[xloop,23], A_M_NAME[xloop,13] ) ; DevOutPict( mix_data[xloop], "&xn2" )
     next
     SetColor( "&c2  /   &c1" )
      endif
   endif
RETURN

FUNCTION   change_tot_d
PARAMETERS  A_N,DIMS,DIMT
FOR XAN1=1 TO  19
  A_N[XAN1,DIMT] :=A_N[XAN1,DIMS]
NEXT
  A_N[21,DIMT] :=A_N[21,DIMS]
  A_N[22,DIMT] :=A_N[22,DIMS]
RETURN

PROCEDURE  RST_MDY_RCPB
PARAMETERS  A_RCPB,_RST
  IF _RST=0
    A_RCPB[1]=0
  ENDIF
  IF A_RCPB[1]=0
    A_RCPB[1]=0
    A_RCPB[2]=SPACE(10)   
    A_RCPB[3]="M1"
    A_RCPB[4]=-1  
    DevPos( 18, 11 ) ; DevOut( DISKVOL )
    DevPos( 18, 18 ) ; DevOut( "000  " )
  ELSE
    XC=SPACE(10)+ALLTRIM(A_RCPB[2])
    DevPos( 18, 11 ) ; DevOut( SUBSTR(XC,-6,6) )
    if     A_RCPB[4]-int(A_RCPB[4]) =0
      DevPos( 18, 18 ) ; DevOutPict( A_RCPB[4], "     " )
      DevPos( 18, 18 ) ; DevOutPict( A_RCPB[4], "9999" )
    else
      DevPos( 18, 18 ) ; DevOutPict( A_RCPB[4], "99.99" )
    endif
  ENDIF
RETURN

