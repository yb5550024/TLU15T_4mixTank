Set( 11, "OFF" )
dbGoTop()
IF ! EOF()
  ASCANO=SCANO
ENDIF
ACARNO=CARNO
ARATNO=RATNO
AVUSE=VUSE
ATANDO=TANDO








dbDelete()
Set( 11, "off" )
RETU



