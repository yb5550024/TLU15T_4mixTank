P_FUNC0 := P_FUNC1 := P_FUNC2 := P_FUNC3 := P_FUNC4 := P_FUNC5 := P_FUNC6 := P_FUNC7 := P_FUNC8 := P_FUNC9 := " "
SetColor( "&C7 +/ &C1" )
XMAKER=RET_X1
retu


PROCEDURE  PNT_TOTDATA
PARAMETERS  P1,P2,P3
x= RDLPT(VAL(APORT)-1)
IF (x =144)  .OR. (x=pnt_redy_code)
  Set( 17, "On" )
  do case
  case aport="1"
    Set( 24, "lpt1", .F. )
    QOut( chr(27) + "sp1;" )
  case aport="2"
    Set( 24, "lpt2", .F. )
    QOut( chr(27) + "sp2;" )
  case aport="3"
    Set( 24, "lpt3", .F. )
    QOut( chr(27) + "sp3;" )
  endcase
  Set( 17, "On" )
  Set( 20, "PRINTER" )
    SetPntWx("5")
  DevPos( PROW()+3, 3 ) ; DevOut( "¤é´Á:" )
  DevPos( PROW(), 8 ) ; DevOut( DATE() )

  DevPos( PROW()+1, 1 ) ; DevOut( D_C )
  DevPos( PROW()+1, 1 ) ; DevOut( "-------------------------------------------------------------------------------" )
  REC_OLD=RECNO()
  dbGoTop()
  TMPX1=0
  TMPX2=0
  while ! EOF()
    DevPos( PROW()+1, 1 ) ; DevOut( " " )
    FOR  I=1  TO  6
      C_FIELD=ARR2[I]
      C_TYPE=ARR3[I]
      DevPos( PROW(), ARR_DSPN[I] ) ; DevOutPict( &C_FIELD, "&C_TYPE" )
      IF I=4
    IF  &C_FIELD  > 0
       TMPX1=TMPX1 +   &C_FIELD
       TMPX2=TMPX2 +   1
    ENDIF
      ENDIF

    NEXT
    dbSkip(1)
  ENDDO
  DevPos( PROW()+1, 1 ) ; DevOut( "-------------------------------------------------------------------------------" )
  DevPos( PROW()+1, ARR_DSPN[4]-3 ) ; DevOutPict( TMPX1, "99999.9" )
  DevPos( PROW(), ARR_DSPN[6] ) ; DevOutPict( TMPX2, "9999" )
  DevPos( PROW(), ARR_DSPN[6] +6 ) ; DevOut( "¨®¦¸" )
  DevPos( PROW()+1, 1 ) ; DevOut( " " )
  DevPos( PROW()+1, 1 ) ; DevOut( " " )
  Set( 20, "SCREEN" )
  dbGoto(REC_OLD)
  Set( 17, "ON" )
ENDIF
   RETU

 PROCEDURE  PNT_CARDATA
 PARAMETERS  P1,P2,P3
 IF (EOF()   .OR.  BOF() )
   RETU
 ENDIF
 x= RDLPT(VAL(APORT)-1)
 IF (x =144)  .OR. (x=pnt_redy_code)
  XDATE5=LUDATE
  XTIME5=LUTIME
  XSNO5 =LAGNO1
  get_tite_d1(@_tot_d_a)
  dbSelectArea( (1 +DBFDN) )
  __dbLocate( {|| ( (LUDATE=XDATE5) .AND.  (LAGNO1=XSNO5) )},,,, .F. )
  IF EOF()  =.T.
    dbSelectArea( "9" )
    RETU
  ENDIF
  L_PRESS=3
  PNT_TITa_p(Xdate5,@_tot_d_a)
  dbSelectArea( (1 +DBFDN) )
  XNSCANO=lagno1
  XA_STPN=1
  YTOTWACT :=ARRAy(15)
  for  x8_loop1=1  to  15
       YTOTWACT[x8_loop1]=0
  next
  while lagno1=XNSCANO .AND. ! EOF()
    X_STORTIME=LUTIME
    X_MIXSEC=MIX_SEC

    IF PNT_REMAIN=1
      CAL_W2(XA_STPN,@A_PRESS_N0,L_PRESS,@YTOTWACT)
    ELSE
      CAL_W20(XA_STPN,@A_PRESS_N0,L_PRESS,@YTOTWACT)
    ENDIF
    pnt_produce(XA_STPN,X_STORTIME,X_MIXSEC,A_PRESS_N0,0)
    IF PNT_REMAIN=1
      pnt_remains(l_press,xa_stpn,A_PRESS_N0,0,0,YTOTWACT)
      xmixtm=tm16
      Pnt_MixTime(PNT_MIXT,PMIXT_PLUS,xMIXTM,0,0)
    else
      pnt_LASTW(l_press,xa_stpn,A_PRESS_N0,0,0,YTOTWACT)
    endif

    XA_STPN=XA_STPN+1
    dbSkip(1)
  ENDDO
  L_PRESS=2
  Set( 20, "SCREEN" )
  dbSelectArea( "9" )
  Set( 17, "ON" )
ENDIF


IF   ((VAL(C_PRT_REP) =77) .AND. (COM_E=1) )
  dbSelectArea( "9" )
  IF (EOF()   .OR.  BOF() )
       RETU
  ENDIF
  X=PNT_OK2()
  IF X=0
     RETU
  ENDIF













  _TOT_D_A[20,4]=1
  X=_TOT_D_A[20,4] +2
  _TOT_D_A[1,X] :=LUDATE







  _TOT_D_A[2,X] :=SCANO
  _TOT_D_A[16,X] :=US2
  _TOT_D_A[3,X]  :=" "
  IF EMPTY(_TOT_D_A[16,X]) =.F.
    dbSelectArea( "11" )
    __dbLocate( {||  alltrim(P1501)==alltrim( _TOT_D_A[16,X])},,,, .F. )
    IF EOF()=.F.
      _TOT_D_A[3,X]  :=P1502
    ENDIF
    dbSelectArea( "9" )
  ENDIF
  _TOT_D_A[4,X]  :=P1702
  _TOT_D_A[7,X]  :=TOTW
  _TOT_D_A[13,X] :=CARNO
  _TOT_D_A[6,X]  :=0

  IF EMPTY(_TOT_D_A[13,X]) =.F.
    dbSelectArea( "10" )
    __dbLocate( {||  (alltrim(P12100)== ALLTRIM(_TOT_D_A[13,X]))  .OR. (alltrim(P12101)== ALLTRIM(_TOT_D_A[13,X]))},,,, .F. )
    IF EOF()=.F.
      _TOT_D_A[6,X]  :=P12103
    ENDIF
    dbSelectArea( "9" )
  ENDIF
  xtotw=0
  for  xloop=1    to  gs_tot+uwc_tot
     icx=alltrim(str(xloop,2,0))
     xtotw=xtotw +totm&icx
  next
  _TOT_D_A[7,X]  :=xTOTW
  _TOT_D_A[5,X]  :=_TOT_D_A[7,X] + _TOT_D_A[6,X]
  _TOT_D_A[8,X]  :=LUTIME
  _TOT_D_A[9,X]  :=CARLAG
  _TOT_D_A[10,X] :=TOTVUSE
  _TOT_D_A[11,X] :=LAGTTW
  _TOT_D_A[12,X] :=0
  _TOT_D_A[17,X] :=0
  _TOT_D_A[18,X] :=RATNO
  IF EMPTY(_TOT_D_A[18,X]) =.F.
    dbSelectArea( "2" )
    __dbLocate( {||  alltrim(RATNO)==alltrim( _TOT_D_A[18,X])},,,, .F. )
    IF EOF()=.F.
      _TOT_D_A[12,X]  :=S_STRO
      _TOT_D_A[17,X] :=S_MAX
    ENDIF
    dbSelectArea( "9" )
  ENDIF
  _TOT_D_A[14,X] :=TANDO
  _TOT_D_A[15,X] :=CARDRV

    Set( 17, "On" )
    FSetToPrinter(bport)
    DO REP_&C_PRT_REP

    Set( 20, "SCREEN" )
ENDIF
  _TOT_D_A[20,3]=0
  _TOT_D_A[20,4]=0
RETU


FUNCTION  NTOC
PARAMETERS   PN
PN=ALLTRIM(STR(PN,10,0))
RETU PN

FUNCTION S_BCC
PARAMETERS  S_TXT
STN2=LEN(S_TXT)
BCN=0
FOR  STN1=1 TO    STN2
  TXB=ASC(SUBSTR(S_TXT,STN1,1))
  BCN=NXOR(BCN,TXB)
NEXT
BCC=CHR(BCN)
RETU  BCC

FUNCTION COM_SEND
PARAMETERS S_COM,S_DATA
TBCC=S_BCC(S_DATA)
HEAD1=SA + VA +CHR(5) + CHR(2) + S_DATA + CHR(3)  + TBCC +EOT
SIO_WRITE(S_COM,HEAD1)
RETU  TBCC


