FUNCTION  GS_DROPOK
PARAMETERS  GS_N
GS_DROK=1
IF GS_DROP[GS_N,1]>1
  XN_D1=mod(GS_DROP[GS_N,1],100)
  FOR I=1  TO  KLCHN
    IF    (GS_DROP[I,1] < XN_D1 ) .AND. (GS_DROP[I,1] <>0)
      IF (GS_DROP[I,2] <> 1) .AND. (GS_DROP[I,2] <> 3)
    GS_DROK=0
    EXIT
      ENDIF
    ENDIF
  NEXT
ENDIF
RETU  GS_DROK


FUNCTION  GS_DROPRST
PARAMETERS  GS_N
GS_CYL=1
FOR I=1  TO  KLCHN
  IF  GS_DROP[I,2] =0
    GS_CYL=0
    EXIT
  ENDIF
NEXT
IF GS_CYL=1
  FOR I=1  TO  KLCHN
    GS_DROP[I,2] :=0
  NEXT
ENDIF
RETU

