FUNCTION  TXT_ECHO
PARAMETERS   D_YS,D_XS,D_C1,D_C2,D_C3,t_color
D_L_C=LEN(D_C1)
D_YE=D_YS+4
D_XE=D_XS+4+D_L_C
XCOR=SETCOLOR()

Set( 20, "SCREEN" )
SetColor( "&C7 / &C5" )
SetColor( "GR+ / R" )
Scroll( D_YS, D_XS, D_YE, D_XE ) ; SetPos( D_YS, D_XS )
BOX_S(D_YS,D_XS,D_YE,D_XE)
Scroll( d_ys +1, d_xs+2, d_ye -1, d_xe-2 ) ; SetPos( d_ys +1, d_xs+2 )
do case
case  t_color=1
  SetColor( "W+ / bl, b/w+" )
case  t_color=2
  SetColor( "7+ / 0 , b/w+" )
case  t_color=3
  SetColor( "r  / gr+ , b/w+" )
case  t_color=4
  SetColor( "gr+ / bl , b/w+" )
endcase


DevPos( D_YS+1, D_XS+2 ) ; DevOut( D_C1 )
DevPos( D_YS+2, D_XS+2 ) ; DevOut( D_C2 )
DevPos( D_YS+3, D_XS+2 ) ; DevOut( D_C3 )

XT=0
SetColor( "&XCOR" )
RETU

FUNCTION  BOX_S
PARAMETERS   UPOW,UPCOL,DWNOW,DWNCOL
   IF  MOD((UPCOL - DWNCOL),2) <> 0
      IF  DWNCOL <>78
    DWNCOL=DWNCOL +1
      ELSE
    DWNCOL=DWNCOL -1
      ENDIF
   ENDIF
   X=UPCOL+2
   while X < DWNCOL
     DevPos( UPOW, X ) ; DevOut( "¢w" )
     DevPos( DWNOW, X ) ; DevOut( "¢w" )
     X=X+2
   ENDDO
   X=UPOW+1
   while X < DWNOW
     DevPos( X, UPCOL ) ; DevOut( "¢x" )
     DevPos( X, DWNCOL ) ; DevOut( "¢x" )
     X=X+1
   ENDDO
DevPos( UPOW, UPCOL ) ; DevOut( "¢z" )
DevPos( UPOW, DWNCOL ) ; DevOut( "¢{" )
DevPos( DWNOW, UPCOL ) ; DevOut( "¢|" )
DevPos( DWNOW, DWNCOL ) ; DevOut( "¢}" )
RETU ""

