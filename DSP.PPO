FUNCTION NREAD
PARAMETERS  NRY1,NRX1,PPX,LONG,x_func,ndspen
if empty(ndspen)
  ndspen="T"
endif
XPX=PpX
pgm=x_func
SetColor( "N/W *" )
CHRN=XPX
DevPos( NRY1, NRX1 ) ; DevOut( CHRN )
SetColor( "7/0" )
     XP=0
       t=0
       SetColor( "W+    / R" )
          DevPos( NRY1, (NRX1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
       SetColor( "&C7 +/ &C1" )

       SetColor( "gr + * /bl" )
       DevPos( NRY1, NRX1 ) ; DevOut( substr(chrn,XP+1,1) )
     SetColor( "&c7 + /&c1" )
       NRXX1=NRX1+XP
       NRYY1=NRY1
       T1=0
       TN1=0
       while T1<>233
       T=0
       INFUNC=1
       while T=0
     if ndspen="T"
     DO DSP2
     if T0A=0
       DO LUSTP
       ENDIF
     endif
     IF T0A <>0
       T=T0A
       T0A=0
     ELSE
       T=INKEY( )

     ENDIF

       ENDDO

       DO CASE
      case    T=19
        IF XP>=1
        XP=XP-1

        SetColor( "N/W *" )
        DevPos( NRY1, NRX1 ) ; DevOut( CHRN )
        SetColor( "7/0" )
        SetColor( "W+  / R" )
        DevPos( NRY1, (NRX1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
        SetColor( "&C7 +/ &C1" )

        NRXX1=NRX1+XP
        NRYY1=NRY1
        ENDIF
      CASE    T=4
        IF XP<=LONG-2
        XP=XP+1

        SetColor( "N/W  *" )
        DevPos( NRY1, NRX1 ) ; DevOut( CHRN )
        SetColor( "7/0" )
        SetColor( "W+  / R" )
               DevPos( NRY1, (NRX1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
        SetColor( "&C7 +/ &C1" )

        NRXX1=NRX1+XP
        NRYY1=NRY1
        ENDIF
      CASE     T>=32
         XP=XP+1
         IF TN1=0 .AND. XP=1
           TN1=1
           CHRN=SPACE(LONG)
         ENDIF
         IF XP<LONG
         CHRN=SUBSTR(CHRN,1,XP-1)+CHR(T)+SUBSTR(CHRN,XP+1,LONG-XP)
        SetColor( "N/W *" )
         DevPos( NRY1, NRX1 ) ; DevOut( CHRN )
         SetColor( "7/0" )

         SetColor( "W+  / R" )
            DevPos( NRY1, (NRX1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
         SetColor( "&C7 +/ &C1" )

         NRXX1=NRX1+XP
         NRYY1=NRY1
         ELSE
         CHRN=SUBSTR(CHRN,1,XP-1)+CHR(T)
        SetColor( "N/W *" )
         DevPos( NRY1, NRX1 ) ; DevOut( CHRN )
         SetColor( "7/0" )
         XP=XP-1
         SetColor( "W+  / R" )
            DevPos( NRY1, (NRX1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
         SetColor( "&C7 +/ &C1" )

         NRXX1=NRX1+XP
         NRYY1=NRY1
         ENDIF
      CASE T=13   .OR. T=23 .OR. T=5 .OR. T=24 .OR. T=27.OR. T=-4 .OR. T=-6 .OR. T=-9 .OR. T=18 .OR. T=3 .OR. T=-5
           T1=233
          XPX=CHRN
           TNSTP=T
           INFUNC=0
      CASE T=28
          IF  pgm      <> " "
          DO &pgm
          ENDIF
           T1=233
          XPX=CHRN
           TNSTP=T
           INFUNC=0
       ENDCASE
       ENDDO
RETU   TNSTP


FUNCTION SER_OK_o
SER_X=VAL(SUBSTR(DTOC(DATE()),1,1))
SER_X=SER_X +VAL(SUBSTR(DTOC(DATE()),2,1))
SER_X=SER_X +VAL(SUBSTR(DTOC(DATE()),4,1))
SER_X=SER_X +VAL(SUBSTR(DTOC(DATE()),5,1))
SER_X=SER_X +VAL(SUBSTR(DTOC(DATE()),7,1))
SER_X=SER_X +VAL(SUBSTR(DTOC(DATE()),8,1))
SER_X=(SER_X * 2)  +9
SER_XW=DOW(DATE())-1
IF  SER_XW =0
  SER_XW=7
ENDIF
SER_XW=STR(SER_XW,1,0)
IF  SER_X <100
  SER_X=SER_X * 10
  SER_X=STR(SER_X,3,0)
  SER_X=SUBSTR(SER_X,1,1) + SER_XW + SUBSTR(SER_X,2,2)
ELSE
  SER_X=STR(SER_X,3,0)
  SER_X=SUBSTR(SER_X,1,2) + SER_XW + SUBSTR(SER_X,3,1)
ENDIF
SER_STP=1
SER_OK=1
while SER_STP <=4
  T_SER=0
  while T_SER=0
    T_SER=INKEY()

  ENDDO
  IF  CHR(T_SER) <> SUBSTR(SER_X,SER_STP,1)
    SER_OK=0
    EXIT
  ENDIF
  SER_STP=SER_STP +1
ENDDO
RETU SER_OK


FUNCTION CKS
dbSelectArea( "5" )
dbGoTop()
cks_1=0
while ! EOF()
  cks_1=cks_1+PA1+PA2+PA3+PA4+PA5+PA6+PA7+PA8
  dbSkip(1)
ENDDO
IF cks_1<> CKS
  if  cks <> 168
  Scroll() ; SetPos(0,0) ; ReadKill(.T.) ; GetList := {}
  DevPos( 0, 0 ) ; DevOut( "DataBase Not Found !  Press Any Key To Continue" )
  T=SER_OK()
  endif
  IF  T= 1 .OR. cks =168
    CKS=cks_1

    DevPos( 0, 0 ) ; DevOut( "             " )
  ELSE
    __Quit()
  ENDIF
ENDIF
RETU  ""

