xcx=""
for _xcnt=1   to  ratno_wid
xcx=xcx+"!"
next

ARR3[1] :=XCX
ARR3[gs_tot +uwc_tot+ 2] :="99"
ARR_PCS[1] :="dSP_TOTW"
FOR I=1 TO  gs_tot +uwc_tot
  ARR2[I+1] :="M" + ALLTRIM(STR(I))
  ARR3[I+1] :=A_M_NAME[I,3]
  ARR_PCS[I+1] :="dSP_TOTW"
NEXT

dbSelectArea( "5" )
dbCloseArea()
dbUseArea( .F.,, "PAR1",, if(.F. .OR. .F., !.F., NIL), .F. )
FOR I=1 TO GS_TOT +UWC_TOT
  IX_C=ALLTRIM(STR(I,2,0))
  dbGoto(20)
  ARR3[I+1] :=ALLTRIM(PA&IX_C)
NEXT
dbCloseArea()
dbUseArea( .F.,, "PAR",, if(.F. .OR. .F., !.F., NIL), .F. )


ARR4[gs_tot +uwc_tot+ 2]=0
FOR I=1 TO 15
  IF EMPTY(A_M_NAME[I,3]) <> .T.
    XX_DE:=A_M_NAME[I,3]
    XX_DE=LEN(XX_DE)- LEN(ALLTRIM(STR(INT(VAL(XX_DE)),8,0)))
    IF XX_DE=0
      ARR4[I+1] :=0
    ELSE
      ARR4[I+1] :=XX_DE-1
    ENDIF
  ENDIF
NEXT




TW_DSPX= LEN(ARR1[1])-5


RET_X1=SPACE(4)
C_TOP1="F7-¦C¦L F8-¦C¦L¥»µ§ "
F7_FUNC="PNT_RATEN"
C_TOP2=""
F8_FUNC="PNT_RATEN"
if SECR[2]=1
  F3_FUNC="GET_SECRE"
C_TOP1="F7-¦C¦L F8-¦C¦L¥»µ§ F3-"
ENDIF
xd_wno=fSelectNo()


IF EMPTY(ActNo)=.T.
    ActNo="2"
ENDIF
    ActNo_N =VAL(ActNo)
   dbSelectArea( ActNO_N )


dbGoTop()
if  BOF()
  dbAppend()
  ENDIF
n_rec=recno()
P_FUNC0 := P_FUNC1 := P_FUNC2 := P_FUNC3 := P_FUNC4 := P_FUNC5 := P_FUNC6 := P_FUNC7 := P_FUNC8 := P_FUNC9 := P_FUNC10 := P_FUNC11 := P_FUNC12 := P_FUNC13 := " "
P_FUNC0="dsp_totw"
DLA_DSP=0
xposn=3

if  15 >=13
  xposn=0
endif
IF  STAR=0
  IF SECR[2]=0


    _GET_BROW(3,xposn,18,XN_TITL+1,ARR1,ARR2,ARR3,"_DMAKE1",ActNo,"P",.T.,.T.,@BisDataChg)
  ELSE

    _GET_BROW(3,xposn,18,XN_TITL+1,ARR1,ARR2,ARR3,"_DMAKE1",ActNo,"N",.T.,.T.,@BisDataChg)
  ENDIF
ELSE
  DLA_DSP=1
  IF SECR[2]=0
    _GET_BROW(14,xposn,10,XN_TITL+1,ARR1,ARR2,ARR3,"_DMAKE1",ActNo,"Y",.T.,.T.,@BisDataChg)
  ELSE
    _GET_BROW(14,xposn,10,XN_TITL+1,ARR1,ARR2,ARR3,"_DMAKE1",ActNo,"N",.T.,.T.,@BisDataChg)
  ENDIF
ENDIF
DLA_DSP=1
P_FUNC0 := P_FUNC1 := P_FUNC2 := P_FUNC3 := P_FUNC4 := P_FUNC5 := P_FUNC6 := P_FUNC7 := P_FUNC8 := P_FUNC9 := P_FUNC10 := P_FUNC11 := P_FUNC12 := P_FUNC13 := " "
C_TOP1 := F3_FUNC := F7_FUNC := F8_FUNC := " "
SetColor( "&C7 +/ &C1" )
dspe_mixamp=1
dbSelectArea( xd_wno )
retu







































































































































   FUNCTION _GET_BROW
   PARAMETERS  Y1_N,X1_N,YL_N,TIT_N,ARR_TITLE,ARR_REC_NAME,ARR_TYPE,P_FUNC,Nb_SELE,_MODI,MDYPAGE,DELREC,isDataChg
   IF _MODI="Y"
     FIST_REC := LAST_REC := 0
   ENDIF
   item_max=0
   item_ofsa=0
   _DATA_MODIFY =0
   X_G_B=SAVESCREEN(Y1_N-1,0,Y1_N+YL_N,79)
   XCOR=SETCOLOR()
   XXP=LEN(C_TOP2)+1
   IF EMPTY(C_TOP2)=.T.
   XXP=0
   ENDIF
   PUBLIC   ARR_DSPN
   ARR_DSPN=ARRAY(15 +3)
   AFILL(ARR_DSPN,0)
   sIndexp := 0
   XX=X1_N+XXP +1+LEN(ARR_TITLE[1])
   if f3_run=-1
       ARR_DSPN[1] :=0
   else
       ARR_DSPN[1] :=XX -1-LEN(ARR3[1])
   endif
   X=2

   if x1_n >1
     D_C=ALLTRIM(C_TOP2) +" "
   else
     d_c=""
   endif
   D_C=D_C +ARR_TITLE[1]+" "
   while X <=  TIT_N

     xp=1
     xspace=" "
     if ( LEN(ARR_TITLE[X]) > len(arr_type[x]))  .AND. x <> gs_tot+2
       xp=0
     xspace=""
     endif
     XX=XX+xp+LEN(ARR_TITLE[X])

      ARR_DSPN[x]=XX -LEN(ARR3[X])-1
      if ARR_DSPN[X] + LEN(ARR_TYPE[X]) >79
     IF ITEM_MAX=0
        ITEM_MAX=X-1
        ARR_DSPN[x]= ARR_DSPN[2]
        XX=ARR_DSPN[x] +xp +LEN(ARR_TITLE[X])
     ENDIF

      ENDIF

     D_C=D_C +ARR_TITLE[X]
     X=X+1
     IF X <= TIT_N
       D_C=D_C +xspace
     ENDIF
   ENDDO
   IF item_max=0
      item_max=TIT_N
   ENDIF













   DC_L=LEN(D_C)
   Set( 20, "SCREEN" )
   X_C2=" Pg-Wown Up¤W¤U­¶ Enter¿ï¾Ü "
   IF  (_MODI="Y") .OR. (_MODI="K")
     X_C1="¡ô¡õ¤W¤Uµ§ F10-§R°£ Esc¸õÂ÷"
   ELSE
     X_C1="¡ô¡õ¤W¤Uµ§ Esc¸õÂ÷ "
   ENDIF
   IF (FIST_REC<>0).AND. (FIST_REC=LAST_REC)
     X_C1=" ¡ô¡õ-­×§ï Esc¸õÂ÷ "
     X_C2=""
   ENDIF
   IF ITEM_MAX <> TIT_N
      X_C2= "Ctrl¡÷¥k­¶ Ctrl¡ö¥ª­¶"
   ENDIF
   IF EMPTY(C_TOP1)= .F.
     x_c2=c_top1 +x_c2
   ENDIF
   X=LEN(X_C1)
   IF X>DC_L
     XX=INT((X-DC_L)/2)
   ELSE
     XX=0
   ENDIF
   SetColor( "GR+ / BL" )

   Scroll( Y1_N-1, X1_N-2-XX, Y1_N+YL_N+1, X1_N + DC_L +1 +XX ) ; SetPos( Y1_N-1, X1_N-2-XX )

   BOX_S(Y1_N-1,X1_N-2-XX,Y1_N+YL_N,X1_N + DC_L+XX)
   SetColor( "GR+ / R" )
   DevPos( Y1_N-1, X1_N ) ; DevOut( D_C )

   IF  DC_L>LEN(X_C1)+LEN(X_C2)+1
     X=LEN(X_C1)+LEN(X_C2)

     DevPos( Y1_N+YL_N, (X1_N +INT((DC_L*0.5) -(X *.5)))-1 ) ; DevOut( X_C2+" "+X_C1 )
   ELSE


     DevPos( Y1_N+YL_N-1, (X1_N +INT((DC_L*0.5) -(X *.5)))-1 ) ; DevOut( X_C1 )
     DevPos( Y1_N+YL_N, (X1_N +INT((DC_L*0.5) -(X *.5)))-1 ) ; DevOut( X_C2 )
   ENDIF



   dbSelectArea( Nb_SELE )
   N_YN=Y1_N
   N_REC=1

   SetColor( "W+ / BL" )
   DO _DSP_ALL
   N_REC=RECNO()


   SetColor( "B / W+" )
   _REC_DSP(N_YN,"W+")
   _LOOP_BR=1
   T=0
   while _LOOP_BR =1
     IF _MODI="P"
       T=-992
       _MODI="Y"
     ENDIF
     dbSelectArea( Nb_SELE )
     NS_RECNO=RECNO()
     while T=0
       IF T0A <>0
     T=T0A
     T0A=0
       ELSE
     T=INKEY()
       ENDIF
       IF DLA_DSP=1
     DO DSP2
       ENDIF
       IF T0A=0
     DO LUSTP
       ENDIF
     ENDDO
     dbSelectArea( Nb_SELE )
     dbGoto(NS_RECNO)
     DO CASE
     CASE T=2  .OR. T=26
       IF ITEM_MAX <> TIT_N
     SetColor( "GR+ / R" )
      if item_ofsa=0
         item_ofsa=item_max
         DevPos( Y1_N-1, ARR_DSPN[2] ) ; DevOut( SPACE(80-ARR_DSPN[2]) )
         FOR XLOOP3=ITEM_MAX +1 TO TIT_N
           DevPos( Y1_N-1, ARR_DSPN[XLOOP3] ) ; DevOut( ARR_TITLE[XLOOP3] )
         NEXT
      else
         item_ofsa=0
         DevPos( Y1_N-1, X1_N ) ; DevOut( D_C )
      endif
       endif
       xN_REC=RECNO()
       xN_YN=N_YN
       dbSkip( -(N_YN-Y1_N) )
       IF BOF()
     dbGoTop()
       ENDIF
       SetColor( "W+ / BL" )
       DO _DSP_ALL
       SetColor( "GR+ / W+" )
       N_REC=XN_REC
       N_YN=XN_YN
       dbGoto(N_REC)
       _REC_DSP(N_YN,"W+")
       TNSTP=1
       T=-992
     CASE T=28
       IF  EMPTY(F3_FUNC) =.F.
     DO &F1_FUNC
       ENDIF
       T=0
     CASE T=-2
       IF  EMPTY(F3_FUNC) =.F.
     DO &F3_FUNC
       ENDIF
       T=0
     CASE T=-6
       F7_ACT=1
       IF  EMPTY(F7_FUNC) =.F.
     F7_ACT=1
     DO &F7_FUNC with  Nb_SELE
       ENDIF
       T=0
     CASE T=-7
       IF  EMPTY(F8_FUNC) =.F.
     DO &F8_FUNC with  Nb_SELE
       ENDIF
       T=0
     CASE T=7
       isDataChg=1
       IF  EMPTY(DEL_FUNC) =.F.
     DO &DEL_FUNC
       ENDIF
       T=0
     CASE T=-992   .AND. (_MODI="Y"  .OR.    _MODI="K"  .OR.    _MODI="1"  )

       _GET_STP=1
       while ( _GET_STP >=0 )  .AND. ( _GET_STP <=TIT_N )
      R_C=ARR_REC_NAME[_GET_STP]
      T_C=ARR_TYPE[_GET_STP]
      _D_TYPE=TYPE("&R_C")
      C_L=LEN(ARR_TYPE[_GET_STP])
      SetColor( "&12 /&11" )
      IF VALTYPE(&R_C)="N"  .AND. &R_C -INT(&R_C) >0

        DevPos( N_YN, ARR_DSPN[_GET_STP] ) ; DevOut( SUBSTR(LTRIM(STR(&R_C))+SPACE(10) ,1,LEN(T_C)) )
      ELSE
        DevPos( N_YN, ARR_DSPN[_GET_STP] ) ; DevOutPict( &R_C, "&T_C" )
      ENDIF
      GET_STPC=ALLTRIM(STR(_GET_STP,2,0))
      p_func=P_FUNC&GET_STPC
      X_GETSTP=_GET_STP
      SetColor( "b  /w" )
      _REC_DSP(N_YN,"W")
      xisdatachg=0
     _GET_STP=READ_AN(N_YN,ARR_DSPN[_GET_STP],&R_C,"&_D_TYPE",C_L,ARR4[_GET_STP],_GET_STP,"&P_FUNC",@xisdatachg,Nb_SELE)
     if  xisdatachg=1
       isDataChg=1
     endif


     IF _GET_STP=99

       _LOOP_BR=0
     ENDIF
     IF T_C="!" .AND. (VALTYPE(_ACT_PX)="C")
       _ACT_PX=UPPER(_ACT_PX)
     ELSE



     ENDIF
     T_C=ARR_TYPE[X_GETSTP]
     DevPos( N_YN, ARR_DSPN[X_GETSTP] ) ; DevOutPict( _ACT_PX, "&T_C" )
     dbSelectArea( Nb_SELE )
     _FIELD->&R_C := _ACT_PX
     IF  EMPTY(ARR_PCS[X_GETSTP]) =.F.
       PCS_CF(N_YN,&R_C,X_GETSTP,RECNO())
     ENDIF
       ENDDO
       SetColor( "gr + /w" )
       dbSelectArea( Nb_SELE )
       dbGoto(NS_RECNO)
       _REC_DSP(N_YN,"W")
       _DATA_MODIFY=1
       IF (_GET_STP <>98)
     if t=13  .AND. (tit_n <> item_max)
       t=26
     else
       T=0
     endif
       ENDIF
     CASE T=5
       IF  (_MODI <> "1")
     UP_DSP1()
       ENDIF
       T=-992
     CASE T=24
       IF  (_MODI <> "1")
       IF  _MODI="Y"    .AND. (_MODI <> "1")
     dbSkip(1)
     IF  EOF()
       dbSkip( -1 )
       FOR    X =1 TO TIT_N
         R_C=ARR_REC_NAME[X]
         IF EMPTY(&R_C)=.F.
           dbAppend()
           EXIT
         ENDIF
       NEXT
       dbSkip(1)
     ENDIF
     dbSkip( -1 )
       ENDIF
       DOWN_DSP1()
       ENDIF
       T=-992
     CASE T=7 .AND.  DELREC=.T.
       isDataChg=1
       dbDelete()
       __dbPack()
       IF  EOF()
     dbSkip( -1 )
     IF  EOF()
       dbAppend()
     ENDIF
       ENDIF
       N_REC=RECNO()
       N_YN=Y1_N
       SetColor( "W+ / BL" )
       DO _DSP_ALL
       SetColor( "GR+ / W+" )
       dbGoto(N_REC)
       _REC_DSP(N_YN,"W+")
       _DATA_MODIFY =1
       T=0
     CASE T=18     .AND.    MDYPAGE=.T.
       dbSkip( -(YL_N +(N_YN-Y1_N)) )
       IF BOF()
     dbGoTop()
       ENDIF
       N_REC=RECNO()
       N_YN=Y1_N
       SetColor( "W+ / BL" )
       DO _DSP_ALL
       SetColor( "GR+ / W+" )
       dbGoto(N_REC)
       _REC_DSP(N_YN,"W+")
       T=0
     CASE T=3     .AND.    MDYPAGE=.T.
       dbSkip( ((Y1_N+YL_N-N_YN)) )
       IF EOF()
     dbGoBottom()
       ENDIF
       N_REC=RECNO()
       N_YN=Y1_N
       SetColor( "W+ / BL" )
       DO _DSP_ALL
       dbGoto(N_REC)
       SetColor( "GR+ / W+" )
       _REC_DSP(N_YN,"W+")
       T=0
     CASE T=13
       X=1
       while X <=TIT_N
     R_C=ARR_REC_NAME[X]
     XK=ALLTRIM(STR(X,2,0))
     RET_X&XK=&R_C
     RET_A[X]=&R_C
     X=X+1
       ENDDO
       _LOOP_BR=0
       T=0
     CASE T=23 .OR. T=27
       _LOOP_BR=0
       T=0
     otherwise
       T=0
     ENDCASE
   ENDDO
   T=0
   SetColor( "&XCOR" )
   MODI_PAGE= .T.
   RESTSCREEN(Y1_N-1,0,Y1_N+YL_N,79,X_G_B)
   RETU























































































































































































































































































































































    FUNCTION READ_AN
   PARAMETERS  RDY1,RDX1,PX,D_TYPE,LONG,N_DASH,TNSTP,C_FUNC,Rischg,Nb_SELE    


   static  xp_read
   Rischg =0












   last_key=0
   XPX=pX
   RDX1=RDX1
   SetColor( "0/7+" )
   DO CASE
   CASE   D_TYPE="N"
     IF ((N_DASH=0 )  .AND. (XPX -INT(XPX) <>0) )
       CHRN=LTRIM(STR(XPX,LONG+3,2))
       XLN1=LEN(CHRN)
       IF XLN1 < LONG
     CHRN=SUBSTR("       ",1,LONG-XLN1) + CHRN
       ELSE
     CHRN=SUBSTR(CHRN,1,LONG)
       ENDIF
     ELSE

       IF XPX -INT(XPX)=0
     CHRN=ALLTRIM(STR(INT(XPX)))
       ELSE
     DO CASE
     CASE  XPX *10 -INT(XPX *10)=0
       CHRN=ALLTRIM(STR(XPX,10,1))
     CASE XPX *100 -INT(XPX *100)=0
       CHRN=ALLTRIM(STR(XPX,10,2))
     OTHERWISE
       CHRN=ALLTRIM(STR(XPX))
     ENDCASE
       ENDIF
       IF LEN(CHRN) < LONG
     CHRN=SUBSTR(SPACE(10) +CHRN,-LONG,LONG)
       ENDIF
     ENDIF
   CASE   D_TYPE="C"
     CHRN=SUBSTR(XPX,1,LONG)
   CASE   D_TYPE="D"
     CHRN=DTOC(XPX)
     LONG=10
   ENDCASE
   SetColor( "0 + /7" )
   DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
   xp_read=0
   t=0
   SetColor( "W+  / R" )
   DevPos( RDY1, (RDX1+xp_read) ) ; DevOut( SUBSTR(CHRN,xp_read+1,1) )
   SetColor( "7/0" )
   XX1=RDX1+xp_read
   YY1=RDY1
   T1=0
   TN1=0
   while T1<>233
     T=0
     dbSelectArea( LUDBF )
     while T=0
       IF (T0A <>0) .AND. (DSP_SCALL=1) .AND. (LUSTP_EN=1)
     T=T0A
     T0A=0
       ELSE
     T=INKEY()
       ENDIF
       IF (DLA_DSP=1)  .AND.  (DSP_SCALL=1)
     DO DSP2
       ENDIF
       IF (T0A=0   ) .AND. (LUSTP_EN=1)
      DO LUSTP
       ENDIF
     ENDDO
     dbSelectArea( LUDBF )
     _LASTKEY=T
     last_key=t
     DO CASE
     CASE T=-4
       IF  EMPTY(F5_FUNC) =.F.
     F5_ACT=1
     IF F5_FUNC <>"0"
       DO &F5_FUNC
     ELSE
       T1=233
       TNSTP=99
     ENDIF
     F5_ACT=0
       ENDIF
     CASE T=-6
       IF  EMPTY(F7_FUNC) =.F.
     F7_ACT=1
     IF F7_FUNC <>"0"
       DO &F7_FUNC with  Nb_SELE
     ELSE
       T1=233
       TNSTP=99
     ENDIF
     F7_ACT=0
       ENDIF
     CASE T=-7
       IF  EMPTY(F8_FUNC) =.F.
     F7_ACT=0
     IF F8_FUNC <>"0"
       DO &F8_FUNC with  Nb_SELE
     ELSE
       T1=233
       TNSTP=99
     ENDIF
       ENDIF
     CASE  T=28 .AND. ( C_FUNC <> " ")
       DO &C_FUNC
       T=0
       xp_read=0
       SetColor( "0/7 +" )
       DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
       SetColor( "&C1 +/ 7 +" )
       DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
       SetColor( "W+    / R" )
       DevPos( RDY1, (RDX1+xp_read) ) ; DevOut( SUBSTR(CHRN,xp_read+1,1) )
     case  T=7
     Rischg=1
     DO CASE
     CASE  D_TYPE <> "D"
       CHRN=SUBSTR(CHRN,1,xp_read) +SUBSTR(CHRN,xp_read+2,LONG-xp_read-1) + " "
     ENDCASE
     SetColor( "0/7 +" )
     DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
     SetColor( "W+  / R" )
     DevPos( RDY1, (RDX1+xp_read) ) ; DevOut( SUBSTR(CHRN,xp_read+1,1) )
     SetColor( "&C7 +/ &C1" )
     XX1=RDX1+xp_read
     YY1=RDY1
      CASE T=-9 .AND. _modi="YY"
    Rischg=1
    dbSelectArea( N_SELE )
    dbDelete()
    __dbPack()
    dbGoto(N_REC)
    IF  EOF()
      dbSkip( -1 )
      N_YN=N_YN  -1
      IF N_YN < Y1_N
        N_YN=Y1_N
      ENDIF
    ENDIF
    IF  BOF()
      dbGoto(1)
      N_YN=Y1_N
    ENDIF
    IF  EOF()
      dbAppend()
      N_YN=Y1_N
    ENDIF
    N_YNO=N_YN
    N_REC=RECNO()
    N_RECO=N_REC
    dbSkip( - (N_YN -Y1_N  ) )
    SetColor( "W+ / BL" )
    DO _DSP_ALL
    SetColor( "b / W+" )
    N_REC=N_RECO
    dbGoto(N_REC)
    N_YN=N_YNO
    _REC_DSP(N_YN,"W+")
    N_REC=N_RECO
    N_YN=N_YNO
    dbGoto(N_REC)
    _DATA_MODIFY =1



    R_CB=ARR_REC_NAME[tnstp]
    xPX = &R_CB
    DO CASE
    CASE   D_TYPE="N"
      CHRN=STR(XPX,LONG,N_DASH)
    CASE   D_TYPE="C"
      CHRN=SUBSTR(XPX,1,LONG)
    CASE   D_TYPE="D"
      CHRN=DTOC(XPX)
      LONG=10
    ENDCASE
    px=chrn
    T=0
    rdy1=n_yn
     case  T=19
       IF xp_read>=1
     xp_read=xp_read-1
     DO CASE
     CASE  D_TYPE="D"
       IF xp_read=2 .OR.  xp_read=5
         xp_read=xp_read-1
       ENDIF
     ENDCASE
     SetColor( "0/7 +" )
     DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
     SetColor( "W+  / R" )
     DevPos( RDY1, (RDX1+xp_read) ) ; DevOut( SUBSTR(CHRN,xp_read+1,1) )
     SetColor( "&C7 +/ &C1" )
     XX1=RDX1+xp_read
     YY1=RDY1
       ENDIF
     CASE  T=4
       IF xp_read<=LONG-2
     xp_read=xp_read+1
     DO CASE
     CASE  D_TYPE="D"
       IF xp_read=2 .OR.  xp_read=5
         xp_read=xp_read+1
       ENDIF
     ENDCASE
     SetColor( "0/7 +" )
     DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
     SetColor( "&C1 +/ 7 +" )
     DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
     SetColor( "W+  / R" )
     DevPos( RDY1, (RDX1+xp_read) ) ; DevOut( SUBSTR(CHRN,xp_read+1,1) )
     SetColor( "&C7 +/ &C1" )
     XX1=RDX1+xp_read
     YY1=RDY1
       ENDIF
     CASE   T>=32
    Rischg=1
       xp_read=xp_read+1
       IF TN1=0 .AND. xp_read=1
     TN1=1
     DO CASE
     CASE  D_TYPE <> "D"
       CHRN=SPACE(LONG)
     ENDCASE
       ENDIF
       IF xp_read<LONG
     CHRN=SUBSTR(CHRN,1,xp_read-1)+CHR(T)+SUBSTR(CHRN,xp_read+1,LONG-xp_read)
     DO CASE
     CASE  D_TYPE="D"
       IF xp_read=2 .OR.  xp_read=5
         xp_read=xp_read+1
       ENDIF
     ENDCASE
     SetColor( "0/7  +" )
     DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
     SetColor( "7/0" )

     SetColor( "0/7 +" )
     DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
     SetColor( "W+  / R" )
     DevPos( RDY1, (RDX1+xp_read) ) ; DevOut( SUBSTR(CHRN,xp_read+1,1) )
     SetColor( "&C7 +/ &C1" )
     XX1=RDX1+xp_read
     YY1=RDY1
       ELSE
     CHRN=SUBSTR(CHRN,1,xp_read-1)+CHR(T)
     SetColor( "0/7+" )
     DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
     SetColor( "7/0" )
     xp_read=xp_read-1
     SetColor( "0/7 +" )
     DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
     SetColor( "W+  / R" )
     DevPos( RDY1, (RDX1+xp_read) ) ; DevOut( SUBSTR(CHRN,xp_read+1,1) )
     SetColor( "&C7 +/ &C1" )

     XX1=RDX1+xp_read
     YY1=RDY1
       ENDIF
     CASE T=13     .OR. T=23 .OR. T=5 .OR. T=24.OR. t=2 .OR. T=3 .OR. T=18  .OR. T=2  .OR. T=26
       IF  T=28 .AND. ( C_FUNC <> " ")
     DO &C_FUNC
     T=13
       ENDIF
       T1=233
       DO CASE
       CASE   D_TYPE="N"
     xPX=VAL(CHRN)
       CASE   D_TYPE="C"
     XPX=CHRN
       CASE   D_TYPE="D"
     XPX=CTOD(CHRN)
       ENDCASE

       PX=XPX
       SetColor( "0/7+" )
       DevPos( RDY1, RDX1 ) ; DevOut( CHRN )



       DO CASE
       CASE T=5
     IF TNSTP=1
       T1=233
       TNSTP=99
     ENDIF
     IF TNSTP>1
       if tnstp=item_max +1
         TNSTP=1
       else
         TNSTP=TNSTP-1
       endif
       LAST_PRESS=5
     ENDIF
       CASE T=3
     T1=233
       TNSTP=98
       CASE T=18
     T1=233
       TNSTP=98
       CASE T=24
     T1=233
     TNSTP=98
       CASE T=13
     if item_ofsa=0
       TNSTP=TNSTP+1
       if tnstp >item_max
         TNSTP=tit_n+1
       endif
     else
       if tnstp=1
         TNSTP=item_max+1
       else
         TNSTP=TNSTP+1
       endif
     endif
       CASE T=2  .OR. T=26
     T1=233
     TNSTP=98
       ENDCASE
       IF T=23
     TNSTP=99
       ENDIF
     CASE T=27
       SetColor( "0/7 +" )
       DevPos( RDY1, RDX1 ) ; DevOut( CHRN )
       XPX=PX
       DO CASE
       CASE   D_TYPE="N"
     XPX=VAL(CHRN)
       CASE   D_TYPE="C"
     XPX=CHRN
       CASE   D_TYPE="D"
     XPX=CTOD(CHRN)
       ENDCASE
       PX=XPX
       SetColor( "7/0" )
       xp_read=0
       t=0
       XX1=RDX1+xp_read
       YY1=RDY1
       T1=233
       TNSTP=99
     ENDCASE
   ENDDO
   _act_px=PX
   RETU   TNSTP






   FUNCTION   _REC_DSP
   PARAMETERS  YD_N,XBCOR
   xLOP3=1
   show_last=ITEM_MAX

   IF  F3_RUN=-1   .OR.  F3_RUN=-18
      IF MIXSEC >0
    IF XBCOR="W"

    ELSE

    ENDIF







      ENDIF
   ENDIF
   while xLOP3 <=show_last
     R_CB=ARR_REC_NAME[xLOP3]
     T_CB=ARR_TYPE[xLOP3]
     _XN1=&R_CB
     IF (VALTYPE(_XN1)="N")
       xdec=fget_dec(t_cb)
       IF F3_RUN=-29
      IF XDEC=0
         XTMP3=ABS(_XN1 -INT(_XN1))
         IF XTMP3 <>0
        XTMP3=ALLTRIM(STR(XTMP3,3,2))
        XDEC=LEN(XTMP3)-2
         ENDIF
      ENDIF
       ENDIF

       X_L=LEN(T_CB)
       IF &R_CB -INT(&R_CB) =0
     X_D=FSUBSTR(INT(&R_CB),-X_L," ",0)
       ELSE
     IF &R_CB *10  -INT(&R_CB *10) =0
       X_D=FSUBSTR(&R_CB,-X_L," ",xdec)
     ELSE
       X_D=FSUBSTR(&R_CB,-X_L," ",2)
     ENDIF
       ENDIF
       DevPos( YD_N, ARR_DSPN[xLOP3] ) ; DevOut( x_d )
     ELSEIF (VALTYPE(_XN1)="C")
       X_L=LEN(T_CB)

       X_D=SUBSTR(&R_CB,1,X_L)
       DevPos( YD_N, ARR_DSPN[xLOP3] ) ; DevOutPict( x_d, "&T_CB" )
     ELSE
       X_L=LEN(T_CB)
       X_D=&R_CB
       DevPos( YD_N, ARR_DSPN[xLOP3] ) ; DevOut( x_d )


     ENDIF
     IF  EMPTY(ARR_PCS[xLOP3]) =.F.
       PCS_CF(YD_N,&R_CB,xLOP3,RECNO())
     ENDIF
     xLOP3=xLOP3+1
     if item_ofsa >0
    if xlop3=2
       xlop3=item_ofsa +1
       show_last=TIT_N
    endif
     endif
   ENDDO
   IF  F3_RUN=-1   .OR.  F3_RUN=-18
       SetColor( "W+    / B" )
   ENDIF
   RETU


   PROCEDURE    _DSP_ALL
   PARAMETERS  P1,P2,P3
   XAL=1
   Y_X=Y1_N
   Scroll( Y1_N, X1_N, Y1_N+YL_N-1, X1_N + DC_L-1 ) ; SetPos( Y1_N, X1_N )
   IF ! BOF()
     while (XAL <=YL_N)  .AND. (! EOF())
       _REC_DSP(Y_X,"B")
       dbSkip(1)
       Y_X=Y_X+1
       XAL=XAL+1
     ENDDO
     dbSkip( -1 )
     N_YN=Y_X -1
   ENDIF
   N_REC=RECNO()
   RETU

   FUNCTION   UP_DSP1
   PARAMETERS  X
   SetColor( "W+ / BL" )
   _REC_DSP(N_YN,"BL")
   dbSkip( -1 )
   if fist_rec=0
     IF BOF()
       dbGoTop()
     ELSE
       N_YN=N_YN -1
       IF N_YN < Y1_N
     N_YN=Y1_N
     SCROLL(Y1_N,X1_N,Y1_N+YL_N-1,X1_N+DC_L,-1)
       ENDIF
     ENDIF
   else
     IF recno() < FIST_REC
       dbSkip(1)
     ELSE
       N_YN=N_YN -1
       IF N_YN < Y1_N
     N_YN=Y1_N
     SCROLL(Y1_N,X1_N,Y1_N+YL_N-1,X1_N+DC_L,-1)
       ENDIF
     ENDIF
   endif
   SetColor( "bl  / W+" )
   _REC_DSP(N_YN,"W+")
   N_REC=RECNO()
   RETU

   FUNCTION   DOWN_DSP1
   PARAMETERS  X
   SetColor( "W+ / BL" )
   _REC_DSP(N_YN,"BL")
   dbSkip(1)
   IF LAST_REC=0
     IF ! EOF()
       N_YN=N_YN +1
       IF N_YN > Y1_N + YL_N-1
     N_YN=Y1_N +YL_N-1
     SCROLL(Y1_N,X1_N,Y1_N+YL_N-1,X1_N+DC_L,1)
       ENDIF
     ELSE
       dbGoto(N_REC)
     ENDIF
   ELSE
     IF RECNO()<=LAST_REC
       N_YN=N_YN +1
       IF N_YN > Y1_N + YL_N-1
     N_YN=Y1_N +YL_N-1
     SCROLL(Y1_N,X1_N,Y1_N+YL_N-1,X1_N+DC_L,1)
       ENDIF
     ELSE
       dbSkip( -1 )
     ENDIF
   ENDIF
   SetColor( "bl  / W+" )
   _REC_DSP(N_YN,"W+")
   N_REC=RECNO()
   RETU






PROCEDURE  DSP_TOTW
PARAMETERS  P1,P2,P3
c_color=SETCOLOr()
SetColor( "GR+ / BL" )

XTOT=0
FOR I=1 TO gs_tot + uwc_tot

  IX_C=ALLTRIM(STR(I,2,0))
  XTOT=XTOT +  M&IX_C
  IF UCHTYPE=16 .AND.  I>=9
    EXIT
  ENDIF
NEXT

DevPos( Y_POSI, ARR_DSPN[2]-6 ) ; DevOutPict( XTOT, "9999" )
SetColor( "&c_color" )
retu
