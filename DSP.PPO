FUNCTION  Set_Temp_cal
PARAMETERS  index,Xfunc,datas
d_retu=0
   do  case
   case Xfunc=0
       temp_cal[1,index] :=0
       temp_cal[2,index] :=seconds()
       temp_cal[3,index] :=0
   case Xfunc=1
     x=seconds()-temp_cal[2,index]
     if (x <0)
       x=86399 +x
     endif
     if x< temp_cal[1,index]
       d_retu=datas  *x/  temp_cal[1,index]
     else
       d_retu=datas
       temp_cal[3,index] :=1
     endif
   endcase
retu d_retu


FUNCTION  SetDigitOut
PARAMETERS  doport,doch,out   
chn=digitout[doport,doch+1]    
if (chn >= 0)
  if (chn >=16)
     chn=chn-16
     dout2(chn,out)
  else
     dout(chn,out)
  endif
endif
retu

FUNCTION  ReadDigitOut
PARAMETERS  doport,doch
retux=0
chn=digitout[doport,doch+1]
if (chn >= 0)
  if (chn >=16)
     chn=chn-16
     retux=rd_do2(chn)
  else
     retux=rd_do1(chn)
  endif
endif
retu  retux

