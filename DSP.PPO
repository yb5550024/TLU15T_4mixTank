      YY1=Y1
    ENDIF
  CASE    T=4
    IF XP<=LONG-2
      XP=XP+1

      SetColor( "0/7 *" )
      DevPos( Y1, X1 ) ; DevOut( CHRN )
      SetColor( "&C1 */ &C7 +" )
      DevPos( Y1, X1 ) ; DevOut( CHRN )
      SetColor( "W+  / R" )
      DevPos( Y1, (X1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
      SetColor( "&C7 +/ &C1" )

      XX1=X1+XP
      YY1=Y1
    ENDIF
  CASE     T=43 .OR.T=45 .OR.T=46 .OR.T=32 .OR. T=48 .OR.T=49 .OR.T=50 .OR.T=51 .OR.T=52 .OR.T=53 .OR.T=54 .OR.T=55 .OR.T=56 .OR.T=57
    XP=XP+1
    IF TN1=0 .AND. XP=1
      TN1=1
      IF  TNSTP<>9
    CHRN="    "
      ELSE
    CHRN="     "
      ENDIF
    ENDIF
    IF XP<LONG
      CHRN=SUBSTR(CHRN,1,XP-1)+CHR(T)+SUBSTR(CHRN,XP+1,LONG-XP)
      SetColor( "0/7    *" )
      IF  VAL(CHRN)>=1000
    CHRN="    "
      ENDIF
      DevPos( Y1, X1 ) ; DevOut( CHRN )
      SetColor( "7/0" )

      SetColor( "0/7 *" )
      DevPos( Y1, X1 ) ; DevOut( CHRN )
      SetColor( "W+  / R" )
      DevPos( Y1, (X1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
      SetColor( "&C7 +/ &C1" )

      XX1=X1+XP
      YY1=Y1
    ELSE
      CHRN=SUBSTR(CHRN,1,XP-1)+CHR(T)
      SetColor( "0/7" )
      IF  TNSTP<>9
    IF  VAL(CHRN)>=1000
      CHRN="    "
    ENDIF
      ELSE
    IF  VAL(CHRN)>=100
      CHRN="     "
    ENDIF
      ENDIF

      DevPos( Y1, X1 ) ; DevOut( CHRN )
      SetColor( "7/0" )
      XP=XP-1
      SetColor( "0/7 *" )
      DevPos( Y1, X1 ) ; DevOut( CHRN )
      SetColor( "W+  / R" )
      DevPos( Y1, (X1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
      SetColor( "&C7 +/ &C1" )

      XX1=X1+XP
      YY1=Y1
    ENDIF
  CASE T=13   .OR. T=23 .OR. T=5 .OR. T=24.OR. t=2
    T1=233
    IF TNSTP<>9
      XPX =INT(VAL(CHRN))
      PX=XPX
      DevPos( Y1, X1 ) ; DevOutPict( PX, "9999" )
    ELSE
      XPX =INT(VAL(CHRN)*100)/100
      IF XPX > 100
    XPX=1
      ENDIF
      PX=XPX
      DevPos( Y1, X1 ) ; DevOutPict( PX, "99.99" )
    ENDIF
    dbSelectArea( "5" )
    IF TNSTP=8
      dbGoto(22)
      _FIELD->PA3 := PX
    ELSE
      dbGoto(3)
      CHNO=LTRIM(STR(TNSTP))
      IF TNSTP=9
    CHNO=STR(8,1,0)
      ENDIF
      _FIELD->PA&CHNO := PX
    ENDIF
    DO CASE
    CASE T=5
      IF TNSTP>1
    TNSTP=TNSTP-1
      ENDIF
    CASE T=24  .OR. T=13
      TNSTP=TNSTP+1
    ENDCASE
    IF T=23 .OR. t=2
      TNSTP=10
    ENDIF
  CASE T=27
    SetColor( "0/7" )
    XPX=PX
    IF TNSTP<>9
      DevPos( Y1, X1 ) ; DevOutPict( XPX, "9999" )
      CHRN=STR(INT(XPX),4)
    ELSE
      DevPos( Y1, X1 ) ; DevOutPict( XPX, "99.99" )
      CHRN=STR(XPX,5,2)
    ENDIF
    SetColor( "7/0" )
    XP=0
    t=0


    XX1=X1+XP
    YY1=Y1
  ENDCASE
ENDDO
RETU   TNSTP

FUNCTION dsk_sno
PARAMETERS  dn

CBUFFER=SPACE(73)
__Run( "vol &dn > c:\TEST.TMP" )
NHANDLE=fopen("c:\TEST.TMP")
FREAD(NHANDLE,@CBUFFER,73)
x=SUBSTR(ALLTRIM(CBUFFER),-11,9)
fCLOSE("c:\TEST.TMP")
FErase( "c:\test.tmp" )
retu x

FUNCTION SER_AOK   
SER_X="4809"
SER_OK=1
SER_STP=1
while SER_STP <=4
  T_SER=0
  while T_SER=0
    T_SER=INKEY()

  ENDDO
  IF  CHR(T_SER) <> SUBSTR(SER_X,SER_STP,1)
    SER_OK=0
    EXIT
  ENDIF
  SER_STP=SER_STP +1
ENDDO
RETU SER_OK

PROCEDURE  DSK_KEY
PARAMETERS  P1,P2,P3
Scroll() ; SetPos(0,0) ; ReadKill(.T.) ; GetList := {}
a_s=space(9)
c_s=space(9)
AN="A:"
CN="C:"
SetCursor( if(Upper("ON") == "ON", 1, 0) )
DevPos( 5, 10 ) ; DevOut( "AN " ) ; SetPos( Row(), Col()+1 ) ; AAdd( GetList, _GET_( AN, "AN",,, ):display() )
DevPos( 6, 10 ) ; DevOut( "CN " ) ; SetPos( Row(), Col()+1 ) ; AAdd( GetList, _GET_( CN, "CN",,, ):display() )
ReadModal(GetList) ; GetList := {}
A_s=dsk_sno(AN)
c_s=dsk_sno(CN)
DevPos( 5, 10 ) ; DevOut( "AS " ) ; SetPos( Row(), Col()+1 ) ; AAdd( GetList, _GET_( A_S, "A_S",,, ):display() )
DevPos( 6, 10 ) ; DevOut( "CS " ) ; SetPos( Row(), Col()+1 ) ; AAdd( GetList, _GET_( C_S, "C_S",,, ):display() )
ReadModal(GetList) ; GetList := {}

RETU


