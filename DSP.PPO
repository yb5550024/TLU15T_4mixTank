  ENDIF
  if  x_OK=0
  Set( 20, "SCREEN" )
  endif
  Set( 20, "SCREEN" )
  RESTSCREEN(10,0,14,79,XPNT_ER)
endif
SetColor( "&XCOR" )
RETU X_OK

