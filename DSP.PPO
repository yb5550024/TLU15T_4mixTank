ENDCASE
SetColor( "&C4 / &C1" )
RETU

FUNCTION FILL_A_D4
PARAMETERS  A_N,X1,X2,X3,X4,X5,XN
FOR XAN1=X2 TO    X3
  FOR XAN2=1  TO  X4
    FOR XAN3=1 TO  X5
      A_N[X1,XAN1,XAN2,XAN3] :=XN
    NEXT
  NEXT
NEXT
RETU

FUNCTION FILL_A_D2
PARAMETERS  A_N,X1,X2,X3,XN
FOR XAN1=X1 TO    X2
  FOR XAN2=1  TO  X3
    A_N[XAN1,XAN2] :=XN
  NEXT
NEXT
RETU

FUNCTION A_COPY_4
PARAMETERS  A_N,X1,X2
FOR XAN1=1 TO  21
  FOR XAN2=X1  TO  X2
    FOR XAN3=1 TO  12
      A_N[2,XAN1,XAN2,XAN3] :=A_N[1,XAN1,XAN2,XAN3]
    NEXT
  NEXT
NEXT
RETU

FUNCTION A_COPY_5
PARAMETERS  A_N,X1,X2
FOR XAN1=1 TO  20
  FOR XAN2=X1  TO  X2
    FOR XAN3=1 TO  12
      A_N[4,XAN1,XAN2,XAN3] :=A_N[1,XAN1,XAN2,XAN3]
    NEXT
  NEXT
NEXT
RETU



FUNCTION A_STOR_4
PARAMETERS  A_N,X1,X2
FOR XAN1=1 TO  20
  FOR XAN2=X1  TO  X2
    FOR XAN3=1 TO  12
      A_N[3,XAN1,XAN2,XAN3] :=A_N[2,XAN1,XAN2,XAN3]
    NEXT
  NEXT
NEXT
RETU

FUNCTION A_STOR_1
PARAMETERS  A_N,X0,X1,X2
FOR XAN1=X0 TO    20
  FOR XAN2=X1  TO  X2
    FOR XAN3=1 TO  12
      A_N[3,XAN1,XAN2,XAN3] :=A_N[2,XAN1,XAN2,XAN3]
    NEXT
  NEXT
NEXT
RETU


FUNCTION A_STORn_1
PARAMETERS  A_N,X0,X1,X2,xs,xt
FOR XAN1=X0 TO    20
  FOR XAN2=X1  TO  X2
    FOR XAN3=1 TO  12
      A_N[xt,XAN1,XAN2,XAN3] :=A_N[xs,XAN1,XAN2,XAN3]
    NEXT
  NEXT
NEXT
RETU

FUNCTION _DSP_VBROW
PARAMETERS  Y1_N,X1_N,YL_N,TIT_N,ARR_TITLE,ARR_REC_NAME,ARR_TYPE,P_FUNC,N_SELE,_MODI,_PRINT  
DSP_MH=INT((79-X1_N-YL_N-2)/YL_N)
IF _MODI="Y"
  FIST_REC := LAST_REC := 0
ENDIF
_DATA_MODIFY =0
X_G_B=SAVESCREEN(Y1_N-1,0,Y1_N+TIT_N+1,79)
XCOR=SETCOLOR()
XXP=LEN(C_TOP2)+1
IF EMPTY(C_TOP2)=.T.
  XXP=0
ENDIF
ARR_DSPN=ARRAY(1)
XX=X1_N+XXP +1+YL_N
ARR_DSPN[1] :=XX -1-LEN(ARR3[1])
X=2

while X <=    TIT_N
  AADD(ARR_DSPN,XX -LEN(ARR3[X])-1)
  X=X+1
ENDDO
X=1
D_C=ALLTRIM(C_TOP2) +" "
while X <=    TIT_N
  D_C=D_C +ARR_TITLE[X]
  X=X+1
  IF X <= TIT_N
    D_C=D_C +" "
  ENDIF
ENDDO
DC_L=LEN(D_C)
Set( 20, "SCREEN" )
X_C2="¡ô¡õ¤W¤U­¶ Esc¸õÂ÷"
IF  (_MODI="Y") .OR. (_MODI="K")
  X_C1="¡ô¡õ¤W¤Uµ§ F3-­×§ï  Esc¸õÂ÷ "
ELSE
  X_C1=""
ENDIF
IF (FIST_REC<>0).AND. (FIST_REC=LAST_REC)
  X_C1=" F3-­×§ï  Esc¸õÂ÷ "
  X_C2=""
ENDIF
X=LEN(X_C1)
IF X>DC_L
  XX=INT((X-DC_L)/2)
ELSE
  XX=0
ENDIF
SetColor( "GR+ / BL" )
Scroll( Y1_N-1, X1_N-2-XX, Y1_N+TIT_N+2, X1_N + (YL_N*DSP_MH)+1 ) ; SetPos( Y1_N-1, X1_N-2-XX )
BOX_S(Y1_N-1,X1_N-2-XX-LEN(ARR_TITLE[1]),Y1_N+TIT_N+1,X1_N + (YL_N*DSP_MH)+1 )
SetColor( "GR+ / R" )

IF  DC_L>LEN(X_C1)+LEN(X_C2)+1
  X=LEN(X_C1)+LEN(X_C2)
  DevPos( Y1_N+TIT_N+1, (X1_N +INT((DC_L*0.5) -(X *.5)))-1 ) ; DevOut( X_C2+" "+X_C1 )
ELSE
  DevPos( Y1_N+TIT_N, (X1_N +INT((DC_L*0.5) -(X *.5)))-1 ) ; DevOut( X_C1 )
  DevPos( Y1_N+TIT_N+1, (X1_N +INT((DC_L*0.5) -(X *.5)))-1 ) ; DevOut( X_C2 )
ENDIF
IF EMPTY(C_TOP1)= .F.
  DevPos( Y1_N+TIT_N+1, X1_N ) ; DevOut( C_TOP1 )
ENDIF
X=1
while X <=    TIT_N
  DevPos( Y1_N-1+X, X1_N-1-LEN(ARR_TITLE[X]) ) ; DevOut( ARR_TITLE[X] )
  X=X+1
ENDDO
dbSelectArea( N_SELE )
N_YN=Y1_N
N_REC=1
dbGoTop()
SetColor( "W+ / BL" )
S_REC=RECNO()
DO _DSP_VALL
N_REC=RECNO()


_LOOP_BR=1
while _LOOP_BR =1
  T=0
  while T=0
    T=INKEY()
    IF DLA_DSP=1
      DO DSP2
    ENDIF
    DO LUSTP
    IF _PRINT=1
      T=3
      IF  EOF()
    T=27
      ENDIF
    ENDIF
  ENDDO
  dbSelectArea( N_SELE )
  DO CASE
  CASE T=-6
    IF    EMPTY(F7_FUNC) =.F.
      DO &F7_FUNC
    ENDIF
  CASE T=-7
    IF    EMPTY(F8_FUNC) =.F.
      DO &F8_FUNC
    ENDIF
  CASE T=-2   .AND. (_MODI="Y"  .OR.    _MODI="K"  )

    _GET_STP=1
    while ( _GET_STP >=0 )  .AND. ( _GET_STP <=TIT_N )
       R_C=ARR_REC_NAME[_GET_STP]
       T_C=ARR_TYPE[_GET_STP]
       _D_TYPE=TYPE("&R_C")
       C_L=LEN(ARR_TYPE[_GET_STP])
       SetColor( "&12 /&11" )
       DevPos( N_YN, ARR_DSPN[_GET_STP] ) ; DevOutPict( &R_C, "&T_C" )
       GET_STPC=ALLTRIM(STR(_GET_STP,2,0))
       p_func=P_FUNC&GET_STPC
       X_GETSTP=_GET_STP
       SetColor( "gr + /w" )
       _REC_DSP(N_YN)
      _GET_STP=READ_A(N_YN,ARR_DSPN[_GET_STP],&R_C,"&_D_TYPE",C_L,ARR4[_GET_STP],_GET_STP,"&P_FUNC")
      IF T_C="!" .AND. (VALTYPE(_ACT_PX)="C")
    _ACT_PX=UPPER(_ACT_PX)
      ELSE
    IF _ACT_PX >INT(VAL(ARR3[X_GETSTP]))
      _ACT_PX =INT(VAL(ARR3[X_GETSTP]))
    ENDIF
      ENDIF
      T_C=ARR_TYPE[X_GETSTP]
      DevPos( N_YN, ARR_DSPN[X_GETSTP] ) ; DevOutPict( _ACT_PX, "&T_C" )
      dbSelectArea( N_SELE )
      _FIELD->&R_C := _ACT_PX
      IF  EMPTY(ARR_PCS[X_GETSTP]) =.F.
    PCS_CF(N_YN,&R_C,X_GETSTP,RECNO())
      ENDIF
    ENDDO
    SetColor( "gr + /w" )
    _REC_DSP(N_YN)
    T=0
    _DATA_MODIFY=1
  CASE T=5   .OR. T=18
    dbGoto(S_REC)
    dbSkip( (-DSP_MH) )
    S_REC=RECNO()
    IF BOF()
      dbGoTop()
    ENDIF
    dbGoto(S_REC)
    DO _DSP_VALL
  CASE T=24 .OR. T=3
    dbSkip(1)
    S_REC=RECNO()
    DO _DSP_VALL
    IF    _MODI="Y"
      dbSkip(1)
      IF  EOF()
    dbSkip( -1 )
    FOR  X =1 TO TIT_N
      R_C=ARR_REC_NAME[X]
      IF EMPTY(&R_C)=.F.
        dbAppend()
        EXIT
      ENDIF
    NEXT
    dbSkip(1)
      ENDIF
      dbSkip( -1 )
    ENDIF
  CASE T=7 .AND. _modi="Y"
    dbDelete()
    __dbPack()
    IF    EOF()
      dbSkip( -1 )
      IF  EOF()
    dbAppend()
      ENDIF
    ENDIF
    N_REC=RECNO()
    N_YN=Y1_N
    SetColor( "W+ / BL" )
    DO _DSP_ALL
    SetColor( "GR+ / W+" )
    dbGoto(N_REC)
    _REC_DSP(N_YN)
    _DATA_MODIFY =1
  CASE T=23 .OR. T=27
    _LOOP_BR=0
  ENDCASE
ENDDO
T=0
SetColor( "&XCOR" )
