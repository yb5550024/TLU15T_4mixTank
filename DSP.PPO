      ARR1[I+1] = A_M_NAME[I,17]
      IF (LEN(ARR1[I+1]) < LEN(A_M_NAME[I,3]) )
    ARR1[I+1]=SPACE(LEN(A_M_NAME[I,3])-LEN(ARR1[I+1]))+ARR1[I+1]
      ENDIF
      ARR2[I+1]=ARR2[I] + LEN(ARR1[I+1]) +1
      IF  I=GS_TOT  +1
    ARR2[15+1]=ARR2[I+1]
    ARR1[I+1] :=" Á`­« " + ARR1[I+1]
    ARR2[I+1]=ARR2[I+1] +6
      ENDIF
      XTIT=XTIT +" " + ARR1[I+1]
    ENDIF
  NEXT

  DevPos( PROW()+1, 1 ) ; DevOut( XTIT )
  DevPos( PROW()+1, 1 ) ; DevOut( "----------------------------------------------------------------------------------------------" )
  xd_wno=fSelectNo()
  dbSelectArea( "2" )
  REC_OLD=RECNO()
  if F7_ACT=1
    dbGoTop()
  endif
  while ! EOF()
    XN_TOTW=0
    XCNR="1"
    DevPos( PROW()+1, 1 ) ; DevOut( RATNO )
    DevPos( PROW(), ARR2[2] ) ; DevOutPict( M&XCNR, "9999" )
    XN_TOTW=XN_TOTW + M&XCNR
    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    DevPos( PROW(), ARR2[3] ) ; DevOutPict( M&XCNR, "9999" )
    XN_TOTW=XN_TOTW + M&XCNR
    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    DevPos( PROW(), ARR2[4] ) ; DevOutPict( M&XCNR, "9999" )
    XN_TOTW=XN_TOTW + M&XCNR
    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    DevPos( PROW(), ARR2[5] ) ; DevOutPict( M&XCNR, "9999" )
    XN_TOTW=XN_TOTW + M&XCNR
    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    DevPos( PROW(), ARR2[6] ) ; DevOutPict( M&XCNR, "9999" )
    XN_TOTW=XN_TOTW + M&XCNR
    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    DevPos( PROW(), ARR2[7] ) ; DevOutPict( M&XCNR, "9999" )
    XN_TOTW=XN_TOTW + M&XCNR
    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    XMC_F=A_M_NAME[7,3]
    DevPos( PROW(), ARR2[8] ) ; DevOutPict( M&XCNR, "&XMC_F" )
    XN_TOTW=XN_TOTW + M&XCNR
    XMC_F=A_M_NAME[8,3]
    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    DevPos( PROW(), ARR2[9] ) ; DevOutPict( M&XCNR, "&XMC_F" )
    XN_TOTW=XN_TOTW + M&XCNR
    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    XMC_F=A_M_NAME[9,3]
    DevPos( PROW(), ARR2[10] ) ; DevOutPict( M&XCNR, "&XMC_F" )
    XN_TOTW=XN_TOTW + M&XCNR
    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    IF EMPTY(ARR2[11]) =.F.
      XMC_F=A_M_NAME[10,3]
      DevPos( PROW(), ARR2[11] ) ; DevOutPict( M&XCNR, "&XMC_F" )
    XN_TOTW=XN_TOTW + M&XCNR
    endif
    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    IF EMPTY(ARR2[12]) =.F.
      XMC_F=A_M_NAME[11,3]
      DevPos( PROW(), ARR2[12] ) ; DevOutPict( M&XCNR, "&XMC_F" )
      XN_TOTW=XN_TOTW + M&XCNR
    ENDIF
    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    IF EMPTY(ARR2[13]) =.F.
      XMC_F=A_M_NAME[12,3]
      DevPos( PROW(), ARR2[13] ) ; DevOutPict( M&XCNR, "&XMC_F" )
      XN_TOTW=XN_TOTW + M&XCNR
    ENDIF

    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    XMC_F=A_M_NAME[13,3]
    DevPos( PROW(), ARR2[14] ) ; DevOutPict( M&XCNR, "&XMC_F" )
    XN_TOTW=XN_TOTW + M&XCNR

    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    XMC_F=A_M_NAME[14,3]
    DevPos( PROW(), ARR2[15] ) ; DevOutPict( M&XCNR, "&XMC_F" )
    XN_TOTW=XN_TOTW + M&XCNR

    XCNR=ALLTRIM(STR(VAL(XCNR)+1,2,0))
    XMC_F=A_M_NAME[15,3]
    DevPos( PROW(), ARR2[16] ) ; DevOutPict( M&XCNR, "&XMC_F" )
    XN_TOTW=XN_TOTW + M&XCNR
    DevPos( PROW(), ARR2[15+1] ) ; DevOutPict( XN_TOTW, "99999" )
    DevPos( PROW()+1, 1 ) ; DevOut( "----------------------------------------------------------------------------------------------" )
    if F7_ACT=1
      dbSkip(1)
    else
      exit
    endif
  ENDDO

  DevPos( PROW()+1, 1 ) ; DevOut( " " )
  DevPos( PROW()+1, 1 ) ; DevOut( " " )
  Set( 20, "SCREEN" )
  dbGoto(REC_OLD)
  Set( 17, "ON" )
  F7_ACT=0
  dbSelectArea( xd_wno )
ENDIF
RETU

PROCEDURE  _CHANGE_DATA
PARAMETERS  P1,P2,P3
SetColor( "W+ / N" )
MODY_D1=1
ARR1 :=ARRAY(15+3) 
ARR2 :=ARRAY(15+3) 
ARR3 :=ARRAY(15+3) 
ARR3_O :=ARRAY(15+3) 
ARR4 :=ARRAY(15+3) 
ARR5 :=ARRAY(15+3) 
ARR6 :=ARRAY(15+3) 
ARR1 :={16,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2}
ARR2[1] :=12
ARR4[1] :=4
ARR5[1] :=1
FOR  I=1 TO GS_TOT +UWC_TOT
  ARR2[I+1]=A_M_NAME[I,13]
  ARR4[I+1]=LEN(ALLTRIM(A_M_NAME[I,3]))
  X=LEN(ALLTRIM(STR(INT(VAL(A_M_NAME[I,3])),6,0)))
  ARR5[I+1]=ARR4[I+1] -X
  IF ARR5[I+1] >=2
    ARR5[I+1]=ARR5[I+1] -1
  ENDIF
NEXT
x=_Tot_d_a[20,4]+2
DevPos( 15, 12 ) ; DevOut( _Tot_d_a[18,X] )
DevPos( 16, 12 ) ; DevOutPict( _Tot_d_a[10,X], "99.9" )
ARR3[1] :=_Tot_d_a[10,X]
ARR3_O[1] :=ARR3[1]
FOR  I=1 TO GS_TOT +UWC_TOT
  IF A_PRESS_N0[2,STPN1,I,5]=0
    RETU
  ENDIF
  ARR3[I+1] :=A_PRESS_N0[2,STPN1,I,1]  / A_PRESS_N0[2,STPN1,I,5]
  ARR3_O[I+1] :=ARR3[I+1]
  ARR6[I]=0
  IF A_PRESS_N0[2,STPN1,I,1] = A_PRESS_N0[2,STPN1,I,8]
    ARR6[I]=1
  ENDIF
NEXT
TNSTP=1
TNSTP_O=1
MODY_D1=0
while TNSTP <=GS_TOT +UWC_TOT + 1
  TNSTP_O=TNSTP
  TNSTP=READ_A(ARR1[TNSTP],ARR2[TNSTP],ARR3[TNSTP],"N",ARR4[TNSTP],ARR5[TNSTP],TNSTP," ")
  if  ARR3[TNSTP_O] <>    VAL(CHRN)
    MODY_D1=1
  endif
  ARR3[TNSTP_O]=VAL(CHRN)
ENDDO
DISC_TOTM=ARR3[1]
if disc_totm >0
  SetColor( "w  / &C1" )
  x=_Tot_d_a[20,4]+2
  if (disc_totm <_Tot_d_a[10,X] )  .OR. mody_d1=1
    FOR XL1=1 TO GS_TOT
      IC_L1=ALLTRIM(STR(XL1,2,0))
      IF disc_totm < A_PRESS_N0[L_PRESS,STPN&IC_L1,XL1,6]
    disc_totm = A_PRESS_N0[L_PRESS,STPN&IC_L1,XL1,6]
      endif
    NEXT
    IF disc_totm >= A_PRESS_N0[L_PRESS,STPN1,1,6]
      XAP1=STPN1
      XAP0=XAP1
      SETVN0=A_PRESS_N0[L_PRESS,XAP1,1,6]
      SETVN1=A_PRESS_N0[L_PRESS,XAP1,1,6]
      IF (disc_totm = A_PRESS_N0[L_PRESS,XAP1,1,6])
      XAP1=XAP1+1
      ELSE
    while (disc_totm > A_PRESS_N0[L_PRESS,XAP1,1,6])  .AND. (A_PRESS_N0[L_PRESS,XAP1,1,6] > 0)
      SETVN0=A_PRESS_N0[L_PRESS,XAP1,1,6]
      XAP1=XAP1+1
      XAP0=XAP1
    ENDDO
    XAP1=XAP0
      ENDIF
      SETVN1=A_PRESS_N0[L_PRESS,XAP1,1,6]
      for xap2=1  to GS_TOT +UWC_TOT
    A_PRESS_N0[L_PRESS,XAP1,XAP2,6] :=DISC_TOTM
    XAP3=(DISC_TOTM-SETVN0)/A_PRESS_N0[L_PRESS,XAP1,XAP2,5]
    A_PRESS_N0[L_PRESS,XAP1,XAP2,1] :=A_PRESS_N0[L_PRESS,XAP1,XAP2,1] * XAP3
    A_PRESS_N0[L_PRESS,XAP1,XAP2,3] :=A_PRESS_N0[L_PRESS,XAP1,XAP2,3] * XAP3
    A_PRESS_N0[L_PRESS,XAP1,XAP2,5] :=DISC_TOTM-SETVN0
    A_PRESS_N0[L_PRESS,XAP1+1,XAP2,1] :=0
    A_PRESS_N0[L_PRESS,XAP1+1,XAP2,2] :=0
    A_PRESS_N0[L_PRESS,XAP1+1,XAP2,3] :=0
    A_PRESS_N0[L_PRESS,XAP1+1,XAP2,4] :=0
    A_PRESS_N0[L_PRESS,XAP1+1,XAP2,5] :=0
    A_PRESS_N0[L_PRESS,XAP1+1,XAP2,6] :=0
    A_PRESS_N0[L_PRESS,XAP1+1,XAP2,7] :=0
    IF ARR6[xap2]=1
      A_PRESS_N0[L_PRESS,XAP1,XAP2,8] := A_PRESS_N0[L_PRESS,XAP1,XAP2,1]
    ENDIF
      NEXT
      XAP1=STPN1
      while A_PRESS_N0[2,XAP1,1,6]>0
    for I=1  to GS_TOT +UWC_TOT
      IF ARR3[I+1] <> ARR3_O[I+1]







        IC_X=ALLTRIM(STR(I,2,0))
        IF (STPN&IC_X <XAP1) .OR. ((STP_a[I] =3) .AND. (stpn&IC_X=XAP1)  )    
          IF  ((STP_a[I] =3) .AND. (stpn&IC_X=XAP1)  )  
        XADJW=A_PRESS_N0[2,XAP1,I,1]    
        A_PRESS_N0[2,XAP1,I,1]=A_PRESS_N0[2,XAP1,I,5] * ARR3[I+1]
        XADJW=A_PRESS_N0[2,XAP1,I,1] -XADJW  
        AdjSetWeiAd(I,XADJW)    
        IF ARR6[I]=1
          A_PRESS_N0[2,XAP1,I,8]=A_PRESS_N0[2,XAP1,I,1]
        ENDIF
        xw1=A_PRESS_N0[2,XAP1,I,8]
        IF DSPADJAW=1
          A_RAND_W[I]=Get_Rand_w(I,xw1)
        endif
          ENDIF
          A_PRESS_N0[2,XAP1,I,1]=A_PRESS_N0[2,XAP1,I,5] * ARR3[I+1]
          IF ARR6[I]=1
        A_PRESS_N0[2,XAP1,I,8]=A_PRESS_N0[2,XAP1,I,1]
          ENDIF
        ENDIF
      ENDIF
    NEXT
    XAP1=XAP1+1
      ENDDO
      x=_Tot_d_a[20,4]+2
      _Tot_d_a[10,X]=disc_totm
    ENDIF
  endif
  x=_Tot_d_a[20,4]+2
  DevPos( 16, 12 ) ; DevOutPict( _Tot_d_a[10,X], "99.9" )
endif
SetColor( "W    / N" )
x=_Tot_d_a[20,4]+2
DevPos( 16, 12 ) ; DevOutPict( _Tot_d_a[10,X], "99.9" )
SetColor( "W+ / N" )
FOR  I=1 TO GS_TOT +UWC_TOT
  XMC_F=A_M_NAME[I,3]
  IC_X=ALLTRIM(STR(I,2,0))
  DevPos( 2, A_M_NAME[I,13] ) ; DevOutPict( A_PRESS_N0[2,STPN&IC_X,I,8], "&XMC_F" )
NEXT
SetColor( "W+ / N" )
dbCommitAll()
RETU

