FUNCTION _AUTO_FLOR
PARAMETERS _AFR_INIT,_SET_WEI,_ACT_WEI,NO_FLOR,F_ROPPEN
IF _AFR_INIT=1
  PUBLIC  _ATFLOR1
  IF  EMPTY(_ATFLOR1)=.T.
    PUBLIC   _ATFLOR1,_ATFLOR2,_ATFLOR3,_ATFLOR4,_ATFLOR5,_ATFLOR6,_ATFLOR7,_ATFLOR9,_ATFLOR8
    dbSelectArea( "5" )
    dbGoto(28)
    IF EOF()
      dbAppend()
      _FIELD->PARNO := RECNO()
      while RECNO() <>28
    dbAppend()
    _FIELD->PARNO := RECNO()
      ENDDO
      dbGoto(27)
      _FIELD->PA1 := 30; _FIELD->PA2 := 30; _FIELD->PA3 := 30; _FIELD->PA4 := 30; _FIELD->PA5 := 30
      _FIELD->PA6 := 15; _FIELD->PA7 := 15; _FIELD->PA8 := 0.2
      dbGoto(28)
      _FIELD->PA1 := 15
    ENDIF
    dbGoto(27)
    _ATFLOR1 =PA1
    _ATFLOR2 =PA2
    _ATFLOR3 =PA3
    _ATFLOR4 =PA4
    _ATFLOR5 =PA5
    _ATFLOR6 =PA6
    _ATFLOR7 =PA7
    _ATFLOR8 =PA8
    dbGoto(28)
    _ATFLOR9 =PA1
  ENDIF
  PUBLIC   _ATF1,_ATF2,_ATF3,_ATF4,_ATF5,_ATF6,_ATF7,_ATF9,_ATF8
  PUBLIC   _ATFA1,_ATFA2,_ATFA3,_ATFA4,_ATFA5,_ATFA6,_ATFA7,_ATFA9,_ATFA8
  _ATF1 := _ATF2 := _ATF3 := _ATF4 := _ATF5 := _ATF6 := _ATF7 := _ATF9 := _ATF8 := 0
  _ATFA1 := _ATFA2 := _ATFA3 := _ATFA4 := _ATFA5 := _ATFA6 := _ATFA7 := _ATFA9 := _ATFA8 := 0
ELSEIF    _AUTO_FLOR=1
  IF F_ROPPEN=0   
    IF    _SET_WEI <> _ACT_WEI
      _XERR=_ACT_WEI -    _SET_WEI
      IF  ABS(_XERR) > _ATFLOR&NO_FLOR
    _XERR=(_XERR/ ABS(_XERR)) * ABS(_ATFLOR&NO_FLOR)
      ENDIF
      PFLOR&NO_FLOR=PFLOR&NO_FLOR +_XERR
      IF PFLOR&NO_FLOR <0
    PFLOR&NO_FLOR=0
      ENDIF
      DO _FLORSAVE
    ENDIF
  ELSE
    PFLOR&NO_FLOR=PFLOR&NO_FLOR-ABS(ERKG&NO_FLOR)  *.5
    IF PFLOR&NO_FLOR  <0
      PFLOR&NO_FLOR=ABS(ERKG&NO_FLOR)
    ENDIF
    DO _FLORSAVE
  ENDIF
ENDIF
_ATF&NO_FLOR := _ATFA&NO_FLOR := 0
retu

PROCEDURE  _FLORSAVE
PARAMETERS  P1,P2,P3
dbSelectArea( "5" )
IF   NO_FLOR="9"
  dbGoto(18)
  _FIELD->PA1 := PFLOR&NO_FLOR
ELSE
  dbGoTop()
  _FIELD->PA&NO_FLOR := PFLOR&NO_FLOR
ENDIF
XCOR=SETCOLOR()
SetColor( "&C7 +/ &C1" )
DevPos( 22, 8 ) ; DevOutPict( PFLOR1, "999" )
DevPos( 22, 16 ) ; DevOutPict( PFLOR2, "999" )
DevPos( 22, 24 ) ; DevOutPict( PFLOR3, "999" )
DevPos( 22, 32 ) ; DevOutPict( PFLOR4, "999" )
DevPos( 22, 42 ) ; DevOutPict( PFLOR5, "999" )
DevPos( 22, 48 ) ; DevOutPict( PFLOR6, "999" )
DevPos( 22, 58 ) ; DevOutPict( PFLOR7, "999" )
DevPos( 22, 66 ) ; DevOutPict( PFLOR9, "999" )
DevPos( 22, 73 ) ; DevOutPict( PFLOR8, "99.99" )
SetColor( "&XCOR" )
RETU

FUNCTION _FLOR_F
PARAMETERS _NOF
_NOFC=ALLTRIM(STR(_NOF,2,0))
IF  _ATF&_NOFC=0
  IF RD_DO1(_NOF)=0
    _ATF&_NOFC=1
    _ATFA&_NOFC=0
  ENDIF
ELSE
  IF RD_DO1(_NOF)=1
    _ATF&_NOFC=1
    _ATFA&_NOFC=1
  ENDIF
ENDIF
RETU

PROCEDURE  _AUTO_MAXIN
PARAMETERS  P1,P2,P3
SetColor( "W+ / N" )
Scroll( 21, 0, 23, 77 ) ; SetPos( 21, 0 )
SetColor( "W+ / &CF" )
DevPos( 23, 0 ) ; DevOut( "¡ü<<  ¤@¦¸¦Û°Ê­×¥¿¸¨®t³Ì¤j­«  >>                                             ¡ü" )
SetColor( "gr +/ &CF" )
DevPos( 23, 2 ) ; DevOut( "<<" )
DevPos( 23, 30 ) ; DevOut( ">>" )
SetColor( "W+ / N" )
FGET=1
SCRNO=22
XP1 =7
XP2 =15
XP3 =23
XP4 =31
XP5 =42
XP6 =50
XP7 =58
XP8 =66
XP9 =74
XPA1=_ATFLOR1
XPA2=_ATFLOR2
XPA3=_ATFLOR3
XPA4=_ATFLOR4
XPA5=_ATFLOR5
XPA6=_ATFLOR6
XPA7=_ATFLOR7
XPA8=_ATFLOR9
XPA9=_ATFLOR8
SetColor( "W+ / N" )
DevPos( 22, XP1 ) ; DevOutPict( _atflor1, "999" )
DevPos( 22, XP2 ) ; DevOutPict( _atflor2, "999" )
DevPos( 22, XP3 ) ; DevOutPict( _atflor3, "999" )
DevPos( 22, XP4 ) ; DevOutPict( _atflor4, "999" )
DevPos( 22, XP5 ) ; DevOutPict( _atflor5, "999" )
DevPos( 22, XP6 ) ; DevOutPict( _atflor6, "999" )
DevPos( 22, XP7 ) ; DevOutPict( _atflor7, "999" )
DevPos( 22, XP8 ) ; DevOutPict( _atflor9, "999" )
DevPos( 22, XP9 ) ; DevOutPict( _atflor8, "9.9" )
while FGET <=9
  FGETC=ALLTRIM(STR(FGET,1,0))
  IF  FGET=9
    CHRN=STR(XPA&FGETC,3,1)
  ELSE
    CHRN=STR(XPA&FGETC,3)
  ENDIF

  TNSTP=READ_A(SCRNO,XP&FGETC,CHRN,"C",3,0,TNSTP," ")
  T_A=_LASTKEY
  XPA&FGETC=VAL(CHRN)
  DO CASE
  CASE    FGETC="8"
    _ATFLOR9=VAL(CHRN)
  CASE    FGETC="9"
    _ATFLOR8=VAL(CHRN)
  OTHERWISE
    _ATFLOR&FGETC=VAL(CHRN)
  ENDCASE
  SetColor( "W+ /N" )
  x_TY="999"
  IF FGETC="9"
    x_TY="9.9"
  ENDIF
  DevPos( SCRNO, xp&FGETC ) ; DevOutPict( XPA&FGETC, "&x_ty" )
  DO CASE
  CASE    T_A=13
    FGET=FGET+1
  CASE    T_A=5
      FGET=FGET-1
      IF  FGET <=0
    FGET=100
      ENDIF
  CASE T_A=24
      FGET=FGET+1
  CASE T_A=23
    T2=0
    FGET=100
  ENDCASE
ENDDO
SetColor( "W+ / N" )
Scroll( 21, 0, 23, 77 ) ; SetPos( 21, 0 )
dbSelectArea( "5" )
dbGoto(27)
_FIELD->PA1 := XPA1; _FIELD->PA2 := XPA2; _FIELD->PA3 := XPA3; _FIELD->PA4 := XPA4; _FIELD->PA5 := XPA5
_FIELD->PA6 := XPA6; _FIELD->PA7 := XPA7; _FIELD->PA8 := XPA9
dbGoto(28)
_FIELD->PA1 := XPA8
dbCommitAll()
RETU


FUNCTION SER_OK
SER_X2=VAL(SUBSTR(DTOC(DATE()),4,2))
SER_XW=DOW(DATE())-1
IF  SER_XW =0
  SER_XW=7
ENDIF
SER_XW=SER_XW + SER_X2
SER_X1=VAL(SUBSTR(DTOC(DATE()),1,2)) +SER_XW
SER_X2=VAL(SUBSTR(DTOC(DATE()),4,2)) +SER_XW
SER_X3=VAL(SUBSTR(DTOC(DATE()),7,2)) +SER_XW
SER_Xok1="TV7213"
SER_Xok2="YB0246"
SER_Xok3=ALLTRIM(STR(SER_X1 * SER_X2 * SER_X3,6,0))
XS=1
XN=7
SER_OK=1
SER_STP=1
  T_SER=""

while (SER_STP <=7)    .AND. (T <>13)
  T=0
  while T =0
    T=INKEY()
  ENDDO
  IF  T <>13
    T_SER=T_SER +UPPER(CHR(T))
  ENDIF
  SER_STP=SER_STP +1
ENDDO
SER_OK=0
IF (T_SER =SER_XOK1) .OR. (T_SER =SER_XOK2) .OR. (T_SER =SER_XOK3)
  SER_OK=1
ELSE
  SER_OK=0
ENDIF
RETU SER_OK


