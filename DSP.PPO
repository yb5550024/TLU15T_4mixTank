FUNCTION  DSP_ARROW
PARAMETERS  XC1,YC1,X_SCA1,Y_SCA1,XP1,X_P_TYPE,XC_COLOR

  XX1=XC1-(X_SCA1/2)
  YY1=YC1-(Y_SCA1/2)
  XX2=XC1+(X_SCA1/2)
  YY2=YC1 -(Y_SCA1/2)
  QOut( CHR(27),"SD14,0;" )
  LINE(XX1,YY1,XX2,YY2,XC_COLOR)
  XX1= XX2
  YY1=YY2
  XX2=XC1
  YY2=YC1
  LINE(XX1,YY1,XX2,YY2,XC_COLOR)
  XX1= XX2
  YY1=YY2
  XX1=XC1-(X_SCA1/2)
  YY1=YC1-(Y_SCA1/2)
  LINE(XX1,YY1,XX2,YY2,XC_COLOR)
  XX1=XC1-(X_SCA1/4)
  YY1=YC1-Y_SCA1
  XX2=XC1+(X_SCA1/4)
  YY2=YC1-(Y_SCA1/2)
  FBOX(XX1,YY1,XX2,YY2,XC_COLOR,"&HFFFF")
  XX1=XC1-(X_SCA1/2)
  YY1=YC1-Y_SCA1
  XX2=XC1+(X_SCA1/2)
  YY2=YC1-1
  IF  X_P_TYPE=1
    FIL_COLOR2(XC1,YC1-5,"C&H00 FF FF FF/S",)
  ELSE
    YY2=YC1+1
    FBOX(XX1,YY1,XX2,YY2,XC_COLOR,"&HFFFF")
  ENDIF











RETU

