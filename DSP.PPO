FUNCTION READ2
PARAMETERS  PX,X1,Y1,TNSTP,LONG
XPX=pX
X1=X1
SetColor( "0/7 *" )
IF TNSTP<>9
  SetColor( "0 * /7" )
  DevPos( Y1, X1 ) ; DevOutPict( XPX, "9999" )
  CHRN=STR(INT(XPX),4)
ELSE
  SetColor( "0 * /7" )
  DevPos( Y1, X1 ) ; DevOutPict( XPX, "99.99" )
  CHRN=STR(XPX,5,2)
ENDIF
XP=0
t=0
SetColor( "W+  / R" )
DevPos( y1, (X1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
SetColor( "7/0" )

XX1=X1+XP
YY1=Y1
T1=0
TN1=0
while T1<>233
  T=0
  while T=0
    T=INKEY( )
    DO DSP2
    DO LUSTP
  ENDDO
  DO CASE
  case    T=19
    IF XP>=1
      XP=XP-1

      SetColor( "0/7 *" )
      DevPos( Y1, X1 ) ; DevOut( CHRN )
      SetColor( "W+  / R" )
      DevPos( Y1, (X1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
      SetColor( "&C7 +/ &C1" )

      XX1=X1+XP
      YY1=Y1
    ENDIF
  CASE    T=4
    IF XP<=LONG-2
      XP=XP+1

      SetColor( "0/7 *" )
      DevPos( Y1, X1 ) ; DevOut( CHRN )
      SetColor( "&C1 */ &C7 +" )
      DevPos( Y1, X1 ) ; DevOut( CHRN )
      SetColor( "W+  / R" )
      DevPos( Y1, (X1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
      SetColor( "&C7 +/ &C1" )

      XX1=X1+XP
      YY1=Y1
    ENDIF
  CASE     T=43 .OR.T=45 .OR.T=46 .OR.T=32 .OR. T=48 .OR.T=49 .OR.T=50 .OR.T=51 .OR.T=52 .OR.T=53 .OR.T=54 .OR.T=55 .OR.T=56 .OR.T=57
    XP=XP+1
    IF TN1=0 .AND. XP=1
      TN1=1
      IF  TNSTP<>9
    CHRN="    "
      ELSE
    CHRN="     "
      ENDIF
    ENDIF
    IF XP<LONG
      CHRN=SUBSTR(CHRN,1,XP-1)+CHR(T)+SUBSTR(CHRN,XP+1,LONG-XP)
      SetColor( "0/7    *" )
      IF  VAL(CHRN)>=1000
    CHRN="    "
      ENDIF
      DevPos( Y1, X1 ) ; DevOut( CHRN )
      SetColor( "7/0" )

      SetColor( "0/7 *" )
      DevPos( Y1, X1 ) ; DevOut( CHRN )
      SetColor( "W+  / R" )
      DevPos( Y1, (X1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
      SetColor( "&C7 +/ &C1" )

      XX1=X1+XP
      YY1=Y1
    ELSE
      CHRN=SUBSTR(CHRN,1,XP-1)+CHR(T)
      SetColor( "0/7" )
      IF  TNSTP<>9
    IF  VAL(CHRN)>=1000
      CHRN="    "
    ENDIF
      ELSE
    IF  VAL(CHRN)>=100
      CHRN="     "
    ENDIF
      ENDIF
      DevPos( Y1, X1 ) ; DevOut( CHRN )
      SetColor( "7/0" )
      XP=XP-1
      SetColor( "0/7 *" )
      DevPos( Y1, X1 ) ; DevOut( CHRN )
      SetColor( "W+  / R" )
      DevPos( Y1, (X1+XP) ) ; DevOut( SUBSTR(CHRN,XP+1,1) )
      SetColor( "&C7 +/ &C1" )

      XX1=X1+XP
      YY1=Y1
    ENDIF
  CASE T=13   .OR. T=23 .OR. T=5 .OR. T=24.OR. t=2
    T1=233
    IF TNSTP<>9
      XPX =INT(VAL(CHRN))
      PX=XPX
      DevPos( Y1, X1 ) ; DevOutPict( PX, "9999" )
    ELSE
      XPX =INT(VAL(CHRN)*100)/100
      IF XPX > 100
    XPX=1
      ENDIF
      PX=XPX
      DevPos( Y1, X1 ) ; DevOutPict( PX, "99.99" )
    ENDIF
    dbSelectArea( "5" )
    CHNO=LTRIM(STR(TNSTP))
    IF TNSTP=8
      dbGoto(18)
      _FIELD->PA1 := PX
    ELSE
     IF TNSTP=9
       CHNO="8"
     ENDIF
     _FIELD->PA&CHNO := PX
    ENDIF
    DO CASE
    CASE T=5
      IF TNSTP>1
    TNSTP=TNSTP-1
      ENDIF
    CASE T=24  .OR. T=13
      TNSTP=TNSTP+1
    ENDCASE
    IF T=23 .OR. t=2
      TNSTP=9
    ENDIF
  CASE T=27
    SetColor( "0/7" )
    XPX=PX
    IF TNSTP<>9
      DevPos( Y1, X1 ) ; DevOutPict( XPX, "9999" )
      CHRN=STR(INT(XPX),4)
    ELSE
      DevPos( Y1, X1 ) ; DevOutPict( XPX, "99.99" )
      CHRN=STR(XPX,5,2)
    ENDIF
    SetColor( "7/0" )
    XP=0
    t=0


    XX1=X1+XP
    YY1=Y1
  ENDCASE
ENDDO
RETU   TNSTP


FUNCTION SER_OK_old
SER_X2=VAL(SUBSTR(DTOC(DATE()),4,2))
SER_XW=DOW(DATE())-1
IF  SER_XW =0
  SER_XW=7
ENDIF
SER_XW=SER_XW + SER_X2
SER_X1=VAL(SUBSTR(DTOC(DATE()),1,2)) +SER_XW
SER_X2=VAL(SUBSTR(DTOC(DATE()),4,2)) +SER_XW
SER_X3=VAL(SUBSTR(DTOC(DATE()),7,2)) +SER_XW
SER_Xok1="TV7213"
SER_Xok2="YB0246"
SER_Xok3=ALLTRIM(STR(SER_X1 * SER_X2 * SER_X3,6,0))
XS=1
XN=7
SER_OK=1
SER_STP=1
  T_SER=""

while (SER_STP <=7)    .AND. (T <>13)
  T=0
  while T =0
    T=INKEY()
  ENDDO
  IF  T <>13
    T_SER=T_SER +UPPER(CHR(T))
  ENDIF
  SER_STP=SER_STP +1
ENDDO
SER_OK=0
IF (T_SER =SER_XOK1) .OR. (T_SER =SER_XOK2) .OR. (T_SER =SER_XOK3)
  SER_OK=1
ELSE
  SER_OK=0
ENDIF
RETU SER_OK

FUNCTION SER_OK_BOSS
SER_X2=VAL(SUBSTR(DTOC(DATE()),4,2))
SER_XW=DOW(DATE())-1
IF  SER_XW =0
  SER_XW=7
ENDIF
SER_XW=SER_XW + SER_X2
SER_X1=VAL(SUBSTR(DTOC(DATE()),1,2)) +SER_XW
SER_X2=VAL(SUBSTR(DTOC(DATE()),4,2)) +SER_XW
SER_X3=VAL(SUBSTR(DTOC(DATE()),7,2)) +SER_XW
SER_Xok1="83479"
SER_Xok3=ALLTRIM(STR(SER_X1 * SER_X2 * SER_X3,6,0))
XS=1
XN=7
SER_OK=1
SER_STP=1
  T_SER=""

while (SER_STP <=7)    .AND. (T <>13)    .AND. (T <>18)    .AND. (T <>3)  .AND. (T <>5)   .AND. (T <>24)    .AND. (T <>4)  .AND. (T <>19)
  T=0
  while T =0
    T=INKEY()
  ENDDO
  IF  T <>13
    T_SER=T_SER +UPPER(CHR(T))
  ENDIF
  SER_STP=SER_STP +1
ENDDO
SER_OK=0
IF (T_SER =SER_XOK1) .OR. (T_SER =SER_XOK3)
  SER_OK=1
ELSE
  SER_OK=0
ENDIF
RETU SER_OK

