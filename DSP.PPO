FUNCTION  PNT1_OK
PARAMETERS   X_OK
XCOR=SETCOLOR()

X_OK=1
x= RDLPT(0)
if (x <>144)   .AND.   (x <> pnt_redy_code)
  Set( 20, "SCREEN" )
  SetColor( "&C7 / &C5" )
  XPNT_ER=SAVESCREEN(10,0,14,79)
  SetColor( "GR+ / R" )
  Scroll( 10, 30, 14, 54 ) ; SetPos( 10, 30 )
  BOX_S(10,30,14,54)
  SetColor( "W+ / R" )
  DevPos( 11, 32 ) ; DevOut( " NO. 1  ¦Cªí¾÷¤£¥¿½T" )
  DevPos( 12, 32 ) ; DevOut( " «ö¸Ë«á«ö¥ô¤@ÁäÄ~Äò" )
  DevPos( 13, 32 ) ; DevOut( " «ö Esc Áä°±¤î¦C¦L " )
  SetColor( "GR+ / R" )
  DevPos( 13, 36 ) ; DevOut( "Esc" )
  SetCursor( if(Upper("off") == "ON", 1, 0) )
  while (RDLPT(0) <> 144)   .AND. (RDLPT(0) <>pnt_redy_code)
    XT=0
    while XT=0
      xt=INKEY()
    ENDDO
    if XT=27
      EXIT
      x_OK=0
    endif
  ENDDO
  SetCursor( if(Upper("oN") == "ON", 1, 0) )
  Set( 20, "PRINTER" )
  x= RDLPT(0)
  if (x <>144)     .AND.     (x <> pnt_redy_code)
