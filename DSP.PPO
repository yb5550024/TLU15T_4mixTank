  QOut( chr(27) + "sp&APORT;" )
      Set( 17, "ON" )
  Set( 20, "PRINTER" )
  DevPos( PROW()+5, 5 ) ; DevOut( " ¤é  ´Á   «È¤á¥N¸¹  «È¤á¦WºÙ            ¹w¦¬ª÷ÃB ¤W´Áµ²¤í  ¦¬¾Ú³æ¸¹" )
  DevPos( PROW()+1, 5 ) ; DevOut( "-------------------------------------------------------------------" )
