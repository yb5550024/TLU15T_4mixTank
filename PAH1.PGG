
SELE 3
set cons on
SET DELE OFF
RECALL	 ALL
DO WHILE .NOT. EOF()
IF SCANO=0 .OR. VUSE=0
 DELE
ENDIF
SKIP
ENDDO
PACK
GOTO TOP
DELE
LUDBF="3"
XX1=6
SCRCC=1
YY1=23
SCRNO=23
Y1=SCRNO
STAR_X=2
STAR_Y=21
END_X=77
END_Y=22
      SET COLOR TO &C6 / &C1
 @ 24,0 SAY "∥ <<出車>>           Esc-取消訂單   Ctl-End 結束 ↑上一筆  ↑↑插單  ↓下一筆∥"
      SET COLOR TO  gr +/ &C1
	@ 24,5	SAY "出車"
	@ 24,22 SAY "Esc"
	@ 24,37 SAY "Ctl-End"
	@ 24,50 SAY "↑"
	@ 24,60 SAY "↑↑"
	@ 24,70 SAY "↓"
  SET COLOR TO &C7 +/ &C1
@ SCRNO,16  SAY ASCANO	  PICT "9999"
@ SCRNO,28  SAY ACARNO	  PICT "XXXXXXX"
@ SCRNO,48  SAY ARATNO	  PICT "9999"
@ SCRNO,64  SAY AVUSE	  PICT "99.9"
@ SCRNO,74  SAY ATANDO	  PICT "9999"
T2=1
T=5
DO WHILE  T2<>0
*IF T=5 .OR.  T=24  .OR. T=27
IF T=5 .OR.  T=24
IF BOF()
XSCANO=LAG_REPNO
XCARNO="       "
XRATNO=0
XVUSE=0
XTANDO=0
ELSE
XSCANO= SCANO
XCARNO= CARNO
XRATNO= RATNO
XVUSE= VUSE
XTANDO=TANDO
ENDIF
ELSE
XSCANO=ASCANO
XCARNO=ACARNO
XRATNO=ARATNO
XVUSE=AVUSE
XTANDO=TANDO
ENDIF
  SET COLOR TO &C1 / &C7 +
@ SCRNO,16  SAY xSCANO	  PICT "9999"
@ SCRNO,28  SAY XCARNO	  PICT "XXXXXXX"
@ SCRNO,48  SAY XRATNO	  PICT "9999"
@ SCRNO,64  SAY XVUSE	  PICT "99.9"
@ SCRNO,74  SAY XTANDO	  PICT "9999"
  SET COLOR TO &C7 +/ &C1
     CHRN=STR(XSCANO,4)
     X1=16
     XP=0
     FGETNO=1
       Y1=SCRNO
       YY1=Y1
       GETNO=1
   DO WHILE   GETNO<=5
       t=0
       *CURSER2(X1,Y1,XP)
       set colo to &c1	/&c7 +
       @ y1,x1 say  chrn
       set colo to gr + * /bl
       @ y1,x1 say  substr(chrn,XP+1,1)
	 set colo to &c7 + /&c1
       XX1=X1+XP
       YY1=Y1
       T1=0
       TN1=0
       DO WHILE T1<>233
       T=0
       LURECNO=RECNO()
       DO WHILE T=0
       T=INKEY( )
       DO DSP2
       DO LUSTP
       ENDDO
       SELE &LUDBF
       GOTO LURECNO
       DO CASE
	  case	T=19
		IF XP>=1
		XP=XP-1
		*CURSER0(XX1,YY1)
		*CURSER2(X1,Y1,XP)
		set colo to &c1  /&c7 +
		@ y1,x1 say  chrn
		set colo to gr + * /bl
		@ y1,x1+xp say	substr(chrn,xp+1,1)
		set colo to &c7 + /&c1
		XX1=X1+XP
		YY1=Y1
		ENDIF
	  CASE	T=4
		IF GETNO=2
		LANPA=5
		ELSE
		LANPA=2
		ENDIF
		IF XP<=LANPA
		XP=XP+1
		*CURSER0(XX1,YY1)
		*CURSER2(X1,Y1,XP)
		set colo to &c1  /&c7 +
		@ y1,x1 say  chrn
		set colo to gr + * /bl
		@ y1,x1+xp say	substr(chrn,xp+1,1)
		set colo to &c7 + /&c1
		XX1=X1+XP
		YY1=Y1
		ENDIF
	  CASE	 (t>=45  .and. T<=90 .AND. GETNO=2)  .OR. (T=32 .AND. GETNO=2)	.OR. (T>=97  .AND. T<=122 .AND. GETNO=2)
		XP=XP+1
		IF TN1=0 .AND. XP=1
		TN1=1
		CHRN="       "
		ENDIF
		IF XP<7
		CHRN=SUBSTR(CHRN,1,XP-1)+CHR(T)+SUBSTR(CHRN,XP+1,7-XP)
  SET COLOR TO &C1 / &C7 +
		@ SCRNO,X1  SAY CHRN
  SET COLOR TO &C7 +/ &C1
		*CURSER0(XX1,YY1)
		*CURSER2(X1,Y1,XP)
		set colo to &c1  /&c7 +
		@ y1,x1 say  chrn
		set colo to gr + * /bl
		@ y1,x1+xp say	substr(chrn,xp+1,1)
		set colo to &c7 + /&c1
		XX1=X1+XP
		YY1=Y1
		ELSE
		CHRN=SUBSTR(CHRN,1,XP-1)+CHR(T)
		SET COLOR TO 0/7
  SET COLOR TO &C1 / &C7 +
		@ SCRNO,X1  SAY CHRN
  SET COLOR TO &C7 +/ &C1
		XP=XP-1
		*CURSER2(X1,Y1,XP)
		XP=6
		XX1=X1+XP
		set colo to &c1  /&c7 +
		@ y1,x1 say  chrn
		set colo to gr + * /bl
		@ y1,x1+xp say	substr(chrn,xp+1,1)
		set colo to &c7 + /&c1
		YY1=Y1
		ENDIF
	  CASE	 T=46 .OR.T=32 .OR. T=48 .OR.T=49 .OR.T=50 .OR.T=51 .OR.T=52 .OR.T=53 .OR.T=54 .OR.T=55 .OR.T=56 .OR.T=57
	     XP=XP+1
	     IF TN1=0 .AND. XP=1
	     TN1=1
	     CHRN="    "
	     ENDIF
	     IF XP<4
	     CHRN=SUBSTR(CHRN,1,XP-1)+CHR(T)+SUBSTR(CHRN,XP+1,4-XP)
  SET COLOR TO &C1 / &C7 +
	     @ SCRNO,X1  SAY CHRN
  SET COLOR TO &C7 +/ &C1
	     *CURSER0(XX1,YY1)
	     *CURSER2(X1,Y1,XP)
	     set colo to &c1  /&c7 +
	     @ y1,x1 say  chrn
	     set colo to gr + * /bl
	     @ y1,x1+xp say  substr(chrn,xp+1,1)
	     set colo to &c7 + /&c1
	     XX1=X1+XP
	     YY1=Y1
	     ELSE
	     CHRN=SUBSTR(CHRN,1,XP-1)+CHR(T)
  SET COLOR TO &C1 / &C7 +
	     @ SCRNO,X1  SAY CHRN
  SET COLOR TO &C7 +/ &C1
	     XP=XP-1
	     *CURSER2(X1,Y1,XP)
	     set colo to &c1  /&c7 +
	     @ y1,x1 say  chrn
	     set colo to gr + * /bl
	     @ y1,x1+xp say  substr(chrn,xp+1,1)
	     set colo to &c7 + /&c1
	     XP=3
	     XX1=X1+XP
	     YY1=Y1
	     ENDIF
	  CASE T=13
	     FGETNO=GETNO+1
	       T1=233
	  CASE T=5
		IF GETNO>1
		FGETNO=GETNO-1
		T1=233
		ELSE
		FGETNO=6
		T1=233
		ENDIF
	  CASE T=27
	     t=0
	     SCRMA=savescreen(15,0,22,39)
	     @ 15,11 clea to  22,39
	     @ 15,13  say "   << 按任一鍵繼續 >>"
	     @ 16,13  say "1. " +  LAGcno1
	     @ 17,13  say "2. " +  LAGcno2
	     @ 18,13  say "3. " +  LAGcno3
	     @ 19,13  say "4. " +  LAGcno4
	     @ 20,13  say "5. " +  LAGcno5
	     DO WHILE T=0
	     T=INKEY( )
	     DO DSP2
	     DO LUSTP
	     ENDDO
	     t=0
	     restscreen(15,0,22,39,scrma)
	 *    T1=233
	 *    GETNO=6
	  CASE T=23
	     T1=233
	     T2=0
	    FGETNO=6
	  CASE T=24
	    T1=233
	    FGETNO=6
       ENDCASE
       ENDDO
  SET COLOR TO &C1 / &C7 +
       DO CASE
       CASE GETNO=1
	    XSCANO=INT(VAL(CHRN))
       @ SCRNO,16  SAY XSCANO	 PICT "9999"
       CASE GETNO=2
	   XCARNO=UPPER(CHRN)
       @ SCRNO,28  SAY XCARNO	   PICT "XXXXXXX"
       CASE GETNO=3
	   XRATNO=INT(VAL(CHRN))
       @ SCRNO,48  SAY XRATNO	 PICT "9999"
       CASE GETNO=4
	    SET DECIM TO 1
	   XVUSE=VAL(CHRN)
	     IF XVUSE>=14
	     XVUSE=0
	       FGETNO=4
	     ENDIF
       @ SCRNO,64  SAY XVUSE	 PICT "99.9"
       CASE GETNO=5
	   XTANDO=INT(VAL(CHRN))
       @ SCRNO,74  SAY XTANDO	 PICT "9999"
       ENDCASE

  SET COLOR TO &C7 +/ &C1
       DO CASE
	  CASE FGETNO=1
	       CHRN=STR(XSCANO,4)
	       X1=16
	       XP=0
	       FGETNO=0
	       GETNO=1
	  CASE FGETNO=2
	       GETNO=2
	       CHRN=XCARNO
	       X1=28
	       XP=0
	       FGETNO=0
	  CASE FGETNO=3
	       GETNO=3
	       CHRN=STR(XRATNO,4)
	       X1=48
	       XP=0
	       FGETNO=0
	  CASE FGETNO=4
	       GETNO=4
	       CHRN=STR(XVUSE,4,1)
	       X1=64
	       XP=0
	       FGETNO=0
	  CASE FGETNO=5
	       GETNO=5
	       CHRN=STR(XTANDO,4)
	       X1=74
	       XP=0
	       FGETNO=0
	  CASE FGETNO=6
	       ASCANO =  XSCANO
	       ACARNO =  XCARNO
	       ARATNO =  XRATNO
	       AVUSE =	 XVUSE
	       ATANDO=XTANDO
	       FGETNO=0
	       GETNO=6
	     @ SCRNO,16  SAY ASCANO    PICT "9999"
	     @ SCRNO,28  SAY ACARNO   PICT "XXXXXXX"
	     @ SCRNO,48  SAY ARATNO    PICT "9999"
	     @ SCRNO,64  SAY AVUSE     PICT "99.9"
	     @ SCRNO,74  SAY ATANDO    PICT "9999"
	     IF T=13
	     T=23
	     T2=0
	     ENDIF

       ENDCASE

       ENDDO
       DO CASE
       CASE  T=13
	  XP=0
       CASE  T=24
	 XP=0
	 RECA
	 SKIP
	 IF EOF()
	 GOTO BOTT
	 ENDIF
	 DELE
       CASE T=5
	 RECA
	   SKIP (-1)
	   XP=0
	   IF  .NOT. BOF()
	   GOTO TOP
	   DELE
	   ELSE
	   ENDIF
     *	CASE T=27
     *	  SET DELE OFF
     *	    PACK
     *	    XP=0
     *	    GOTO TOP
     *	    IF .NOT. BOF()
     *	    DELE
     *	    ENDIF
     *	    T=5
       ENDCASE
       @ SCRNO,16  SAY ASCANO	 PICT "9999"
       @ SCRNO,28  SAY ACARNO	 PICT "XXXXXXX"
       @ SCRNO,48  SAY ARATNO	 PICT "9999"
       @ SCRNO,64  SAY AVUSE	 PICT "99.9"
       @ SCRNO,74  SAY ATANDO	 PICT "9999"
       @ SCRNO,74  SAY ATANDO	 PICT "9999"
     ENDDO
     T=0







