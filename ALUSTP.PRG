	NEXT
      ENDIF
      SELE 8
    ELSE
      LVUSE=VUSE -MLMV_1
      MLA_LAG=MLA_LAG+LVUSE
      XM_PLUS=0
      SELE 2
      FOR XNP=1  TO 12
	XNPC=LTRIM(STR(INT(XNP),2,0))
