*LUSTP.PRG

IF STAR=1  .AND. DOSIGN=0
   IF NEXTOK=1	.OR. NEXTOK2=1 .OR. PRCEND=1
      DO CASE
      CASE  LCHTYPE=1  .AND. NEXTOK1=1
	 IF STP1=0 .AND. VAL(TPCOA)-PANDIC <>0
	 IF SWA&TPCOA<>0
	 STP1=1
	 ELSEIF SWA&TPCOA=0 .AND. WAZOK=0
	 STP1=1
	 ENDIF
	 ENDIF
	 IF STP2=0 .AND. VAL(TPCOB)-PANDIC <>0
	    IF SWB&TPCOB<>0
	    STP2=1
	    ELSEIF SWB&TPCOB=0 .AND. WBZOK=0
	    STP2=1
	    ENDIF
	 ENDIF
	 IF STP3=0 .AND. VAL(TPCOC)-PANDIC <>0
	     IF SWC&TPCOC<>0
	     STP3=1
	     ELSEIF SWC&TPCOC=0 .AND. WCZOK=0
	     STP3=1
	     ENDIF
	 ENDIF
	 IF STP4=0 .AND. VAL(TPCOD)-PANDIC <>0
	     IF SWD&TPCOD<>0
	     STP4=1
	     ELSEIF SWD&TPCOD=0 .AND. WDZOK=0
	     STP4=1
	     ENDIF
	 ENDIF

      CASE  LCHTYPE=2  .AND. NEXTOK1=1
	 IF STP2=0 .AND. STP1=0 .AND. VAL(TPCOB)-PANDIC <>0
	 STP1=1
	 ENDIF
	 IF STP3=0 .AND. VAL(TPCOC)-PANDIC <>0
	    IF SWC&TPCOC<>0
	    STP3=1
	    ELSEIF SWC&TPCOC=0 .AND. WCZOK=0
	    STP3=1
	    ENDIF
	 ENDIF
	 IF STP4=0 .AND. VAL(TPCOD)-PANDIC <>0
	   IF SWD&TPCOD<>0
	   STP4=1
	   ELSEIF SWD&TPCOD=0 .AND. WDZOK=0
	   STP4=1
	   ENDIF
	 ENDIF
      CASE  LCHTYPE=3  .AND. NEXTOK1=1
	 IF STP1=0 .AND. VAL(TPCOA)-PANDIC <>0
	   IF SWA&TPCOA<>0
	   STP1=1
	   ELSEIF SWA&TPCOA=0 .AND. WAZOK=0
	   STP1=1
	   ENDIF
	 ENDIF
	 IF STP2=0 .AND. VAL(TPCOB)-PANDIC <>0
	   IF SWB&TPCOB<>0
	   STP2=1
	   ELSEIF SWB&TPCOB=0 .AND. WBZOK=0
	   STP2=1
	   ENDIF
	 ENDIF
	 IF STP4=0 .AND. STP3=0 .AND. VAL(TPCOD)-PANDIC <>0
	 STP3=1
	 ENDIF
      CASE  LCHTYPE=4  .AND. NEXTOK1=1

	    IF STP2=0 .AND. STP1=0 .AND. VAL(TPCOB)-PANDIC <>0
	      IF     (ABS(SWA&TPCOB)	   > INT((WDATA(0)-2048)*MOVKG0/PER/2048)) .AND. SWA&TPCOB <>0
		 STP1=1
	      ELSE
		IF SWA&TPCOB <>0
		   SET COLOR TO &C2 / &C1
			 @ 12,7  SAY   "úZúYúYúYúYúYú["
		   SET COLOR TO &C7 +/ &C1
		   PUBL EWA&TPCOA
		   EWA&TPCOA=ABS(SWA&TPCOA)
		    @ 9,8  SAY	  EWA&TPCOA   PICT "9999"
		   SETCHDATA(0,(EWA&TPCOA)*2048/Movkg0)
		   SETDLA(0,EWA&TPCOA*2048/Movkg0)
		ELSE
		   PUBL EWA&TPCOB
		   EWA&TPCOB=0
		   WAZOK=1
		ENDIF
		 STP1=0
		 IF WAFOK=1
		 WAFOK1=1
		 ELSE
		 WAFOK=1
		 ENDIF
		 TPCOA=LTRIM(STR(INT(VAL(TPCOA)-1)))
		 PUBL EWA&TPCOA
		 EWA&TPCOA=0
		 STP2=2
		   IF SWB&TPCOB<>0
		     IF     ABS(SWB&TPCOB)	 +EWA&TPCOB> INT((WDATA(0)-2048)*MOVKG0/PER/2048)
			STP2=2
		     ELSE
			SET COLOR TO &C2 / &C1
			 @ 12,7  SAY   "úZúYúYúYúYúYú["
			SET COLOR TO &C7 +/ &C1
			STP2=4
			IF WBFOK=1
			WBFOK1=1
			ELSE
			WBFOK=1
			ENDIF
			PUBL EWB&TPCOB
			EWB&TPCOB=INT((WDATA(0)-2048)*MOVKG0/PER/2048)-EWA&TPCOB
		    @ 9,16 SAY	  EWB&TPCOB   PICT "9999"
			SETCHDATA(1,(EWB&TPCOB)*2048/MOVKG0)
		     ENDIF
		   ENDIF
	      ENDIF
	    ENDIF
	 IF STP3=0 .AND. STP4=0 .AND. VAL(TPCOD)-PANDIC <>0
	       IF SWD&TPCOC=0
		 if  val(tpcoc)-PANDIC	= 1
		 xx=discl
		 else
		 xx=1
		 endif
		 XPWA=PWATER * xx
		 ELSE
		 XPWA=0
	       ENDIF
	       IF (ABS(SWC&TPCOC)      -XPWA > INT((WDATA(1)-2048)*MOVKG1/PER/2048))  .AND. SWC&TPCOD <>0
		 STP3=1
	       ELSE
		 IF SWC&TPCOD <>0
		    SET COLOR TO &C2 / &C1
		 @ 12,23 SAY   "úZúYúYúYúYúYú["
		    SET COLOR TO &C7 +/ &C1
		 ELSE
		   WCZOK=1
		   STP3=0
		 ENDIF
		 IF WCFOK=1
		 WCFOK1=1
		 ELSE
		 WCFOK=1
		 ENDIF
		 PUBL EWC&TPCOD
		 EWC&TPCOD=ABS(SWC&TPCOC)      -XPWA
		    @ 9,24 SAY	  EWC&TPCOD   PICT "9999"
		 SETCHDATA(2,(EWC&TPCOD)*2048/MOVKG1)
		   SETDLA(1,EWC&TPCOD*2048/Movkg1)
		 TPCOC=LTRIM(STR(INT(VAL(TPCOC)-1)))
		 PUBL EWC&TPCOC
		 EWC&TPCOC=0
		 STP4=2

		  IF SWD&TPCOD<>0
		  if  val(tpcoc)-PANDIC  = 1
		  xx=discl
		  else
		  xx=1
		  endif
		  IF	 ABS(SWD&TPCOD)      -(PWATER * xx)+EWC&TPCOD > INT((WDATA(1)-2048)*MOVKG1/PER/2048)
		     STP4=2
		  ELSE
		     SET COLOR TO &C2 / &C1
		 @ 12,23 SAY   "úZúYúYúYúYúYú["
		     SET COLOR TO &C7 +/ &C1
		     STP4=4
		     IF WDFOK=1
		     WDFOK1=1
		     ELSE
		     WDFOK=1
		     ENDIF
		     PUBL EWD&TPCOD
		     EWD&TPCOD=INT((WDATA(1)-2048)*MOVKG1/PER/2048)-EWC&TPCOD
		    @ 9,32 SAY	  EWD&TPCOD   PICT "9999"
		     SETCHDATA(3,(EWD&TPCOD)*2048/MOVKG1)
		  ENDIF
		  ELSEIF SWD&TPCOD=0 .AND. WDZOK=0
		  STP4=2
		  ENDIF
	      ENDIF
	  ENDIF
      CASE  LCHTYPE=5  .AND. NEXTOK1=1
	 IF STP1=0 .AND. STP2=0 .AND. STP3=0 .AND. STP4=0 .AND. VAL(TPCOD) -PANDIC <>0
	   IF	  (ABS(SWA&TPCOB)	> INT((WDATA(0)-2048)*MOVKG0/PER/2048)) .OR. (SWB&TPCOD =0 .AND.  SWC&TPCOD =0	.AND.  SWD&TPCOD =0 )
	      STP1=1
	   ELSE
		SET COLOR TO &C2 / &C1
		      @ 12,7  SAY   "úZúYúYúYúYúYúYúYúYúYúYúYúYúYú["
		SET COLOR TO &C7 +/ &C1
		PUBL EWA&TPCOA
		EWA&TPCOA=ABS(SWA&TPCOA)
		 @ 9,8	SAY    EWA&TPCOA   PICT "9999"
		SETCHDATA(0,(EWA&TPCOA)*2048/Movkg0)
		SETDLA(0,EWA&TPCOA*2048/Movkg0)
	      STP1=0
	      IF WAFOK=1
	      WAFOK1=1
	      ELSE
	      WAFOK=1
	      ENDIF
	      TPCOA=LTRIM(STR(VAL(TPCOA)-1,5,0))
	      PUBL EWA&TPCOA
	      EWA&TPCOA=0
		  IF	 ABS(SWB&TPCOB)       +EWA&TPCOD> INT((WDATA(0)-2048)*MOVKG0/PER/2048)	.OR. ( SWC&TPCOD =0  .AND.  SWD&TPCOD =0  )
		     STP2=2
		  ELSE
		     SET COLOR TO &C2 / &C1
		      @ 12,7  SAY   "úZúYúYúYúYúYúYúYúYúYúYúYúYúYú["
		     SET COLOR TO &C7 +/ &C1
		       IF WBFOK=1
		       WBFOK1=1
		       ELSE
		       WBFOK=1
		       ENDIF
		     PUBL EWB&TPCOB
		     EWB&TPCOD=ABS(SWB&TPCOD)
		     @ 9,16 SAY    EWB&TPCOB   PICT "9999"
		     SETCHDATA(1,(EWB&TPCOB)*2048/MOVKG0)
		       SETDLA(0,(EWA&TPCOd+EWB&TPCOD)*2048/Movkg0)
		     STP2=0
		     IF WBFOK=1
		     WBFOK1=1
		     ELSE
		     WBFOK=1
		     ENDIF
		     TPCOB=LTRIM(STR(VAL(TPCOB)-1,5,0))
		     PUBL EWB&TPCOB
		     EWB&TPCOB=0

		  IF	 ABS(SWC&TPCOC) +EWA&TPCOD+EWB&TPCOD > INT((WDATA(0)-2048)*MOVKG0/PER/2048)  .OR.    SWD&TPCOD =0
		     STP3=2
		  ELSE
		     SET COLOR TO &C2 / &C1
		      @ 12,7  SAY   "úZúYúYúYúYúYúYúYúYúYúYúYúYúYú["
		     SET COLOR TO &C7 +/ &C1
		       IF WCFOK=1
		       WCFOK1=1
		       ELSE
		       WCFOK=1
		       ENDIF
		     PUBL EWC&TPCOD
		     EWC&TPCOD=ABS(SWC&TPCOD)
		     @ 9,24 SAY    EWC&TPCOD   PICT "9999"
		     SETCHDATA(2,(EWC&TPCOD)*2048/MOVKG0)
		       SETDLA(0,(EWA&TPCOD+EWB&TPCOD+EWC&TPCOD)*2048/Movkg0)
		     STP3=0
		     IF WCFOK=1
		     WCFOK1=1
		     ELSE
		     WCFOK=1
		     ENDIF
		     TPCOC=LTRIM(STR(INT(VAL(TPCOC)-1)))
		     PUBL EWC&TPCOC
		     EWC&TPCOC=0
		     STP4=2
		    ENDIF
		  ENDIF
	   ENDIF

	 ENDIF
      ENDCASE


      DO CASE
      CASE  UCHTYPE=1  .AND. NEXTOK2=1
	 IF STP5=0 .AND. VAL(TPCOE)-PANDIC <>0
	   IF SWE&TPCOE<>0
	   if  val(tpcoc)-PANDIC  = 1
	   xx=discu
	   else
	   xx=1
	   endif
	   IF	  ABS(SWE&TPCOE)      +(PWATER * xx) > INT((WDATA(KLCHN+0)-2048)*MOVKG4/PER/2048)
	      STP5=1
	   ELSE
	      SET COLOR TO &C2 / &C1
		    @ 12,49 SAY   "úZúYú["
	   SET COLOR TO &C7 +/ &C1
	      STP5=4
	      WEFOK=1
		    PUBL EWE&TPCOE
	      EWE&TPCOE=INT((WDATA(KLCHN)-2048)*MOVKG4/PER/2048)
	      SETCHDATA(4,(WDATA(KLCHN)-2048))
	   ENDIF

	   ELSEIF SWE&TPCOE=0 .AND. WEZOK=0
	   STP5=1
	   ENDIF
	 ENDIF
	 IF STP6=0 .AND. VAL(TPCOF)-PANDIC <>0
	    IF SWF&TPCOF<>0
	    IF	   ABS(SWF&TPCOF)	> INT((WDATA(KLCHN+1)-2048)*MOVKG5/PER/2048)
	       STP6=1
	    ELSE
	       SET COLOR TO &C2 / &C1
		     @ 12,57 SAY   "úZúYú["
	    SET COLOR TO &C7 +/ &C1
	       STP6=4
	       WFFOK=1
		     PUBL EWF&TPCOF
	       EWF&TPCOF=INT((WDATA(KLCHN+1)-2048)*MOVKG5/PER/2048)
	       SETCHDATA(5,(WDATA(KLCHN+1)-2048))
	    ENDIF

	    ELSEIF SWF&TPCOF=0 .AND. WFZOK=0
	    STP6=1
	    ENDIF
	 ENDIF

	    IF STP7=0 .AND. STP9=0 .AND. VAL(TPCOI)-PANDIC <>0	.AND. WIZOK=0
		 IF	(ABS(SWG&TPCOG)       > INT((WDATA(KLCHN+2)-2048)*MOVKG6/PER/2048))  .AND.  SWG&TPCOI<>0
		    STP7=1
		 ELSE
		    IF SWG&TPCOG <>0
		       SET COLOR TO &C2 / &C1
		       @ 12,65 SAY   "úZúYú["
		       SET COLOR TO &C7 +/ &C1
		       PUBL EWG&TPCOG
		       IF SWI&TPCOG=0
			  EWG&TPCOG=INT((WDATA(KLCHN+2)-2048)*MOVKG6/PER/2048)
		       ELSE
			  EWG&TPCOG=ABS(SWG&TPCOG)
		       ENDIF
		       @ 6,66 SAY EWG&TPCOG  PICT "9999"
		       SETDLA((KLCHN+2),CHENDATA(6))
		    ELSE
		       PUBL EWG&TPCOG
		       EWG&TPCOG=0
		    ENDIF
		    STP7=0
		    WGZOK=1
		    WGFOK=1
		    TPCOG=LTRIM(STR(INT(VAL(TPCOG)-1)))
		    PUBL EWG&TPCOG
		    EWG&TPCOG=0
		    IF SWI&TPCOI<>0
		      IF     ABS(SWI&TPCOI)	  +EWG&TPCOI> INT((WDATA(KLCHN+2)-2048)*MOVKG6/PER/2048)
		      STP9=2
		   ELSE
		      SET COLOR TO &C2 / &C1
		      @ 12,65 SAY   "úZúYú["
		      SET COLOR TO &C7 +/ &C1
		      STP9=4
		      WIFOK=1
		      PUBL EWI&TPCOI
		      EWI&TPCOI=INT((WDATA(KLCHN+2)-2048)*MOVKG6/PER/2048)-EWG&TPCOI
		      @ 9,66 SAY    EWI&TPCOI	PICT "9999"
		      SETCHDATA(6,(EWI&TPCOI)*2048/MOVKG6)
		  ENDIF
		ELSE
		 IF SWG&TPCOI=0
		     IF   WIzok=0
		      WIFOK=1
		      WIZOK=1
		      STP9=0
		      PUBL EWI&TPCOI
		      EWI&TPCOI=0
		      TPCOI=LTRIM(STR(INT(VAL(TPCOI)-1)))
		      PUBL EWI&TPCOI
		       EWI&TPCOI=0
		     ENDIF
		 ELSE
		    WIFOK=1
		    PUBL EWI&TPCOI
		    EWI&TPCOI=0
		 STP9=4
		 ENDIF
		 ENDIF
	     ENDIF
	   ENDIF


	 IF STP8=0 .AND. VAL(TPCOH)-PANDIC <>0
	    IF SWH&TPCOH<>0
	    IF	   ABS(SWH&TPCOH)	> INT((WDATA(KLCHN+3)-2048)*MOVKG7/PER/2048)
	       STP8=1
	    ELSE
	       SET COLOR TO &C2 / &C1
		     @ 12,73 SAY   "úZúYú["
	    SET COLOR TO &C7 +/ &C1
	       STP8=4
	       WHFOK=1
		     PUBL EWH&TPCOH
	       EWH&TPCOH=INT((((WDATA(KLCHN+3)-2048)*MOVKG7/PER/2048))*100)/100
	       SETCHDATA(7,(WDATA(KLCHN+3)-2048))
	    ENDIF

	    ELSEIF SWH&TPCOH=0 .AND. WHZOK=0
	    STP8=1
	    WHZOK=1
	    ENDIF
	 ENDIF

      CASE  UCHTYPE=2  .AND. NEXTOK2=1
	 IF STP5=0 .AND. VAL(TPCOE)-PANDIC <>0
	   IF SWE&TPCOE<>0
	   STP5=1
	   ELSEIF SWE&TPCOE=0 .AND. WEZOK=0
	   STP5=1
	   ENDIF
	 ENDIF
	 IF STP6=0 .AND. STP7=0 .AND. STP9=0 .AND. VAL(TPCOI)-PANDIC <>0
	 STP6=1
	 ENDIF
	 IF STP8=0 .AND. VAL(TPCOH)-PANDIC <>0
	    IF SWH&TPCOH<>0
	    STP8=1
	    ELSEIF SWH&TPCOH=0 .AND. WHZOK=0
	    STP8=1
	    ENDIF
	 ENDIF
      CASE  UCHTYPE=3  .AND. NEXTOK2=1
	 IF STP5=0 .AND. VAL(TPCOE)-PANDIC <>0
	    IF SWE&TPCOE<>0
	    STP5=1
	    ELSEIF SWE&TPCOE=0 .AND. WEZOK=0
	    STP5=1
	    ENDIF
	 ENDIF
	 IF STP6=0 .AND. STP7=0 .AND. STP8=0 .AND. STP9=0   .AND. VAL(TPCOH)-PANDIC <>0
	 STP6=1
	 ENDIF
      ENDCASE
  *ENDIF
  IF STP1=1   .OR. STP2=1.OR. STP3=1.OR. STP4=1
    DO CASE
       CASE LCHTYPE=1
	    IF STP1=1  .AND. DIN(0)=1  .AND. DRAF=0
	      DRAF=1
	      SET COLOR TO W*/N
	      SET COLOR TO &C2 */ &C1
	      @ 12,7 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	    ENDIF
	    IF STP2=1 .AND. DIN(1)=1  .AND. DRBF=0
	      DRBF=1
	      SET COLOR TO &C2 */ &C1
	      @ 12,15 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	    ENDIF
	    IF STP3=1 .AND. DIN(2)=1  .AND. DRCF=0
	      DRCF=1
	      SET COLOR TO &C2 */ &C1
	      @ 12,23 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	    ENDIF
	    IF STP4=1  .AND. DIN(3)=1 .AND. DRDF=0
	      DRDF=1
	      SET COLOR TO &C2 */ &C1
	      @ 12,31 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	    ENDIF
       CASE LCHTYPE=2
	    IF STP1=1  .AND. DIN(0)=1 .AND. DRAF=0
	      DRAF=1
	      SET COLOR TO &C2 */ &C1
	      @ 12,7  SAY   "úZúYúYúYúYúYú["
	      SET COLOR TO &C7 +/ &C1
	    ENDIF
	    IF STP3=1  .AND. DIN(1)=1  .AND. DRCF=0
	      DRCF=1
	      SET COLOR TO &C2 */ &C1
	      @ 12,23 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	    ENDIF
	    IF STP4=1 .AND. DIN(2)=1  .AND. DRDF=0
	      DRDF=1
	      SET COLOR TO &C2 */ &C1
	      @ 12,31 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	    ENDIF
       CASE LCHTYPE=3
	      IF STP1=1  .AND. DIN(0)=1 .AND. DRAF=0
		DRAF=1
	      SET COLOR TO &C2 */ &C1
		@ 12,7 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	      ENDIF
	      IF STP2=1  .AND. DIN(1)=1 .AND. DRBF=0
		DRBF=1
	      SET COLOR TO &C2 */ &C1
		@ 12,15 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	      ENDIF
	      IF STP3=1   .AND. DIN(2)=1 .AND. DRCF=0
		DRCF=1
	      SET COLOR TO &C2 */ &C1
	      @ 12,23 SAY   "úZúYúYúYúYúYú["
	      SET COLOR TO &C7 +/ &C1
	      ENDIF

       CASE LCHTYPE=4
	      IF STP1=1  .AND. DIN(0)=1  .AND. DRAF=0
		DRAF=1
	      SET COLOR TO &C2 */ &C1
	      @ 12,7  SAY   "úZúYúYúYúYúYú["
	      SET COLOR TO &C7 +/ &C1
	      ENDIF
	      IF STP3=1  .AND. DIN(1)=1  .AND. DRCF=0
		DRCF=1
	      SET COLOR TO &C2 */ &C1
	      @ 12,23 SAY   "úZúYúYúYúYúYú["
	      SET COLOR TO &C7 +/ &C1
	      ENDIF

       CASE LCHTYPE=5
	      IF STP1=1  .AND. DIN(0)=1  .AND. DRAF=0
		DRAF=1
	      SET COLOR TO &C2 */ &C1
	      @ 12,7  SAY   "úZúYúYúYúYúYúYúYúYúYúYúYúYúYú["
	      SET COLOR TO &C7 +/ &C1
	      ENDIF
    ENDCASE
  ENDIF

    IF STP5=1 .OR. STP6=1.OR. STP7=1.OR. STP8=1
      DO CASE
	 CASE UCHTYPE=1
	      IF STP5=1  .AND. DIN(KLCHN)=1    .AND. DREF=0
		DREF=1
	      SET COLOR TO &C2 */ &C1
		@ 12,49 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	      ENDIF
	      IF STP6=1 .AND. DIN(KLCHN+1)=1  .AND. DRFF=0
		DRFF=1
	      SET COLOR TO &C2 */ &C1
		@ 12,57 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	      ENDIF
	      IF STP7=1 .AND. DIN(KLCHN+2)=1  .AND. DRGF=0
		DRGF=1
	      SET COLOR TO &C2 */ &C1
		@ 12,65 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	      ENDIF
	      IF STP8=1  .AND. DIN(KLCHN+3)=1  .AND. DRHF=0
		DRHF=1
	      SET COLOR TO &C2 */ &C1
		@ 12,73 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	      ENDIF
	 CASE UCHTYPE=2
	      IF STP5=1  .AND. DIN(KLCHN)=1 .AND. DREF=0
		DREF=1
	      SET COLOR TO &C2 */ &C1
		@ 12,49 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	      ENDIF
	      IF STP6=1 .AND. DIN(KLCHN+1)=1  .AND. DRFF=0
		DRFF=1
	      SET COLOR TO &C2 */ &C1
		@ 12,57 SAY   "úZúYúYúYúYúYú["
	      SET COLOR TO &C7 +/ &C1
	      ENDIF
	      IF STP8=1  .AND. DIN(KLCHN+2)=1 .AND. DRHF=0
		DRHF=1
	      SET COLOR TO &C2 */ &C1
		@ 12,73 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	      ENDIF
	 CASE	UCHTYPE=3
       IF STP5=1  .AND. DIN(KLCHN)=1  .AND. DREF=0
	 DREF=1
	      SET COLOR TO &C2 */ &C1
	 @ 12,57 SAY   "úZúYúYúYúYúYúYúYúYúYú[ "
	      SET COLOR TO &C7 +/ &C1
       ENDIF

      ENDCASE
    ENDIF
   DO CASE
      CASE STP1=1   .and. din(14)=1  .AND. DIN(0)=0
	   STP1=2
      CASE STP1=2
	   DRAF=0
	   DO CASE
	   CASE NEXTOK1=1  .AND. (VAL(TPCOA)-PANDIC >0) .AND. SWA&TPCOA=0
	      DO CASE
		 CASE LCHTYPE=1  .OR. LCHTYPE=3
		      STP1=0
	   TOTANK0=0
		      PUBL EWA&TPCOA
		      EWA&TPCOA=0
		 CASE LCHTYPE=2 .OR.LCHTYPE=4 .OR.LCHTYPE=5
		      STP1=0
		      STP2=2
		      PUBL EWA&TPCOA
		      EWA&TPCOA=0
	      ENDCASE
	      WAZOK=1
	      IF WAFOK=1
	      WAFOK1=1
	      ELSE
	      WAFOK=1
	      ENDIF
	      TPCOA=LTRIM(STR(INT(VAL(TPCOA)-1)))
	      PUBL EWA&TPCOA
	      EWA&TPCOA=0
	   CASE NEXTOK1=1  .AND. VAL(TPCOA)-PANDIC  > 0  .AND. SWA&TPCOA <> 0
	      @  4,8  SAY  ABS(SWA&TPCOA) PICT "9999"

	      SET COLOR TO &C2 / &C1
	      @  7,7 SAY   "úLúKúO"
		 do case
		 CASE LCHTYPE=1
	      SET COLOR TO &C2 / &C1
		    @ 12,7 SAY	 "úZúYú["
		 CASE LCHTYPE=2
	      SET COLOR TO &C2 / &C1
		    @ 12,7  SAY   "úZúYúYúYúYúYú["
		 CASE LCHTYPE=3
	      SET COLOR TO &C2 / &C1
		    @ 12,7 SAY	 "úZúYú["
		 CASE LCHTYPE=4
	      SET COLOR TO &C2 / &C1
		    @ 12,7  SAY   "úZúYúYúYúYúYú["
		 CASE LCHTYPE=5
	      SET COLOR TO &C2 / &C1
		     @ 12,7  SAY   "úZúYúYúYúYúYúYúYúYúYúYúYúYúYú["
		 ENDCASE
	      SET COLOR TO &C7 +/ &C1
	      CLEACHMEM(0)
	      CLEACHW(0)
	      IF VAL(TPCOA)-PANDIC =1
	      PPFLOR1=PFLOR1+SDRA*PERFLR

	      ELSE
	      PPFLOR1=PFLOR1
	      ENDIF
	      IF SWA&TPCOA<0
		 SWA&TPCOA=ABS(SWA&TPCOA)
		IF NVUSE > 5
		  IF DISCH1=1
		  DISAA=0.5
		  ELSE
		  DISAA=1
		  ENDIF
		MOVKG0=MOVKG0*NVUSE/(NVUSE-DISAA)
		POVKG0=POVKG0*NVUSE/(NVUSE-DISAA)
		ENDIF
	      ELSE
		POVKG0=SPOVKG0
		MOVKG0=SMOVKG0
	      ENDIF
	      SETW1(0,(SWA&TPCOA*PER-PPFLOR1)*2048/POVKG0)
	      SETW2(0,(SWA&TPCOA*PER-ERKG1)*2048/POVKG0)
	      SETOK(0)
	      DOUT(0,1)
	      STP1=3
	   ENDCASE
      CASE STP1=3
	   IF STOPTM1=0
	     STOPTM1=SECONDS()
	     STOP1 =INT((CHENDATA(0))*POVKG0/PER/2048)
	   ELSEIF SECONDS()-STOPTM1 >=2
	     STOPTM1=SECONDS()
	     IF (INT((CHENDATA(0))*POVKG0/PER/2048)-STOP1) < STOPA
	     DOUT3(0,1)
	     ELSE
	       DOUT3(0,0)
	      stoptm1=0
	     ENDIF
	   ENDIF

	   IF RDOK2(0)=0 .or. WCNT1=0
	     STOPTM1=0
	     DOUT3(0,0)
		      PUBL EWA&TPCOA
		EWA&TPCOA=INT((CHENDATA(0))*POVKG0/PER/2048)
	      IF WAFOK=1
	      WAFOK1=1
	      ELSE
	      WAFOK=1
	      ENDIF
	      @  4,8  SAY 0  PICT "9999"
	      @  9,8  SAY EWA&TPCOA  PICT "9999"
	      SET COLOR TO &C2 / &C1
	      @  7,7 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	      DO CASE
		 CASE LCHTYPE=1 .OR.LCHTYPE=3
		      STP1=4
		 CASE LCHTYPE=2 .OR.LCHTYPE=4 .OR. LCHTYPE=5
		      STP1=0
		      STP2=2
		      SETDLA(0,EWA&TPCOA*2048/povkg0)
		      TPCOA=LTRIM(STR(INT(VAL(TPCOA)-1)))
		      PUBL EWA&TPCOA
		      EWA&TPCOA=0
	      ENDCASE
	    *	POVKG0=SPOVKG0
	   ENDIF
      CASE STP1=4  .AND. DIN(8)=1   .AND. DRTKF=0  .AND. TOTANK0=1
	   DRTKF=1
	      SET COLOR TO &C2 */ &C1
	@ 13,42 SAY "újúKúk"
	      SET COLOR TO &C7 +/ &C1
      CASE STP1=4  .AND. DIN(8)=0 .AND. DIN(11)=1
	      * POVKG0=SPOVKG0
	   IF  TOTANK0=1  .AND. (DRSTA<=DRNO) .AND. (TOTDR1>0)
	   TOTDR1=TOTDR1-1
	   DRTKF=1
	   TOTANK0=0
	   DOUT2(0,1)
	      SET COLOR TO &C2 / &C1
	   @ 12,7 SAY	"úLúKúO"
	   IF TANKSTP=0
	   @ 13,42 say	"ú^ú]ú_"
	   ENDIF
	   TOTANK=1
	      SET COLOR TO &C7 +/ &C1
	   SETZERTM(0,PZERTM1)
SETZER(0,INT(((PZER1/MOVKG0))*PER*2048)+2048)
	   SETZEROK(0)
	   STP1=5

	   ENDIF
      CASE STP1=5
	   IF  RDZEROK(0)=0
	 * MOVKG0=SMOVKG0
	    POVKG0=SPOVKG0
	   MOVKG1=SMOVKG0
	   DRNO=DRNO+1
	   TOTDR1=TOTDR1+1

	   CLEACHMEM(0)
	      SET COLOR TO &C2 / &C1
	   @ 12,7 SAY	"úLúPúO"
	      SET COLOR TO &C7 +/ &C1
	   WAZOK=1
	   TPCOA=LTRIM(STR(INT(VAL(TPCOA)-1)))
	   PUBL EWA&TPCOA
	   EWA&TPCOA=0
	   STP1=0
	   ENDIF
   ENDCASE

   DO CASE
      CASE STP2=1  .AND. DIN(1)=0
	   STP2=2
      CASE STP2=2 .and. din(14)=1
	   DRBF=0
	   DO CASE
	   CASE NEXTOK1=1  .AND. (VAL(TPCOB)-PANDIC >0) .AND. SWB&TPCOB=0
	      DO CASE
		 CASE LCHTYPE=1 .OR. LCHTYPE=3
		      TOTANK1=0
		      STP2=0
		      WBZOK=1
		      PUBL EWB&TPCOB
		      EWB&TPCOB=0
		      TPCOB =LTRIM(STR(INT(VAL(TPCOB)-1)))
		      PUBL EWB&TPCOB
		      EWB&TPCOB=0
		 CASE LCHTYPE=2 .OR. LCHTYPE=4
		      STP2=0
			IF  EWA&TPCOB<>0
			STP2=4
		      ELSE
		      WBZOK=1
		      ENDIF
		      PUBL EWB&TPCOB
		      EWB&TPCOB=0
		 CASE LCHTYPE=5
		      STP2=0
		      STP3=2
		      PUBL EWB&TPCOB
		      EWB&TPCOB=0
	      TPCOB=LTRIM(STR(INT(VAL(TPCOB)-1)))
	      PUBL EWB&TPCOB
	      EWB&TPCOB=0
	      ENDCASE
	      IF WBFOK=1
	      WBFOK1=1
	      ELSE
	      WBFOK=1
	      ENDIF
	   CASE NEXTOK1=1  .AND. (VAL(TPCOB)-PANDIC >0) .AND. SWB&TPCOB<>0
	      @  4,16 SAY  ABS(SWB&TPCOB)   PICT "9999"
	      SET COLOR TO &C2 / &C1
	      @  7,15 SAY   "úLúKúO"
	      do case
	      CASE LCHTYPE=1
	      SET COLOR TO &C2 / &C1
		 @ 12,15 SAY   "úZúYú["
	      CASE LCHTYPE=2
	      SET COLOR TO &C2 / &C1
		 @ 12,7  SAY   "úZúYúYúYúYúYú["
	      CASE LCHTYPE=3
	      SET COLOR TO &C2 / &C1
		 @ 12,15 SAY   "úZúYú["
	      CASE LCHTYPE=4
	      SET COLOR TO &C2 / &C1
		 @ 12,7  SAY   "úZúYúYúYúYúYú["
	      CASE LCHTYPE=5
	      SET COLOR TO &C2 / &C1
		  @ 12,7  SAY	"úZúYúYúYúYúYúYúYúYúYúYúYúYúYú["
	      ENDCASE
	      SET COLOR TO &C7 +/ &C1

	      CLEACHMEM(1)
	      IF LCHTYPE=1 .OR. LCHTYPE=3
	      CLEACHW(1)

	      ENDIF
	      IF VAL(TPCOB)-PANDIC =1
	      PPFLOR2=PFLOR2+SDRB*PERFLR
	      ELSE
	      PPFLOR2=PFLOR2
	      ENDIF
	      IF SWB&TPCOB<0
		 SWB&TPCOB=ABS(SWB&TPCOB)
		IF NVUSE > 5
		  IF DISCH1=1
		  DISAA=0.5
		  ELSE
		  DISAA=1
		  ENDIF
		POVKG1=POVKG1*NVUSE/(NVUSE-DISAA)
		ENDIF
	      DO CASE
	      CASE LCHTYPE=1 .OR. LCHTYPE=3
		MOVKG1=POVKG1
	      CASE LCHTYPE=2 .OR. LCHTYPE=4 .OR. LCHTYPE=5
		MOVKG0=POVKG1
	      ENDCASE
	      ELSE
		POVKG1=SPOVKG1
		DO CASE
		CASE LCHTYPE=1 .OR. LCHTYPE=3
		  MOVKG1=SMOVKG1
		CASE LCHTYPE=2 .OR. LCHTYPE=4 .OR. LCHTYPE=5
		  MOVKG0=SMOVKG0
		ENDCASE
	      ENDIF
	      SETW1(1,(SWB&TPCOB*PER-PPFLOR2)*2048/POVKG1)
	      SETW2(1,(SWB&TPCOB*PER-ERKG2)*2048/POVKG1)
	      SETOK(1)
	      DOUT(1,1)
	      STP2=3
	   ENDCASE
      CASE STP2=3
	   IF LCHTYPE=4
	   WDSP1=1
	   ENDIF
	     IF STOPTM2=0
	       STOPTM2=SECONDS()
	       STOP2 =INT((CHENDATA(1))*POVKG1/PER/2048)
	     ELSEIF SECONDS()-STOPTM2 >=2
	       STOPTM2=SECONDS()
	       IF (INT((CHENDATA(1))*POVKG1/PER/2048)-STOP2) < STOPB
	       DOUT3(1,1)
	       ELSE
	       DOUT3(1,0)
	       STOPTM2=0
	       ENDIF
	     ENDIF
	   IF RDOK2(1)=0
	     STOPTM2=0
	       DOUT3(1,0)
		      PUBL EWB&TPCOB
	      EWB&TPCOB=INT((CHENDATA(1) )*POVKG1/PER/2048)
	      @  9,16 SAY EWB&TPCOB  PICT "9999"
	      @  4,16 SAY 0  PICT "9999"
	      IF WBFOK=1
	      WBFOK1=1
	      ELSE
	      WBFOK=1
	      ENDIF
	      SET COLOR TO &C2 / &C1
	      @  7,15 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	   *  @  4,16 SAY  0 PICT "9999"
		 IF   LCHTYPE=5
		      STP2=0
		      STP3=2
		      SETDLA(0,(EWA&TPCOB+EWB&TPCOB)*2048/POVKG1)
		      TPCOB=LTRIM(STR(INT(VAL(TPCOB)-1)))
		      PUBL EWB&TPCOB
		      EWB&TPCOB=0
		 ELSE
		      STP2=4
		 ENDIF
	      * POVKG1=SPOVKG1
	   ENDIF
       CASE STP2=4  .AND. DIN(8)=1   .AND. DRTKF=0
	      * POVKG1=SPOVKG1
	    IF	(LCHTYPE=1 .OR. LCHTYPE=3) .AND. TOTANK1=1
	    DRTKF=1
	      SET COLOR TO &C2 */ &C1
	@ 13,42 SAY "újúKúk"
	      SET COLOR TO &C7 +/ &C1
	    ELSEIF   (LCHTYPE=2 .OR. LCHTYPE=4) .AND. TOTANK0=1
	     *	POVKG0=SPOVKG0
	    DRTKF=1
	      SET COLOR TO &C2 */ &C1
	@ 13,42 SAY "újúKúk"
	      SET COLOR TO &C7 +/ &C1
	    ENDIF

      CASE STP2=4   .AND. DIN(8)=0  .AND. DIN(11)=1
	   DO CASE
	    CASE  (LCHTYPE=1 .OR. LCHTYPE=3) .AND. TOTANK1=1 .AND. (DRSTB<=DRNO) .AND. (TOTDR1>0)
	    TOTDR1=TOTDR1-1
	      TOTANK1=0
	   STP2=5
	      DOUT2(1,1)
	      SET COLOR TO &C2 / &C1
	      @ 12,15 SAY   "úLúKúO"
	   IF TANKSTP=0
	   @ 13,42 say	"ú^ú]ú_"
	   ENDIF
	   TOTANK=1
	      SET COLOR TO &C7 +/ &C1
	      SETZERTM(1,PZERTM2)
SETZER(1,INT(((PZER2/MOVKG1))*PER*2048)+2048)
	      SETZEROK(1)
	    CASE  (LCHTYPE=2 .OR. LCHTYPE=4) .AND. TOTANK0=1 .AND. (DRSTA<=DRNO) .AND. (TOTDR1>0)
	    TOTDR1=TOTDR1-1
	      TOTANK0=0
	     DOUT2(0,1)
	   WDSP1=0
	      SET COLOR TO &C2 / &C1
	     @ 12,7  SAY   "úLúPúPúKúPúPúO"
	   IF TANKSTP=0
	   @ 13,42 say	"ú^ú]ú_"
	   ENDIF
	   TOTANK=1

	      SET COLOR TO &C7 +/ &C1
	     SETZERTM(0,PZERTM1)
SETZER(0,INT(((PZER1/MOVKG0))*PER*2048)+2048)
	     SETZEROK(0)
	   STP2=5
	   ENDCASE
      CASE STP2=5
	      IF  LCHTYPE=1 .OR. LCHTYPE=3
		 IF  RDZEROK(1)=0
	 * MOVKG1=SMOVKG1
	 POVKG1=SPOVKG1
	 MOVKG1=SMOVKG1
	    TOTDR1=TOTDR1+1
	    DRNO=DRNO+1
		 CLEACHMEM(1)
	      SET COLOR TO &C2 / &C1
		 @ 12,15 SAY   "úLúPúO"
	      SET COLOR TO &C7 +/ &C1
		 WBZOK=1
		 TPCOB=LTRIM(STR(INT(VAL(TPCOB)-1)))
		 PUBL EWB&TPCOB
		 EWB&TPCOB=0
		 STP2=0
		 ENDIF
	      ELSE
		 IF  RDZEROK(0)=0
	      @  9,8  SAY  0 PICT "9999"
	      @  9,16 SAY  0 PICT "9999"
	 * MOVKG0=SMOVKG0
	 POVKG0=SPOVKG0
	 POVKG1=SPOVKG1
	 MOVKG0=SMOVKG0
		 CLEACHMEM(0)
		 CLEACHMEM(1)
		 SETDLA(0,0)
	      SET COLOR TO &C2 / &C1
		 @ 12,7  SAY   "úLúPúPúPúPúPúO"
	      SET COLOR TO &C7 +/ &C1
		 TOTDR1=TOTDR1+1
		 DRNO=DRNO+1
		 WAZOK=1
		 WBZOK=1
		 TPCOB=LTRIM(STR(INT(VAL(TPCOB)-1)))
		 PUBL EWB&TPCOB
		 EWB&TPCOB=0
		 STP2=0
		 ENDIF
	      ENDIF
   ENDCASE

   DO CASE
      CASE STP3=1
	   IF  LCHTYPE=1 .OR. LCHTYPE=3
	      IF  DIN(2)=0

	      STP3=2
	      ENDIF
	   ELSE
	      IF  DIN(1)=0
	      STP3=2
	      ENDIF
	   ENDIF
      CASE STP3=2   .and. din(14)=1
	   DRCF=0
	   DO CASE
	   CASE NEXTOK1=1  .AND. (VAL(TPCOC)-PANDIC >0) .AND. SWC&TPCOC=0
	      DO CASE
		 CASE LCHTYPE=1 .OR. LCHTYPE=2
		      IF LCHTYPE=1
		      TOTANK2=0
		      ELSE
		      TOTANK1=0
		      ENDIF

		      STP3=0
		      WCZOK=1
		      PUBL EWC&TPCOC
		      EWC&TPCOC=0

		 CASE  LCHTYPE=3.OR. LCHTYPE=4
		      STP3=0
		      STP4=2
		      PUBL EWC&TPCOC
		      EWC&TPCOC=0
		 CASE LCHTYPE=5
		      STP3=0
		      STP4=2
		      PUBL EWC&TPCOC
		      EWC&TPCOC=0
		      SETDLA(0,(EWA&TPCOB+EWB&TPCOB)*2048/POVKG0)
	      ENDCASE
	      IF WCFOK=1
	      WCFOK1=1
	      ELSE
	      WCFOK=1
	      ENDIF

	      TPCOC=LTRIM(STR(INT(VAL(TPCOC)-1)))
	      PUBL EWC&TPCOC
	      EWC&TPCOC=0
	   CASE NEXTOK1=1  .AND. (VAL(TPCOC)-PANDIC >0) .AND. SWC&TPCOC<>0
	      IF SWD&TPCOC=0
	      if  val(tpcoc)-PANDIC  = 1
	      xx=discl
	      else
	      xx=1
	      endif

	      if xx_1 <> 4
	      @  4,24 SAY  (ABS(SWC&TPCOC)-PWATER * xx)   PICT "9999"
	      ENDIF
	      XPWA=PWATER * xx
	      ELSE
	      XPWA=0
	      if xx_1 <> 4
	      @  4,24 SAY  ABS(SWC&TPCOC)   PICT "9999"
	      ENDIF
	      ENDIF

	      SET COLOR TO &C2 / &C1
	      @  7,23 SAY   "úLúKúO"
	      do case
	      CASE LCHTYPE=1
	      SET COLOR TO &C2 / &C1
		 @ 12,23 SAY   "úZúYú["
	      CASE LCHTYPE=2
	      SET COLOR TO &C2 / &C1
		 @ 12,23 SAY   "úZúYú["
	      CASE LCHTYPE=3
	      CLEACHW(2)
	      SET COLOR TO &C2 / &C1
		 @ 12,23  SAY	"úZúYúYúYúYúYú["
	      CASE LCHTYPE=4
	      CLEACHW(1)
	      SET COLOR TO &C2 / &C1
		 @ 12,23 SAY   "úZúYúYúYúYúYú["
	      CASE LCHTYPE=5
	      SET COLOR TO &C2 / &C1
		  @ 12,7  SAY	"úZúYúYúYúYúYúYúYúYúYúYúYúYúYú["
	      ENDCASE
	      SET COLOR TO &C7 +/ &C1
	      disc2_s3=disc2
	      IF VAL(TPCOC)-PANDIC =1
		PPFLOR3=PFLOR3+SDRC*PERFLR
		IF MOD(NVUSE,RATVOL)<>0
		* LUSTPP1=ABS(SWC&TPCOC)/(ABS(SWC&TPCOC)+DISC2*MOD(NVUSE,RATVOL)/RATVOL)
		* LUSTPP1=ABS(SWC&TPCOC)/(ABS(SWC&TPCOC)+DISC2*MOD(NVUSE,RATVOL)/RATVOL)
		* POVKG2=SPOVKG2*LUSTPP1
		  disc2_s3=DISC2*MOD(NVUSE,RATVOL)/RATVOL
		ELSE
		 *LUSTPP1=ABS(SWC&TPCOC)/(ABS(SWC&TPCOC)+DISC2)
		 *POVKG2=SPOVKG2*LUSTPP1
		  disc2_s3=DISC2
		ENDIF
	      ELSE
	       *LUSTPP1=ABS(SWC&TPCOC)/(ABS(SWC&TPCOC)+DISC2)
	       *POVKG2=SPOVKG2*LUSTPP1
		PPFLOR3=PFLOR3
	      ENDIF

	      IF SWC&TPCOC<0
		SWC&TPCOC=ABS(SWC&TPCOC)
		IF NVUSE > 5
		   IF DISCH1=1
		   DISAA=0.5
		   ELSE
		   DISAA=1
		   ENDIF
		POVKG2= POVKG2*NVUSE/(NVUSE-DISAA)
		ENDIF
	      ENDIF
	      DO CASE
	      CASE LCHTYPE=1 .OR. LCHTYPE=3
		MOVKG2=POVKG2
	      CASE LCHTYPE=2 .OR. LCHTYPE=4
	       MOVKG1=POVKG2
	      CASE LCHTYPE=5
		MOVKG0=POVKG2
	      ENDCASE
	      IF SWD&TPCOC=0
		if  val(tpcoc)-PANDIC  = 1
		  xx=discl
		else
		  xx=1
		endif
		PWATER0=PWATER * xx
		if  val(tpcoc)-PANDIC  = 1
		  xx=discl
		else
		  xx=1
		endif
		SETW1(2,((SWC&TPCOC + disc2_s3 -(PWATER * xx))*PER-PPFLOR3)*2048/POVKG2)
		SETW2(2,((SWC&TPCOC + disc2_s3 -(PWATER * xx))*PER-ERKG3)*2048/POVKG2)
	      ELSE
		SETW1(2,((SWC&TPCOC + disc2_s3 -PCON)*PER-PPFLOR3)*2048/POVKG2)
		SETW2(2,((SWC&TPCOC + disc2_s3 -PCON)*PER-ERKG3)*2048/POVKG2)
	      ENDIF
	      SETOK(2)
	      DOUT(2,1)
	      STP3=3
	   ENDCASE
      CASE STP3=3
	   IF STOPTM3=0
	     STOPTM3=SECONDS()
	     STOP3 =INT((CHENDATA(2))*POVKG2/PER/2048)
	   ELSEIF SECONDS()-STOPTM3 >=2
	     STOPTM3=SECONDS()
	     IF (INT((CHENDATA(2))*POVKG2/PER/2048)-STOP3) < STOPC
	     DOUT3(2,1)
	     ELSE
	     DOUT3(2,0)
	     STOPTM3=0
	     ENDIF
	   ENDIF

	   IF SWD&TPCOC=0
	   if  val(tpcoc)-PANDIC  = 1
	   xx=discl
	   else
	   xx=1
	   endif
	   IF  (PWATER * xx)-PWATER0 <>0
	   ADJWATER(0,(PWATER0-(PWATER * xx))*2048/POVKG2)
	   PWATER0=PWATER * xx
	   ENDIF
	      if xx_1 <> 4
	   @  4,24 SAY	(SWC&TPCOC-(PWATER * xx))   PICT "9999"
	   ENDIF
	   ENDIF
	   IF RDOK2(2)=0
	     DOUT3(2,0)
	     STOPTM3=0
		      PUBL EWC&TPCOC
	      EWC&TPCOC=INT((CHENDATA(2) )*POVKG2/PER/2048)-disc2_s3
	      IF SWD&TPCOC=0
	      if  val(tpcoc)-PANDIC  = 1
	      xx=discl
	      else
	      xx=1
	      endif
	      PUBL  MKWATER&TPCOC
	      MKWATER&TPCOC =PWATER  * xx
	      ENDIF
	      IF WCFOK=1
	      WCFOK1=1
	      ELSE
	      WCFOK=1
	      ENDIF
	      if xx_1 <> 4
	      @  4,24 SAY  0  PICT "9999"
	      ENDIF
	      @  9,24 SAY  EWC&TPCOC  PICT "9999"
	      SET COLOR TO &C2 / &C1
	      @  7,23 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
		 DO CASE
		 CASE LCHTYPE=1  .OR. LCHTYPE=2
		    STP3=4
		 CASE LCHTYPE=3  .OR. LCHTYPE=4
		      STP3=0
		      STP4=2
		      IF LCHTYPE=3
		      SETDLA(2,(EWC&TPCOC)*2048/POVKG2)
		      ELSE
		     SETDLA(1,(EWC&TPCOC)*2048/POVKG2)
		    * MOVKG1=SMOVKG1
		      ENDIF
		      TPCOC=LTRIM(STR(INT(VAL(TPCOC)-1)))
		      PUBL EWC&TPCOC
		      EWC&TPCOC=0
		 CASE  LCHTYPE=5
		      STP3=0
		      STP4=2
		      SETDLA(0,(EWA&TPCOC+EWB&TPCOC+EWC&TPCOC +disc2_s3)*2048/POVKG2)
		      TPCOC=LTRIM(STR(INT(VAL(TPCOC)-1)))
		      PUBL EWC&TPCOC
		      EWC&TPCOC=0
		ENDCASE
	      * POVKG2=SPOVKG2
	   ENDIF
       CASE STP3=4  .AND. DIN(8)=1   .AND. DRTKF=0
	      * POVKG2=SPOVKG2
	    IF	(LCHTYPE=1 .OR. LCHTYPE=3) .AND. TOTANK2=1
	    DRTKF=1
	      SET COLOR TO &C2 */ &C1
	@ 13,42 SAY "újúKúk"
	      SET COLOR TO &C7 +/ &C1
	    ELSEIF   (LCHTYPE=2 .OR. LCHTYPE=4) .AND. TOTANK1=1
	    DRTKF=1
	      SET COLOR TO &C2 */ &C1
	@ 13,42 SAY "újúKúk"
	      SET COLOR TO &C7 +/ &C1
	    ENDIF
      CASE STP3=4   .AND. DIN(8)=0    .AND. DIN(11)=1
	       *  POVKG2=SPOVKG2
	      IF  LCHTYPE=1  .AND. TOTANK2=1  .AND. (DRSTC<=DRNO) .AND. (TOTDR1>0)
	      TOTDR1=TOTDR1-1
	    DRTKF=0
	      TOTANK2=0
	   STP3=5
	      DOUT2(2,1)
	      SET COLOR TO &C2 / &C1
	      @ 12,23 SAY   "úLúKúO"
	   IF TANKSTP=0
	   @ 13,42 say	"ú^ú]ú_"
	   ENDIF
	   TOTANK=1
	      SET COLOR TO &C7 +/ &C1
	      SETZERTM(2,PZERTM3)
SETZER(2,INT(((PZER3/MOVKG2))*PER*2048)+2048)
	      SETZEROK(2)
	   ELSEIF LCHTYPE=2  .AND. TOTANK1=1  .AND. (DRSTB<=DRNO) .AND. (TOTDR1>0)
	   TOTDR1=TOTDR1-1
	    DRTKF=0
	      TOTANK1=0
	     DOUT2(1,1)
	   STP3=5
	      SET COLOR TO &C2 / &C1
	     @ 12,23 SAY   "úLúKúO"
	   IF TANKSTP=0
	   @ 13,42 say	"ú^ú]ú_"
	   ENDIF
	   TOTANK=1
	      SET COLOR TO &C7 +/ &C1
	     SETZERTM(1,PZERTM2)
SETZER(1,INT(((PZER2/MOVKG0))*PER*2048)+2048)
	     SETZEROK(1)
	   ENDIF
      CASE STP3=5
	    IF LCHTYPE=1 .OR. LCHTYPE=2
	       IF LCHTYPE=1
		WDC=2
		WDD="2"
	       ELSE
		WDC=1
		WDD="1"
	       ENDIF
	       IF STOPTML3=0
		 STOPTML3=SECONDS()
		 STOPL3 =INT((WDATA(WDC)-2048)*MOVKG&WDD/PER/2048)
	       ELSEIF SECONDS()-STOPTML3 >=2
		 STOPTML3=SECONDS()
		 IF (INT((WDATA(WDC)-2048)*MOVKG&WDD/PER/2048) -STOPL3) < STOPLC
		 DOUT3(4,1)
		 ELSE
		 DOUT3(4,0)
		 STOPTML3=0
		 ENDIF
	       ENDIF
	       ENDIF

	      IF  LCHTYPE=1
		  IF  RDZEROK(2)=0
		 DOUT3(4,0)
	 * MOVKG2=SMOVKG2
	 POVKG2=SPOVKG2
	 MOVKG2=SMOVKG2
		 STOPTML3=0
		  TOTDR1=TOTDR1+1
		  DRNO=DRNO+1
		 CLEACHMEM(2)
	      SET COLOR TO &C2 / &C1
		  @ 12,23 SAY	"úLúPúO"
	      SET COLOR TO &C7 +/ &C1
		  WCZOK=1
		  STP3=0
		  TPCOC=LTRIM(STR(INT(VAL(TPCOC)-1)))
		  PUBL EWC&TPCOC
		  EWC&TPCOC=0
		  ENDIF
	      ELSEIF LCHTYPE=2
		  IF  RDZEROK(1)=0
	 POVKG2=SPOVKG2
	 MOVKG1=SMOVKG1
		 DOUT3(4,0)
		 STOPTML3=0
	  *MOVKG1=SMOVKG1
		  TOTDR1=TOTDR1+1
		  DRNO=DRNO+1
		 CLEACHMEM(2)
		  STP3=0
	      SET COLOR TO &C2 / &C1
		  @ 12,23 SAY	"úLúPúO"
	      SET COLOR TO &C7 +/ &C1
		  WCZOK=1
		  TPCOC=LTRIM(STR(INT(VAL(TPCOC)-1)))
		  PUBL EWC&TPCOC
		  EWC&TPCOC=0
		  ENDIF
	      ENDIF

   ENDCASE

   DO CASE
      CASE STP4=1
	   IF  LCHTYPE=1
	      IF  DIN(3)=0
	      STP4=2
	      ENDIF
	   ELSE
	      IF  DIN(2)=0
	      STP4=2
	      ENDIF
	   ENDIF
      CASE STP4=2  .and. din(14)=1
	   DRDF=0
	   DO CASE
	   CASE NEXTOK1=1  .AND. (VAL(TPCOD)-PANDIC >0) .AND. SWD&TPCOD=0
	      DO CASE
		 CASE LCHTYPE=1 .OR. LCHTYPE=2
		       IF LCHTYPE=1
		       TOTANK3=0
		       ELSE
		       TOTANK2=0
		       ENDIF
		      STP4=0
		      WDZOK=1
		      PUBL EWD&TPCOD
		      EWD&TPCOD=0
		      TPCOD=LTRIM(STR(INT(VAL(TPCOD)-1)))
		      PUBL EWD&TPCOD
		      EWD&TPCOD=0
		 CASE LCHTYPE=3 .OR. LCHTYPE=4
		      STP4=0
		      IF EWC&TPCOD<>0
		      STP4=4
		      ENDIF
		      PUBL EWD&TPCOD
		      EWD&TPCOD=0
		 CASE  LCHTYPE=5
		      STP4=0
		      IF EWA&TPCOD<>0 .OR.EWB&TPCOD<>0 .OR.EWC&TPCOD<>0
		      STP4=4
		      ENDIF
		      PUBL EWD&TPCOD
		      EWD&TPCOD=0
	      ENDCASE
	      IF WDFOK=1
	      WDFOK1=1
	      ELSE
	      WDFOK=1
	      ENDIF
	   CASE NEXTOK1=1  .AND. (VAL(TPCOD)-PANDIC >0) .AND. SWD&TPCOD<>0
	      if  val(tpcoc)-PANDIC  = 1
	      xx=discl
	      else
	      xx=1
	      endif
	      if xx_1 <> 5
	      @  4,32 SAY  (ABS(SWD&TPCOD)-(PWATER * xx))   PICT "9999"
	      ENDIF

	      SET COLOR TO &C2 / &C1
	      @  7,31 SAY   "úLúKúO"
	      do case
	      CASE LCHTYPE=1
	      CLEACHW(3)
		 @ 12,31 SAY   "úZúYú["
	      CASE LCHTYPE=2
	      CLEACHW(2)
		 @ 12,31 SAY   "úZúYú["
	      CASE LCHTYPE=3
		 @ 12,23  SAY	"úZúYúYúYúYúYú["
	      CASE LCHTYPE=4
		 @ 12,23 SAY   "úZúYúYúYúYúYú["
	      CASE LCHTYPE=5
		  @ 12,7  SAY	"úZúYúYúYúYúYúYúYúYúYúYúYúYúYú["
	      ENDCASE
	      SET COLOR TO &C7 +/ &C1

	      CLEACHMEM(3)
	      IF VAL(TPCOD)-PANDIC =1
	      PPFLOR4=PFLOR4+SDRD*PERFLR
	      ELSE
	      PPFLOR4=PFLOR4
	      ENDIF
	      IF SWD&TPCOD<0
		 SWD&TPCOD=ABS(SWD&TPCOD)
		IF NVUSE > 5
		  IF DISCH1=1
		  DISAA=0.5
		  ELSE
		  DISAA=1
		  ENDIF
		POVKG3=SPOVKG3*NVUSE/(NVUSE-DISAA)
		ENDIF
		ELSE
		  POVKG3=SPOVKG3
		ENDIF
	      DO CASE
	      CASE LCHTYPE=1
		MOVKG3=POVKG3
	      CASE LCHTYPE=2 .OR. LCHTYPE=3
		MOVKG2=POVKG3
	      CASE LCHTYPE=4
		MOVKG1=POVKG3
	      CASE LCHTYPE=5
		MOVKG0=POVKG3
	      ENDCASE
	      if  val(tpcoc)-PANDIC  = 1
	      xx=discl
	      else
	      xx=1
	      endif
	      PWATER0=PWATER	* xx
	      SETW1(3,((SWD&TPCOD-(PWATER * xx))*PER-PPFLOR4)*2048/POVKG3)
	      SETW2(3,((SWD&TPCOD-(PWATER * xx))*PER-ERKG4)*2048/POVKG3)
	      SETOK(3)
	      DOUT(3,1)
	      STP4=3
	   ENDCASE
      CASE STP4=3
	   IF LCHTYPE=4  .OR. LCHTYPE=3
	      WDSP2=1
	   ENDIF
	   IF STOPTM4=0
	     STOPTM4=SECONDS()
	     STOP4 =INT((CHENDATA(3))*POVKG3/PER/2048)
	   ELSEIF SECONDS()-STOPTM4 >=2
	     STOPTM4=SECONDS()
	     IF (INT((CHENDATA(3))*POVKG3/PER/2048)-STOP4) < STOPD
	     DOUT3(3,1)
	     ELSE
	     DOUT3(3,0)
	     STOPTM4=0
	     ENDIF
	   ENDIF
	   if  val(tpcod)-PANDIC  = 1
	   xx=discl
	   else
	   xx=1
	   endif

	   IF  (PWATER * xx)-PWATER0 <>0
	   ADJWATER(1,(PWATER0-(PWATER * xx))*2048/POVKG3)
	   PWATER0=PWATER * xx
	   ENDIF
	      if xx_1 <> 5
	   @  4,32 SAY	(SWD&TPCOD-(PWATER * xx))   PICT "9999"
	   ENDIF
	   IF RDOK2(3)=0
	     DOUT3(3,0)
	     STOPTM4=0
		      PUBL EWD&TPCOD
	      EWD&TPCOD=INT((CHENDATA(3) )*POVKG3/PER/2048)
	      PUBL  MKWATER&TPCOD
	      MKWATER&TPCOD =PWATER * xx
	      IF WDFOK=1
	      WDFOK1=1
	      ELSE
	      WDFOK=1
	      ENDIF
	      if xx_1 <> 5
	      @  4,32 SAY  0 PICT "9999"
	      ENDIF
	      @  9,32 SAY  EWD&TPCOD PICT "9999"
	      SET COLOR TO &C2 / &C1
	      @  7,31 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1
	      STP4=4
	     *	POVKG3=SPOVKG3
	   ENDIF

       CASE STP4=4  .AND. DIN(8)=1   .AND. DRTKF=0
	   FLS=0
	   DO CASE
	   CASE  LCHTYPE=1   .AND. TOTANK3=1
	   FLS=1
	    DRTKF=1
	    CASE     (LCHTYPE=2 .OR. LCHTYPE=3) .AND. TOTANK2=1
	   FLS=1
	    DRTKF=1
	    CASE     LCHTYPE=4	.AND. TOTANK1=1
	   FLS=1
	    DRTKF=1
	    CASE     LCHTYPE=5	.AND. TOTANK0=1
	   FLS=1
	    DRTKF=1
	    ENDCASE
	    IF FLS=1
	      SET COLOR TO &C2 */ &C1
	@ 13,42 SAY "újúKúk"
	      SET COLOR TO &C7 +/ &C1
	    ENDIF
      CASE STP4=4   .AND. DIN(8)=0  .AND. DIN(11)=1
		* POVKG3=SPOVKG3
	       *  MOVKG1=SMOVKG1
	      DO CASE
	      CASE  LCHTYPE=1  .AND. TOTANK3=1	  .AND. (DRSTD<=DRNO) .AND. (TOTDR1>0)
		  TOTDR1=TOTDR1-1
		  STP4=5
		  TOTANK3=0
		  DOUT2(3,1)
	      SET COLOR TO &C2 / &C1
		  @ 12,31 SAY	"úLúKúO"
		  IF TANKSTP=0
		  @ 13,42 say  "ú^ú]ú_"
		  ENDIF
	   TOTANK=1
	      SET COLOR TO &C7 +/ &C1
		  SETZERTM(3,PZERTM4)
SETZER(3,INT(((PZER4/MOVKG3))*PER*2048)+2048)
		  SETZEROK(3)
	      CASE  LCHTYPE=2  .AND. TOTANK2=1	 .AND. (DRSTC<=DRNO) .AND. (TOTDR1>0)
		  TOTDR1=TOTDR1-1
		      STP4=5
		      TOTANK2=0
		  DOUT2(2,1)
	      SET COLOR TO &C2 / &C1
		  @ 12,31 SAY	"úLúKúO"
		  IF TANKSTP=0
		  @ 13,42 say  "ú^ú]ú_"
		  ENDIF
	   TOTANK=1
	      SET COLOR TO &C7 +/ &C1
		  SETZERTM(2,PZERTM3)
SETZER(2,INT(((PZER3/MOVKG2))*PER*2048)+2048)
		  SETZEROK(2)
	      CASE  LCHTYPE=3  .AND. TOTANK2=1	.AND. (DRSTC<=DRNO) .AND. (TOTDR1>0)
		  TOTDR1=TOTDR1-1
		* POVKG2=SPOVKG2
		      STP4=5
		      TOTANK2=0
		  DOUT2(2,1)
	      SET COLOR TO &C2 / &C1
		  @ 12,23 SAY	"úLúPúPúKúPúPúO"
	   IF TANKSTP=0
	   @ 13,42 say	"ú^ú]ú_"
	   ENDIF
	   TOTANK=1
	      SET COLOR TO &C7 +/ &C1
		  SETZERTM(2,PZERTM3)
SETZER(2,INT(((PZER3/MOVKG2))*PER*2048)+2048)
		  SETZEROK(2)
	      CASE  LCHTYPE=4  .AND. TOTANK1=1	 .AND. (DRSTB<=DRNO) .AND. (TOTDR1>0)
	       *  POVKG2=SPOVKG2
		  TOTDR1=TOTDR1-1
		      STP4=5
		      TOTANK1=0
		  DOUT2(1,1)
	      SET COLOR TO &C2 / &C1
		  @ 12,23 SAY	"úLúPúPúKúPúPúO"
	   IF TANKSTP=0
	   @ 13,42 say	"ú^ú]ú_"
	   ENDIF
	   TOTANK=1
	      SET COLOR TO &C7 +/ &C1
		  SETZERTM(1,PZERTM2)
SETZER(1,INT(((PZER3/MOVKG1))*PER*2048)+2048)
		  SETZEROK(1)
	      CASE  LCHTYPE=5  .AND. TOTANK0=1
		* POVKG2=SPOVKG2
		      TOTANK0=0
		  DOUT2(0,1)
	      SET COLOR TO &C2 / &C1
		  @ 12,7  SAY	"úLúPúPúPúPúPúPúKúPúPúPúPúPúPúO"
	   IF TANKSTP=0
	   @ 13,42 say	"ú^ú]ú_"
	   ENDIF
	   TOTANK=1
	      SET COLOR TO &C7 +/ &C1
		  SETZERTM(0,PZERTM1)
SETZER(0,INT(((PZER1/MOVKG0))*PER*2048)+2048)
		  SETZEROK(0)
		      STP4=5
	      ENDCASE
      CASE STP4=5
	      if xx_1 <> 4
	      @  4,32 SAY  0 PICT "9999"
	      ENDIF
		 DO CASE
		   CASE LCHTYPE=1
		     WDC=3
		WDD="3"
		   CASE LCHTYPE=2 .OR.	 LCHTYPE=3
		     WDC=2
		WDD="2"
		   CASE LCHTYPE=4
		     WDC=1
		WDD="1"
		   CASE LCHTYPE=5
		     WDC=0
		WDD="0"
		 ENDCASE
		 IF STOPTML4=0
		   STOPTML4=SECONDS()
		   STOPL4 =INT((WDATA(WDC)-2048)*MOVKG&WDD/PER/2048)
		 ELSEIF SECONDS()-STOPTML4 >=2
		   STOPTML4=SECONDS()
		   IF (INT((WDATA(WDC)-2048)*MOVKG&WDD/PER/2048) -STOPL4) < STOPLD
		   DOUT3(13,1)
		   ELSE
		   DOUT3(13,0)
		   STOPTML4=0
		   ENDIF
		 ENDIF

	   DO CASE
	   CASE  LCHTYPE=1
	      IF  RDZEROK(3)=0
		 DOUT3(13,0)
		 STOPTML4=0
	  MOVKG3=SMOVKG3
	 POVKG3=SPOVKG3
		  TOTDR1=TOTDR1+1
		  DRNO=DRNO+1
		 CLEACHMEM(3)
		  STP4=0
	      SET COLOR TO &C2 / &C1
	      @ 12,31 SAY   "úLúPúO"
	      SET COLOR TO &C7 +/ &C1
	      WDZOK=1
	      TPCOD=LTRIM(STR(INT(VAL(TPCOD)-1)))
	      PUBL EWD&TPCOD
	      EWD&TPCOD=0
	      ENDIF
	   CASE  LCHTYPE=2
	      IF  RDZEROK(2)=0
		 DOUT3(13,0)
		 STOPTML4=0
	  MOVKG2=SMOVKG2
	 POVKG3=SPOVKG3
		 CLEACHMEM(3)
		 TOTDR1=TOTDR1+1
		 DRNO=DRNO+1
	      SET COLOR TO &C2 / &C1
	      @ 12,31 SAY   "úLúPúO"
	      SET COLOR TO &C7 +/ &C1
		  STP4=0
	      WDZOK=1
	      TPCOD=LTRIM(STR(INT(VAL(TPCOD)-1)))
	      PUBL EWD&TPCOD
	      EWD&TPCOD=0
	      ENDIF
	   CASE  LCHTYPE=3
	      IF  RDZEROK(2)=0
		  WDSP2=0
		   DOUT3(13,0)
		   STOPTML4=0
	   MOVKG2=SMOVKG2
	   POVKG3=SPOVKG3
	   POVKG2=SPOVKG2
		 TOTDR1=TOTDR1+1
		 DRNO=DRNO+1
		 CLEACHMEM(3)
		 CLEACHMEM(2)
		 SETDLA(2,0)
		  STP4=0
	      SET COLOR TO &C2 / &C1
	      @ 12,23 SAY   "úLúPúPúPúPúPúO"
	      SET COLOR TO &C7 +/ &C1
	      WCZOK=1
	      WDZOK=1
	      TPCOD=LTRIM(STR(INT(VAL(TPCOD)-1)))
	      PUBL EWD&TPCOD
	      EWD&TPCOD=0
	      ENDIF
	   CASE  LCHTYPE=4
	      IF  RDZEROK(1)=0
	      @  9,24 SAY  0 PICT "9999"
	      @  9,32 SAY  0 PICT "9999"
		   DOUT3(13,0)
		   STOPTML4=0
		  WDSP2=0
	   MOVKG1=SMOVKG1
	   POVKG3=SPOVKG3
	   PONKG2=SPOVKG2
		 CLEACHMEM(2)
		 CLEACHMEM(3)
		 TOTDR1=TOTDR1+1
		 DRNO=DRNO+1
		 SETDLA(1,0)
		  STP4=0
	      SET COLOR TO &C2 / &C1
	      @ 12,23 SAY   "úLúPúPúPúPúPúO"
	      SET COLOR TO &C7 +/ &C1
	      WCZOK=1
	      WDZOK=1
	      TPCOD=LTRIM(STR(INT(VAL(TPCOD)-1)))
	      PUBL EWD&TPCOD
	      EWD&TPCOD=0
	      ENDIF
	   CASE  LCHTYPE=5
	      IF  RDZEROK(0)=0
		 DOUT3(13,0)
		 STOPTML4=0
		 MOVKG0=SMOVKG0
		 POVKG0=SPOVKG0
		 POVKG1=SPOVKG1
		 POVKG2=SPOVKG2
		 POVKG3=SPOVKG3
		 CLEACHMEM(0)
		 CLEACHMEM(1)
		 CLEACHMEM(2)
		 CLEACHMEM(3)
		 SETDLA(0,0)
		 STP4=0
		 SET COLOR TO &C2 / &C1
		 @ 12,7  SAY   "úLúPúPúPúPúPúPúPúPúPúPúPúPúPúO"
		 SET COLOR TO &C7 +/ &C1
		 WAZOK=1
		 WBZOK=1
		 WCZOK=1
		 WDZOK=1
		 TPCOD=LTRIM(STR(INT(VAL(TPCOD)-1)))
		 PUBL EWA&TPCOD
		 PUBL EWB&TPCOD
		 PUBL EWC&TPCOD
		 PUBL EWD&TPCOD
		 EWA&TPCOD=0
		 EWB&TPCOD=0
		 EWC&TPCOD=0
		 EWD&TPCOD=0
	      ENDIF
	  ENDCASE
   ENDCASE

   DO CASE
      CASE STP5=1
	   PKLCH=LTRIM(STR(KLCHN+1,5,0))
	   IF  DIN(KLCHN)=0

	   STP5=2
	   ENDIF
      CASE STP5=2 .and. din(14)=1
	   DREF=0
	   DO CASE
	   CASE NEXTOK2=1  .AND. (VAL(TPCOE)-PANDIC >0) .AND. SWE&TPCOE=0
	       CHKLCHN=LTRIM(STR(KLCHN,5,0))
	      TOTANK&CHKLCHN=1
		      STP5=0
		      PUBL EWE&TPCOE
		      EWE&TPCOE=0
		      PUBL  NKWATER&TPCOE
		      NKWATER&TPCOE =0
	      WEZOK=1
	      WEFOK=1
	      TPCOE=LTRIM(STR(VAL(TPCOE)-1,5,0))
	      PUBL EWE&TPCOE
	      EWE&TPCOE=0
	   CASE NEXTOK2=1  .AND. (VAL(TPCOE)-PANDIC >0) .AND. SWE&TPCOE<>0
	       if  val(tpcoe)-PANDIC  = 1
	       xx=discu
	       else
	       xx=1
	       endif
	      if xx_1 <> 6
	      @  4,50 SAY  (ABS(SWE&TPCOE)+(PWATER * xx))   PICT "9999"
	      endif
	      SET COLOR TO &C2 / &C1
	      @  7,49 SAY   "úLúKúO"
		    @ 12,49 SAY   "úZúYú["
	      SET COLOR TO &C7 +/ &C1

	      CLEACHMEM(4)
	      CLEACHW(KLCHN)
	      IF VAL(TPCOE)-PANDIC =1
	      PPFLOR5=PFLOR5+SDRE*PERFLR
	      ELSE
	      PPFLOR5=PFLOR5
	      ENDIF
	      IF SWE&TPCOE<0
		 SWE&TPCOE=ABS(SWE&TPCOE)
		IF SVUSE > 5
		POVKG4=SPOVKG4*SVUSE/(SVUSE-1*NDISC1)
		MOVKG4=SMOVKG4*SVUSE/(SVUSE-1*NDISC1)
		ENDIF
	      ENDIF
	      PWATER1=PWATER	* xx
	      SETW1(4,((SWE&TPCOE+(PWATER * xx))*PER-PPFLOR5)*2048/POVKG4)
	      SETW2(4,((SWE&TPCOE+(PWATER * xx))*PER-ERKG5)*2048/POVKG4)
	      SETOK(4)
	      DOUT(4,1)
	      STP5=3
	   ENDCASE
      CASE STP5=3
	   if  val(tpcoe)-PANDIC  = 1
	   xx=discu
	   else
	   xx=1
	   endif
	   IF  (PWATER * xx)-PWATER1 <>0
	   ADJWATER(2,((PWATER * xx)-PWATER1)*2048/POVKG4)
	   PWATER1=PWATER * xx
	   ENDIF
	      if xx_1 <> 6
	   @  4,50 SAY	(SWE&TPCOE+(PWATER * xx))   PICT "9999"
	   endif
