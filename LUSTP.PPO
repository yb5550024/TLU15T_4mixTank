IF STAR=1 

  Set( 20, "SCREEN" )
  do  npah1_1
  DO STPSTARN
  IF star=1 .OR.NEXTOK=1  .OR. NEXTOK2=1 .OR. PRCEND=1
    IF STP_a[val(WATER_OUT_NC)]=6

      IF t=woff_code
    WATER_OUT=VAL(WATER_OUT_NC)
    water_off=1
      ENDIF
    ENDIF
    for xstp=1    to gs_tot
      STP_ALL(XSTP,STP_A[XSTP],2)
      IF INFUNC =1
    T0A=INKEY()
    IF T0A <> 0
      RETU
    ENDIF
      ENDIF
    next
    for xstp=gs_tot+1  to gs_tot+water_tot
      STP_ALL_W(XSTP,STP_A[XSTP],2)
      IF INFUNC =1
    T0A=INKEY()
    IF T0A <> 0
      RETU
    ENDIF
      ENDIF
    next
    for xstp=gs_tot+water_tot+1  to gs_tot+uwc_tot
      IF (XSTP    > gs_tot+water_tot+c_tot)
    STP_ALL_AE(XSTP,STP_A[XSTP],2)
      ELSE
    STP_ALL(XSTP,STP_A[XSTP],2)
      ENDIF
      IF INFUNC =1
    T0A=INKEY()
    IF T0A <> 0
      RETU
    ENDIF
      ENDIF
    next
    x=RDN_DATA(368)
    IF INFUNC =1
      T0A=INKEY()
      IF T0A <> 0
    RETU
      ENDIF
    ENDIF
    IF KOT=1  
      DO TANKsTPAU
    else
      DO CONVEYER
      DO TANKSTP0
    ENDIF
    DO UP_TANK
    DO TANKSTP0


  ENDIF
ENDIF



PROCEDURE  MP1
PARAMETERS  P1,P2,P3
  MX="1"
  MLA_LAG=0
  XSTP=INT((VUSE+RATVOL-0.1)/RATVOL)
  while MLA_LAG < VUSE
    IF VAL(MX) < XSTP
      MLA_LAG=MLA_LAG+RATVOL
      dbSelectArea( "2" )
      XM_PLUS=0
      FOR XNP=1  TO 15
    XNPC=LTRIM(STR(INT(XNP),2,0))
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * RATVOL
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := 0
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,5] := RATVOL
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG
    IF LCHTYPE=16    .OR.  UCHTYPE=19   .OR.  UCHTYPE=30
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * RATVOL
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,3] := 0
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,5] := RATVOL
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG
    ENDIF

    IF XNP <=5
      IF M&XNPC >0
        XM_PLUS=XM_PLUS + A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]
      ENDIF
    ENDIF
      NEXT
      dbSelectArea( "16" )
      __dbLocate( {|| (ALLTRIM(DSRATNO)==ALLTRIM(ARATNO))},,,, .F. )
      IF !    EOF()
    A_PRESS_N0[GD_PRESS,VAL(MX),8,3] := DSCO1  * RATVOL
    A_PRESS_N0[GD_PRESS,VAL(MX),9,3] := DSCO2  * RATVOL
    FOR XNP=1  TO 5
      X_DSW=(DSCO1 +DSCO2) * RATVOL *A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]/XM_PLUS
      XNPC=LTRIM(STR(INT(XNP),2,0))
      IF A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] >0
        A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := X_DSW
      ENDIF
    NEXT
      ENDIF
      dbSelectArea( "2" )
    ELSE
      LVUSE=VUSE -MLA_LAG
      MLA_LAG=VUSE
      XM_PLUS=0
      dbSelectArea( "2" )
      FOR XNP=1  TO 15
    XNPC=LTRIM(STR(INT(XNP),2,0))
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * LVUSE
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := 0
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,5] := LVUSE
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG

    IF LCHTYPE=16     .OR.  UCHTYPE=19  .OR.  UCHTYPE=30
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * RATVOL
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,3] := 0
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,5] := RATVOL
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG
    ENDIF

    IF XNP <=5
      IF M&XNPC >0
        XM_PLUS=XM_PLUS + A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]
      ENDIF
    ENDIF
      NEXT
      dbSelectArea( "16" )
      __dbLocate( {|| (ALLTRIM(DSRATNO)==ALLTRIM(ARATNO))},,,, .F. )
      IF !    EOF()
    A_PRESS_N0[GD_PRESS,VAL(MX),8,3] := DSCO1  * LVUSE
    A_PRESS_N0[GD_PRESS,VAL(MX),9,3] := DSCO2  * LVUSE
    FOR XNP=1  TO 5
      X_DSW=(DSCO1 +DSCO2) * LVUSE    *A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]/XM_PLUS
      XNPC=LTRIM(STR(INT(XNP),2,0))
      IF A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] >0
        A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := X_DSW
      ENDIF
    NEXT
      ENDIF
      dbSelectArea( "2" )
    ENDIF
    MX=LTRIM(STR(INT(VAL(MX)+1),2,0))
  ENDDO
RETU

PROCEDURE  MP1_1
PARAMETERS  P1,P2,P3
dbSelectArea( "8" )
MX=INT((VUSE+0.4)*2)*.5
__dbLocate( {|| (MLAV=RATVOL) .AND.(MLMV=MX)},,,, .F. )
IF   ! EOF()
  MX="1"
  MLA_LAG=0
  while MLA&MX >0
    IF MLMV_1 > MLA_LAG
      X_MLA=MLA&MX
      MLA_LAG=MLA_LAG+X_MLA
      XM_PLUS=0
      dbSelectArea( "2" )
      FOR XNP=1  TO 15
    XNPC=LTRIM(STR(INT(XNP),2,0))
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * X_MLA
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := 0
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,5] := X_MLA
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG
    IF LCHTYPE=16    .OR.  UCHTYPE=19   .OR.  UCHTYPE=30
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * RATVOL
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,3] := 0
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,5] := RATVOL
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG
    ENDIF




    IF XNP <=5
      IF M&XNPC >0
        XM_PLUS=XM_PLUS + A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]
      ENDIF
    ENDIF
      NEXT
      dbSelectArea( "16" )
      __dbLocate( {|| (ALLTRIM(DSRATNO)==ALLTRIM(ARATNO))},,,, .F. )
      IF !    EOF()
    A_PRESS_N0[GD_PRESS,VAL(MX),8,3] := DSCO1  * X_MLA
    A_PRESS_N0[GD_PRESS,VAL(MX),9,3] := DSCO2  * X_MLA
    FOR XNP=1  TO 5
      X_DSW=(DSCO1 +DSCO2) * X_MLA    *A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]/XM_PLUS
      XNPC=LTRIM(STR(INT(XNP),2,0))
      IF A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] >0
        A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := X_DSW
      ENDIF
    NEXT
      ENDIF
      dbSelectArea( "8" )
    ELSE
      LVUSE=VUSE -MLMV_1
      MLA_LAG=MLA_LAG+LVUSE
      XM_PLUS=0
      dbSelectArea( "2" )
      FOR XNP=1  TO 15
    XNPC=LTRIM(STR(INT(XNP),2,0))
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * LVUSE
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := 0
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,5] := LVUSE
    A_PRESS_N0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG

    IF LCHTYPE=16    .OR.  UCHTYPE=19   .OR.  UCHTYPE=30
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,1] :=M&XNPC * RATVOL
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,3] := 0
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,5] := RATVOL
      A_PRESS_B0[GD_PRESS,VAL(MX),XNP,6] := MLA_LAG
    ENDIF





    IF XNP <=5
      IF M&XNPC >0
        XM_PLUS=XM_PLUS + A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]
      ENDIF
    ENDIF
      NEXT
      dbSelectArea( "16" )
      __dbLocate( {|| (ALLTRIM(DSRATNO)==ALLTRIM(ARATNO))},,,, .F. )
      IF !    EOF()
    A_PRESS_N0[GD_PRESS,VAL(MX),8,3] := DSCO1  * LVUSE
    A_PRESS_N0[GD_PRESS,VAL(MX),9,3] := DSCO2  * LVUSE
    FOR XNP=1  TO 5
      X_DSW=(DSCO1 +DSCO2) * LVUSE    *A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1]/XM_PLUS
      XNPC=LTRIM(STR(INT(XNP),2,0))
      IF A_PRESS_N0[GD_PRESS,VAL(MX),XNP,1] >0
        A_PRESS_N0[GD_PRESS,VAL(MX),XNP,3] := X_DSW
      ENDIF
    NEXT
      ENDIF
      dbSelectArea( "8" )
    ENDIF
    MX=LTRIM(STR(INT(VAL(MX)+1),2,0))
  ENDDO
ELSE
  DO MP1
ENDIF
RETU






FUNCTION DSP_RECIP
PARAMETERS  CHN,CHTYPE
SetColor( "&C7 +/ &C1" )
INDEX1=GET_DATA2(CHN,1)
DO CASE
CASE  CHTYPE=0    
      IF   ((WEIGHT_TYPE[chn]=77) .OR.    (WEIGHT_TYPE[chn]=1) .OR. (WEIGHT_TYPE[chn]=3) .OR. (WEIGHT_TYPE[chn]=6) .OR. (WEIGHT_TYPE[chn]=10)  )
      FOR  XLOOP=chn  TO  chn +INDEX1
        XLOOPC=ALLTRIM(STR(XLOOP,2,0))
        XMC_F=A_M_NAME[XLOOP,3]
        if DSPD_NOR=0
          DevPos( A_M_NAME[xloop,23], A_M_NAME[xloop,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&xloopc,xloop,8] + A_PRESS_N0[L_PRESS,STPN&xloopc,xloop,11], "&XMC_F" )
        ELSE
          DevPos( A_M_NAME[xloop,23], A_M_NAME[xloop,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&xloopc,xloop,1] + A_PRESS_N0[L_PRESS,STPN&xloopc,xloop,2], "&XMC_F" )
        ENDIF
      NEXT
      ENDIF
CASE  CHTYPE=1
  DO CASE
  CASE    WEIGHT_TYPE[CHN]=1
    XMC_F=A_M_NAME[STP_FN,3]
    XMC_F2=A_M_NAME[STP_FN+1,3]
    if DSPD_NOR=0
      DevPos( A_M_NAME[STP_FN,23], A_M_NAME[STP_FN,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8], "&XMC_F" )
      DevPos( A_M_NAME[STP_FN,23], A_M_NAME[STP_FN+1,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,8], "&XMC_F2" )
    ELSE
      DevPos( A_M_NAME[STP_FN,23], A_M_NAME[STP_FN,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1], "&XMC_F" )
      DevPos( A_M_NAME[STP_FN,23]+1, A_M_NAME[STP_FN+1,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1], "&XMC_F2" )
    ENDIF
  ENDCASE
ENDCASE
SetColor( "&C7 +/ &C1" )
RETU

FUNCTION GET_DATA2
PARAMETERS  XWEIGHT_TYPE ,XMOD
   XRETU=0
   DO CASE
   CASE    XMOD=1
       DO  CASE
       CASE WEIGHT_TYPE[STP_FN]=77
      XRETU=0
       CASE  WEIGHT_TYPE[STP_FN]=1
        XRETU=1
       CASE  WEIGHT_TYPE[STP_FN]=3
        XRETU=2
       CASE  WEIGHT_TYPE[STP_FN]=6
        XRETU=3
       CASE  WEIGHT_TYPE[STP_FN]=10
        XRETU=4
       ENDCASE
   CASE  XMOD=-1   
      DO  CASE
      CASE WEIGHT_TYPE[STP_FN]=77  .OR.   WEIGHT_TYPE[STP_FN]=1   .OR.     WEIGHT_TYPE[STP_FN]=3    .OR.   WEIGHT_TYPE[STP_FN]=6   .OR.   WEIGHT_TYPE[STP_FN]=10
     XRETU=0
      CASE    WEIGHT_TYPE[STP_FN]=2   .OR. WEIGHT_TYPE[STP_FN]=4   .OR.   WEIGHT_TYPE[STP_FN]=7  .OR.    WEIGHT_TYPE[STP_FN]=11
       XRETU=1
      CASE     WEIGHT_TYPE[STP_FN]=5     .OR. WEIGHT_TYPE[STP_FN]=8  .OR.   WEIGHT_TYPE[STP_FN]=12
       XRETU=2
      CASE  WEIGHT_TYPE[STP_FN]=9   .OR. WEIGHT_TYPE[STP_FN]=13
       XRETU=3
      CASE  WEIGHT_TYPE[STP_FN]=14
       XRETU=4
      ENDCASE
   CASE    XMOD=-2
       DO  CASE
       CASE WEIGHT_TYPE[STP_FN]=77
      XRETU=0
       CASE  WEIGHT_TYPE[STP_FN]=2
        XRETU=1
       CASE  WEIGHT_TYPE[STP_FN]=5
        XRETU=2
       CASE  WEIGHT_TYPE[STP_FN]=9
        XRETU=3
       CASE  WEIGHT_TYPE[STP_FN]=14
        XRETU=4
       ENDCASE
   ENDCASE
RETU    XRETU

FUNCTION SH_W_ADJ2
PARAMETERS  X_STPN,XWATER_INPUT
  W2=0
  W11=0
  IF WATER_CHG=0
    RETURN
  ENDIF
  IF XWATER_INPUT=0
    RETURN
  ENDIF
  WATER_CHG=0
  W11=0
  FOR  I=1 TO GS_TOT
    w11=W11- (A_PRESS_N0[L_PRESS,X_STPN,I,8]  *  WATER_INC[I]  /100 )
  NEXT
  PWATER=W11
  IF  WATER_INPUT=1
    SetColor( "W+  / &C1" )
    if dspe_mixamp=1
      DevPos( 17, 71 ) ; DevOutPict( PWATER, "9999" )
    endif
    SetColor( "&C2 / &C1" )
  ENDIF
  XWT8=0
  FOR  X_STP_FN =GS_TOT+1   TO GS_TOT +WATER_TOT
      XWT8=XWT8+ A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,8]
  NEXT
  IF XWT8 >0
     FOR  X_STP_FN =GS_TOT+1   TO GS_TOT +WATER_TOT
     XWT=A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,8]+(A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,8]*W11/XWT8)
     IF XWT >0
       XMC_F=A_M_NAME[X_STP_FN,3]
       SetColor( "w / &C1" )
       DevPos( A_M_NAME[X_STP_FN,23], A_M_NAME[X_STP_FN,13] ) ; DevOutPict( XWT, "&XMC_F" )
       SetColor( "&C2 / &C1" )
     ENDIF
     NEXT

  ENDIF
RETU

FUNCTION GET_W_ADJ2
PARAMETERS  X_STP_FN,X_STPN,XWATER_INPUT,STOR_F,W2,W11
W2=0
W11=0
IF XWATER_INPUT=1
     FOR  I=1 TO GS_TOT
       w2=W2- INT(A_PRESS_N0[L_PRESS,X_STPN,I,1]  *  WATER_INC[I]  /100)
       w11=W11- INT(A_PRESS_N0[L_PRESS,X_STPN,I,8]    *  WATER_INC[I]  /100)
     NEXT
     PWATER=W2
ELSE
     W2=INT(PWATER *  A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,5]/ RATVOL)
     W11=W2
ENDIF
DO CASE
CASE WEIGHT_TYPE[X_STP_FN]=77
      IF (A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,1] =0)
      W2=0
      ENDIF
      IF (A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,8] =0)
      W11=0
      ENDIF
      IF  STOR_F=1
    A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,2]=W2
    A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,11]=W11
      ENDIF
CASE WEIGHT_TYPE[X_STP_FN]=1  .OR.  WEIGHT_TYPE[X_STP_FN]=2
      IF   WEIGHT_TYPE[X_STP_FN]=1
    XCHN=1
      ELSE
    XCHN=-1
      ENDIF
      XWT1=A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,1] +A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN+XCHN,1]
      XWT8=A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,8] +A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN+XCHN,8]
      W2=INT(W2 *A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,1]/XWT1)
      W11=INT(W11 *A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,8]/XWT8)
      IF (A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,1] =0)
      W2=0
      ENDIF
      IF (A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,8] =0)
      W11=0
      ENDIF
      IF  STOR_F=1
    A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,2]=W2
    A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,11]=W11
      ENDIF
ENDCASE
RETU

FUNCTION GET_WATER_ADJ
PARAMETERS  X_STP_FN,X_STPN,XWATER_INPUT,STOR_F,W2,W11,xWATER_INC
   W2=0
   W11=0
   IF X_STP_FN    >  GS_TOT
      RETU
   ENDIF
   RETUN=0
   IF XWATER_INPUT=1
       W2=INT(A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,1]  *    xWATER_INC[X_STP_FN]  /100)
       A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,2]=W2
       W11=INT(A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,8]  *  xWATER_INC[X_STP_FN]  /100 )
       A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,11]=W11

       DO CASE
       CASE WEIGHT_TYPE[X_STP_FN]=77
        A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,2]=  INT(A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,1]  *  xWATER_INC[X_STP_FN]    /100)
        A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,11]= INT(A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,8]  *  xWATER_INC[X_STP_FN]    /100 )
       CASE WEIGHT_TYPE[X_STP_FN]=1
       FOR X=0  TO 1
        A_PRESS_N0[ L_PRESS,X_STPN,X_STP_FN+X,2]= INT(A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN+X,1]  *  xWATER_INC[X_STP_FN+X]  /100)
        A_PRESS_N0[ L_PRESS,X_STPN,X_STP_FN+X,11]=INT(A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN+X,8]  *  xWATER_INC[X_STP_FN+X]  /100)
       NEXT
       CASE WEIGHT_TYPE[X_STP_FN]=3
       FOR X=0  TO 2
        A_PRESS_N0[ L_PRESS,X_STPN,X_STP_FN+X,2]= INT(A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN+X,1]  *  xWATER_INC[X_STP_FN+X]  /100 )
        A_PRESS_N0[ L_PRESS,X_STPN,X_STP_FN+X,11]=INT( A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN+X,8]  *  xWATER_INC[X_STP_FN+X]  /100)
       NEXT
       CASE WEIGHT_TYPE[X_STP_FN]=6
       FOR X=0  TO 3
        A_PRESS_N0[ L_PRESS,X_STPN,X_STP_FN+X,2]= INT(A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN+X,1]  *  xWATER_INC[X_STP_FN+X]  /100)
        A_PRESS_N0[ L_PRESS,X_STPN,X_STP_FN+X,11]=INT( A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN+X,8]  *  xWATER_INC[X_STP_FN+X]  /100)
       NEXT

       ENDCASE

   ELSE
    IF   X_STP_FN <= G_TOT
       RETU
    ENDIF
     STOT1=0
     STOT8=0
     FOR X=G_TOT+1    TO   GS_TOT
         STOT1 +=A_PRESS_N0[L_PRESS,X_STPN,X,1]
         STOT8 +=A_PRESS_N0[L_PRESS,X_STPN,X,8]
     NEXT
     PWATER_A=INT(-PWATER *  A_PRESS_N0[L_PRESS,X_STPN,X,5]/ RATVOL)
     IF STOR_F=0
        IF STOT1 >0
          W2=INT(PWATER_A *A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,1]/ STOT1)
        ENDIF
        IF STOT8 >0
          W11=INT(PWATER_A *A_PRESS_N0[L_PRESS,X_STPN,X_STP_FN,8]/ STOT8)
        ENDIF
        RETU
     ENDIF
     FOR  X=G_TOT +1  TO  GS_TOT
       A_PRESS_N0[ L_PRESS,X_STPN,X,2]=0
       A_PRESS_N0[ L_PRESS,X_STPN,X,11]=0
        IF STOT1 >0
          A_PRESS_N0[ L_PRESS,X_STPN,X,2]=INT(PWATER_A *A_PRESS_N0[L_PRESS,X_STPN,X,1]/ STOT1)
        ENDIF
        IF STOT8 >0
          A_PRESS_N0[ L_PRESS,X_STPN,X,11]=INT(PWATER_A *A_PRESS_N0[L_PRESS,X_STPN,X,8]/ STOT8)
        ENDIF
     NEXT
   ENDIF
RETU   0

FUNCTION  GET_RECIP_A
PARAMETERS  CHN
INDEX1=GET_DATA2(CHN,-1)
XRETU=0
FOR XLOOP=CHN TO CHN-INDEX1  STEP  -1
    XLOOPC=ALLTRIM(STR(XLOOP,2,0))
    IF XLOOP=CHN
      XRETU=A_PRESS_N0[L_PRESS,STPN&xloopc,xloop,1] + A_PRESS_N0[L_PRESS,STPN&xloopc,xloop,2]
    ELSE
      XRETU=XRETU + A_PRESS_N0[L_PRESS,STPN&xloopc,xloop,4]
    ENDIF
NEXT
RETU    XRETU


FUNCTION setArrowA 
PARAMETERS  WEITYPE,XSTP_FN,FLAG
IF FLAG=1
  DO CASE
  CASE WEITYPE=1
    if (temp_cal[4,stp_fn]=-1)
      DSPA_ARROW(STP_FN,1,14)  
      DSPA_ARROW(STP_FN+1,0,0)    
    elseif (temp_cal[4,stp_fn+1]=-1)
      DSPA_ARROW(STP_FN+1,1,14)  
      DSPA_ARROW(STP_FN,0,0)  
    else
      DSPA_ARROW(STP_FN+1,0,0)    
      DSPA_ARROW(STP_FN,0,0)  
    endif
  CASE WEITYPE=2
    if (temp_cal[4,stp_fn-1]=-1)
      DSPA_ARROW(STP_FN-1,1,14)  
      DSPA_ARROW(STP_FN,0,0)  
    elseif (temp_cal[4,stp_fn]=-1)
      DSPA_ARROW(STP_FN,1,14)  
      DSPA_ARROW(STP_FN-1,0,0)    
    else
      DSPA_ARROW(STP_FN-1,0,0)    
      DSPA_ARROW(STP_FN,0,0)  
    endif
  ENDCASE
ELSE
    DO CASE
    CASE WEITYPE=2
      DSPA_ARROW(XSTP_FN,0,0)  
      DSPA_ARROW(XSTP_FN-1,0,0)  
    ENDCASE
ENDIF

PROCEDURE  STP_ALL
PARAMETERS  STPA_NAME,STPA_STEP,P3
if (din(15)=0)
   retu
endif
STP_ZN=STPA_NAME-1
STP_FN=STPA_NAME
STP_FC=ALLTRIM(STR(STP_FN,2,0))
DO CASE
CASE (STPA_STEP=0)   .AND. (din(14)=1) .AND. (DIN(15)=1)    
  IF   ((WEIGHT_TYPE[STP_FN]=77) .OR.  (WEIGHT_TYPE[STP_FN]=1) .OR. (WEIGHT_TYPE[STP_FN]=3) .OR. (WEIGHT_TYPE[STP_FN]=6) .OR. (WEIGHT_TYPE[STP_FN]=10)    )  .AND. NEXTOK1=1
    IF (A_PRESS_n0[1,dima_len,STP_FN,1] =77)
       INDEX1=GET_DATA2(WEIGHT_TYPE[STP_FN],1)
       FOR  XLOOP=STP_FN  TO STP_FN +INDEX1
        if stp_a[xloop] <> 0
           retu
        endif
       NEXT
     a_copy_4(A_PRESS_N0,STP_FN,STP_FN+INDEX1)  
     NEXTOK1=0
     FOR  XLOOP=STP_FN  TO STP_FN +INDEX1
       A_PRESS_n0[1,dima_len,XLOOP,1] :=0
     NEXT
     STP_A[STPA_NAME]=1
     FOR IX=1 TO (GS_TOT+UWC_TOT)
       IF  A_PRESS_n0[1,dima_len,ix,1] =77
         NEXTOK1=1
       ENDIF
     NEXT
    ENDIF
  ENDIF
CASE (STPA_STEP=1)   .AND. (din(14)=1) .AND. (DIN(15)=1)    
  IF   ((WEIGHT_TYPE[STP_FN]=77) .OR.  (WEIGHT_TYPE[STP_FN]=1) .OR. (WEIGHT_TYPE[STP_FN]=3) .OR. (WEIGHT_TYPE[STP_FN]=6) .OR. (WEIGHT_TYPE[STP_FN]=10)    )
    INDEX1=GET_DATA2(WEIGHT_TYPE[STP_FN],1)
    FOR  XLOOP=STP_FN  TO STP_FN +INDEX1
      WTANK_F[XLOOP,1] :=77
    NEXT
    STP_A[STPA_NAME]=2
    RDDELAY[STP_FN,2] :=SECONDS()
    RDDELAY[STP_FN,3] :=0
  ENDIF
CASE STPA_STEP=2
  DRAF=0
  GS_CHG=0
  W2=0
  W11=0
  GET_WATER_ADJ(STP_FN,STPN&STP_FC,WATER_INPUT,1,W2,W11,@WATER_INC)
  DO CASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    DSP_RECIP(STP_FN,0)
    DO CASE
    CASE WEIGHT_TYPE[STP_FN]=77 .OR.  WEIGHT_TYPE[STP_FN]=2 .OR. WEIGHT_TYPE[STP_FN]=5 .OR. WEIGHT_TYPE[STP_FN]=9 .OR. WEIGHT_TYPE[STP_FN]=14
      STP_A[STP_FN]=3
    OTHERWISE
      STP_A[STPA_NAME]=0
      STP_A[STPA_NAME+1]=2
    ENDCASE
    WTANK_F[STP_FN,1] :=1
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]  :=0
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]  :=1
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    X=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]
    IF    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
      DSPDATA_A[STP_FN] := 1
    ELSE
      DSPDATA_A[STP_FN] := 0
    ENDIF
    ADJWN=0
    ADJWN_f=0



    DSP_RECIP(STP_FN,0)
    IF     ((WEIGHT_TYPE[STP_FN]<>77) .AND.  (WEIGHT_TYPE[STP_FN]<>2) .AND. (WEIGHT_TYPE[STP_FN]<>5) .AND. (WEIGHT_TYPE[STP_FN]<>9) .AND. (WEIGHT_TYPE[STP_FN]<>14)  )
       index1=0
       index1=GET_RECIP_A(STP_FN)
       RDDLY(STP_FN,A_M_NAME[STP_FN,8],INDEX1,2)
       XRD := RDDELAY[STP_FN,3]
       IF XRD<>0
        IF XRD=1
          XMC_F=A_M_NAME[STP_FN,3]
          EWN= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]
          DevPos( A_M_NAME[STP_FN,23], A_M_NAME[STP_FN,13] ) ; DevOutPict( EWN, "&XMC_F" )
          A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := EWN
          A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
          EWN= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] +A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
          EWN= EWN    * 2048/A_M_NAME[STP_FN,9]
          SETCHDATA(STP_ZN,EWN)
          STP_A[STPA_NAME]=3
          WTANK_F[STP_FN,1] :=1







        endif
        DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  
        RETU
       endif
    endif
    XMC_F=A_M_NAME[STP_FN,3]

    IF DSPDATA_A[STP_FN] =1
      DevPos( A_M_NAME[STP_FN,23], A_M_NAME[STP_FN,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11], "&XMC_F" )
      SetColor( "&C2    / &C1" )

      DSPA_ARROW(STP_FN,1,14)  
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)    
    endif
      SetColor( "&C10 / &C1" )

      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)    
      WEIG_RESCALL(STP_FN)
    DSP_RECIP(STP_FN,0)

    SetColor( "&C7 +/ &C1" )
    CLEACHMEM(STP_ZN)
    SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]  + A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]

    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])

    SETOK(STP_ZN)

    SetDigitOut(1,STP_ZN,1)
    SetDigitOut(2,A_M_NAME[STP_FN,8],0)
    STP_A[STPA_NAME]=3
    if (STP_FN>gs_tot + water_tot) .AND. (STP_FN < gs_tot + water_tot +c_tot+1)
      SetCout2(STP_FC,1)
    endif


    IF     mdirty_no[1] >0
      IF   stp_fn  = mdirty_no[1]
     mdirty_no[4]=-1
     mdirty_no[5]=0
      ENDIF
    ENDIF
  ENDCASE
CASE STPA_STEP=3







    IF     (stp_fn  <= gs_tot)


       W2_X=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
       W2=0
       W11=0
       GET_WATER_ADJ(STP_FN,STPN&STP_FC,WATER_INPUT,0,@W2,@W11,@WATER_INC)
       IF  W2  <> W2_X
         ADJW12(STP_ZN,(W2 -W2_X)*2048/A_M_NAME[STP_FN,10])
         A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=W2
         A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,11] :=W11
         XMC_F=A_M_NAME[STP_FN,3]
         IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0)
           DevPos( A_M_NAME[STP_FN,23], A_M_NAME[STP_FN,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +W11, "&XMC_F" )
         ENDIF
       ENDIF

    ENDIF
    IF     mdirty_no[1] >0
      IF   (stp_fn  = mdirty_no[1])
    DO CASE
    CASE  mdirty_no[5]=0   
      XDD1=INT((CHENDATA( mdirty_no[1]-1 ))*A_M_NAME[ mdirty_no[1],9 ]/PER/2048)
      if xdd1 >= mdirty_no[2]
        SetDigitOut(1,STP_ZN,0)
        mdirty_no[4]=SECONDS()
        mdirty_no[5]=1
        SetDigitOut(2,A_M_NAME[STP_FN,8],1)
        DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  
        RETU
      ENDIF
    CASE  mdirty_no[5]=1
      if ABS(SECONDS()-mdirty_no[4]) >= mdirty_no[3]
        SetDigitOut(1,STP_ZN,1)
        IF RDOK2(STP_ZN)=0
          SETOK(STP_ZN)
        ENDIF
        SetDigitOut(2,A_M_NAME[STP_FN,8],0)
        DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
        mdirty_no[5]=2
      ELSE
        RETU
      ENDIF
    ENDCASE
      ENDIF
    ENDIF



  IF RDOK2(STP_ZN)=0

    SetDigitOut(1,STP_ZN,0)
    SetCout2(STP_FC,0)

    STOPTM&STP_FC=0
    EWN=CHENDATA(STP_ZN)
    EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
    EW_CHK=EWN*A_M_NAME[STP_FN,9]/PER/2048



    XMC_F=A_M_NAME[STP_FN,3]
    SW1_TMP=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]  + A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
    xFlorTmp=PFLOR&STP_FC
    if      xFlorTmp < ERKG&STP_FC
       xFlorTmp = ERKG&STP_FC
    endif
    IF EW_CHK <(SW1_TMP -xFlorTmp)
      SetColor( "GR+    / &C1" )
      DevPos( A_M_NAME[STP_FN,23], A_M_NAME[STP_FN,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11], "&XMC_F" )
      SetColor( "&C2    / &C1" )

      DSPA_ARROW(STP_FN,1,14)  
      SETW1(STP_ZN,(SW1_TMP-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,9])
      SETW2(STP_ZN,(SW1_TMP-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,9])
      SETOK(STP_ZN)

      SetDigitOut(1,STP_ZN,1)
      SetDigitOut(2,A_M_NAME[STP_FN,8],0)
      RETU
    ENDIF





    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
    XMC_F=A_M_NAME[STP_FN,3]

    SetColor( "&C2 / &C1" )

    DSPA_ARROW(STP_FN,0,0)  
    SetColor( "&C7 +/ &C1" )
    INDEX1=GET_DATA2(WEIGHT_TYPE[STP_FN],-1)
    EWN=0
    FOR  XLOOP=STP_FN  TO (STP_FN- INDEX1)  STEP  -1
      EWN=EWN +CHENDATA(XLOOP-1)
      WTANK_F[STP_FN,1] :=1
    NEXT
    DO CASE
    CASE WEIGHT_TYPE[STP_FN]=77 .OR.  WEIGHT_TYPE[STP_FN]=2 .OR. WEIGHT_TYPE[STP_FN]=5 .OR. WEIGHT_TYPE[STP_FN]=9 .OR. WEIGHT_TYPE[STP_FN]=14
      STP_A[STPA_NAME]=4
    OTHERWISE
      SETDLA(A_M_NAME[STP_FN,8],EWN)
      STP_A[STPA_NAME]=0
      STP_A[STPA_NAME+1]=2
    ENDCASE

  ENDIF
  TIME1[A_M_NAME[STP_FN,8]+1,2] :=0
CASE STPA_STEP=4  .AND.  (WTANK_F[STP_FN,1]=-99)
    STP_A[STPA_NAME]=41
    INDEX1=GET_DATA2(WEIGHT_TYPE[STP_FN],-2)
    FOR  XLOOP=STP_FN  TO (STP_FN- INDEX1)  STEP  -1
      WTANK_F[XLOOP,1] :=-98  

    NEXT

CASE STPA_STEP=41
  if stp_fn > gs_tot
     IF ( DIN(9)=1 )   .OR.  ( DIN(12)=0)
       RETU
     ENDIF
  else
    IF KOT=1
      IF ( DIN(9)=1 )    .OR.  ( DIN(12)=0)
    RETU
      ENDIF
    ELSE
      IF ( DIN(8)=1) .OR. (DIN(11)=0)
    RETU
      ENDIF
    ENDIF
  endif
  IF  TIME1[A_M_NAME[STP_FN,8]+1,2] =0
    TIME1[A_M_NAME[STP_FN,8]+1,2] :=SECONDS()
  ENDIF
  IF ABS(SECONDS()-TIME1[A_M_NAME[STP_FN,8]+1,2]) >=TIME1[A_M_NAME[STP_FN,8]+1,1]
    TIME1[A_M_NAME[STP_FN,8]+1,2] :=0
    STP_A[STPA_NAME]=5
  ENDIF
  if ( stp_fn <=gs_tot )
    IF GS_DROPOK(A_M_NAME[STP_FN,8] +1)<> 1
      IF SPACIAL_0=0
    STP_A[STPA_NAME]=41
      ENDIF
    ENDIF
  ENDIF
CASE STPA_STEP=5
  if GS_DROP[A_M_NAME[STP_FN,8] +1,1] >100
    GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=3
  else
    GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=2
  endif

  INDEX1=GET_DATA2(WEIGHT_TYPE[STP_FN],-2)
  EWN=0
  FOR  XLOOP=STP_FN  TO (STP_FN- INDEX1)  STEP    -1
    WTANK_F[XLOOP,1] :=66  
    WTANK_F[XLOOP,2] :=0  
  NEXT
  STP_A[STPA_NAME]=6
  dsp_e=get_dspb(STP_FN,WEIGHT_TYPE[STP_FN])
  IF DSP_E=1
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  
  ENDIF
    if    (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0) .OR.   (WEIGHT_TYPE[STP_FN]=2) .OR. (WEIGHT_TYPE[STP_FN]=5) .OR. (WEIGHT_TYPE[STP_FN]=9) .OR. (WEIGHT_TYPE[STP_FN]=14)
      SetColor( "&C11 / &C1" )


      xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))







      SETZERTM(A_M_NAME[STP_FN,8],PZERTM[A_M_NAME[STP_FN,8]+1])
      SETZEROK(A_M_NAME[STP_FN,8])

      SetDigitOut(2,A_M_NAME[STP_FN,8],1)
  ENDIF
  if ( stp_fn <=gs_tot )
    SANDCUTW[A_M_NAME[STP_FN,8]+1,2] := 0
  endif
CASE STPA_STEP=6
  JMPF=0
  JMPF=JMP_E(STP_FN,WEIGHT_TYPE[STP_FN])
  IF JMPF=0





    ELSE
    setZokn(A_M_NAME[STP_FN,8],0)
    ENDIF
    IF     ( stp_fn <=gs_tot )
      IF (SANDCUTW[A_M_NAME[STP_FN,8]+1,1] >0)
    IF  ( SANDCUTW[A_M_NAME[STP_FN,8]+1,2] =0 )
      X=INT((WDATA(A_M_NAME[STP_FN,8])-2048)*A_M_NAME[A_M_NAME[STP_FN,8]+1,6]/PER/2048)
        IF X <= SANDCUTW[A_M_NAME[STP_FN,8]+1,1]

          SetDigitOut(2,A_M_NAME[STP_FN,8],0)
          GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=3
          SANDCUTW[A_M_NAME[STP_FN,8]+1,2] := 1
          RETU
        ENDIF
      ELSE
        xlast= CHK_LASTOUT()
        xlast=xlast -WSCALE_type[A_M_NAME[STP_FN,8]+1]
        IF XLAST >0
          RETU
        ENDIF
        SANDCUTW[A_M_NAME[STP_FN,8]+1,2] := 1
        IF    RDZEROK(A_M_NAME[STP_FN,8])<>0

          SetDigitOut(2,A_M_NAME[STP_FN,8],1)
        endif
      ENDIF
    ENDIF
     ENDIF
  IF  RDZEROK(A_M_NAME[STP_FN,8])=0
     SetColor( "&C2 / &C1" )

     DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
     SetColor( "&C7 +/ &C1" )

    SetDigitOut(2,A_M_NAME[STP_FN,8],0)
    INDEX1=GET_DATA2(STP_FN,-1)

    if stp_fn >gs_tot  .AND.   KOT=0  
      x_stor=4
    else
      x_stor=3
    endif
    IF PNT_REMAIN=1
      XREM=GET_REMAINS(STP_FN,STPN&STP_FC,INDEX1,@A_PRESS_N0,x_stor)
    ENDIF

    STP_A[STPA_NAME]=7
    setdla(A_M_NAME[STP_FN,8],0)
    stpn_old=stpn&stp_fc
    FOR XLOOP=stp_fn TO stp_fn-INDEX1  STEP  -1
      XLOOPC=ALLTRIM(STR(XLOOP,2,0))
      XMC_F=A_M_NAME[xloop,3]
      DevPos( A_M_NAME[XLOOP,23], A_M_NAME[XLOOP,13] ) ; DevOutPict( "     ", "&XMC_F" )
      A_M_NAME[XLOOP,10] := A_M_NAME[XLOOP,9]
      A_M_NAME[XLOOP,12] := A_M_NAME[XLOOP,6]
      CLEACHMEM(XLOOP-1)
      STPN&XLOOPC=STPN&xLOOPC+1
      WTANK_F[xloop,1] :=0
      WTANK_F[xloop,2] :=1    
    NEXT
    if    stp_fn    >gs_tot

      X_LAST=CHK_LAST_DROP(0)

      IF X_LAST=1
    IF PNT_REMAIN=1
       if  KOT=0  
         x_stor=4
       else
         x_stor=3
       endif

       hTOTWACT :=ARRAy(15)
       afill(hTOTWACT,0)

       pnt_remains(x_stor,STPN_OLD,A_PRESS_N0,0,1,hTOTWACT)
    ENDIF
      ENDIF
    endif
  ENDIF
CASE STPA_STEP=7
  if ( stp_fn <=gs_tot )
    if kot=0
      SET_LAST_PCS(STP_FN,A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5],0)
    endif
    GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=1
    GS_DROPRST()
  endif
  INDEX1=GET_DATA2(STP_FN,-1)
  STP_A[STPA_NAME]=0



  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
    STP_A[STPA_NAME-INDEX1]=1
  ELSE
    FOR XLOOP=stp_fn TO stp_fn-INDEX1  STEP  -1
      XLOOPC=ALLTRIM(STR(XLOOP,2,0))
      STPN&XLOOPC=1
       WTANK_F[XLOOP,3] :=1
    NEXT
    if kot=1
      SET_LAST_PCS(1,1,0)
    endif
  ENDIF
ENDCASE
RETU



PROCEDURE  STP_ALL_AE
PARAMETERS  STPA_NAME,STPA_STEP,P3
if (din(15)=0)
   retu
endif
STP_ZN=STPA_NAME-1
STP_FN=STPA_NAME
STP_FC=ALLTRIM(STR(STP_FN,2,0))
DO CASE
CASE (STPA_STEP=0)   .AND. (din(14)=1) .AND. (DIN(15)=1)    
  IF   ((WEIGHT_TYPE[STP_FN]=77) .OR.  (WEIGHT_TYPE[STP_FN]=1) .OR. (WEIGHT_TYPE[STP_FN]=3) .OR. (WEIGHT_TYPE[STP_FN]=6) .OR. (WEIGHT_TYPE[STP_FN]=10)    )  .AND. NEXTOK1=1
    IF (A_PRESS_n0[1,dima_len,STP_FN,1] =77)
       INDEX1=GET_DATA2(WEIGHT_TYPE[STP_FN],1)
       FOR  XLOOP=STP_FN  TO STP_FN +INDEX1
        if stp_a[xloop] <> 0
           retu
        endif
       NEXT
     a_copy_4(A_PRESS_N0,STP_FN,STP_FN+INDEX1)  
     NEXTOK1=0
     FOR  XLOOP=STP_FN  TO STP_FN +INDEX1
       A_PRESS_n0[1,dima_len,XLOOP,1] :=0
     NEXT
     STP_A[STPA_NAME]=1
     FOR IX=1 TO (GS_TOT+UWC_TOT)
       IF  A_PRESS_n0[1,dima_len,ix,1] =77
         NEXTOK1=1
       ENDIF
     NEXT
    ENDIF
  ENDIF
CASE (STPA_STEP=1)   .AND. (din(14)=1) .AND. (DIN(15)=1)    
  IF   ((WEIGHT_TYPE[STP_FN]=77) .OR.  (WEIGHT_TYPE[STP_FN]=1) .OR. (WEIGHT_TYPE[STP_FN]=3) .OR. (WEIGHT_TYPE[STP_FN]=6) .OR. (WEIGHT_TYPE[STP_FN]=10)    )
    INDEX1=GET_DATA2(WEIGHT_TYPE[STP_FN],1)
    FOR  XLOOP=STP_FN  TO STP_FN +INDEX1
      WTANK_F[XLOOP,1] :=77
    NEXT
    STP_A[STPA_NAME]=2
    RDDELAY[STP_FN,2] :=SECONDS()
    RDDELAY[STP_FN,3] :=0
  ENDIF
CASE STPA_STEP=2
  dsp_e=get_dspb(STP_FN,WEIGHT_TYPE[STP_FN])
  DSP_E=1
  DSPB_FMK(A_M_NAME[STP_FN,8]+1,dsp_e)    
  DRAF=0
  GS_CHG=0
  DO CASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    DSP_RECIP(STP_FN,0)
    DO CASE
    CASE WEIGHT_TYPE[STP_FN]=77 .OR.  WEIGHT_TYPE[STP_FN]=2 .OR. WEIGHT_TYPE[STP_FN]=5 .OR. WEIGHT_TYPE[STP_FN]=9 .OR. WEIGHT_TYPE[STP_FN]=14
      STP_A[STP_FN]=3
    OTHERWISE
      STP_A[STPA_NAME]=0
      STP_A[STPA_NAME+1]=2
    ENDCASE
    WTANK_F[STP_FN,1] :=1
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]  :=0
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]  :=1
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    X=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]
    IF    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
      DSPDATA_A[STP_FN] := 1
    ELSE
      DSPDATA_A[STP_FN] := 0
    ENDIF
    ADJWN=0
    ADJWN_f=0
    W2=0
    W11=0


    DSP_RECIP(STP_FN,0)
    IF     ((WEIGHT_TYPE[STP_FN]<>77) .AND.  (WEIGHT_TYPE[STP_FN]<>2) .AND. (WEIGHT_TYPE[STP_FN]<>5) .AND. (WEIGHT_TYPE[STP_FN]<>9) .AND. (WEIGHT_TYPE[STP_FN]<>14)  )
       index1=0
       index1=GET_RECIP_A(STP_FN)
       RDDLY(STP_FN,A_M_NAME[STP_FN,8],INDEX1,2)
       XRD := RDDELAY[STP_FN,3]
       IF XRD<>0
        IF XRD=1
          XMC_F=A_M_NAME[STP_FN,3]
          EWN= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]
          DevPos( A_M_NAME[STP_FN,23], A_M_NAME[STP_FN,13] ) ; DevOutPict( EWN, "&XMC_F" )
          A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := EWN
          A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
          EWN= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] +A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
          EWN= EWN    * 2048/A_M_NAME[STP_FN,10]
          SETCHDATA(STP_ZN,EWN)
          STP_A[STPA_NAME]=3
          WTANK_F[STP_FN,1] :=1










        endif

        RETU
       endif
    endif
    XMC_F=A_M_NAME[STP_FN,3]

    IF DSPDATA_A[STP_FN] =1
      DevPos( A_M_NAME[STP_FN,23], A_M_NAME[STP_FN,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ ADJWN_f, "&XMC_F" )
      SetColor( "&C2    / &C1" )

      DSPA_ARROW(STP_FN,1,14)  

    endif
      SetColor( "&C10 / &C1" )


      WEIG_RESCALL(STP_FN)
    DSP_RECIP(STP_FN,0)
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
    SetColor( "&C7 +/ &C1" )
    CLEACHMEM(STP_ZN)
    SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]  + ADJWN
    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETOK(STP_ZN)

    SetDigitOut(1,STP_ZN,1)
    SetDigitOut(2,A_M_NAME[STP_FN,8],0)
    STP_A[STPA_NAME]=3
  ENDCASE
CASE STPA_STEP=3





  IF RDOK2(STP_ZN)=0

    SetDigitOut(1,STP_ZN,0)
    STOPTM&STP_FC=0
    EWN=CHENDATA(STP_ZN)
    EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1*100)/100
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
    XMC_F=A_M_NAME[STP_FN,3]

    SetColor( "&C2 / &C1" )

    DSPA_ARROW(STP_FN,0,0)  
    SetColor( "&C7 +/ &C1" )
    INDEX1=GET_DATA2(WEIGHT_TYPE[STP_FN],-1)
    EWN=0
    FOR  XLOOP=STP_FN  TO (STP_FN- INDEX1)  STEP  -1
      EWN=EWN +CHENDATA(XLOOP-1)
      WTANK_F[STP_FN,1] :=1
    NEXT
    DO CASE
    CASE WEIGHT_TYPE[STP_FN]=77 .OR.  WEIGHT_TYPE[STP_FN]=2 .OR. WEIGHT_TYPE[STP_FN]=5 .OR. WEIGHT_TYPE[STP_FN]=9 .OR. WEIGHT_TYPE[STP_FN]=14
      STP_A[STPA_NAME]=4
    OTHERWISE
      SETDLA(A_M_NAME[STP_FN,8],EWN)
      STP_A[STPA_NAME]=0
      STP_A[STPA_NAME+1]=2
    ENDCASE
  ENDIF
CASE STPA_STEP=4  .AND.   ((WTANK_F[STP_FN,1]=-99    .AND. DIN(9)=0  ) .OR. TIME1[STP_FN,1]=88    )   .AND. DIN(12)=1

    IF ( DIN(9)=1  .AND. TIME1[STP_FN,1] <>88  )   .OR.  ( DIN(12)=0)
      RETU
    ENDIF
  if TIME1[A_M_NAME[STP_FN,8]+1,1]=88  
    TIME1[A_M_NAME[STP_FN,8]+1,2] :=0
    STP_A[STPA_NAME]=5
  ELSE
    IF    TIME1[A_M_NAME[STP_FN,8]+1,2] =0
      TIME1[A_M_NAME[STP_FN,8]+1,2] :=SECONDS()
    ENDIF
    IF ABS(SECONDS()-TIME1[A_M_NAME[STP_FN,8]+1,2]) >=TIME1[A_M_NAME[STP_FN,8]+1,1]
      TIME1[A_M_NAME[STP_FN,8]+1,2] :=0
      STP_A[STPA_NAME]=5
    ENDIF
  ENDIF
CASE STPA_STEP=5
  INDEX1=GET_DATA2(WEIGHT_TYPE[STP_FN],-2)
  EWN=0
  FOR  XLOOP=STP_FN  TO (STP_FN- INDEX1)  STEP    -1
    WTANK_F[XLOOP,1] :=66  
    WTANK_F[XLOOP,2] :=0  
  NEXT
  STP_A[STPA_NAME]=6
  dsp_e=get_dspb(STP_FN,WEIGHT_TYPE[STP_FN])
  IF DSP_E=1
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  
  ENDIF
    if    (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0) .OR.   (WEIGHT_TYPE[STP_FN]=2) .OR. (WEIGHT_TYPE[STP_FN]=5) .OR. (WEIGHT_TYPE[STP_FN]=9) .OR. (WEIGHT_TYPE[STP_FN]=14)
      SetColor( "&C11 / &C1" )


      xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))






      y= A_M_NAME[A_M_NAME[STP_FN,8]+1,6]
      x=x/y

      SETZERTM(A_M_NAME[STP_FN,8],PZERTM[A_M_NAME[STP_FN,8]+1])
      SETZEROK(A_M_NAME[STP_FN,8])

      SetDigitOut(2,A_M_NAME[STP_FN,8],1)
  ENDIF
CASE STPA_STEP=6
  JMPF=0
  IF JMPF=0





    ELSE
    setZokn(A_M_NAME[STP_FN,8],0)
    ENDIF
  IF  RDZEROK(A_M_NAME[STP_FN,8])=0
     SetColor( "&C2 / &C1" )

     DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
     SetColor( "&C7 +/ &C1" )

    SetDigitOut(2,A_M_NAME[STP_FN,8],0)
    INDEX1=GET_DATA2(STP_FN,-1)

    IF PNT_REMAIN=1  .AND.  TIME1[STP_FN,1] <>88
       if  KOT=0  
     x_stor=4
       else
     x_stor=3
       endif



       XREM=GET_REMAINS(STP_FN,STPN&STP_FC,INDEX1,@A_PRESS_N0,x_stor ) 
    ENDIF

    STP_A[STPA_NAME]=7
    setdla(A_M_NAME[STP_FN,8],0)
    stpn_old=stpn&stp_fc
    FOR XLOOP=stp_fn TO stp_fn-INDEX1  STEP  -1
    XLOOPC=ALLTRIM(STR(XLOOP,2,0))
    XMC_F=A_M_NAME[xloop,3]
    DevPos( A_M_NAME[XLOOP,23], A_M_NAME[XLOOP,13] ) ; DevOutPict( "     ", "&XMC_F" )
      A_M_NAME[XLOOP,10] := A_M_NAME[XLOOP,9]
      A_M_NAME[XLOOP,12] := A_M_NAME[XLOOP,6]
      CLEACHMEM(XLOOP-1)
      STPN&XLOOPC=STPN&xLOOPC+1
      WTANK_F[xloop,1] :=0
      WTANK_F[xloop,2] :=1
    NEXT

    X_LAST=CHK_LAST_DROP(0)

    IF X_LAST=1
      IF PNT_REMAIN=1     .AND.    TIME1[STP_FN,1] <>88
     hTOTWACT :=ARRAy(15)
     for  xlpa=1  to  15
          hTOTWACT[xlpa]=0
     next
     if  KOT=0  
       x_stor=4
     else
       x_stor=3
     endif


     pnt_remains(x_stor,STPN_OLD,A_PRESS_N0,0,1,hTOTWACT)
      ENDIF
    ENDIF





  ENDIF
CASE STPA_STEP=7 .AND.    (WTANK_F[STP_FN,1] =2  .OR. TIME1[STP_FN,1] <>88  )
    if kot=0
      SET_LAST_PCS(STP_FN,A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5],0)
  endif
  INDEX1=GET_DATA2(STP_FN,-1)
  STP_A[STPA_NAME]=0



  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
    STP_A[STPA_NAME-INDEX1]=1
  ELSE
    FOR XLOOP=stp_fn TO stp_fn-INDEX1  STEP  -1
      XLOOPC=ALLTRIM(STR(XLOOP,2,0))
      STPN&XLOOPC=1
      WTANK_F[XLOOP,3] :=1
    NEXT
    if kot=1
      SET_LAST_PCS(1,1,0)
    endif
  ENDIF
ENDCASE
RETU


FUNCTION      get_dspb
PARAMETERS  X_STP_FN,X_WEIGHT_TYPE
RETUN=0
   DO  CASE
   CASE  X_WEIGHT_TYPE =77
       IF   A_PRESS_N0[2,1,X_STP_FN,8] >0
     RETUN=1
       ENDIF
   CASE  X_WEIGHT_TYPE =2
      IF  ( A_PRESS_N0[2,1,X_STP_FN,8] >0 )   .OR.  ( A_PRESS_N0[2,1,X_STP_FN-1,8] >0 )
    RETUN=1
      ENDIF
   CASE  X_WEIGHT_TYPE =5
      IF  ( A_PRESS_N0[2,1,X_STP_FN,8] >0 )   .OR.  ( A_PRESS_N0[2,1,X_STP_FN-1,8] >0 )    .OR.  ( A_PRESS_N0[2,1,X_STP_FN-2,8] >0 )
    RETUN=1
      ENDIF
   CASE  X_WEIGHT_TYPE =9
      IF  ( A_PRESS_N0[2,1,X_STP_FN,8] >0 )   .OR.  ( A_PRESS_N0[2,1,X_STP_FN-1,8] >0 )    .OR.  ( A_PRESS_N0[2,1,X_STP_FN-2,8] >0 )    .OR.  ( A_PRESS_N0[2,1,X_STP_FN-3,8] >0 )
    RETUN=1
      ENDIF

   ENDCASE
RETU   RETUN

FUNCTION      JMP_E
PARAMETERS  X_STP_FN,X_WEIGHT_TYPE
RETUN=0
   DO  CASE
   CASE  X_WEIGHT_TYPE =77
       IF   A_PRESS_N0[2,1,X_STP_FN,1] =0
     RETUN=1
       ENDIF
   CASE  X_WEIGHT_TYPE =2
      IF  ( A_PRESS_N0[2,1,X_STP_FN,1] =0 )  .AND.  ( A_PRESS_N0[2,1,X_STP_FN-1,1]=0)
    RETUN=1
      ENDIF
   CASE  X_WEIGHT_TYPE =5
      IF  ( A_PRESS_N0[2,1,X_STP_FN,8]=0 ) .AND.  ( A_PRESS_N0[2,1,X_STP_FN-1,1]=0)    .AND.  ( A_PRESS_N0[2,1,X_STP_FN-2,1]=0)
    RETUN=1
      ENDIF
   ENDCASE
RETU   RETUN


PROCEDURE  STP_ALL_W
PARAMETERS  STPA_NAME,STPA_STEP,P3
if (din(15)=0)
   retu
endif
STP_ZN=STPA_NAME-1
STP_FN=STPA_NAME
STP_FC=ALLTRIM(STR(STP_FN,2,0))
SH_W_ADJ2(STPN&STP_FC,WATER_INPUT)
DO CASE
CASE (STPA_STEP=0)   .AND. (din(14)=1) .AND. (DIN(15)=1)    
  IF   ((WEIGHT_TYPE[STP_FN]=77) .OR.  (WEIGHT_TYPE[STP_FN]=1) .OR. (WEIGHT_TYPE[STP_FN]=3) .OR. (WEIGHT_TYPE[STP_FN]=6) .OR. (WEIGHT_TYPE[STP_FN]=10)    )  .AND. NEXTOK1=1
    IF (A_PRESS_n0[1,dima_len,STP_FN,1] =77)
       INDEX1=GET_DATA2(WEIGHT_TYPE[STP_FN],1)
       FOR  XLOOP=STP_FN  TO STP_FN +INDEX1
        if stp_a[xloop] <> 0
           retu
        endif
       NEXT
     a_copy_4(A_PRESS_N0,STP_FN,STP_FN+INDEX1)  



     NEXTOK1=0
     FOR  XLOOP=STP_FN  TO STP_FN +INDEX1
       A_PRESS_n0[1,dima_len,XLOOP,1] :=0
     NEXT
     STP_A[STPA_NAME]=1
     FOR IX=1 TO (GS_TOT+UWC_TOT)
       IF  A_PRESS_n0[1,dima_len,ix,1] =77
         NEXTOK1=1
       ENDIF
     NEXT
    ENDIF
  ENDIF
CASE (STPA_STEP=1)   .AND. (din(14)=1) .AND. (DIN(15)=1)    
  IF   ((WEIGHT_TYPE[STP_FN]=77) .OR.  (WEIGHT_TYPE[STP_FN]=1) .OR. (WEIGHT_TYPE[STP_FN]=3) .OR. (WEIGHT_TYPE[STP_FN]=6) .OR. (WEIGHT_TYPE[STP_FN]=10)    )
    INDEX1=GET_DATA2(WEIGHT_TYPE[STP_FN],1)
    FOR  XLOOP=STP_FN  TO STP_FN +INDEX1
      WTANK_F[XLOOP,1] :=77
    NEXT
    STP_A[STPA_NAME]=2
    RDDELAY[STP_FN,2] :=SECONDS()
    RDDELAY[STP_FN,3] :=0
  ENDIF
CASE STPA_STEP=2
  DRAF=0
  GS_CHG=0
  W_LOWLEVEL[STP_FN-GS_TOT]=0
  DO CASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] =0 )





    DSP_RECIP(STP_FN,0)
    DO CASE
    CASE WEIGHT_TYPE[STP_FN]=77 .OR.  WEIGHT_TYPE[STP_FN]=2 .OR. WEIGHT_TYPE[STP_FN]=5 .OR. WEIGHT_TYPE[STP_FN]=9 .OR. WEIGHT_TYPE[STP_FN]=14
      STP_A[STP_FN]=3
    OTHERWISE
      STP_A[STPA_NAME]=0
      STP_A[STPA_NAME+1]=2
    ENDCASE
    WTANK_F[STP_FN,1] :=1
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]  :=0
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]  :=1
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    X=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]
    IF    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
      DSPDATA_A[STP_FN] := 1
    ELSE
      DSPDATA_A[STP_FN] := 0
    ENDIF
    ADJWN=0
    ADJWN_f=0
    W2=0
    W11=0
    GET_W_ADJ2(STP_FN,STPN&STP_FC,WATER_INPUT,1,@W2,@W11)
    DSP_RECIP(STP_FN,0)
    IF     ((WEIGHT_TYPE[STP_FN]<>77) .AND.  (WEIGHT_TYPE[STP_FN]<>2) .AND. (WEIGHT_TYPE[STP_FN]<>5) .AND. (WEIGHT_TYPE[STP_FN]<>9) .AND. (WEIGHT_TYPE[STP_FN]<>14)  )
       index1=0
       index1=GET_RECIP_A(STP_FN)
       RDDLY(STP_FN,A_M_NAME[STP_FN,8],INDEX1,2)
       XRD := RDDELAY[STP_FN,3]
       IF XRD<>0
        IF XRD=1
          XMC_F=A_M_NAME[STP_FN,3]
          EWN= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]
          DevPos( A_M_NAME[STP_FN,23], A_M_NAME[STP_FN,13] ) ; DevOutPict( EWN, "&XMC_F" )
          A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := EWN
          A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
          EWN= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] +A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
          EWN= EWN    * 2048/A_M_NAME[STP_FN,10]
          SETCHDATA(STP_ZN,EWN)




          SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]  + A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
          W_LOWLEVEL[STP_FN-GS_TOT]=(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10]  
          if W_LOWLEVEL[STP_FN-GS_TOT] < 0
        W_LOWLEVEL[STP_FN-GS_TOT] = 0
          endif

          STP_A[STPA_NAME]=3
          WTANK_F[STP_FN,1] :=1











        endif
        DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  
        RETU
       endif
    endif
    XMC_F=A_M_NAME[STP_FN,3]

    IF DSPDATA_A[STP_FN] =1
      DevPos( A_M_NAME[STP_FN,23], A_M_NAME[STP_FN,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11], "&XMC_F" )
      SetColor( "&C2    / &C1" )

      DSPA_ARROW(STP_FN,1,14)  
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)    
    endif
      SetColor( "&C10 / &C1" )

      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)    
      WEIG_RESCALL(STP_FN)
    DSP_RECIP(STP_FN,0)

    SetColor( "&C7 +/ &C1" )










    CLEACHMEM(STP_ZN)
    SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]  + A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]












    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    W_LOWLEVEL[STP_FN-GS_TOT]=(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10]  
    SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETOK(STP_ZN)

    SetDigitOut(1,STP_ZN,1)
    SetDigitOut(2,A_M_NAME[STP_FN,8],0)
    STP_A[STPA_NAME]=3
  ENDCASE
CASE STPA_STEP=3





  _last=chk_dnlast(A_PRESS_N0,U_PRESS,STPN&STP_FC,STP_FN,cnvstp)  
  TMPDATA=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
  if _last=0
    W2=0
    W11=0
    GET_W_ADJ2(STP_FN,STPN&STP_FC,WATER_INPUT,0,@W2,@W11)
    IF  W2    <> TMPDATA
      XWADJTMP=(W2 -TMPDATA)*2048/A_M_NAME[STP_FN,10]


      ADJW12(STP_ZN,XWADJTMP)
      IF  W_LOWLEVEL[STP_FN-GS_TOT] >0
        W_LOWLEVEL[STP_FN-GS_TOT]=W_LOWLEVEL[STP_FN-GS_TOT]+XWADJTMP
      ENDIF

      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=W2
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,11] :=W11
      XMC_F=A_M_NAME[STP_FN,3]
      IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0)
        DevPos( A_M_NAME[STP_FN,23], A_M_NAME[STP_FN,13] ) ; DevOutPict( A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +W11, "&XMC_F" )
      ENDIF
    ENDIF
  endif
  IF  WATER_INPUT=1
    SetColor( "W+  / &C1" )
    if dspe_mixamp=1
      DevPos( 17, 71 ) ; DevOutPict( PWATER, "9999" )
    endif
  ENDIF



  SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]    + A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
  EWN=CHENDATA(STP_ZN)
  EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
  W_LOWLEVEL[STP_FN-GS_TOT]=(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10]    
  if W_LOWLEVEL[STP_FN-GS_TOT] < 0
    W_LOWLEVEL[STP_FN-GS_TOT] = 0
  endif


  IF RDOK2(STP_ZN)=1
    xFlorTmp=PFLOR&STP_FC
    if    xFlorTmp > ERKG&STP_FC
       xFlorTmp = ERKG&STP_FC
    endif
    IF    EW1  > sw1-xFlorTmp
      SetDigitOut(1,STP_ZN,0)



    ENDIF
  enDif


  IF RDOK2(STP_ZN)=0

    SetDigitOut(1,STP_ZN,0)
    if waste=1
      SetDigitOut(2,13,0)
    endif
    STOPTM&STP_FC=0
    EWN=CHENDATA(STP_ZN)
    EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
    XMC_F=A_M_NAME[STP_FN,3]

    SetColor( "&C2 / &C1" )

    DSPA_ARROW(STP_FN,0,0)  
    SetColor( "&C7 +/ &C1" )
    INDEX1=GET_DATA2(WEIGHT_TYPE[STP_FN],-1)
    EWN=0
    FOR  XLOOP=STP_FN  TO (STP_FN- INDEX1)  STEP  -1
      EWN=EWN +CHENDATA(XLOOP-1)
      WTANK_F[STP_FN,1] :=1
    NEXT
    DO CASE
    CASE WEIGHT_TYPE[STP_FN]=77 .OR.  WEIGHT_TYPE[STP_FN]=2 .OR. WEIGHT_TYPE[STP_FN]=5 .OR. WEIGHT_TYPE[STP_FN]=9 .OR. WEIGHT_TYPE[STP_FN]=14
      STP_A[STPA_NAME]=4
    OTHERWISE
      SETDLA(A_M_NAME[STP_FN,8] ,EWN)
      STP_A[STPA_NAME]=0
      STP_A[STPA_NAME+1]=2
    ENDCASE
  ENDIF
  TIME1[A_M_NAME[STP_FN,8]+1,2] :=0
  waterlow[STP_FN-GS_TOT]=0

CASE STPA_STEP=4
   xwch=val(water_out_no)
   xwaterset=0
   SetDigitOut(2,A_M_NAME[STP_FN,8],0)
   if  (autoin_w <> -1 )
     if   W_LOWLEVEL[xwch-GS_TOT] >0   
       xwaterset=1
     elSe
       if   weight_type[STP_FN]=2
        if    xwch <> STP_FN
          xwch= STP_FN
        else
          xwch= STP_FN -1
        endif
        if     W_LOWLEVEL[xwch-GS_TOT] >0   
          xwaterset=1
        endif
       endif
     endif
   endif




  if  xwaterset=1
    if    ReChk_WFull(xwch,STP_FN)<0
      retu
    endif
  endif
 if  (WTANK_F[STP_FN,1]<>-99)
    return
 endif
  water_off=0
    IF ( DIN(9)=1 )   .OR.  ( DIN(12)=0)
      RETU
    ENDIF
  IF  TIME1[A_M_NAME[STP_FN,8]+1,2] =0
    TIME1[A_M_NAME[STP_FN,8]+1,2] :=SECONDS()
  ENDIF
  IF ABS(SECONDS()-TIME1[A_M_NAME[STP_FN,8]+1,2]) >=TIME1[A_M_NAME[STP_FN,8]+1,1]
    TIME1[A_M_NAME[STP_FN,8]+1,2] :=0
    STP_A[STPA_NAME]=5
  ENDIF
CASE STPA_STEP=5
  SETOKn(STP_ZN,0)
  SetDigitOut(2,A_M_NAME[STP_FN,8],0)
  SetDigitOut(1,STP_ZN,0)
  if weight_type[STP_ZN]=2
    SETOKn(STP_ZN-1,0)
    SetDigitOut(1,STP_ZN-1,0)
  endif
  water_off=0

  INDEX1=GET_DATA2(WEIGHT_TYPE[STP_FN],-2)
  EWN=0
  FOR  XLOOP=STP_FN  TO (STP_FN- INDEX1)  STEP    -1
    WTANK_F[XLOOP,1] :=66  
    WTANK_F[XLOOP,2] :=0  
  NEXT
  STP_A[STPA_NAME]=6
  dsp_e=get_dspb(STP_FN,WEIGHT_TYPE[STP_FN])
  IF DSP_E=1
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  
  ENDIF
    if    (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0) .OR.   (WEIGHT_TYPE[STP_FN]=2) .OR. (WEIGHT_TYPE[STP_FN]=5) .OR. (WEIGHT_TYPE[STP_FN]=9) .OR. (WEIGHT_TYPE[STP_FN]=14)
      SetColor( "&C11 / &C1" )


      xc=alltrim(str(A_M_NAME[STP_FN,8] + 1,2,0))





      SETZERTM(A_M_NAME[STP_FN,8],PZERTM[A_M_NAME[STP_FN,8]+1])
      SETZEROK(A_M_NAME[STP_FN,8])

      SetDigitOut(2,A_M_NAME[STP_FN,8],1)
  ENDIF
  SANDCUTW[A_M_NAME[STP_FN,8]+1,2] := 0
CASE STPA_STEP=6
  JMPF=0
  JMPF=JMP_E(STP_FN,WEIGHT_TYPE[STP_FN])
  if (water_off=1)
    JMPF=1
  endif
    water_off=0
  IF JMPF=0





    ELSE
    setZokn(A_M_NAME[STP_FN,8],0)
    ENDIF
  IF  RDZEROK(A_M_NAME[STP_FN,8])=0
     SetColor( "&C2 / &C1" )

     DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
     SetColor( "&C7 +/ &C1" )

    SetDigitOut(2,A_M_NAME[STP_FN,8],0)
    INDEX1=GET_DATA2(STP_FN,-1)

    IF PNT_REMAIN=1
       if  KOT=0  
     x_stor=4
       else
     x_stor=3
       endif

       XREM=GET_REMAINS(STP_FN,STPN&STP_FC,INDEX1,@A_PRESS_N0,x_stor)    
       for xstp=gs_tot+water_tot+c_tot+1  to gs_tot+uwc_tot
     IF PNT_REMAIN=1  .AND.  TIME1[xstp,1] =88
       if KOT=0  
         x_stor=4
       else
         x_stor=3
       endif

       INDEX1=GET_DATA2(xstp,-1)
       XREM=GET_REMAINS(xstp,STPN&STP_FC,INDEX1,@A_PRESS_N0,x_stor)  
     ENDIF
      next
    ENDIF

    INDEX1=GET_DATA2(STP_FN,-1)
    STP_A[STPA_NAME]=7
    setdla(A_M_NAME[STP_FN,8],0)
    STPN_OLD=STPN&STP_FC
    FOR XLOOP=stp_fn TO stp_fn-INDEX1  STEP  -1
    XLOOPC=ALLTRIM(STR(XLOOP,2,0))
    XMC_F=A_M_NAME[xloop,3]
    DevPos( A_M_NAME[XLOOP,23], A_M_NAME[XLOOP,13] ) ; DevOutPict( "     ", "&XMC_F" )
    A_M_NAME[XLOOP,10] := A_M_NAME[XLOOP,9]
    A_M_NAME[XLOOP,12] := A_M_NAME[XLOOP,6]
    CLEACHMEM(XLOOP-1)
    STPN&XLOOPC=STPN&xLOOPC+1
    WTANK_F[xloop,1] :=0
    WTANK_F[xloop,2] :=1
    NEXT

    X_LAST=CHK_LAST_DROP(0)

    IF X_LAST=1
       if pnt_remain=1
      hTOTWACT :=ARRAy(15)
      for  xlpa=1  to  15
           hTOTWACT[xlpa]=0
      next
      if  KOT=0  
        x_stor=4
      else
        x_stor=3
      endif


      pnt_remains(x_stor,STPN_OLD,A_PRESS_N0,0,1,hTOTWACT)

       endif
    ENDIF



  ENDIF
CASE STPA_STEP=7
   xaeok=0
   XAEOK=CHK_AEOK()
   IF XAEOK=0
       RETU
   ENDIF
  INDEX1=GET_DATA2(STP_FN,-1)
  STP_A[STPA_NAME]=0



  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
    STP_A[STPA_NAME-INDEX1]=1
  ELSE
    IF    WATER_INPUT=1
      SetColor( "W+  / &C1" )
      if dspe_mixamp=1
    DevPos( 17, 71 ) ; DevOut( "    " )
      endif
    ENDIF
    FOR XLOOP=stp_fn TO stp_fn-INDEX1  STEP  -1
      XLOOPC=ALLTRIM(STR(XLOOP,2,0))
      STPN&XLOOPC=1
      WTANK_F[XLOOP,3] :=1
    NEXT
    if kot=1
      SET_LAST_PCS(1,1,0)
    endif
  ENDIF
ENDCASE
RETU

FUNCTION chk_dnlast
PARAMETERS x_press,x_lpress,X_STPN,x_stpfn,x_cnvstp
retn=0
_x1=x_press[x_lpress,x_stpn+1,x_stpfn,5]
if   (_x1=0)  .AND.   x_cnvstp>0
   retn=1
endif
RETU retn


FUNCTION CHK_AEOK
PARAMETERS  XWEIGHT_TYPE ,XMOD
   XRETU=1
   FOR    I=1  TO  AE_LAST_CH[5]
       IF (TIME1[AE_LAST_CH[I],1] =88)
       IF  STP_A[AE_LAST_CH[I]] <> 7  .AND. WEIGHT_TYPE[AE_LAST_CH[I]] <>1
         XRETU=0
         RETU   XRETU
       ENDIF
       ENDIF
   NEXT
   FOR    I=1  TO  AE_LAST_CH[5]
     IF (TIME1[AE_LAST_CH[I],1] =88)
       WTANK_F[AE_LAST_CH[I],1] :=2
     ENDIF
   NEXT
RETU   XRETU

FUNCTION  GET_REMAINS
PARAMETERS X_STP_FN,X_STPN,X_LOOP,X_PRESS,X_POS
XN =A_M_NAME[X_STP_FN,8]
XNC=ALLTRIM(STR(XN+1,2))
Xn2=WDATA(XN) -2048
XN2 =XN2*A_M_NAME[xn+1,6]/2048
x_stp_fc=alltrim(str(X_STP_FN,2,0))

xd_wno=fSelectNo()
dbSelectArea( "5" )
xn_recno=recno()
dbGoto(70)
XN3=0
IF EOF()=.F.
 XN3=PA&xnc /1000
ENDIF

x_LAST=gs_tot+uwc_tot-ae_tot
XRET=XN2
XWTOT=0
  FOR X_LOOP1 =X_STP_FN TO X_STP_FN-X_LOOP  STEP -1
    XWTOT=XWTOT+X_PRESS[X_POS,X_STPN,X_LOOP1,1]+X_PRESS[X_POS,X_STPN,X_LOOP1,2]
  NEXT
  FOR X_LOOP1 =X_STP_FN TO X_STP_FN-X_LOOP  STEP -1
    Xw0=(X_PRESS[X_POS,X_STPN,X_LOOP1,1]+X_PRESS[X_POS,X_STPN,X_LOOP1,2])
    IF XN3 >0
       if x_stp_fn > x_last
      x_amp=100
      x_div=100
       else
      x_amp=1
      x_div=1
       endif
       x_w=get_rand(xw0,xn3,x_amp,x_div,1)

    else
      if xwtot>0
    X_w=XN2*xw0/XWTOT
      else
     x_w=0
      endif
    endif
    X_PRESS[X_POS,X_STPN,X_loop1,12]=x_w
  NEXT
  dbGoto(xn_recno)
  dbSelectArea( xd_wno )
RETU  XRET

FUNCTION  CHK_LAST_DROP
PARAMETERS X_STP_FN
XRET=1
FOR  I=GS_TOT+1  TO (GS_TOT +UWC_TOT)
  IF (TIME1[I,1] <>88)
    IF WTANK_F[I,2]<>1
      XRET=0
      EXIT
    ENDIF
  ENDIF
NEXT
RETU  XRET

FUNCTION  rst_WTANK_F2
PARAMETERS P1
FOR  I=GS_TOT+1  TO (GS_TOT +UWC_TOT)
  IF (TIME1[I,1] <>88)
     WTANK_F[I,2]=0
  ENDIF
NEXT
RETU

FUNCTION  get_rand     
PARAMETERS x_stdn,x_err,x_a,x_d,X_DIR  
if x_stdn=0 .OR.   x_err=0
   xret=0
else
  x_err= int(INT(x_stdn  *x_a)     * x_err)
  RNDX=int(SECONDS()  * RAND())
  xret=INT(MOD(RNDX,(x_err * X_DIR) +1)-(x_err*(X_DIR-1)))/x_d
endif
RETU  XRET





































PROCEDURE  SetCout2     
PARAMETERS  XSTP_FC,xout
  dbSelectArea( "8" )
  dbCloseArea()
  dbUseArea( .F.,, "PAR1",, if(.F. .OR. .F., !.F., NIL), .F. )
  dbGoto(24)
  IF VAL(PA1)=77
     chn=VAL(PA&XSTP_FC) 
     IF chn>4
       if (chn >= 16)
        chn=chn-16
        dout2(chn,xout)
     else
        dout(chn,xout)
     endif
     ENDIF
  ENDIF
  dbSelectArea( "8" )
  dbCloseArea()
  dbUseArea( .F.,, "MLDSP",, if(.F. .OR. .F., !.F., NIL), .F. )
RETU

FUNCTION ReChk_WFull
PARAMETERS  x_wchadj,x_stpfn
   XRETU=-1
   xwadj_ZN=x_wchadj-1
    if    (autoin_w <> -1 )  .AND.  (weight_type[x_stpfn]=77  .OR.  weight_type[x_stpfn]=2)

      x_STP_FC=ALLTRIM(STR(x_stpfn,2,0))
    xFlorTmp=PFLOR&X_STP_FC
    if  xFlorTmp > ERKG&X_STP_FC
       xFlorTmp = ERKG&X_STP_FC
    endif
    xFlorTmp=3
    xFlorN=xFlorTmp*2048/A_M_NAME[X_STPFN,10]

       IF WATERLOW[x_stpfn-GS_TOT]=0
       X=WDATA(a_m_name[x_wchadj,8])-2048
       XRETU=1
       IF weight_type[x_stpfn]=77
           W_LOWLEVEL[2]=0
       ENDIF




       IF X <W_LOWLEVEL[1]+W_LOWLEVEL[2]   
         WATERLOW[X_STPFN-GS_TOT]=1
         SetColor( "&C10 / &C1" )

         if (val(water_out_no)< x_stpfn )  .OR. (x_wchadj<x_stpfn )
           xdla=0
           if W_LOWLEVEL[1]>0
         if W_LOWLEVEL[2]>0
           xdla=CHENDATA(x_stpfn-1)
         endif


           endif
           SETDLA(A_M_NAME[x_stpfn,8] ,xdla)
         endif

         DSPA_ARROW(x_wchadj,1,14)    
         SETOK(xwadj_ZN)

         SetDigitOut(1,xwadj_ZN,1)
         SetDigitOut(2,A_M_NAME[x_wchadj,8],0)
         XRETU=-1
       ENDIF
       ELSE






       X=WDATA(a_m_name[x_wchadj,8])-2048
       IF weight_type[x_stpfn]=77
           W_LOWLEVEL[2]=0
       ENDIF

       IF X >W_LOWLEVEL[1]+W_LOWLEVEL[2]   
          SETOKn(xwadj_ZN,0)
       endif








      iF RDOK2(xwadj_ZN)=0
        WATERLOW[X_STPFN-GS_TOT]=0







        SetDigitOut(1,xwadj_ZN,0)
        SetColor( "&C2 / &C1" )

        DSPA_ARROW(x_wchadj,0,0)  
        SetColor( "&C7 +/ &C1" )
        XRETU=1
      ENDIF
       ENDIF
    ELSE
      XRETU=1
    ENDIF
RETU   XRETU
