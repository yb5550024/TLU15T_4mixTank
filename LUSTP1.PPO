FUNCTION GET_MIX_DATA
PARAMETERS  _ARATNO,_AVUSE,STOR_A
   xd_wno=fSelectNo()
   ISSEEK=0
   X_RET=""
   ISSEEK= fseek_C(2,"RATNO",_ARATNO,"RATNO",@X_RET)
   IF ISSEEK >0
       X_OK=0
      IF AUTOR =1
      dbSelectArea( "8" )
      MX=INT((_AVUSE+0.4)*2)*.5
      __dbLocate( {|| (MLAV=RATVOL) .AND.(MLMV=MX)},,,, .F. )
      IF   ! EOF()
        X_OK=1
        IF _AVUSE >MLA1
          STOR_A[GS_TOT +UWC_TOT +1]=MLA1
    ELSE
          STOR_A[GS_TOT +UWC_TOT +1]=_AVUSE
        ENDIF
      ENDIF
      ENDIF
      IF (AUTOR =0) .OR.  (X_OK=0)
     IF _AVUSE > RATVOL
         STOR_A[GS_TOT +UWC_TOT +1]=RATVOL
     ELSE
         STOR_A[GS_TOT +UWC_TOT +1]=_AVUSE
     ENDIF
      ENDIF
      dbSelectArea( "2" )
      dbGoto(isseek)
      FOR XLOOP=1  TO    GS_TOT+ UWC_TOT
     ICX=ALLTRIM(STR(XLOOP,2,0))
     STOR_A[XLOOP]= M&ICX  *  STOR_A[GS_TOT +UWC_TOT +1]
      NEXT
   ENDIF
   dbSelectArea( xd_wno )
RETU   ISSEEK

FUNCTION GET_DATA
PARAMETERS  GD_PRESS
xd_wno=fSelectNo()
dbSelectArea( "2" )
__dbLocate( {|| ALLTRIM(RATNO)==ALLTRIM(ARATNO)},,,, .F. )
IF ! EOF()

  IF    COM_E=1
     if (empty(Aus2)=.F.)  .AND. (AVUSE>0)
       _XUS3=0
       _LAG_LAG=0
       _LAG_CAR=0
       IS_SEEK=fseek_2C(14,"LAG_NA_NO",alltrim(Aus2),"LAG_ADDR_NO",alltrim(A_ADDR_NO),"LAG_LAG","LAG_CAR",@_LAG_LAG,@_LAG_CAR)
       XUS3=xvuse
       XTOT_CAR=1
       dbSelectArea( "14" )
       IF IS_SEEK <0
     dbAppend()
     _FIELD->LAG_NA_NO := AUS2; _FIELD->LAG_NAME := AUS2_1; _FIELD->LAG_ADDR_NO := A_ADDR_NO; _FIELD->LAG_ADDR := AUS2_2
       ENDIF
       _FIELD->LAG_DATE := DATE(); _FIELD->LAG_LAG := AUS3; _FIELD->LAG_CAR := ATOT_CAR
     endIf
    dbSelectArea( "2" )
  ENDIF

  LAST_PCS=0
  IF WASTE <>1
    DevPos( 23, 75 ) ; DevOutPict( ACALW_REP, "99" )
  ENDIF
  ACALW_REP=ACALW_REP-1
  IF  ACALW_REP <0
    ACALW_REP=0
  ENDIF
  NEXTOK1=1
  LAST_PCS=0
  NSCANO1=ASCANO
  VUSE=AVUSE
  RATNO=ARATNO
  CARNO=ACARNO
  TANDO=ATANDO
  FILL_A_D4(A_PRESS_N0,1,1,21,15,11,0)
  FILL_A_D2(A_PRESS_N1,GD_PRESS,GD_PRESS,18,0)
  FILL_A_D4(A_PRESS_B0,1,1,21,15,11,0)
  A_PRESS_N1[GD_PRESS,13] :=RATVOL
  A_PRESS_N1[GD_PRESS,15] :=VUSE
  FOR IX=1 TO 15
    A_PRESS_N0[1,21,IX,1] :=77
    A_PRESS_N0[1,21,IX,2] :=RATNO
  NEXT
  IF AUTOR =0
    DO MP1
  ELSE
    DO MP1_1
  ENDIF
  actx=0
  FOR I=1  TO GS_TOT +UWC_TOT
    ic=ltrim(str(i,2,0))
    if (stp_a[i] > 0)
      actx=1
      exit
    endif
  NEXT
  MX=1
  WHILE  A_PRESS_N0[GD_PRESS,MX,1,5] >0
    FOR I=1  TO GS_TOT +UWC_TOT
      IC_X=ALLTRIM(STR(I,2,0))
      X0= A_PRESS_N0[GD_PRESS,MX,I,1]
      A_PRESS_N0[GD_PRESS,MX,I,8] := X0
      IF MX=1
    if( actx=0  .AND.  lchtype=6)
       SetColor( "gr+/ &C1" )
       XMC_F=A_M_NAME[i,3]
       DevPos( A_M_NAME[I,23], A_M_NAME[I,13] ) ; DevOutPict( x0, "&XMC_F" )
       SetColor( "&C7 +/ &C1" )
    endif
      endif
    NEXT
    MX=MX+1
  ENDDO
  IF W0DBF=1
    dbSelectArea( "17" )
    __dbLocate( {|| ALLTRIM(RATNO)==ALLTRIM(ARATNO)},,,, .F. )
    IF    (! EOF()   .AND.  ((W0_EN=1)    .OR.  (DIN(6)=1)) )
      MX=1
      wwic=ALLTRIM(STR(gs_tot+uwc_tot+1,2,0))
      WHILE  A_PRESS_N0[GD_PRESS,MX,1,5] >0
    FOR I=1  TO GS_TOT +UWC_TOT
      IC_X=ALLTRIM(STR(I,2,0))
      X0= A_PRESS_N0[GD_PRESS,MX,I,1]
      X1= A_PRESS_N0[GD_PRESS,MX,I,5] * M&IC_X
      A_PRESS_N0[GD_PRESS,MX,I,1] := X1














        A_PRESS_B0[GD_PRESS,MX,I,1] := X1



    NEXT
    MX=MX+1
      ENDDO
    else
      if disc2>0
    do case
    case lchtype=13
      MX=1
      IF A_PRESS_N0[GD_PRESS,MX,6,8] >0
        WHILE  A_PRESS_N0[GD_PRESS,MX,1,5] >0
        XDISC=DISC2  *    A_PRESS_N0[GD_PRESS,MX,1,5]
        X0= XDISC  * A_PRESS_N0[GD_PRESS,MX,3,8]/(A_PRESS_N0[GD_PRESS,MX,3,8] +A_PRESS_N0[GD_PRESS,MX,4,8] )
        A_PRESS_N0[GD_PRESS,MX,3,1]=A_PRESS_N0[GD_PRESS,MX,3,1]  + X0
        X0= XDISC  *  A_PRESS_N0[GD_PRESS,MX,4,8]/(A_PRESS_N0[GD_PRESS,MX,3,8] +A_PRESS_N0[GD_PRESS,MX,4,8] )
        A_PRESS_N0[GD_PRESS,MX,4,1]=A_PRESS_N0[GD_PRESS,MX,4,1]  + X0
        A_PRESS_N0[GD_PRESS,MX,6,1]=A_PRESS_N0[GD_PRESS,MX,6,1]  -XDISC
          MX=MX+1
        ENDDO
      ENDIF
    endcase
      ENDIF
    ENDIF
    dbSelectArea( "2" )
  ENDIF
  SetColor( "GR + * / &C1" )
  DevPos( 23, 11 ) ; DevOut( SUBSTR(SPACE(9)+ALLTRIM(ASCANO),-9,9) )
  DevPos( 23, 25 ) ; DevOut( ACARNO )
  DevPos( 23, 37 ) ; DevOut( ARATNO )
  DevPos( 23, 52 ) ; DevOutPict( AVUSE, "99.9" )
  DevPos( 23, 61 ) ; DevOutPict( ATANDO, "9999" )
  SetColor( "&C7 +/ &C1" )












  X=_TOT_D_A[20,4]
  IF  X =0
    IF _TOT_D_A[20,3]=0
      _TOT_D_A[20,4] :=1
      X=3
    ELSE
      _TOT_D_A[20,4] := _TOT_D_A[20,3]
      X=_TOT_D_A[20,3]
      X=MOD(X,2)+1
      _TOT_D_A[20,3] :=X
      _TOT_D_A[20,4] := _TOT_D_A[20,3]
      X=X+2
    ENDIF
  ELSE
      X=_TOT_D_A[20,4]
      X=MOD(X,2)+1
      _TOT_D_A[20,3] :=X

      X=X+2
  ENDIF
  _TOT_D_A[20,4]=2
  _TOT_D_A[20,3]=2
  X=4
   _TOT_D_A[2,X] :=ALLTRIM(ASCANO)
   _TOT_D_A[3,X]  :=AUS2_1
   _TOT_D_A[4,X]  :=AUS2_2
   _TOT_D_A[22,X]  :=Aposition
   _TOT_D_A[5,X]  :=0
   _TOT_D_A[6,X]  :=ACARW
   _TOT_D_A[7,X]  :=0
   _TOT_D_A[8,X]  :=TIME()
   _TOT_D_A[9,X]  :=ATOT_CAR
   _TOT_D_A[10,X] :=AVUSE
   _TOT_D_A[11,X] :=AUS3



     _TOT_D_A[12,X] :=S_STRO
     _TOT_D_A[14,X] :=S_TANDO
     _TOT_D_A[17,X] :=S_MAX

   _TOT_D_A[13,X] :=ACARNO
   IF ATANDO <>0
     _TOT_D_A[14,X] :=ATANDO
   ENDIF
   _TOT_D_A[15,X] :=ACARDRV
   _TOT_D_A[16,X] :=AUS2
   _TOT_D_A[18,X] :=ARATNO
   _TOT_D_A[21,X] :=AU_PRICE
   IF (EMPTY(ASCANO) <> .T.  ) .AND. val(ASCANO)>10000
    IF    LAG_REPNO1 <> ASCANO
      LAG_REPNO1 = ALLTRIM(ASCANO)
    ENDIF
    IF (LAGDATE=DATE() .OR.  repno_cont=1   )
      LAG_REPNO1=str(val(LAG_REPNO1)+1 ,9,0)
    ELSE
      LAG_REPNO1=fgetserno(9,1)
      LAGDATE=DATE()
    ENDIF
   ENDIF
   LAG_REPNO=LAG_REPNO1
   lag_sno=ALLTRIM(str(val(lag_sno)+1,9,0))

   _TOT_D_A[19,X] :=LAG_SNO
  __MSave( "LAGDATA9", "LAG*", .T. )
  ASCANO=LAG_REPNO1
  LAG_PNO=LAG_REPNO1
  IF ACALW_REP <=0
    AVUSE=0
    ARATNO=space(9)
    dbSelectArea( "3" )
    Set( 11, "ON" )
    dbGoTop()
    IF ! EOF()
      AVUSE=VUSE
      ARATNO=RATNO
      ASCANO=SCANO
      ACARNO=CARNO
      ATANDO=TANDO
      DevPos( 23, 11 ) ; DevOut( SUBSTR(SPACE(7)+ALLTRIM(ASCANO),-9,9) )
      DevPos( 23, 25 ) ; DevOut( ACARNO )
      DevPos( 23, 37 ) ; DevOut( ARATNO )
      DevPos( 23, 52 ) ; DevOutPict( AVUSE, "99.9" )
      DevPos( 23, 61 ) ; DevOutPict( ATANDO, "9999" )
      IF WASTE <>1
    DevPos( 23, 75 ) ; DevOutPict( ACALW_REP, "99" )
      ENDIF
      dbDelete()
      __dbPack()
      Set( 11, "OFF" )
    ENDIF
      IF WASTE <>1
    DevPos( 23, 75 ) ; DevOutPict( ACALW_REP, "99" )
      ENDIF
  ENDIF
ELSE


  IF EMPTY(ARATNO)=.T.
    AVUSE=0
    ARATNO=space(9)
  ENDIF
  dbSelectArea( "3" )
  Set( 11, "ON" )
  dbGoTop()
  IF ! EOF()
    AVUSE=VUSE
    ARATNO=RATNO
    ASCANO=SCANO
    ACARNO=CARNO
    ATANDO=TANDO





    dbDelete()
    __dbPack()
    Set( 11, "OFF" )
  ENDIF
ENDIF
dbSelectArea( xd_wno )
dbGoto(LURECNO)
 aus3=0
 ATOT_CAR=0
X=_TOT_D_A[20,3] +1
IF X >=3
  X=1
ENDIF

RETU

FUNCTION RDDLY     
PARAMETERS  RDN,WN,W_AN  



IF INT((WDATA(WN)-2048)*A_M_NAME[wn+1,6]/PER/2048)> W_AN
  IF  ABS(SECONDS()-RDDELAY[RDN,2]) >= RDDELAY[RDN,1]
    RDDELAY[RDN,3] :=1
  ELSE
    RDDELAY[RDN,3] :=77
  ENDIF
ELSE
  RDDELAY[RDN,3] :=0
ENDIF
RETU   













PROCEDURE  pnt_tit
PARAMETERS  P1,P2,P3
PRINTERTST=0
DO  PRINTERTST      WITH     APORT
IF PRINTERTST=1
  Set( 17, "On" )
















  FSetToPrinter(aport,PNTW)

  DevPos( PROW()+2, 2 ) ; DevOut( " ¤é´Á :    ¦~    ¤ë    ¤é                                               " )
  X=_Tot_d_a[20,4] +2
  DevPos( PROW(), 9 ) ; DevOutPict( YEAR(DATE()), "9999" )
  DevPos( PROW(), 17 ) ; DevOut( SUBSTR(DTOC(DATE()),1,2) )
  DevPos( PROW(), 23 ) ; DevOut( SUBSTR(DTOC(DATE()),4,2) )
  DevPos( PROW(), 34 ) ; DevOut( "¨®¸¹:" )
  DevPos( PROW(), 41 ) ; DevOut( _Tot_d_a[13,X] )
  DevPos( PROW(), 51 ) ; DevOut( "°t¤ñ:" )
  DevPos( PROW(), 56 ) ; DevOutPict( _Tot_d_a[18,X], "9999" )
  IF  empty(_Tot_d_a[2,X]) <> .T.
    DevPos( PROW(), 66 ) ; DevOut( "§Ç¸¹:" )
    DevPos( PROW(), 72 ) ; DevOutPict( _Tot_d_a[2,X], "XXXXXXXXXXXXXX" )
  ENDIF
  IF  (COM_E=0)  .AND.    ((empty(_Tot_d_a[2,X])    <> .T.)  .OR. (_Tot_d_a[14,X] <> 0))
      DevPos( PROW()+1, 1 ) ; DevOut( " " )
      if  waste=1
     DevPos( PROW(), 51 ) ; DevOut( "¤u¦a:" )
     DevPos( PROW(), 56 ) ; DevOut( _Tot_d_a[22,X] )
      endif
    IF    _Tot_d_a[14,X] <> 0
      DevPos( PROW(), 66 ) ; DevOut( "§~«×:" )
      DevPos( PROW(), 71 ) ; DevOutPict( _Tot_d_a[14,X], "9999" )
    ENDIF
  ENDIF
  DevPos( PROW()+1, 1 ) ; DevOut( "--------------------------------------------------------------------------------------------------" )
  DevPos( PROW()+1, 1 ) ; DevOut( "      NO.  ®É¶¡  ¦Ì¼Æ  ²Ö­p(¦Ì)        ³]©w­«¶q/¹ê»Ú­«¶q (Kg)" )
  DevPos( PROW()+1, 1 ) ; DevOut( " " )
  FOR X=1 TO (GS_TOT+UWC_TOT)
    xcd=SUBSTR("       "+alltrim(A_M_NAME[X,1] ),-6,6)
    DevPos( PROW(), 6 *(X-1)+1 ) ; DevOut( XCD )
  NEXT
  DevPos( PROW(), 6 *(X-1)+1 ) ; DevOut( "Á`­«" )
  DevPos( PROW()+1, 1 ) ; DevOut( "------------------------------------------------------------------------------------------------------" )
  DevPos( PROW()+1, 1 ) ; DevOut( " " )
  Set( 20, "SCREEN" )
endif
RETU


FUNCTION TST1_LS1
PARAMETERS  TST_M1
IF LS1[TST_M1,1]=1
  IF DIX(DI_ADS2,TST_M1-1)=0 .AND. RDOK2(TST_M1-1)=1
    IF LS1[TST_M1,2]=0

      SetDigitOut(1,TST_M1-1,0)
      LS1[TST_M1,2] :=1
      DO CASE
      CASE UCHTYPE=1
    SetColor( "R * / &C1" )
    MTANK_MARK(6,STP_FN,1)
    SetColor( "&C7  / &C1" )
      ENDCASE
    ENDIF
    RETU
  ELSE
    IF LS1[TST_M1,2]=1
      LS1[TST_M1,2] :=0

      SetDigitOut(1,TST_M1-1,1)
      SetColor( "&C2    / &C1" )
      MTANK_MARK(6,STP_FN,1)
      SetColor( "&C7    / &C1" )
    ENDIF
  ENDIF
ENDIF
RETU

FUNCTION TST0_LS1   
PARAMETERS  TST_M1,TST_M2
FOR XDI=TST_M1 TO TST_M2
  IF LS1[XDI,1]=1
    DIN_X=0
    IF DIX(DI_ADS2,XDI-1)=1
      DIN_X=1
    ENDIF
    IF DIN_X=1 .AND. RDZEROK(A_M_NAME[XDI,8])=1
      IF LS1[XDI,2]=0

    SetDigitOut(2,A_M_NAME[XDI,8],0)
    LS1[XDI,2] :=1
    DO CASE
    CASE LCHTYPE=4
      SetColor( "R * / &C1" )
      MTANK_MARK(6,XDI,1)
      SetColor( "&C7  / &C1" )
    ENDCASE
      ENDIF
    ELSE
      IF  RDZEROK(A_M_NAME[XDI,8])=1
    IF LS1[XDI,2]=1
      LS1[XDI,2] :=0

      SetColor( "&C2 / &C1" )
      MTANK_MARK(6,XDI,0)
      SetColor( "&C7  / &C1" )
    ENDIF
      ELSE

    FOR XDI_1=TST_M1 TO TST_M2
      LS1[XDI_1,2] :=0
      SetColor( "&C2 / &C1" )
      MTANK_MARK(6,XDI,0)
      SetColor( "&C7  / &C1" )
    NEXT
      ENDIF
    ENDIF
  ENDIF
NEXT
XN1=0
FOR XDI_1=TST_M1 TO TST_M2
  IF  LS1[XDI_1,2] =1
    XN1=1
    EXIT
  ENDIF
NEXT
IF XN1=0
  IF MIXAMP < MIXMAX
    IF TST_M1 <= GS_TOT

      SetDigitOut(2,A_M_NAME[TST_M1,8],1)
    ELSE
      IF MIXAMP > 10

    SetDigitOut(2,A_M_NAME[TST_M1,8],1)
      else

    SetDigitOut(2,A_M_NAME[TST_M1,8],0)
      endif
    ENDIF
  ELSE

    SetDigitOut(2,A_M_NAME[TST_M1,8],0)
  ENDIF
ELSE

  SetDigitOut(2,A_M_NAME[TST_M1,8],0)
ENDIF
RETU

