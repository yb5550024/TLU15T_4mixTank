sET COLO TO &C7 +/ &C1
x=s_bcc("12")
IF INFUNC =1
  T0A=INKEY()
  IF T0A <> 0
    RETU
  ENDIF
ENDIF
if ERROR_LINK=0

  C_BUFF=SPACE(20)
  N=SIO_READ(0,C_BUFF)
  IF  N >0
    *C_READ=C_READ+SUBSTR(C_BUFF,1,N)
    *@ 20,0  SAY C_READ
    ??	SUBSTR(C_BUFF,1,N)
    IF	LEN(C_READ) > 70
      C_READ=""
    ENDIF
  ENDIF
ENDIF
FOR  X=13 TO 12
  MTANK_MARK(6,X,1)
  CTANK_MARK(11,X,1)
  INKEY(1)
  MTANK_MARK(6,X,0)
  CTANK_MARK(11,X,0)
  INKEY(1)
NEXT
@ 0,71 SAY  TIME()
IF DO0_DSP=1
  FOR  x=1  TO (GS_TOT+UWC_TOT)
    @ 1,A_M_NAME[x,2]  SAY  rd_do1(x-1)  pict  "9"
    DO0_DSPF=1
  NEXT
  FOR  x=1  TO (KLCHN+KUCHN)
    @ 12,(A_M_NAME[x,20]/8)  SAY  rd_do2(x-1)  pict  "9"
    DO0_DSPF=1
  NEXT
  @ 14,UPTANK[5,1]    SAY   rd_do1(14)	pict  "9"
  @ 19,58    SAY   rd_do1(15)  pict  "9"
  @ 19,62    SAY   "Bee"
  @ 19,66    SAY   rd_do1(12)  pict  "9"

ELSEIF DO0_DSPF=1
 @ 1,0 CLEA  TO 1,79
  DO0_DSPF=0
ENDIF
IF  STAR=0 .AND. DOSIGN=1 .AND. DIN(15)=1
  @ 1,0 SAY "      "
  DOSIGN=0
  SETMEM(HEXTODEC("284"),INT(PDROP1*INTNO))
  SETMEM(HEXTODEC("286"),INT(PDRCL*INTNO))
  SETMEM(HEXTODEC("288"),INT(PDROP2*INTNO))
  SETMEM(HEXTODEC("28A"),INT(PMIXTM*INTNO))
  SETMEM(HEXTODEC("28C"),INT(PMIXA*2048/POVKG9)+2048)
  SETMEM(HEXTODEC("28E"),INT(PMIXOP*INTNO))
ENDIF
IF  STAR=0
  if spacial=1
    if spacial_0 <>  din(7)
       spacial_0 =  din(7)
       DO   DSP_SPACIAL
    endif
  endif
endif
IF STAR=1
  DO CASE
  CASE	 DOSIGN=1 .AND.   DIN(15)=1
    DOSIGN=0
    RESTOUT()
    OFF_LONG=ABS(SECONDS()-OFF_TIME)
    MIXSTM=MIXSTM + OFF_LONG
    @ 1,0 SAY "      "
    IF (KOT=0  ) .AND. (UPTKSTP=3)
      SET COLOR TO W/ &C1
      @  3,UPTANK[5,1]-6  SAY "┌┬──┐"
      @  4,UPTANK[5,1]-6  SAY "││    │"
      @  5,UPTANK[5,1]-6  SAY "│├──┘"
      @  6,UPTANK[5,1]-6  SAY "�U�V"
      @  7,UPTANK[5,1]-6  SAY "││"
      @  8,UPTANK[5,1]-6  SAY "││"
      @  9,UPTANK[5,1]-6  SAY "││"
      @ 10,UPTANK[5,1]-6  SAY "││"
      @ 11,UPTANK[5,1]-6  SAY "�U�V"
      @ 12,UPTANK[5,1]-6  SAY "││"
      @ 13,UPTANK[5,1]-6  SAY "    "
      @ 13,UPTANK[5,1]-38  SAY "┌──�R───────�R────┼┤"
      @ 14,UPTANK[5,1]-38  SAY "└──�Q───────�Q────┴┘"
      SET COLOR TO &C2 / &C1
    ENDIF

    DO CASE
    CASE  TANKSTP=2
      *dout(8,1)
      xx=ABS(INT((PDROP1-abs(SECONDS() -MIXSTM)) *INTNO))
      SETMEM(HEXTODEC("284"),xx)
      SETMEM(HEXTODEC("286"),INT(PDRCL*INTNO))
      SETMEM(HEXTODEC("288"),INT(PDROP2*INTNO))
      SETMEM(HEXTODEC("28A"),ABS(INT((PMIXTM-abs((SECONDS() -MIXSTM)) )*INTNO)))
      SETMIX()
      setdrop()
    CASE  TANKSTP=4  .or. TANKSTP=3
      *dout(8,1)
      SETMEM(HEXTODEC("284"),0)
      SETMEM(HEXTODEC("286"),0)
      XX=ABS(INT((PDROP1+PDRCL+PDROP2-abs((SECONDS() -MIXSTM)) )*INTNO))
      SETMEM(HEXTODEC("288"),XX)
      XX=ABS(INT((PMIXTM-abs((SECONDS() -MIXSTM)) )*INTNO))
      SETMEM(HEXTODEC("28A"),XX)
      SETMIX()
      setdrop()
    ENDCASE
  CASE	 DOSIGN=0  .AND.     DIN(15)=0
    DOSIGN=1
    WAITOUT()
    SETMEM(HEXTODEC("284"),0)
    SETMEM(HEXTODEC("286"),0)
    SETMEM(HEXTODEC("288"),0)
    OFF_TIME=SECONDS()
    *SET COLOR TO &C5* +/ &C1
    SET COLO TO R+ /&C1
    @ 1,0 SAY " Wait "
    SET COLOR TO &C2 +/ &C1
  ENDCASE
ELSEIF X_MONI=77
  DO MONI
ENDIF
if ABS(seconds()-dsptime) >0.3
  dsptime=seconds()
  DO CASE
  CASE	LCHTYPE=2
    IF STAR=1
      IF     ISDEMO=1	.and. dosign=0
	DO DEMO_INP
      ENDIF
      IF W0DBF=1 .AND. DSPD_NOR=0
	FOR I=1 TO GS_TOT
	  IC_X=ALLTRIM(STR(I,2,0))
	  IF (STP&IC_X >=1)  .OR. (I=4 .AND. STP5 >0)
	    IF	A_PRESS_N0[2,1,I,1]>0
	      A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	    ENDIF
	  ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	NEXT
      ENDIF

      DD1=INT((CHENDATA(0))*A_M_NAME[1,10]/PER/2048)
      DD2=INT((CHENDATA(1))*A_M_NAME[2,10]/PER/2048)
      DD3=INT((CHENDATA(2))*A_M_NAME[3,10]/PER/2048)-disc2_s3
      DD4=INT((CHENDATA(3))*A_M_NAME[4,10]/PER/2048)
      DD5=INT((CHENDATA(4))*A_M_NAME[5,10]/PER/2048)
      @ 8,A_M_NAME[1,13]  SAY	 DD1   PICT "9999"
      @ 8,A_M_NAME[2,13]  SAY	DD2   PICT "9999"
      @ 8,A_M_NAME[3,13]  SAY	DD3   PICT "9999"
      @ 8,A_M_NAME[4,13]  SAY	DD4   PICT "9999"
      @ 8,A_M_NAME[5,13]  SAY	DD5   PICT "9999"
      IF W0DBF=1  .AND. DSPD_NOR=0
	FOR I=1 TO KLCHN
	  IC_X=ALLTRIM(STR(I,2,0))
	  IF (STP&IC_X >=1)
	    IF	A_PRESS_N0[2,1,I,8]>0
	      A_M_NAME[I,12]=A_M_NAME[I,6] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	    ENDIF
	  ENDIF
	NEXT
      ENDIF
      A_M_NAME[4,12]=A_M_NAME[4,10]
      IF  W0DBF=1
	FOR I=	1  to GS_TOT
	  *IC_X=ALLTRIM(STR(I,2,0))
	  *IF (STP&IC_X >=1)
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	  *ENDIF
	NEXT
      ENDIF
    ENDIF
    @ 10,A_M_NAME[1,16] SAY INT((WDATA(0)-2048)*A_M_NAME[1,12]/PER/2048)   PICT "9999"
    @ 10,A_M_NAME[2,16]  SAY INT((WDATA(1)-2048)*A_M_NAME[2,12]/PER/2048)   PICT "9999"
    @ 10,A_M_NAME[3,16]  SAY INT((WDATA(2)-2048)*A_M_NAME[3,12]/PER/2048)   PICT "9999"
    IF	(DSPD_NOR=0) .AND. ((STP4>=1 .AND. STP4<=3) .OR. (STP5>=1 .AND. STP5<=6))
      DD5_MY=INT((WDATA(3)-CHENDATA(3)-CHENDATA(4)-2048)*A_M_NAME[4,12]/PER/2048)
      @ 10,A_M_NAME[4,16]  SAY INT(DD4 +DD5 +DD5_MY)   PICT "9999"
    ELSE
      @ 10,A_M_NAME[4,16]  SAY INT((WDATA(3)-2048)*A_M_NAME[4,12]/PER/2048)   PICT "9999"
    ENDIF
    IF W0DBF=1
      FOR I=1 TO KLCHN
	*IC_X=ALLTRIM(STR(I,2,0))
	*IF (STP&IC_X >=1)
	*  IF  A_PRESS_N0[2,1,I,8]>0
	    A_M_NAME[I,12]=A_M_NAME[I,6]
	*  ENDIF
	*ENDIF
      NEXT
    ENDIF
  CASE	LCHTYPE=4
    STOR  0  TO  DD1,DD2,DD3,DD4,DD5
    IF STAR=1
      IF     ISDEMO=1	.and. dosign=0
	DO DEMO_INP
      ENDIF
      IF W0DBF=1 .AND. DSPD_NOR=0
	 IF (STP1 > 0 )  .OR. (STP2 >0)  .OR. (STP3 >0)
	   IF A_PRESS_N0[2,STPN1,1,1] <> 0
	     A_M_NAME[1,10]=A_M_NAME[1,9] * A_PRESS_N0[2,STPN1,1,8]/A_PRESS_N0[2,STPN1,1,1]
	   ENDIF
	   IF A_PRESS_N0[2,STPN2,2,1] <> 0
	     A_M_NAME[2,10]=A_M_NAME[2,9] * A_PRESS_N0[2,STPN2,2,8]/A_PRESS_N0[2,STPN2,2,1]
	   ENDIF
	   IF A_PRESS_N0[2,STPN3,3,1] <> 0
	     A_M_NAME[3,10]=A_M_NAME[3,9] * A_PRESS_N0[2,STPN3,3,8]/A_PRESS_N0[2,STPN3,3,1]
	   ENDIF
	 ENDIF
	 IF (STP4 > 0 )  .OR. (STP5 >0)
	   IF A_PRESS_N0[2,STPN4,4,1] <> 0
	     A_M_NAME[4,10]=A_M_NAME[4,9] * A_PRESS_N0[2,STPN4,4,8]/A_PRESS_N0[2,STPN4,4,1]
	   ENDIF
	   IF A_PRESS_N0[2,STPN5,5,1] <> 0
	     A_M_NAME[5,10]=A_M_NAME[5,9] * A_PRESS_N0[2,STPN5,5,8]/A_PRESS_N0[2,STPN5,5,1]
	   ENDIF
	 ENDIF
      ENDIF
      DD1=INT((CHENDATA(0))*A_M_NAME[1,10]/PER/2048)
      DD2=INT((CHENDATA(1))*A_M_NAME[2,10]/PER/2048)
      DD3=INT((CHENDATA(2))*A_M_NAME[3,10]/PER/2048)-disc2_s3
      DD4=INT((CHENDATA(3))*A_M_NAME[4,10]/PER/2048)
      DD5=INT((CHENDATA(4))*A_M_NAME[5,10]/PER/2048)
      @ 8,A_M_NAME[1,2]  SAY	DD1   PICT "9999"
      @ 8,A_M_NAME[2,2]  SAY   DD2   PICT "9999"
      @ 8,A_M_NAME[3,2]  SAY   DD3   PICT "9999"
      @ 8,A_M_NAME[4,2]  SAY   DD4   PICT "9999"
      @ 8,A_M_NAME[5,2]  SAY   DD5   PICT "9999"
    ENDIF
    SWX=SCALE_DSP(W0DBF,DSPD_NOR,STAR,0,DD1+DD2+DD3,1,3)
    DD1=N_DIV(SWX,DSP_DIV[1])
    @ 10,12 SAY DD1 PICT "9999"
    SWX=SCALE_DSP(W0DBF,DSPD_NOR,STAR,1,DD4+DD5,4,5)
    DD2=N_DIV(SWX,DSP_DIV[2])
    @ 10,25 SAY DD2   PICT "9999"
    _SEND_RS40D(0,0,DD1)
    _SEND_RS40D(1,0,DD2)
    IF	W0DBF=1
      FOR I=  1  to GS_TOT
	  A_M_NAME[I,10]=A_M_NAME[I,9]
      NEXT
    ENDIF
  CASE	LCHTYPE=5  .or.LCHTYPE=30   .or. LCHTYPE=14   .or. LCHTYPE=15
    IF STAR=1
      IF     ISDEMO=1	.and. dosign=0
	DO DEMO_INP
      ENDIF
      IF W0DBF=1 .AND. DSPD_NOR=0
	FOR I=1 TO GS_TOT
	  IC_X=ALLTRIM(STR(I,2,0))
	  IF (STP1 >0)	.OR. (STP2 >0)	 .OR. (STP3 >0)  .OR. (STP4 >0)
	    IF	A_PRESS_N0[2,1,I,1]>0
	     *A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+ A_PRESS_N0[2,STPN&IC_X,I,11])/(A_PRESS_N0[2,STPN&IC_X,I,1]+ A_PRESS_N0[2,STPN&IC_X,I,2]   )
	      x= (A_PRESS_N0[2,STPN&IC_X,I,8]+ A_PRESS_N0[2,STPN&IC_X,I,11])/(A_PRESS_N0[2,STPN&IC_X,I,1]+ A_PRESS_N0[2,STPN&IC_X,I,2]	 )
	      A_M_NAME[I,10]=A_M_NAME[I,9] * x
	    ELSEIF (GS_CHG > 0)
	       IF (GS_CHG=3) .AND. (I=2)
		 A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I+1,1]
	       ELSEIF (GS_CHG=2) .AND. (I=3)
		 A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I-1,1]
	       ENDIF
	    ENDIF
	  ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	NEXT
      ENDIF

      DD1=INT((CHENDATA(0))*A_M_NAME[1,10]/PER/2048)
      X=0
      Y=0
      IF GS_CHG=3
	 X=1
      ENDIF
      IF GS_CHG=2
	 Y=1
      ENDIF
      DD2=INT((CHENDATA(1+X))*A_M_NAME[2,10]/PER/2048)
      DD3=INT((CHENDATA(2-Y))*A_M_NAME[3,10]/PER/2048)-disc2_s3
      DD4=INT((CHENDATA(3))*A_M_NAME[4,10]/PER/2048)
      @ 8,A_M_NAME[1,13]  SAY	 DD1   PICT "9999"
      @ 8,A_M_NAME[2,13]  SAY	DD2   PICT "9999"
      @ 8,A_M_NAME[3,13]  SAY	DD3   PICT "9999"
      @ 8,A_M_NAME[4,13]  SAY	DD4   PICT "9999"
      IF (STP1 >0)  .OR. (STP2 >0)   .OR. (STP3 >0)  .OR. (STP4 >0)
	DD5=DD1+DD2+DD3+DD4
	DD3=CHENDATA(0)+CHENDATA(1)+CHENDATA(2)+CHENDATA(3)
	IF DD3 > 0
	  DD5_MY=INT((WDATA(0)-DD3-2048)* DD5 /PER/DD3)
	ELSE
	  A_M_NAME[1,12]=A_M_NAME[1,10]
	  DD5_MY=INT((WDATA(0)-DD3-2048)* A_M_NAME[1,12] /PER/2048)
	ENDIF
	dd4= DD5 +DD5_MY
	DD4=N_DIV(DD4,DSP_DIV[1])
	@ 10,A_M_NAME[1,16]  SAY  dd4  PICT "9999"
      ELSE
	A_M_NAME[1,12]=A_M_NAME[1,6]
	DD4=INT((WDATA(0)-2048)*A_M_NAME[1,12]/PER/2048)
	DD4=N_DIV(DD4,DSP_DIV[1])
	@ 10,A_M_NAME[1,16] SAY dd4   PICT "9999"
      ENDIF

      IF  W0DBF=1
	FOR I=	1  to GS_TOT
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	NEXT
      ENDIF
    ELSE
      dd4=INT((WDATA(0)-2048)*A_M_NAME[1,6]/PER/2048)
      DD4=N_DIV(DD4,DSP_DIV[1])
      @ 10,A_M_NAME[1,16] SAY  dd4   PICT "9999"
    ENDIF
    _SEND_RS40D(0,0,DD4)
    IF W0DBF=1
      A_M_NAME[1,12]=A_M_NAME[1,6]
    ENDIF
  CASE	LCHTYPE=6  .OR.  LCHTYPE=9    .OR.  LCHTYPE=10	 .OR.  LCHTYPE=11   .OR.  LCHTYPE=12   .OR.  LCHTYPE=13
    IF STAR=1
      IF     ISDEMO=1	.and. dosign=0
	DO DEMO_INP
      ENDIF
      IF W0DBF=1 .AND. DSPD_NOR=0
	FOR I=1 TO GS_TOT
	  IC_X=ALLTRIM(STR(I,2,0))
	  IF (STP&IC_X >=1)  .OR. (I=4 .AND. STP5 >0)
	    IF	A_PRESS_N0[2,1,I,1]>0
	      A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]  +A_PRESS_N0[2,STPN&IC_X,I,2] )/(A_PRESS_N0[2,STPN&IC_X,I,1]+ +A_PRESS_N0[2,STPN&IC_X,I,2]  )
	    ENDIF
	  ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	NEXT
      ENDIF

      DD1=INT((CHENDATA(0))*A_M_NAME[1,10]/PER/2048)
      DD2=INT((CHENDATA(1))*A_M_NAME[2,10]/PER/2048)
      DD3=INT((CHENDATA(2))*A_M_NAME[3,10]/PER/2048)-disc2_s3
      DD4=INT((CHENDATA(3))*A_M_NAME[4,10]/PER/2048)
      @ 8,A_M_NAME[1,13]  SAY	 DD1   PICT "9999"
      @ 8,A_M_NAME[2,13]  SAY	DD2   PICT "9999"
      @ 8,A_M_NAME[3,13]  SAY	DD3   PICT "9999"
      @ 8,A_M_NAME[4,13]  SAY	DD4   PICT "9999"
      IF W0DBF=1  .AND. DSPD_NOR=0
	FOR I=1 TO KLCHN
	  IC_X=ALLTRIM(STR(I,2,0))
	  IF (STP&IC_X >=1)
	    IF	A_PRESS_N0[2,1,I,8]>0
	      A_M_NAME[I,12]=A_M_NAME[I,6] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	    ENDIF
	  ENDIF
	NEXT
      ENDIF
      A_M_NAME[4,12]=A_M_NAME[4,10]
      IF  W0DBF=1
	FOR I=	1  to GS_TOT
	  *IC_X=ALLTRIM(STR(I,2,0))
	  *IF (STP&IC_X >=1)
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	  *ENDIF
	NEXT
      ENDIF
    ENDIF
    DD1= INT((WDATA(0)-2048)*A_M_NAME[1,12]/PER/2048)
    DD2=INT((WDATA(1)-2048)*A_M_NAME[2,12]/PER/2048)
    if DSPDATA_A[3]=1
      DD3=INT((WDATA(2)-2048)*A_M_NAME[3,12]/PER/2048)
      ACTWEIT_A[3] :=DD3
    ELSE
      DD3 := ACTWEIT_A[3]
    ENDIF
    if DSPDATA_A[3]=1
      DD4=INT((WDATA(3)-2048)*A_M_NAME[4,12]/PER/2048)
      ACTWEIT_A[4] :=DD4
    ELSE
      DD4 := ACTWEIT_A[4]
    ENDIF
    DD1=N_DIV(DD1,DSP_DIV[1])
    DD2=N_DIV(DD2,DSP_DIV[2])
    DD3=N_DIV(DD3,DSP_DIV[3])
    DD4=N_DIV(DD4,DSP_DIV[4])
    @ 10,A_M_NAME[1,16]  SAY  DD1     PICT "9999"
    @ 10,A_M_NAME[2,16]  SAY  DD2     PICT "9999"
    @ 10,A_M_NAME[3,16]  SAY  DD3     PICT "9999"
    @ 10,A_M_NAME[4,16]  SAY  DD4     PICT "9999"
    IF LCHTYPE=6   .OR.   LCHTYPE=10
       _SEND_RS40D(0,0,DD1)
       _SEND_RS40D(1,0,DD2)
       _SEND_RS40D(2,0,DD3)
       _SEND_RS40D(3,0,DD4)
    else

      IF LED_IO >0
	LED_DSP(0,0,DD1,0)
	LED_DSP(0,1,DD2,0)
	LED_DSP(0,2,DD3,0)
	LED_DSP(0,3,DD4,0)
      ENDIF
    ENDIF

    IF W0DBF=1
      FOR I=1 TO KLCHN
	    A_M_NAME[I,12]=A_M_NAME[I,6]
      NEXT
    ENDIF
  CASE	 LCHTYPE=32
    IF STAR=1
      IF     ISDEMO=1	.and. dosign=0
	DO DEMO_INP
      ENDIF
      IF W0DBF=1 .AND. DSPD_NOR=0
	FOR I=1 TO GS_TOT
	  IC_X=ALLTRIM(STR(I,2,0))
	  IF I=5
	     IF ((STP&IC_X >=1)   .and. (STP&IC_X <7 ) )
	       IF  A_PRESS_N0[2,1,I,1]>0
		 A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8])/(A_PRESS_N0[2,STPN&IC_X,I,1] )
		 if A_PRESS_N0[2,1,I,8] =0
		    A_M_NAME[I,10]=0
		 endif
	       ELSE
		A_M_NAME[I,10]=A_M_NAME[I,9]
	       ENDIF
	     ELSE
	       A_M_NAME[I,10]=A_M_NAME[I,9]
	     ENDIF
	  ELSE
	    IF (STP1 >0)  .OR. (STP2 >0)   .OR. (STP3 >0)  .OR. (STP4 >0)
	      IF  A_PRESS_N0[2,1,I,1]>0
	       *A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+ A_PRESS_N0[2,STPN&IC_X,I,11])/(A_PRESS_N0[2,STPN&IC_X,I,1]+ A_PRESS_N0[2,STPN&IC_X,I,2]   )
		x= (A_PRESS_N0[2,STPN&IC_X,I,8]+ A_PRESS_N0[2,STPN&IC_X,I,11])/(A_PRESS_N0[2,STPN&IC_X,I,1]+ A_PRESS_N0[2,STPN&IC_X,I,2]   )
		A_M_NAME[I,10]=A_M_NAME[I,9] * x
	      ELSEIF (GS_CHG > 0)
		 IF (GS_CHG=3) .AND. (I=2)
		   A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I+1,1]
		 ELSEIF (GS_CHG=2) .AND. (I=3)
		   A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I-1,1]
		 ENDIF
	      ENDIF
	    ELSE
	      A_M_NAME[I,10]=A_M_NAME[I,9]
	    ENDIF
	  ENDIF
	NEXT
      ENDIF

      DD1=INT((CHENDATA(0))*A_M_NAME[1,10]/PER/2048)
      X=0
      Y=0
      IF GS_CHG=3
	 X=1
      ENDIF
      IF GS_CHG=2
	 Y=1
      ENDIF
      DD2=INT((CHENDATA(1+X))*A_M_NAME[2,10]/PER/2048)
      DD3=INT((CHENDATA(2-Y))*A_M_NAME[3,10]/PER/2048)-disc2_s3
      DD4=INT((CHENDATA(3))*A_M_NAME[4,10]/PER/2048)
      DD5=INT((CHENDATA(4))*A_M_NAME[5,10]/PER/2048)
      @ 8,A_M_NAME[1,13]  SAY	 DD1   PICT "9999"
      @ 8,A_M_NAME[2,13]  SAY	DD2   PICT "9999"
      @ 8,A_M_NAME[3,13]  SAY	DD3   PICT "9999"
      @ 8,A_M_NAME[4,13]  SAY	DD4   PICT "9999"
      @ 8,A_M_NAME[5,13]  SAY	DD5   PICT "9999"
      *IF ((STP5 >=3)  .AND. (STP5 <=3))
      *  *XSW=A_PRESS_N0[2,STPN5,5,1] -PWATER
      *  XSW=A_PRESS_N0[2,STPN5,5,1]
      *  XSW =DD5-XSW
      *   SEND_ES2001(0,XSW)
      *ELSE
      *   SEND_ES2001(0,0)
      *ENDIF
      IF (STP1 >0)  .OR. (STP2 >0)   .OR. (STP3 >0)  .OR. (STP4 >0)
	DD9=DD1+DD2+DD3+DD4
	DD3=CHENDATA(0)+CHENDATA(1)+CHENDATA(2)+CHENDATA(3)
	IF DD3 > 0
	  DD9_MY=INT((WDATA(0)-DD3-2048)* DD9 /PER/DD3)
	ELSE
	  A_M_NAME[1,12]=A_M_NAME[1,10]
	  DD9_MY=INT((WDATA(0)-DD3-2048)* A_M_NAME[1,12] /PER/2048)
	ENDIF
	dd4= DD9 +DD9_MY
	DD4=N_DIV(DD4,DSP_DIV[1])
	@ 10,A_M_NAME[1,16]  SAY  dd4  PICT "9999"
      ELSE
	A_M_NAME[1,12]=A_M_NAME[1,6]
	DD4=INT((WDATA(0)-2048)*A_M_NAME[1,12]/PER/2048)
	DD4=N_DIV(DD4,DSP_DIV[1])
	@ 10,A_M_NAME[1,16] SAY dd4   PICT "9999"
      ENDIF
      IF  W0DBF=1
	  A_M_NAME[5,12]=A_M_NAME[5,10]
      ENDIF
      dd5=INT((WDATA(1)-2048)*A_M_NAME[5,12]/PER/2048)
      DD5=N_DIV(DD5,DSP_DIV[2])
      @ 10,A_M_NAME[2,16] SAY  dd5   PICT "9999"
      IF  W0DBF=1
	FOR I=	1  to GS_TOT
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	NEXT
      ENDIF
    ELSE
	* SEND_ES2001(0,0)
      dd1=INT((WDATA(0)-2048)*A_M_NAME[1,6]/PER/2048)
      DD1=N_DIV(DD1,DSP_DIV[1])
      @ 10,A_M_NAME[1,16] SAY  dd1   PICT "9999"
      dd2=INT((WDATA(1)-2048)*A_M_NAME[2,6]/PER/2048)
      DD2=N_DIV(DD2,DSP_DIV[2])
      @ 10,A_M_NAME[2,16] SAY  dd2   PICT "9999"
    ENDIF
    IF	STAR=1
    IF ((STP5 >=3)  .AND. (STP5 <=4))
      *XSW=A_PRESS_N0[2,STPN5,5,1] -PWATER
      XSW=A_PRESS_N0[2,STPN5,5,1]
      XSW =DD5-XSW
       SEND_ES2001(0,XSW)
    ELSE
       SEND_ES2001(0,0)
    ENDIF
    ELSE
       SEND_ES2001(0,0)
    ENDIF

    _SEND_RS40D(0,0,DD1)
    _SEND_RS40D(1,0,DD2)
    IF W0DBF=1
      A_M_NAME[1,12]=A_M_NAME[1,6]
      A_M_NAME[2,12]=A_M_NAME[2,6]
    ENDIF

  CASE	LCHTYPE=7
    IF STAR=1
      IF     ISDEMO=1	.and. dosign=0
	DO DEMO_INP
      ENDIF
      IF W0DBF=1 .AND. DSPD_NOR=0
	FOR I=1 TO GS_TOT
	  IC_X=ALLTRIM(STR(I,2,0))
	  IF (STP&IC_X >=1)  .OR. (I=4 .AND. STP5 >0)
	    IF	A_PRESS_N0[2,1,I,1]>0
	      A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	    ENDIF
	  ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	NEXT
      ENDIF

      DD1=INT((CHENDATA(0))*A_M_NAME[1,10]/PER/2048)
      DD2=INT((CHENDATA(1))*A_M_NAME[2,10]/PER/2048)
      DD3=INT((CHENDATA(2))*A_M_NAME[3,10]/PER/2048)-disc2_s3
      DD4=INT((CHENDATA(3))*A_M_NAME[4,10]/PER/2048)
      DD5=INT((CHENDATA(4))*A_M_NAME[5,10]/PER/2048)
      @ 8,A_M_NAME[1,13]  SAY	 DD1   PICT "9999"
      @ 8,A_M_NAME[2,13]  SAY	DD2   PICT "9999"
      @ 8,A_M_NAME[3,13]  SAY	DD3   PICT "9999"
      @ 8,A_M_NAME[4,13]  SAY	DD4   PICT "9999"
      @ 8,A_M_NAME[5,13]  SAY	DD5   PICT "9999"
      IF W0DBF=1  .AND. DSPD_NOR=0
	FOR I=1 TO KLCHN
	  IC_X=ALLTRIM(STR(I,2,0))
	  IF (STP&IC_X >=1)
	    IF	A_PRESS_N0[2,1,I,8]>0
	      A_M_NAME[I,12]=A_M_NAME[I,6] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	    ENDIF
	  ENDIF
	NEXT
      ENDIF
      A_M_NAME[4,12]=A_M_NAME[4,10]
      IF  W0DBF=1
	FOR I=	1  to GS_TOT
	  *IC_X=ALLTRIM(STR(I,2,0))
	  *IF (STP&IC_X >=1)
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	  *ENDIF
	NEXT
      ENDIF
    ENDIF
    XD1=INT((WDATA(0)-2048)*A_M_NAME[1,12]/PER/2048) + REMOTE[1]
    XD1=N_DIV(XD1,DSP_DIV[1])
    @ 10,A_M_NAME[1,16] SAY XD1   PICT "9999"
    LEDEACH_DSP(0,0,XD1,0)
    XD2=INT((WDATA(1)-2048)*A_M_NAME[2,12]/PER/2048) + REMOTE[2]
    XD2=N_DIV(XD2,DSP_DIV[2])
    @ 10,A_M_NAME[2,16]  SAY  XD2  PICT "9999"
    LEDEACH_DSP(0,1,XD2,0)
    XD3=INT((WDATA(2)-2048)*A_M_NAME[3,12]/PER/2048) + REMOTE[3]
    XD3=N_DIV(XD3,DSP_DIV[3])
    @ 10,A_M_NAME[3,16]  SAY XD3   PICT "9999"
    LEDEACH_DSP(0,2,XD3,0)
    *F	(DSPD_NOR=0) .AND. ((STP4>=1 .AND. STP4<=3) .OR. (STP5>=1 .AND. STP5<=6))
    *  DD5_MY=INT((WDATA(3)-CHENDATA(3)-CHENDATA(4)-2048)*A_M_NAME[4,12]/PER/2048)
    *  @ 10,A_M_NAME[4,16]  SAY INT(DD4 +DD5 +DD5_MY)	PICT "9999"
    *ELSE
    XD4=INT((WDATA(3)-2048)*A_M_NAME[4,12]/PER/2048) + REMOTE[4]
    XD4=N_DIV(XD4,DSP_DIV[4])
      @ 10,A_M_NAME[4,16]  SAY XD4   PICT "9999"
    LEDEACH_DSP(0,3,XD4,0)
      XD5=INT((WDATA(4)-2048)*A_M_NAME[5,12]/PER/2048) + REMOTE[5]
    XD5=N_DIV(XD5,DSP_DIV[5])
      @ 10,A_M_NAME[5,16]  SAY XD5   PICT "9999"
    LEDEACH_DSP(0,4,XD5,0)
    *ENDIF
    IF W0DBF=1
      FOR I=1 TO KLCHN
	*IC_X=ALLTRIM(STR(I,2,0))
	*IF (STP&IC_X >=1)
	*  IF  A_PRESS_N0[2,1,I,8]>0
	    A_M_NAME[I,12]=A_M_NAME[I,6]
	*  ENDIF
	*ENDIF
      NEXT
    ENDIF





  case	lchtype =26
    DO	LDSP26
  case	lchtype =8  .OR.  lchtype=16  .or. LCHTYPE=17
    IF STAR=1
      IF     ISDEMO=1	.and. dosign=0
	DO DEMO_INP
      ENDIF
      IF W0DBF=1 .AND. DSPD_NOR=0
	FOR I=1 TO GS_TOT
	  IC_X=ALLTRIM(STR(I,2,0))
	  IF (STP&IC_X >=1)  .OR. (I=1 .AND. STP2 >0)	.OR. (I=3 .AND. STP4 >0)
	    IF	A_PRESS_N0[2,1,I,1]>0
	      x=A_PRESS_N0[2,STPN&IC_X,i,2]
	      A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+x)/(A_PRESS_N0[2,STPN&IC_X,I,1]+x)
	    ENDIF
	  ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	NEXT
      ENDIF
      DD1=INT((CHENDATA(0))*A_M_NAME[1,10]/PER/2048)
      DD2=INT((CHENDATA(1))*A_M_NAME[2,10]/PER/2048)
      DD3=INT((CHENDATA(2))*A_M_NAME[3,10]/PER/2048)-disc2_s3
      DD4=INT((CHENDATA(3))*A_M_NAME[4,10]/PER/2048)
     * DD5=INT((CHENDATA(4))*A_M_NAME[5,10]/PER/2048)
      @ 8,A_M_NAME[1,13]  SAY	 DD1   PICT "9999"
      @ 8,A_M_NAME[2,13]  SAY	DD2   PICT "9999"
      @ 8,A_M_NAME[3,13]  SAY	DD3   PICT "9999"
      @ 8,A_M_NAME[4,13]  SAY	DD4   PICT "9999"
      *@ 8,A_M_NAME[5,13]  SAY	 DD5   PICT "9999"
      IF W0DBF=1  .AND. DSPD_NOR=0

	  IF (STP1 >=1) .or. (stp2 > 0)
	    IF	(A_PRESS_N0[2,stpn1,1,1]>0 )
	      A_M_NAME[1,12]=A_M_NAME[1,6] * A_PRESS_N0[2,STPN1,1,8]/A_PRESS_N0[2,STPn1,1,1]
	    else
	      IF  (A_PRESS_N0[2,stpn2,2,1]>0 )
		A_M_NAME[1,12]=A_M_NAME[1,6] * A_PRESS_N0[2,STPN2,2,8]/A_PRESS_N0[2,STPn2,2,1]
	      endif
	    ENDIF
	  ENDIF
	  IF (STP3 >=1) .or. (stp4 > 0)
	    IF	(A_PRESS_N0[2,stpn3,3,1]>0 )
	      A_M_NAME[2,12]=A_M_NAME[2,6] * A_PRESS_N0[2,STPN3,3,8]/A_PRESS_N0[2,STPn3,3,1]
	    else
	      IF  (A_PRESS_N0[2,stpn4,4,1]>0 )
		A_M_NAME[1,12]=A_M_NAME[1,6] * A_PRESS_N0[2,STPN4,4,8]/A_PRESS_N0[2,STPn4,4,1]
	      endif
	    ENDIF
	  ENDIF
      ENDIF
      A_M_NAME[4,12]=A_M_NAME[4,10]
      IF  W0DBF=1
	FOR I=	1  to GS_TOT
	  *IC_X=ALLTRIM(STR(I,2,0))
	  *IF (STP&IC_X >=1)
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	  *ENDIF
	NEXT
      ENDIF
    ENDIF
    IF	(DSPD_NOR=0) .AND. ((STP1>=1 .AND. STP1<=3) .OR. (STP2>=1 .AND. STP2<=6))
      xad_o= CHENDATA(0) +CHENDATA(1)
      DD2_MY=INT((WDATA(0)-XAD_O-2048)*(DD1+DD2)/XAD_O)
      XD1=INT(DD1 +DD2 +DD2_MY)  + REMOTE[1]
    ELSE
      XD1=INT((WDATA(0)-2048)*A_M_NAME[1,12]/PER/2048)	+ REMOTE[1]
    ENDIF
    XD1=N_DIV(XD1,DSP_DIV[1])
    @ 10,A_M_NAME[1,16] SAY XD1   PICT "9999"
    IF	(DSPD_NOR=0) .AND. ((STP3>=1 .AND. STP3<=3) .OR. (STP4>=1 .AND. STP4<=6))
      xad_o= CHENDATA(2) +CHENDATA(3)
      DD4_MY=INT((WDATA(1)-XAD_O-2048)*(DD3+DD4)/XAD_O)
      XD2=INT(DD3 +DD4 +DD4_MY)  + REMOTE[2]
    ELSE
      XD2=INT((WDATA(1)-2048)*A_M_NAME[2,12]/PER/2048)	+ REMOTE[2]
    ENDIF
    XD2=N_DIV(XD2,DSP_DIV[2])
    @ 10,A_M_NAME[2,16]  SAY  XD2  PICT "9999"
    IF LCHTYPE=16  .or. LCHTYPE=17
       _SEND_RS40D(0,0,XD1)
       _SEND_RS40D(1,0,XD2)
    else
      LEDEACH_DSP(0,0,XD1,0)
      LEDEACH_DSP(0,1,XD2,0)
    ENDIF
    IF W0DBF=1
      FOR I=1 TO KLCHN
	*IC_X=ALLTRIM(STR(I,2,0))
	*IF (STP&IC_X >=1)
	*  IF  A_PRESS_N0[2,1,I,8]>0
	    A_M_NAME[I,12]=A_M_NAME[I,6]
	*  ENDIF
	*ENDIF
      NEXT
    ENDIF
  case	lchtype =21
    do	PRL21
  ENDCASE
  DO  D_UPPER
  mixamp=INT((MIXA()-2048)*MAIN_AMP/2048)
  IF ((MIXAMP <= 10) .OR. (MIXAMP >= MIXMAX))
     SET  COLO	TO  R+ / &C1
     MIX_ERR=1
     @ 14,58 SAY  " 混合"
     @ 15,58 SAY  " 電流"
  ELSE
    IF MIX_ERR=1
      SET COLOR TO &C5 +/ &C1
      @ 14,58 SAY  " 混合"
      @ 15,58 SAY  " 電流"
    ENDIF
     SET  COLO	TO  W+	/ &C1
     MIX_ERR=0
  ENDIF
  X=0
  IF PLOT_ACT=1
    X=1
  ENDIF
  @ 17+X,57 SAY  mixamp   PICT	"999"
  SET  COLO  TO  W+  / &C1
  PWATER=INT((WDATA(15)-2048)*WATER_ADJ/2048)
  IF  WATER_INPUT=0
    @ 17,71 SAY  PWATER  PICT "9999"
  ENDIF
  IF PLOT_E=1
    IF (TANKSTP >0 )   .AND.  (TANKSTP <5)
      IF (SECONDS()-BMP_SN[2]) > PLOT_PN[7]
	DO PLOT_MIXAS
      ENDIF
      DO PLOT_MIXA
    ENDIF
  ENDIF
ENDIF
*______________________________________________________________________________
***SCALE_DSP(W0DBF,DSPD_NOR,STAR,0,
FUNCTION  SCALE_DSP
PARAMETERS  PW0DBF,PDSPD_NOR,PSTAR,WEITR,MAT_TOTW,MAT_STAR,MAT_END
SCALE_DW=MAT_TOTW
*IF (PW0DBF=1) .AND. (PDSPD_NOR=0) .AND. ( PSTAR=1) .AND.  (MAT_TOTW > 0)
IF (PW0DBF=1) .AND. (PDSPD_NOR=0) .AND. ( PSTAR=1) .and. (a_press_n0[2,1,MAT_STAR,1] > 0  .or. a_press_n0[2,1,MAT_STAR,8] > 0 )   .and. (a_press_n0[2,1,MAT_STAR,1] <> a_press_n0[2,1,MAT_STAR,8] )
  FSKIP=1
  FOR I=MAT_STAR TO MAT_END
    IC=NTOC(I)
    IF	STP&IC > 0
      FSKIP=0
      EXIT
    ENDIF
  NEXT
  IF  FSKIP=0
    IC=NTOC(MAT_END)
    *DO CASE
    *CASE   (STP&IC > 0)
      SCALE_X1=WDATA(WEITR)-2048
      SCALE_X2=0
      FOR I=MAT_STAR TO MAT_END
	SCALE_X2=SCALE_X2 + CHENDATA(I-1)
      NEXT
      IF SCALE_X2 > 0
	SCALE_DW=MAT_TOTW * SCALE_X1 /SCALE_X2
      ENDIF
    *ENDCASE
  ENDIF
ELSE
  SCALE_DW= (WDATA(WEITR)-2048)*A_M_NAME[WEITR+1,12]/2048
ENDIF
RETU  SCALE_DW
&&-----------------------------------------------------------------------------
FUNCTION   LEDEACH_DSP
PARAMETERS  PCB_N,CH_N,X_DATA,x_decdsp
x_data1=INT(abs(x_data)  * (10 ^x_decdsp)  )
d1_1=160
d2_0=10
d2_1=160
pch=0
if ch_n <=7
  if X_data < 0
    SIMBOUT[CH_N+1,1]=2 ^ CH_N
  ELSE
    SIMBOUT[CH_N+1,1]=0
  endif
endif
do case
case ch_n >=8
  ch_n=ch_n -8
  pch=64
  if X_data < 0
    SIMBOUT[CH_N+1,2] := 2 ^ CH_N
  ELSE
    SIMBOUT[CH_N+1,2] := 0
  endif
  IF CH_N=1
    MM=SIMBOUT[1,2]+SIMBOUT[2,2]
    _out(576 +2,MM)
    MM=0
    FOR  I=1 TO 8
      MM=MM+SIMBOUT[I,1]
    NEXT
    _out(576,MM)
  ENDIF
case ch_n >=4
  ch_n=ch_n  -4
  pch=1
endcase
d1_0=mod(X_data1,10)
if int(x_data1/10) >0
  d1_1=mod(int(X_data1/10),10)*16
  if int(x_data1/100) >0
    d2_0=mod(int(X_data1/100),10)
    if int(x_data1/1000) >0
      d2_1=mod(int(X_data1/1000),10)*16
    endif
  endif
endif
mm=0
d1=d1_0+d1_1
d2=d2_0+d2_1
_out(LED_IO,d1)
xn=255-(2 ^(ch_n *2))
_out(LED_IO +pch + 1,xn )
_out(LED_IO +pch  + 1,255 )
_out(LED_IO,d2)
xn=255-(2 ^(ch_n *2+1))
_out(LED_IO +pch  + 1,xn )
_out(LED_IO +pch  + 1,255 )
RETU
&&-----------------------------------------------------------------------------
FUNCTION   N_DIV
PARAMETERS  NDX,NDIV
NDX=INT((NDX +(0.49 * NDIV))/NDIV )  * NDIV
RETU  NDX
&&-----------------------------------------------------------------------------
PROCEDURE   D_UPPER
PARAMETERS  P1,P2,P3
DO CASE
CASE  UCHTYPE=1
  STOR	0  TO  DD1,DD2,DD3,DD4,DD5,DD6,DD7
  IF STAR=1
    IF W0DBF=1 .AND. DSPD_NOR=0
       IF (STP6 > 0 )  .OR. (STP7 >0)
	 IF  A_PRESS_N0[2,STPN6,6,1] <> 0
	   A_M_NAME[6,10]=A_M_NAME[6,9] * A_PRESS_N0[2,STPN6,6,8]/A_PRESS_N0[2,STPN6,6,1]
	 ENDIF
	 IF  A_PRESS_N0[2,STPN7,7,1] <> 0
	   A_M_NAME[7,10]=A_M_NAME[7,9] * A_PRESS_N0[2,STPN7,7,8]/A_PRESS_N0[2,STPN7,7,1]
	 ENDIF
       ENDIF
       IF (STP8 > 0 )
	 IF  A_PRESS_N0[2,STPN8,8,1] <> 0
	   A_M_NAME[8,10]=A_M_NAME[8,9] * A_PRESS_N0[2,STPN8,8,8]/A_PRESS_N0[2,STPN8,8,1]
	 ENDIF
       ENDIF
       IF (STP9 > 0 )  .OR. (STP10 >0)
	 IF  A_PRESS_N0[2,STPN9,9,1] <> 0
	   A_M_NAME[9,10]=A_M_NAME[9,9] * A_PRESS_N0[2,STPN9,9,8]/A_PRESS_N0[2,STPN9,9,1]
	 ENDIF
	 IF  A_PRESS_N0[2,STPN10,10,1] <> 0
	   A_M_NAME[10,10]=A_M_NAME[10,9] * A_PRESS_N0[2,STPN10,10,8]/A_PRESS_N0[2,STPN10,10,1]
	 ENDIF
       ENDIF
       IF (STP11 > 0 )
	 IF  A_PRESS_N0[2,STPN11,11,1] <> 0
	   A_M_NAME[11,10]=A_M_NAME[11,9] * A_PRESS_N0[2,STPN11,11,8]/A_PRESS_N0[2,STPN11,11,1]
	 ENDIF
       ENDIF
       IF (STP12 > 0 )
	 IF  A_PRESS_N0[2,STPN12,12,1] <> 0
	   A_M_NAME[12,10]=A_M_NAME[12,9] * A_PRESS_N0[2,STPN12,12,8]/A_PRESS_N0[2,STPN12,12,1]
	 ENDIF
       ENDIF
    ENDIF
    DD1=INT((CHENDATA(5))*A_M_NAME[6,10]/PER/2048)
    DD2=INT((CHENDATA(6))*A_M_NAME[7,10]/PER/2048)
    DD3=INT((CHENDATA(7))*A_M_NAME[8,10]/PER/2048)
    DD4=INT((CHENDATA(8))*A_M_NAME[9,10]/PER/2048)
    DD5=INT((CHENDATA(9))*A_M_NAME[10,10]/PER/2048)
    DD6=INT((CHENDATA(10))*A_M_NAME[11,10]*100/PER/2048)/100
    DD7=INT((CHENDATA(11))*A_M_NAME[12,10]*100/PER/2048)/100

    @ 8,A_M_NAME[6,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[8,13]	   SAY	 DD3   PICT "9999"
    @ 8,A_M_NAME[9,13]	   SAY	 DD4   PICT "9999"
    @ 8,A_M_NAME[10,13]     SAY   DD5	PICT "9999"
    ICS=A_M_NAME[11,3]
    @ 8,A_M_NAME[11,13]     SAY   DD6	PICT "&ICS"
    ICS=A_M_NAME[12,3]
    @ 8,A_M_NAME[12,13]     SAY   DD7	PICT "&ICS"
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF
  DD1=SCALE_DSP(W0DBF,DSPD_NOR,STAR,KLCHN+0,DD1+DD2,GS_TOT+1,GS_TOT+2)
  DD2=SCALE_DSP(W0DBF,DSPD_NOR,STAR,KLCHN+1,DD3,GS_TOT+3,GS_TOT+3)
  DD3=SCALE_DSP(W0DBF,DSPD_NOR,STAR,KLCHN+2,DD4+DD5,GS_TOT+4,GS_TOT+5)
  DD4=SCALE_DSP(W0DBF,DSPD_NOR,STAR,KLCHN+3,DD6,GS_TOT+6,GS_TOT+6)
  DD5=SCALE_DSP(W0DBF,DSPD_NOR,STAR,KLCHN+4,DD7,GS_TOT+7,GS_TOT+7)
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  DD3=N_DIV(DD3,DSP_DIV[KLCHN+3])
  DD4=N_DIV(DD4*100,DSP_DIV[KLCHN+4]) /100
  DD5=N_DIV(DD5*100,DSP_DIV[KLCHN+5])/100
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  @ 10,38  SAY DD1   PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  @ 10,47  SAY DD2   PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  @ 10,57  SAY DD3     PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  @ 10,67  SAY DD4   PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  @ 10,74  SAY DD5   PICT "&XDSPC"
  &&DA726(int(IO_726+2),INT(2048+2048*(DD1/DA_MAX2)))
  &&DA726(int(IO_726+4),INT(2048+2048*(DD2/DA_MAX3)))
  &&x_x1=int(IO_726+6)
  &&x_x2=INT(2048 + (2048*DD3/DA_MAX4))
  &&DA726(x_x1,x_x2)
  &&DA726(int(IO_726+8),INT(2048+2048*(DD4/DA_MAX5)))
  _SEND_RS40D(KLCHN,0,DD1)
  _SEND_RS40D(KLCHN+1,0,DD2)
  _SEND_RS40D(KLCHN+2,0,DD3)
  _SEND_RS40D(KLCHN+3,2,DD4)
  _SEND_RS40D(KLCHN+4,2,DD5)
CASE  UCHTYPE=2
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (STP&IC_X >=1)  .OR. (I=8 .AND. STP9 >0)
	  IF  A_PRESS_N0[2,1,I,1]>0
	    A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	  ELSE
	    A_M_NAME[I,10]=1
	  ENDIF
	ELSE
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	ENDIF
      NEXT
    ENDIF
    DD1=INT((CHENDATA(5))*A_M_NAME[6,10]/PER/2048)
    DD2=INT((CHENDATA(6))*A_M_NAME[7,10]/PER/2048)
    DD3=INT((CHENDATA(7))*A_M_NAME[8,10]/PER/2048)
    DD4=INT((CHENDATA(8))*A_M_NAME[9,10]/PER/2048)
    DD5=((CHENDATA(9))*A_M_NAME[10,10]/PER/2048)
    DD6=INT((CHENDATA(10))*A_M_NAME[11,10]*100/PER/2048)/100
    DD7=INT((CHENDATA(11))*A_M_NAME[12,10]*100/PER/2048)/100
    @ 8,A_M_NAME[6,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[8,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[10,3]
    @ 8,A_M_NAME[10,13]     SAY   DD5	PICT "&ICS"
    IF A_M_NAME[11,13]	<>0
      ICS=A_M_NAME[11,3]
      @ 8,A_M_NAME[11,13]     SAY   DD6   PICT "&ICS"
    ENDIF
    IF A_M_NAME[12,13]	<>0
      ICS=A_M_NAME[12,3]
      @ 8,A_M_NAME[12,13]     SAY   DD7   PICT "&ICS"
    ENDIF
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+5,10]

    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      *IC_X=ALLTRIM(STR(I,2,0))
      *IF (STP&IC_X >=1)
	A_M_NAME[I,10]=A_M_NAME[I,9]
      *ENDIF
    NEXT
  ENDIF

  DD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  IF (DSPD_NOR=0) .AND. ((STP8>=1 .AND. STP8<=3) .OR. (STP9>=1 .AND. STP9<=5))
    DD3=DD3+DD4
    DD3_MY=INT(((WDATA(KLCHN+2)-2048-CHENDATA(7)-CHENDATA(8))*A_M_NAME[KLCHN+3,12])/PER/2048)
  ELSE
    DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
    DD3_MY=0
  ENDIF
  DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048)
  DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"

  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY (DD3 + DISC2_C2N)+DD3_MY   PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  IF A_M_NAME[KLCHN+5,16]  <>0
    @ 10,A_M_NAME[KLCHN+5,16]	SAY DD5   PICT "&XDSPC"
  ENDIF

  DA726(int(IO_726+2),INT(2048+2048*(DD1/DA_MAX2)))
  DA726(int(IO_726+4),INT(2048+2048*(DD2/DA_MAX3)))
  x_x1=int(IO_726+6)
  x_x2=INT(2048 + (2048*DD3/DA_MAX4))
  DA726(x_x1,x_x2)
  DA726(int(IO_726+8),INT(2048+2048*(DD4/DA_MAX5)))
CASE  UCHTYPE=99
   DO  DSP2_UP99
CASE  UCHTYPE=5
   DO  DSP2_UP5
CASE  UCHTYPE=8
   DO  DSP2_UP8
CASE  UCHTYPE=6
   DO  DSP2_UP6
CASE  UCHTYPE=7
   DO  DSP2_UP7
CASE  UCHTYPE=26  .or.	UCHTYPE=32
   DO  DSP2_UP26
CASE  UCHTYPE=9
   DO  DSP2_UP9
CASE  UCHTYPE=91
   DO  DSP2_UP92
CASE  UCHTYPE=10
   DO  DSP2_UP10
CASE  UCHTYPE=11
   DO  DSP2_UP11
CASE  UCHTYPE=12
   DO  DSP2_UP12
CASE  UCHTYPE=13
   DO  DSP2_UP13
CASE  UCHTYPE=15
   DO  DSP2_UP15
CASE  UCHTYPE=16
   DO  DSP2_UP16
CASE  UCHTYPE=17
   DO  DSP2_UP17
CASE  UCHTYPE=18
   DO  DSP2_UP18
CASE  UCHTYPE=19
   DO  DSP2_UP19
CASE  UCHTYPE=21
  DO  DSP2_UP21
CASE  UCHTYPE=22
   DO  DSP2_UP22
CASE  UCHTYPE=30
   DO  DSP2_UP30
CASE  UCHTYPE=31
   DO  DSP2_UP31
CASE  UCHTYPE=33
   DO  DSP2_UP33
 CASE  UCHTYPE=34
    DO	DSP2_UP34



ENDCASE
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP_SPACIAL
PARAMETERS  P1,P2,P3
if spacial_0=1
  SET COLOR TO GR+ / &C1
  @ 12,47			  SAY " 秒  優質水泥拌合流程"
  SET COLOR TO W+ / &C1
  @ 13,41 SAY "拌合１   "
  @ 14,41 SAY "拌合２   "
  @ 15,41 SAY "拌合３   "
  @ 13,48  SAY	SPACMIXTM[1,1]	PICT  "99"
  @ 14,48  SAY	SPACMIXTM[2,1]	PICT  "99"
 *@ 16,52 SAY  SPACMIXTM[3,1] PICT "99"
  SET COLOR TO &C2 / &C1
else
  if  lchtype <> 21
    SET COLOR TO &C2 / &C1
    @ 12,47 SAY "                     "
    *@ 13,47 SAY "         "
    @ 13,47			    SAY "───────────────┐"
    *@ 13,51			      SAY "─────────────┐"
    @ 14,41 SAY "         "
    @ 15,41 SAY "         "
    SET COLOR TO W+  / &C1
    @ 16,52 SAY  PMIXTM PICT "99"
    SET COLOR TO &C2 / &C1
  endif
endif
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP91
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (STP&IC_X >=1)  .OR. (I=8 .AND. STP9 >0)
	  IF  A_PRESS_N0[2,1,I,1]>0
	    A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ELSE
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	ENDIF
      NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[5,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[6,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[8,10]/PER/2048)
    DD5=((CHENDATA(GS_TOT +4))*A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+5,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+6,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  DD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  if A_M_NAME[KLCHN+4,12] >2
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048)
  ELSE
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)
  ENDIF
  DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY (DD3 + DISC2_C2N)   PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  @ 10,A_M_NAME[KLCHN+5,16]   SAY DD5	PICT "&XDSPC"
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP92
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (STP&IC_X >=1)  .OR. (I=7 .AND. STP8 >0)   .OR. (I=9 .AND. STP10 >0)
	  IF  A_PRESS_N0[2,1,I,1]>0
	    A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ELSE
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	ENDIF
      NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[5,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[6,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[8,10]/PER/2048)
    DO	CASE
    CASE  ((STP7>0) .OR.(STP8>0))    .AND. DSPD_NOR=0
	DO  CASE
	CASE	(A_PRESS_N0[2,STPN7,7,8]=0)  .AND. (A_PRESS_N0[2,STPN7,7,1]>0)	  .AND.  (A_PRESS_N0[2,STPN8,8,1] =0)	.AND.  (A_PRESS_N0[2,STPN8,8,8]>0)
	       DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,9]/PER/2048)
	       X= A_PRESS_N0[2,STPN7,7,8]
	       X1= A_PRESS_N0[2,STPN7,7,8]+A_PRESS_N0[2,STPN8,8,8]
	       X2= A_PRESS_N0[2,STPN7,7,1]+A_PRESS_N0[2,STPN8,8,1]
	       DD4=DD3 *X1/X2
	       DD3=0
	       TEMP_CAL[4,7]=0
	       TEMP_CAL[4,8]=-1
	CASE	(A_PRESS_N0[2,STPN7,7,8]>0)  .AND. (A_PRESS_N0[2,STPN7,7,1]=0)	  .AND.  (A_PRESS_N0[2,STPN8,8,1] >0)	.AND.  (A_PRESS_N0[2,STPN8,8,8]=0)
	       DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[8,9]/PER/2048)
	       X= A_PRESS_N0[2,STPN7,7,8]
	       X1= A_PRESS_N0[2,STPN7,7,8]+A_PRESS_N0[2,STPN8,8,8]
	       X2= A_PRESS_N0[2,STPN7,7,1]+A_PRESS_N0[2,STPN8,8,1]
	       DD3=DD4 *X1/X2
	       DD4=0
	       TEMP_CAL[4,7]=-1
	       TEMP_CAL[4,8]=0
	CASE	(A_PRESS_N0[2,STPN7,7,8]>0)  .AND. (A_PRESS_N0[2,STPN7,7,1]=0)	  .AND.  (A_PRESS_N0[2,STPN8,8,1]>0)	 .AND.	(A_PRESS_N0[2,STPN8,8,8]>0)
		 IF   (A_PRESS_N0[2,STPN7,7,8]>0)  .AND. (A_PRESS_N0[2,STPN7,7,1]=0)	.AND.  (A_PRESS_N0[2,STPN8,8,1]>0)
		   DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[8,9]/PER/2048)
		   X= A_PRESS_N0[2,STPN7,7,8]-STANDW_ERR[7]
		   X1= A_PRESS_N0[2,STPN7,7,8]+A_PRESS_N0[2,STPN8,8,8]
		   X2= A_PRESS_N0[2,STPN7,7,1]+A_PRESS_N0[2,STPN8,8,1]
		   X3=DD4 *X1/X2
		   IF (X3 <X)
		     TEMP_CAL[3,7]=X3
		     TEMP_CAL[4,7]=-1
		     DD3=X3
		     DD4=0
		   ELSE
		     IF (TEMP_CAL[4,7]<>1)
		       X=GET_RND(STANDW_ERR[7])
		       X= A_PRESS_N0[2,STPN7,7,8]+X
		       TEMP_CAL[3,7]=X
		       TEMP_CAL[4,7]=1
		       TEMP_CAL[4,8]=-1
		     ENDIF
		      DD3= TEMP_CAL[3,7]
		      DD4=X3-DD3
		   ENDIF
		 ENDIF
	CASE	(A_PRESS_N0[2,STPN7,7,8]>0)  .AND. (A_PRESS_N0[2,STPN7,7,1]>0)	  .AND.  (A_PRESS_N0[2,STPN8,8,1]=0)	 .AND.	(A_PRESS_N0[2,STPN8,8,8]>0)
		   DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,9]/PER/2048)
		   X= A_PRESS_N0[2,STPN7,7,8]-STANDW_ERR[7]
		   X1= A_PRESS_N0[2,STPN7,7,8]+A_PRESS_N0[2,STPN8,8,8]
		   X2= A_PRESS_N0[2,STPN7,7,1]+A_PRESS_N0[2,STPN8,8,1]
		   X3=DD3 *X1/X2
		   IF (X3 <X)
		     TEMP_CAL[3,7]=X3
		     TEMP_CAL[4,7]=-1
		     DD3=X3
		     DD4=0
		   ELSE
		     IF (TEMP_CAL[4,7]<>1)
		       X=GET_RND(STANDW_ERR[7])
		       X= A_PRESS_N0[2,STPN7,7,8]+X
		       TEMP_CAL[3,7]=X
		       TEMP_CAL[4,7]=1
		       TEMP_CAL[4,8]=-1
		     ENDIF
		     TEMP_CAL[4,8]=-1
		      DD3= TEMP_CAL[3,7]
		      DD4=X3-DD3
		   ENDIF
	CASE	(A_PRESS_N0[2,STPN7,7,8]=0) .and.  (A_PRESS_N0[2,STPN8,8,1]=0)
		     TEMP_CAL[4,7]=0
		     TEMP_CAL[4,8]=0

	  ENDCASE
    ENDCASE
    DD5=((CHENDATA(GS_TOT +4))*A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+5,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+6,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  DD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  IF  (DSPD_NOR=0) .AND. (STP7>=1 .OR. STP8>1)
    IF	(DSPD_NOR=0) .AND. (STP7>=1 .OR. STP8 <=3)
      DD3=INT(DD3 +DD4 )
    ELSE
      DD3_MY=INT((WDATA(KLCHN+2)-CHENDATA(GS_TOT +2)-CHENDATA(GS_TOT +3)-2048)*A_M_NAME[KLCHN+3,6]/PER/2048)
      DD3=INT((DD3 +DD4 +DD3_MY))
    ENDIF
  ELSE
    DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  ENDIF





  IF (STP8 >0)
  ENDIF
  *if A_M_NAME[KLCHN+4,12] >2
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048)
  *ELSE
  *  DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)
  *ENDIF
  DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY (DD3 + DISC2_C2N)   PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"

  **XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  **@ 10,A_M_NAME[KLCHN+5,16]	SAY DD5   PICT "&XDSPC"
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    **A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------

PROCEDURE   DSP2_UP9
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (STP&IC_X >=1)  .OR. (I=8 .AND. STP9 >0)
	  IF  A_PRESS_N0[2,1,I,1]>0
	    A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ELSE
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	ENDIF
      NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[5,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[6,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[8,10]/PER/2048)
    DD5=((CHENDATA(GS_TOT +4))*A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+5,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+6,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  DD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  if A_M_NAME[KLCHN+4,12] >2
    DD4=INT((((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048) * 100)/100
  ELSE
    DD4=INT((((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048) *100)/100
  ENDIF
  *DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY (DD3 + DISC2_C2N)   PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
  IF LED_IO >0
    LED_DSP(1,0,DD1,0)
    LED_DSP(1,1,DD2,0)
    LED_DSP(1,2,DD3,0)
    LED_DSP(1,3,DD4 * 100,2)
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP7
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	 IC_X=ALLTRIM(STR(I,2,0))
	 IF (STP&IC_X >=1)  .OR. (I=8 .AND. STP9 >0)
	   IF  A_PRESS_N0[2,1,I,1]>0
	     A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	   ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	   ENDIF
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	 ENDIF
       NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[klchn+1,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT+1))*A_M_NAME[klchn+2,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT+2))*A_M_NAME[klchn+3,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[klchn+4,10]/PER/2048)
    DD5=((CHENDATA(GS_TOT +4))*A_M_NAME[klchn+5,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[klchn+6,10]*100/PER/2048)/100
    @ 8,A_M_NAME[GS_TOT +1,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[GS_TOT +2,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[GS_TOT +3,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[GS_TOT +4,3]
    @ 8,A_M_NAME[GS_TOT +4,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[GS_TOT +5,3]
    @ 8,A_M_NAME[GS_TOT +5,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[GS_TOT +6,13]  <>0
      ICS=A_M_NAME[GS_TOT +6,3]
      @ 8,A_M_NAME[GS_TOT +6,13]     SAY   DD6	 PICT "&ICS"
    ENDIF
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+4,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+6,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  DD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048) + REMOTE[6]
  DD1=N_DIV(DD1,DSP_DIV[6])
  DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048) + REMOTE[7]
  DD2=N_DIV(DD2,DSP_DIV[7])
  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048) + REMOTE[8]
  DD3=N_DIV(DD3,DSP_DIV[8])
  *if A_M_NAME[KLCHN+4,12] >2
    DD4=INT(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048) + REMOTE[9]
  DD4=N_DIV(DD4,DSP_DIV[9])
    DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048) + (REMOTE[10]/100)
    DD5_0=int(N_DIV(DD5*100,DSP_DIV[10] *100))
    dd5=dd5_0 /100
  *ELSE
  *  DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)
  *ENDIF
  W_1=DD2
  W_2=DD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  LEDEACH_DSP(0,5,DD1,0)
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  LEDEACH_DSP(0,6,DD2,0)
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY (DD3 + DISC2_C2N)   PICT "&XDSPC"
  LEDEACH_DSP(0,7,(DD3 + DISC2_C2N) ,0)
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
  LEDEACH_DSP(0,8,DD4,0)
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  @ 10,A_M_NAME[KLCHN+5,16]   SAY DD5	PICT "&XDSPC"
  LEDEACH_DSP(0,9,dd5_0,0)
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+6,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP6
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	 IC_X=ALLTRIM(STR(I,2,0))
	 IF ((STP&IC_X >=1)   .and. (STP&IC_X <7 ) )  .OR. (I=5 .AND. STP6 >0)	  .OR. (I=8 .AND. STP9 >0)
	   IF  A_PRESS_N0[2,STPN&IC_X,I,1]>0
	     A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	   ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	   ENDIF
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	 ENDIF
       NEXT
    ENDIF
    XNDD1=  CHENDATA(GS_TOT)
    XNDD2=  CHENDATA(GS_TOT +1)
    XDSPC=RIGHT(ALLTRIM(A_M_NAME[KLCHN+1,3]),2)
    IF XDSPC="."
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/204.8)/10
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/204.8)/10
    ELSE
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/2048)
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/2048)
    ENDIF
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    XNDD4=  CHENDATA(GS_TOT +3)
    DD4=INT( XNDD4  *A_M_NAME[8,10]/PER/2048)
    XNDD5=  CHENDATA(GS_TOT +4)
    DD5=( XNDD5  *A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    DD7=INT((CHENDATA(GS_TOT +6))*A_M_NAME[11,10]*100/PER/2048)/100
    XDD1=DD1
    XDD2=DD2
    XDD4=DD4
    XDD5=DD5
    ICS=A_M_NAME[5,3]
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "&ICS"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT  "&ICS"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
    ICS=A_M_NAME[11,3]
    @ 8,A_M_NAME[11,13]     SAY   DD7	PICT "&ICS"

  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+4,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+6,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+7,10]
  ENDIF

  DD1=(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  if  (stp6>0 .and.  stp6 <=3 )  .or.  ( stp5 >0 )
    IF	(A_M_NAME[GS_TOT +1,10] <>A_M_NAME[GS_TOT +1,9])  .OR.	(A_M_NAME[GS_TOT +2,10] <>A_M_NAME[GS_TOT +2,9])
      DD1=XDD1+XDD2
    ENDIF
  ELSEIF (STP6 >3  )   .AND.  (STP6 <=6 )
    DD1=(WDATA(KLCHN+0)-2048) * (XDD1 +XDD2)/ ( XNDD1+XNDD2)
  ENDIF
  if DSPDATA_A[3]=1
    DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
    ACTWEIT_A[KLCHN+1] :=DD2
  ELSE
    DD2 := ACTWEIT_A[KLCHN+1]
  ENDIF
  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  if  (stp9>0 .and.  stp9 <=3 )  .or.  ( stp8 >0 )
    IF	(A_M_NAME[GS_TOT +4,10] <>A_M_NAME[GS_TOT +4,9])  .OR.	(A_M_NAME[GS_TOT +5,10] <>A_M_NAME[GS_TOT +5,9])
      DD3=XDD4+XDD5
    ENDIF
  ELSEIF (STP9 >3  )   .AND.  (STP9 <=6 )
    DD3=(WDATA(KLCHN+2)-2048) * (XDD4 +XDD5)/ ( XNDD4+XNDD5)
  ENDIF
  *if A_M_NAME[KLCHN+4,12] >2
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048)
  *ELSE
  *  DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)
  *ENDIF
  DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  DD3=N_DIV(DD3,DSP_DIV[KLCHN+3])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY DD3	 PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  DD4=N_DIV(DD4,DSP_DIV[KLCHN+4])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  DD5=N_DIV(DD5,DSP_DIV[KLCHN+5])
  @ 10,A_M_NAME[KLCHN+5,16]   SAY DD5	PICT "&XDSPC"
  IF LCHTYPE=6
    XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
    IF SUBSTR(XDSPC,-2,1) ="."
      XDSPC=1
    ELSE
      XDSPC=0
    ENDIF
     _SEND_RS40D(KLCHN+0,XDSPC,DD1)
     _SEND_RS40D(KLCHN+1,0,DD2)

     _SEND_RS40D(KLCHN+2,0,DD3)
     _SEND_RS40D(KLCHN+3,2,DD4)
     _SEND_RS40D(KLCHN+4,2,DD5)
  ENDIF


  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP8
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (STP&IC_X >=1)  .OR. (I=6 .AND. STP7 >0)    .OR. (I=8 .AND. STP9 >0)
	  IF  A_PRESS_N0[2,1,I,1]>0
	    A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ELSE
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	ENDIF
      NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[5,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[6,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[8,10]/PER/2048)
    DD5=((CHENDATA(GS_TOT +4))*A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    DD7=INT((CHENDATA(GS_TOT +6))*A_M_NAME[11,10]*100/PER/2048)/100
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
    IF A_M_NAME[11,13]	<>0
      ICS=A_M_NAME[11,3]
      @ 8,A_M_NAME[11,13]     SAY   DD7   PICT "&ICS"
    ENDIF
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+4,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+6,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+7,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  XD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048) + REMOTE[3]
  XD1=N_DIV(XD1,DSP_DIV[3])
  IF  (DSPD_NOR=0) .AND. ((STP6>=1 .AND. STP6<=3) .OR. (STP7>=1 .AND. STP7<=6))
    DD3_MY=INT((WDATA(KLCHN+1)-CHENDATA(GS_TOT +1)-CHENDATA(GS_TOT +2)-2048)*A_M_NAME[KLCHN+2,12]/PER/2048)
    XD2=INT(DD2 +DD3 +DD3_MY)  + REMOTE[4]
  ELSE
    XD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048) + REMOTE[4]
  ENDIF
  XD2=N_DIV(XD2,DSP_DIV[4])
  IF  (DSPD_NOR=0) .AND. ((STP6>=1 .AND. STP6<=3) .OR. (STP7>=1 .AND. STP7<=6))
    DD5_MY=INT((WDATA(KLCHN+2)-CHENDATA(GS_TOT +3)-CHENDATA(GS_TOT +4)-2048)*A_M_NAME[KLCHN+3,12]/PER/2048)
    XD3=INT(DD4 +DD5 +DD5_MY)  + REMOTE[5]
  ELSE
    XD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])*PERCON/PER/2048) + REMOTE[5]
  ENDIF
  XD3=N_DIV(XD3,DSP_DIV[5])
  if A_M_NAME[KLCHN+4,12] >2
    XD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048) + (REMOTE[6]/100)
  ELSE
    XD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)	+ (REMOTE[6]  /100)
  ENDIF
  XD4=N_DIV(XD4,DSP_DIV[6])
  XD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)  + (REMOTE[7] /100)
  XD5=N_DIV(XD5,DSP_DIV[7])
  W_1=XD2
  W_2=XD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY XD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY XD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY (XD3 + DISC2_C2N)   PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY XD4	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  XD5= INT(XD5 *100)/100
  @ 10,A_M_NAME[KLCHN+5,16]   SAY XD5	PICT "&XDSPC"
    LEDEACH_DSP(0,2,XD1,0)
    LEDEACH_DSP(0,3,XD2,0)
    LEDEACH_DSP(0,4,XD3,0)
    LEDEACH_DSP(0,5,XD4,2)
    LEDEACH_DSP(0,6,XD5,2)
    LEDEACH_DSP(0,9,-5,0)
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP5
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (STP&IC_X >=1)  .OR. (I=8 .AND. STP9 >0)
	  IF  A_PRESS_N0[2,1,I,1]>0
	    A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ELSE
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	ENDIF
      NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[5,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[6,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[8,10]/PER/2048)
    DD5=((CHENDATA(GS_TOT +4))*A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    DD7=INT((CHENDATA(GS_TOT +6))*A_M_NAME[11,10]*100/PER/2048)/100
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
    IF A_M_NAME[11,13]	<>0
      ICS=A_M_NAME[11,3]
      @ 8,A_M_NAME[11,13]     SAY   DD7   PICT "&ICS"
    ENDIF
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+5,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+6,10]
    A_M_NAME[KLCHN+6,12]=A_M_NAME[GS_TOT+7,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  DD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  if A_M_NAME[KLCHN+4,12] >2
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048)
  ELSE
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)
  ENDIF
  DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  DD6=(((WDATA(KLCHN+5)-2048)*A_M_NAME[KLCHN+6,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY (DD3 + DISC2_C2N)   PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  @ 10,A_M_NAME[KLCHN+5,16]   SAY DD5	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+6,5])
  @ 10,A_M_NAME[KLCHN+6,16]   SAY DD6	PICT "&XDSPC"
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
    A_M_NAME[KLCHN+6,12]=A_M_NAME[KLCHN+6,6]
  ENDIF
RETU
&&-----/-----------------------------------------------------------------------
&&-----------------------------------------------------------------------------
FUNCTION   LED_DSP
PARAMETERS  PCB_N,CH_N,X_DATA,x_decdsp
x_data1=abs(x_data)
d1_1=160
d2_0=10
d2_1=160
d1_0=mod(X_data1,10)
if (int(x_data1/10) >0)  .or. (x_decdsp>0 )
  d1_1=mod(int(X_data1/10),10)*16
  if (int(x_data1/100) >0)   .or. (x_decdsp>1 )
    d2_0=mod(int(X_data1/100),10)
    if (int(x_data1/1000) >0)	.or. (x_decdsp>2 )
      d2_1=mod(int(X_data1/1000),10)*16
    endif
  endif
endif
mm=0
d1=d1_0+d1_1
d2=d2_0+d2_1
if X_data < 0
  mm=128
endif
_out(LED_IO,d1)
_out(LED_IO+2,d2)
_out(LED_IO+4,(4*PCB_N)+CH_N+mm)
_out(LED_IO+4,(4*PCB_N)+CH_N+mm+16)
_Out(LED_IO+4,17)
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP10
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (STP&IC_X >=1)  .OR. (I=6 .AND. STP7 >0)    .OR. (I=8 .AND. STP9 >0)
	  IF  A_PRESS_N0[2,1,I,1]>0
	    A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ELSE
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	ENDIF
      NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[5,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[6,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[8,10]/PER/2048)
    DD5=((CHENDATA(GS_TOT +4))*A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+4,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+6,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  XD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048) + REMOTE[3]
  XD1=N_DIV(XD1,DSP_DIV[3])
  IF  (DSPD_NOR=0) .AND. ((STP6>=1 .AND. STP6<=3) .OR. (STP7>=1 .AND. STP7<=6))
    DD3_MY=INT((WDATA(KLCHN+1)-CHENDATA(GS_TOT +1)-CHENDATA(GS_TOT +2)-2048)*A_M_NAME[KLCHN+2,12]/PER/2048)
    XD2=INT(DD2 +DD3 +DD3_MY)  + REMOTE[4]
  ELSE
    XD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048) + REMOTE[4]
  ENDIF
  XD2=N_DIV(XD2,DSP_DIV[4])
  IF  (DSPD_NOR=0) .AND. ((STP6>=1 .AND. STP6<=3) .OR. (STP7>=1 .AND. STP7<=6))
    DD5_MY=INT((WDATA(KLCHN+2)-CHENDATA(GS_TOT +3)-CHENDATA(GS_TOT +4)-2048)*A_M_NAME[KLCHN+3,12]/PER/2048)
    XD3=INT(DD4 +DD5 +DD5_MY)  + REMOTE[5]
  ELSE
    XD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])*PERCON/PER/2048) + REMOTE[5]
  ENDIF
  XD3=N_DIV(XD3,DSP_DIV[5])
  if A_M_NAME[KLCHN+4,12] >2
    XD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048) + (REMOTE[6]/100)
  ELSE
    XD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)	+ (REMOTE[6]  /100)
  ENDIF
  XD4=N_DIV(XD4 * 100,DSP_DIV[6]) /100
  XD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)  + (REMOTE[7] /100)
  XD5=N_DIV(XD5,DSP_DIV[7])
  W_1=XD2
  W_2=XD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY XD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY XD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY (XD3 + DISC2_C2N)   PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY XD4	PICT "&XDSPC"

  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP11
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	 IC_X=ALLTRIM(STR(I,2,0))
	 IF ((STP&IC_X >=1)   .and. (STP&IC_X <7 ) )  .OR. (I=5 .AND. STP6 >0)	  .OR. (I=8 .AND. STP9 >0)
	   IF  A_PRESS_N0[2,STPN&IC_X,I,1]>0
	     A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	   ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	   ENDIF
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	 ENDIF
       NEXT
    ENDIF
    XNDD1=  CHENDATA(GS_TOT)
    XNDD2=  CHENDATA(GS_TOT +1)
    XDSPC=RIGHT(ALLTRIM(A_M_NAME[KLCHN+1,3]),2)
    IF XDSPC="."
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/204.8)/10
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/204.8)/10
    ELSE
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/2048)
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/2048)
    ENDIF
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    XNDD4=  CHENDATA(GS_TOT +3)
    DD4=INT( XNDD4  *A_M_NAME[8,10]/PER/2048)
    XNDD5=  CHENDATA(GS_TOT +4)
    DD5=( XNDD5  *A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    &&DD7=INT((CHENDATA(GS_TOT +6))*A_M_NAME[11,10]*100/PER/2048)/100
    XDD1=DD1
    XDD2=DD2
    XDD4=DD4
    XDD5=DD5
    ICS=A_M_NAME[5,3]
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "&ICS"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT  "&ICS"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
    &&ICS=A_M_NAME[11,3]
    &&@ 8,A_M_NAME[11,13]     SAY   DD7   PICT "&ICS"

  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+4,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+6,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+7,10]
  ENDIF

  DD1=(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  if  (stp6>0 .and.  stp6 <=3 )  .or.  ( stp5 >0 )
    IF	(A_M_NAME[GS_TOT +1,10] <>A_M_NAME[GS_TOT +1,9])  .OR.	(A_M_NAME[GS_TOT +2,10] <>A_M_NAME[GS_TOT +2,9])
      DD1=XDD1+XDD2
    ENDIF
  ELSEIF (STP6 >3  )   .AND.  (STP6 <=6 )
    DD1=(WDATA(KLCHN+0)-2048) * (XDD1 +XDD2)/ ( XNDD1+XNDD2)
  ENDIF
  DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  if  (stp9>0 .and.  stp9 <=3 )  .or.  ( stp8 >0 )
    IF	(A_M_NAME[GS_TOT +4,10] <>A_M_NAME[GS_TOT +4,9])  .OR.	(A_M_NAME[GS_TOT +5,10] <>A_M_NAME[GS_TOT +5,9])
      DD3=XDD4+XDD5
    ENDIF
  ELSEIF (STP9 >3  )   .AND.  (STP9 <=6 )
    DD3=(WDATA(KLCHN+2)-2048) * (XDD4 +XDD5)/ ( XNDD4+XNDD5)
  ENDIF
  *if A_M_NAME[KLCHN+4,12] >2
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048)
  *ELSE
  *  DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)
  *ENDIF
  DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY DD3	 PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"

  &&XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  &&@ 10,A_M_NAME[KLCHN+5,16]	SAY DD5   PICT "&XDSPC"


  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    &&A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP12
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	 IC_X=ALLTRIM(STR(I,2,0))
	 IF ((STP&IC_X >=1)   .and. (STP&IC_X <7 ) )  .OR. (I=5 .AND. STP6 >0)	  .OR. (I=8 .AND. STP9 >0)
	   IF  A_PRESS_N0[2,STPN&IC_X,I,1]>0
	     A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	   ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	   ENDIF
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	 ENDIF
       NEXT
    ENDIF
    XNDD1=  CHENDATA(GS_TOT)
    XNDD2=  CHENDATA(GS_TOT +1)
    XDSPC=RIGHT(ALLTRIM(A_M_NAME[KLCHN+1,3]),2)
    IF XDSPC="."
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/204.8)/10
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/204.8)/10
    ELSE
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/2048)
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/2048)
    ENDIF
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    XNDD4=  CHENDATA(GS_TOT +3)
    DD4=INT( XNDD4  *A_M_NAME[8,10]/PER/2048)
    XNDD5=  CHENDATA(GS_TOT +4)
    DD5=( XNDD5  *A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    DD7=INT((CHENDATA(GS_TOT +6))*A_M_NAME[11,10]*100/PER/2048)/100
    XDD1=DD1
    XDD2=DD2
    XDD4=DD4
    XDD5=DD5
    ICS=A_M_NAME[5,3]
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "&ICS"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT  "&ICS"
    if	A_PRESS_N0[2,1,3,8] >0
      @ 8,A_M_NAME[7,13]     SAY   DD3	 PICT "9999"
    endif
    if	A_PRESS_N0[2,1,3,8] >0
      ICS=A_M_NAME[8,3]
      @ 8,A_M_NAME[8,13]     SAY   DD4	 PICT "&ICS"
    endif
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
    ICS=A_M_NAME[11,3]
    @ 8,A_M_NAME[11,13]     SAY   DD7	PICT "&ICS"

  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+4,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+6,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+7,10]
  ENDIF

  DD1=(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  if  (stp6>0 .and.  stp6 <=3 )  .or.  ( stp5 >0 )
    IF	(A_M_NAME[GS_TOT +1,10] <>A_M_NAME[GS_TOT +1,9])  .OR.	(A_M_NAME[GS_TOT +2,10] <>A_M_NAME[GS_TOT +2,9])
      DD1=XDD1+XDD2
    ENDIF
  ELSEIF (STP6 >3  )   .AND.  (STP6 <=6 )
    DD1=(WDATA(KLCHN+0)-2048) * (XDD1 +XDD2)/ ( XNDD1+XNDD2)
  ENDIF
  DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  if  (stp9>0 .and.  stp9 <=3 )  .or.  ( stp8 >0 )
    IF	(A_M_NAME[GS_TOT +4,10] <>A_M_NAME[GS_TOT +4,9])  .OR.	(A_M_NAME[GS_TOT +5,10] <>A_M_NAME[GS_TOT +5,9])
      DD3=XDD4+XDD5
    ENDIF
  ELSEIF (STP9 >3  )   .AND.  (STP9 <=6 )
    DD3=(WDATA(KLCHN+2)-2048) * (XDD4 +XDD5)/ ( XNDD4+XNDD5)
  ENDIF
  *if A_M_NAME[KLCHN+4,12] >2
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048)
  *ELSE
  *  DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)
  *ENDIF
  DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY DD3	 PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"

  &&XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  &&@ 10,A_M_NAME[KLCHN+5,16]	SAY DD5   PICT "&XDSPC"
  IF LED_IO >0
    LED_DSP(1,0,DD1,0)
    LED_DSP(1,1,DD2,0)
    LED_DSP(1,2,DD3,0)
    LED_DSP(1,3,DD4 * 100,2)
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    &&A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF
RETU
&&-----------------------------------------------------------------------------
**-----------------------------------------------------------------------------
FUNCTION _SEND_RS40
PARAMETERS  SLN,x_decn,sdn1
IF SIO1_FAULT <> 0
   RETU
ENDIF
txc=send_txt1 + chr(sln) + chr(x_decn)
bccn=sln + x_decn
IF (X_DECN >0)
  SDN1=STR(SDN1,6,X_DECN)
  SDNC=SDN1
   SDN1=""
   FOR X2=1 TO 5
     XSDN=SUBSTR(SDNC,-X2,1)
     IF XSDN <> "."
       SDN1=XSDN + SDN1
     ENDIF
   NEXT
ELSE
SDN1=STR(SDN1,4,0)
ENDIF
FOR X2=1 TO 4
  x1_tmp=SUBSTR(SDN1,X2,1)
  bccn=BCCN + ASC(X1_TMP)
  TXC=TXC + X1_TMP
NEXT
BCCN=MOD(BCCN,128)
TXC=TXC +CHR(3) + CHR(BCCN) + CHR(4)
*com_write(S_PORT-1,TXC)
SIO_PUTB(S_PORT,TXC)
RETU

&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP13
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (STP&IC_X >=1)  .OR. (I=7 .AND. STP8 >0)
	  IF  A_PRESS_N0[2,1,I,1]>0
	    A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+A_PRESS_N0[2,STPN&IC_X,I,11])/(A_PRESS_N0[2,STPN&IC_X,I,1]+A_PRESS_N0[2,STPN&IC_X,I,2] )
	    if A_PRESS_N0[2,1,I,8] =0
	       A_M_NAME[I,10]=0
	    endif
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ELSE
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	ENDIF
      NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[5,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[6,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[8,10]/PER/2048)
    DD5=((CHENDATA(GS_TOT +4))*A_M_NAME[9,10]/PER/2048)
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    tstn=dd3
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+5,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  DD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  IF (STP7 >0)	.OR. (STP8 >0)
    IF	(A_PRESS_N0[2,1,7,1]>0)  .or.  (A_PRESS_N0[2,1,8,1]>0)
      A_M_NAME[KLCHN+3 ,12]=A_M_NAME[KLCHN +3,6]
    ENDIF
     DD3=DD3+DD4
     DD5=CHENDATA(GS_TOT +2)+CHENDATA(GS_TOT +3)
     IF DD5 > 0
       DD3_MY=INT((WDATA(klchn +2)-DD5-2048)* DD3 /PER/DD5)
     ELSE
       DD3_MY=INT((WDATA(klchn +2)-2048)* A_M_NAME[klchn +3,12] /PER/2048)
     ENDIF
     dd3= DD3 +DD3_MY

  else
    DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  ENDIF

  if A_M_NAME[KLCHN+4,12] >2
    DD4=INT((((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048) * 100)/100
  ELSE
    DD4=INT((((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048) *100)/100
  ENDIF
  *DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  DD3= (DD3 + DISC2_C2N)
  DD3=N_DIV(DD3,DSP_DIV[KLCHN+3])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY DD3	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  DD4=N_DIV(DD4*100,DSP_DIV[KLCHN+4])/100
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
  IF SIO1_FAULT = 0
    _SEND_RS40D(KLCHN,0,DD1)
    _SEND_RS40D(KLCHN+1,0,DD2)
    _SEND_RS40D(KLCHN+2,0,DD3)
    _SEND_RS40D(KLCHN+3,2,DD4)
  else
    IF LED_IO >0
      LED_DSP(1,0,DD1,0)
      LED_DSP(1,1,DD2,0)
      LED_DSP(1,2,DD3,0)
      LED_DSP(1,3,DD4 * 100,2)
    ENDIF
  endif
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP15
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (STP&IC_X >=1)  .OR. (I=6 .AND. STP7 >0)
	  IF  A_PRESS_N0[2,1,I,1]>0
	    A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+A_PRESS_N0[2,STPN&IC_X,I,2]+A_PRESS_N0[2,STPN&IC_X,I,11])/(A_PRESS_N0[2,STPN&IC_X,I,1]+A_PRESS_N0[2,STPN&IC_X,I,2] )
	    if A_PRESS_N0[2,1,I,8] =0
	       A_M_NAME[I,10]=0
	    endif
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ELSE
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	ENDIF
      NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[5,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[6,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[8,10]/PER/2048)
    DD5=((CHENDATA(GS_TOT +4))*A_M_NAME[9,10]/PER/2048)
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    tstn=dd3
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+4,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+5,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  DD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  *DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  IF (STP6 >0)	.OR. (STP7 >0)
    IF	(A_PRESS_N0[2,1,6,1]>0)  .or.  (A_PRESS_N0[2,1,7,1]>0)
      A_M_NAME[KLCHN+2 ,12]=A_M_NAME[KLCHN +2,6]
    ENDIF
     DD2=DD2+DD3
     DD5=CHENDATA(GS_TOT +1)+CHENDATA(GS_TOT +2)
     IF DD5 > 0
       DD2_MY=INT((WDATA(klchn +1)-DD5-2048)* DD2 /PER/DD5)
     ELSE
       DD2_MY=INT((WDATA(klchn +1)-2048)* A_M_NAME[klchn +2,12] /PER/2048)
     ENDIF
     dd2= DD2 +DD2_MY

  else
    DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  ENDIF

  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12]) *100/PER/2048)/100
  if A_M_NAME[KLCHN+4,12] >2
    DD4=INT((((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048) * 100)/100
  ELSE
    DD4=INT((((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048) *100)/100
  ENDIF
  *DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  DD3=N_DIV(DD3 *100,DSP_DIV[KLCHN+3])/100
  @ 10,A_M_NAME[KLCHN+3,16]   SAY DD3	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  DD4=N_DIV(DD4*100,DSP_DIV[KLCHN+4])/100
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
  IF LED_IO >0
    LED_DSP(1,0,DD1,0)
    LED_DSP(1,1,DD2,0)
    LED_DSP(1,2,DD3,0)
    LED_DSP(1,3,DD4 * 100,2)
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP16
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	 IC_X=ALLTRIM(STR(I,2,0))
	 IF ((STP&IC_X >=1)   .and. (STP&IC_X <7 ) )  .OR. (I=5 .AND. STP6 >0)	  .OR. (I=8 .AND. STP9 >0)
	   IF  A_PRESS_N0[2,STPN&IC_X,I,1]>0
	     A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	   ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	   ENDIF
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	 ENDIF
       NEXT
    ENDIF
    XNDD1=  CHENDATA(GS_TOT)
    XNDD2=  CHENDATA(GS_TOT +1)
    XDSPC=RIGHT(ALLTRIM(A_M_NAME[KLCHN+1,3]),2)
    IF XDSPC="."
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/204.8)/10
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/204.8)/10
    ELSE
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/2048)
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/2048)
    ENDIF
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    XNDD4=  CHENDATA(GS_TOT +3)
    DD4=INT( XNDD4  *A_M_NAME[8,10]/PER/2048)
    XNDD5=  CHENDATA(GS_TOT +4)
    DD5=( XNDD5  *A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    DD7=INT((CHENDATA(GS_TOT +6))*A_M_NAME[11,10]*100/PER/2048)/100
    DD8=INT((CHENDATA(GS_TOT +7))*A_M_NAME[12,10]*100/PER/2048)/100
    XDD1=DD1
    XDD2=DD2
    XDD4=DD4
    XDD5=DD5
    XDD6=DD6
    XDD7=DD7
    XDD8=DD8
    ICS=A_M_NAME[5,3]
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "&ICS"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT  "&ICS"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
    ICS=A_M_NAME[11,3]
    @ 8,A_M_NAME[11,13]     SAY   DD7	PICT "&ICS"
    ICS=A_M_NAME[12,3]
    @ 8,A_M_NAME[12,13]     SAY   DD8	PICT "&ICS"

  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+4,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+5,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+6,10]
    A_M_NAME[KLCHN+6,12]=A_M_NAME[GS_TOT+7,10]
    A_M_NAME[KLCHN+7,12]=A_M_NAME[GS_TOT+8,10]
  ENDIF

  DD1=(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  if  (stp6>0 .and.  stp6 <=3 )  .or.  ( stp5 >0 )
    IF	(A_M_NAME[GS_TOT +1,10] <>A_M_NAME[GS_TOT +1,9])  .OR.	(A_M_NAME[GS_TOT +2,10] <>A_M_NAME[GS_TOT +2,9])
      DD1=XDD1+XDD2
    ENDIF
  ELSEIF (STP6 >3  )   .AND.  (STP6 <=6 )
    DD1=(WDATA(KLCHN+0)-2048) * (XDD1 +XDD2)/ ( XNDD1+XNDD2)
  ENDIF
  if DSPDATA_A[3]=1
    DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
    ACTWEIT_A[KLCHN+1] :=DD2
  ELSE
    DD2 := ACTWEIT_A[KLCHN+1]
  ENDIF
  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  *if  (stp8>0 .and.  stp8 <=6 )
  *  IF  (A_M_NAME[GS_TOT +4,10] <>A_M_NAME[GS_TOT +4,9])
  *    DD3=XDD4
  *  ENDIF
  *ELSEIF (STP8 >3  )	.AND.  (STP8 <=6 )
  *  DD3=(WDATA(KLCHN+2)-2048) * (XDD4 )/ ( XNDD4)
  *ENDIF
  *if A_M_NAME[KLCHN+4,12] >2
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048)
  *ELSE
  *  DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)
  *ENDIF
  DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  DD6=(((WDATA(KLCHN+5)-2048)*A_M_NAME[KLCHN+6,12])/PER/2048)
  DD7=(((WDATA(KLCHN+6)-2048)*A_M_NAME[KLCHN+7,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  DD3=N_DIV(DD3,DSP_DIV[KLCHN+3])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY DD3	 PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  DD4=N_DIV(DD4,DSP_DIV[KLCHN+4])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  DD5=N_DIV(DD5,DSP_DIV[KLCHN+5])
  @ 10,A_M_NAME[KLCHN+5,16]   SAY DD5	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+6,5])
  DD6=N_DIV(DD6,DSP_DIV[KLCHN+6])
  @ 10,A_M_NAME[KLCHN+6,16]   SAY DD6	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+7,5])
  DD7=N_DIV(DD7,DSP_DIV[KLCHN+7])
  @ 10,A_M_NAME[KLCHN+7,16]   SAY DD7	PICT "&XDSPC"
    XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
    IF SUBSTR(XDSPC,-2,1) ="."
      XDSPC=1
    ELSE
      XDSPC=0
    ENDIF
     _SEND_RS40D(KLCHN+0,XDSPC,DD1)
     _SEND_RS40D(KLCHN+1,0,DD2)
     _SEND_RS40D(KLCHN+2,0,DD3)
     _SEND_RS40D(KLCHN+3,0,DD4)
     _SEND_RS40D(KLCHN+4,2,DD5)
     _SEND_RS40D(KLCHN+5,2,DD6)
     _SEND_RS40D(KLCHN+6,2,DD7)


  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
    A_M_NAME[KLCHN+6,12]=A_M_NAME[KLCHN+6,6]
    A_M_NAME[KLCHN+7,12]=A_M_NAME[KLCHN+7,6]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF
RETU
&&-----------------------------------------------------------------------------
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP17
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	 IC_X=ALLTRIM(STR(I,2,0))
	 IF ((STP&IC_X >=1)   .and. (STP&IC_X <7 ) )  .OR. (I=5 .AND. STP6 >0)	  .OR. (I=8 .AND. STP9 >0)
	   IF  A_PRESS_N0[2,STPN&IC_X,I,1]>0
	     x=A_PRESS_N0[2,STPN&IC_X,i,2]
	     A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+x )/(A_PRESS_N0[2,STPN&IC_X,I,1]+x)
	   ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	   ENDIF
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	 ENDIF
       NEXT
    ENDIF
    XNDD1=  CHENDATA(GS_TOT)
    XNDD2=  CHENDATA(GS_TOT +1)
    XDSPC=RIGHT(ALLTRIM(A_M_NAME[KLCHN+1,3]),2)
    IF XDSPC="."
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/204.8)/10
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/204.8)/10
    ELSE
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/2048)
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/2048)
    ENDIF
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    XNDD4=  CHENDATA(GS_TOT +3)
    DD4=INT( XNDD4  *A_M_NAME[8,10]/PER/2048)
    XNDD5=  CHENDATA(GS_TOT +4)
    DD5=( XNDD5  *A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    DD7=INT((CHENDATA(GS_TOT +6))*A_M_NAME[11,10]*100/PER/2048)/100
    XDD1=DD1
    XDD2=DD2
    XDD4=DD4
    XDD5=DD5
    XDD6=DD6
    XDD7=DD7
    ICS=A_M_NAME[5,3]
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "&ICS"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT  "&ICS"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
    ICS=A_M_NAME[11,3]
    @ 8,A_M_NAME[11,13]     SAY   DD7	PICT "&ICS"

  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+4,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+5,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+6,10]
    A_M_NAME[KLCHN+6,12]=A_M_NAME[GS_TOT+7,10]
  ENDIF

  DD1=(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  if  (stp6>0 .and.  stp6 <=3 )  .or.  ( stp5 >0 )
    IF	(A_M_NAME[GS_TOT +1,10] <>A_M_NAME[GS_TOT +1,9])  .OR.	(A_M_NAME[GS_TOT +2,10] <>A_M_NAME[GS_TOT +2,9])
      DD1=XDD1+XDD2
    ENDIF
  ELSEIF (STP6 >3  )   .AND.  (STP6 <=6 )
    DD1=(WDATA(KLCHN+0)-2048) * (XDD1 +XDD2)/ ( XNDD1+XNDD2)
  ENDIF
  if DSPDATA_A[3]=1
    DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
    ACTWEIT_A[KLCHN+1] :=DD2
  ELSE
    DD2 := ACTWEIT_A[KLCHN+1]
  ENDIF
  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  *if  (stp8>0 .and.  stp8 <=6 )
  *  IF  (A_M_NAME[GS_TOT +4,10] <>A_M_NAME[GS_TOT +4,9])
  *    DD3=XDD4
  *  ENDIF
  *ELSEIF (STP8 >3  )	.AND.  (STP8 <=6 )
  *  DD3=(WDATA(KLCHN+2)-2048) * (XDD4 )/ ( XNDD4)
  *ENDIF
  *if A_M_NAME[KLCHN+4,12] >2
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048)
  *ELSE
  *  DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)
  *ENDIF
  DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  DD6=(((WDATA(KLCHN+5)-2048)*A_M_NAME[KLCHN+6,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  DD3=N_DIV(DD3,DSP_DIV[KLCHN+3])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY DD3	 PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  DD4=N_DIV(DD4,DSP_DIV[KLCHN+4])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  DD5=N_DIV(DD5,DSP_DIV[KLCHN+5])
  @ 10,A_M_NAME[KLCHN+5,16]   SAY DD5	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+6,5])
  DD6=N_DIV(DD6,DSP_DIV[KLCHN+6])
  @ 10,A_M_NAME[KLCHN+6,16]   SAY DD6	PICT "&XDSPC"

    XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
    IF SUBSTR(XDSPC,-2,1) ="."
      XDSPC=1
    ELSE
      XDSPC=0
    ENDIF
     _SEND_RS40D(KLCHN+0,XDSPC,DD1)
     _SEND_RS40D(KLCHN+1,0,DD2)
     _SEND_RS40D(KLCHN+2,0,DD3)
     _SEND_RS40D(KLCHN+3,0,DD4)
     _SEND_RS40D(KLCHN+4,2,DD5)
     _SEND_RS40D(KLCHN+5,2,DD6)

  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
    A_M_NAME[KLCHN+6,12]=A_M_NAME[KLCHN+6,6]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP18
PARAMETERS  P1,P2,P3
  IF STAR=1

    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (I=5 .OR. I=9)
	  IF (STP&IC_X >=1)
	    IF	A_PRESS_N0[2,1,I,1]>0
	      A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+A_PRESS_N0[2,STPN&IC_X,I,11])/(A_PRESS_N0[2,STPN&IC_X,I,1]+A_PRESS_N0[2,STPN&IC_X,I,2] )
	      if A_PRESS_N0[2,1,I,8] =0
		 A_M_NAME[I,10]=0
	      endif
	    ELSE
	     A_M_NAME[I,10]=A_M_NAME[I,9]
	    ENDIF
	  ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ELSE
	  IF ((I >=6)  .AND. (I<=8)  .AND.( STP6 >0 .OR. STP7 >0 .OR. STP8 >0))
	    IF	A_PRESS_N0[2,1,I,1]>0
	      A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+A_PRESS_N0[2,STPN&IC_X,I,11])/(A_PRESS_N0[2,STPN&IC_X,I,1]+A_PRESS_N0[2,STPN&IC_X,I,2] )
	      if A_PRESS_N0[2,1,I,8] =0
		 A_M_NAME[I,10]=0
	      endif
	    ELSE
	     *A_M_NAME[I,10]=A_M_NAME[I,9]
	       A_M_NAME[I,10]=0
	    ENDIF
	  ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ENDIF
      NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[5,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[6,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[8,10]/PER/2048)
    DD5=((CHENDATA(GS_TOT +4))*A_M_NAME[9,10]/PER/2048)
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    tstn=dd3
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+5,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  DD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  IF (STP6 >0)	.OR. (STP7 >0)	.OR. (STP8 >0)
    IF	(A_PRESS_N0[2,1,6,1]>0)  .or. (A_PRESS_N0[2,1,7,1]>0)  .or.  (A_PRESS_N0[2,1,8,1]>0)
      A_M_NAME[KLCHN+2 ,12]=A_M_NAME[KLCHN +2,6]
    ENDIF
     DD2=DD2+DD3+DD4
     DD5=CHENDATA(GS_TOT +1)+CHENDATA(GS_TOT +2)+ CHENDATA(GS_TOT +3)
     IF DD5 > 0
       DD2_MY=INT((WDATA(klchn +1)-DD5-2048)* DD2 /PER/DD5)
     ELSE
       DD2_MY=INT((WDATA(klchn +1)-2048)* A_M_NAME[klchn +2,12] /PER/2048)
     ENDIF
     dd2= DD2 +DD2_MY
  else
    DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])/PER/2048)
  ENDIF

  DD3=INT((((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048) * 100)/100
  W_1=DD2
  W_2=DD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"

  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  DD2= (DD2 + DISC2_C2N)
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"

  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  DD3=N_DIV(DD3*100,DSP_DIV[KLCHN+3])/100
  @ 10,A_M_NAME[KLCHN+3,16]   SAY DD3	PICT "&XDSPC"
  IF SIO1_FAULT = 0
    _SEND_RS40D(KLCHN,0,DD1)
    _SEND_RS40D(KLCHN+1,0,DD2)
    _SEND_RS40D(KLCHN+2,2,DD3)
  endif
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP19
PARAMETERS  P1,P2,P3
  IF STAR=1

    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	DO  CASE
	CASE (I=11 .OR.  I=12)
	  IF ((STP&IC_X >=1)   .and. (STP&IC_X <7 ) )
	    IF	A_PRESS_N0[2,1,I,1]>0
	      A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+A_PRESS_N0[2,STPN&IC_X,I,11])/(A_PRESS_N0[2,STPN&IC_X,I,1]+A_PRESS_N0[2,STPN&IC_X,I,2] )
	      if A_PRESS_N0[2,1,I,8] =0
		 A_M_NAME[I,10]=0
	      endif
	    ELSE
	     A_M_NAME[I,10]=A_M_NAME[I,9]
	    ENDIF
	  ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	OTHERWISE
	  IF ((I =5  .OR. I=6)	.AND. ( STP5 >0 .OR. STP6 >0))	.OR. ((I =7  .OR. I=8)	.AND. ( STP7 >0 .OR. STP8 >0))	.OR. ((I =9  .OR. I=10)  .AND. ( STP9 >0 .OR. STP10 >0))
	    IF	A_PRESS_N0[2,1,I,1]>0
	      A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+A_PRESS_N0[2,STPN&IC_X,I,11])/(A_PRESS_N0[2,STPN&IC_X,I,1]+A_PRESS_N0[2,STPN&IC_X,I,2] )
	      if A_PRESS_N0[2,1,I,8] =0
		 A_M_NAME[I,10]=0
	      endif
	    ELSE
	     *A_M_NAME[I,10]=A_M_NAME[I,9]
	       A_M_NAME[I,10]=0
	    ENDIF
	  ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ENDCASE
      NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[5,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[6,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[8,10]/PER/2048)
    DD5=((CHENDATA(GS_TOT +4))*A_M_NAME[9,10]/PER/2048)
    DD6=((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]/PER/2048)
    DD7=((CHENDATA(GS_TOT +6))*A_M_NAME[11,10]/PER/2048)
    DD8=((CHENDATA(GS_TOT +7))*A_M_NAME[12,10]/PER/2048)
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    tstn=dd3
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    ICS=A_M_NAME[10,3]
    @ 8,A_M_NAME[10,13]     SAY   DD6	PICT "&ICS"
    ICS=A_M_NAME[11,3]
    @ 8,A_M_NAME[11,13]     SAY   DD7	PICT "&ICS"
    ICS=A_M_NAME[12,3]
    @ 8,A_M_NAME[12,13]     SAY   DD8	PICT "&ICS"
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+5,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+7,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+8,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  IF (STP5 >0)	.OR. (STP6 >0)
     DD1=DD1+DD2
     DD19=CHENDATA(GS_TOT )+CHENDATA(GS_TOT +1)
     IF DD19 > 0
       DD1_MY=INT((WDATA(klchn )-DD19-2048)* DD1 /PER/DD19)
     ELSE
       DD1_MY=INT((WDATA(klchn)-2048)* A_M_NAME[klchn +1,12] /PER/2048)
     ENDIF
     dd1= DD1 +DD1_MY
   ELSE
     DD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
   ENDIF
  IF (STP7 >0)	.OR. (STP8 >0)
     DD2=DD3+DD4
     DD19=CHENDATA(GS_TOT+2 )+CHENDATA(GS_TOT +3)
     IF DD19 > 0
       DD1_MY=INT((WDATA(klchn+1 )-DD19-2048)* DD2 /PER/DD19)
     ELSE
       DD1_MY=INT((WDATA(klchn+1)-2048)* A_M_NAME[klchn +2,12] /PER/2048)
     ENDIF
     dd2= DD2 +DD1_MY
  ELSE
     DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])/PER/2048)
  ENDIF
  IF (STP9 >0)	.OR. (STP10 >0)
     DD3=DD5+DD6
     DD19=CHENDATA(GS_TOT+4 )+CHENDATA(GS_TOT +5)
     IF DD19 > 0
       DD1_MY=INT((WDATA(klchn+2 )-DD19-2048)* DD3 /PER/DD19)
     ELSE
       DD1_MY=INT((WDATA(klchn+2)-2048)* A_M_NAME[klchn +3,12] /PER/2048)
     ENDIF
     dd3= DD3 +DD1_MY
  ELSE
     DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  ENDIF
  DD4=INT((((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048) * 100)/100
  DD5=INT((((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048) * 100)/100
  W_1=DD2
  W_2=DD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"

  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  DD2= (DD2 + DISC2_C2N)
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"

  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  DD3=N_DIV(DD3*100,DSP_DIV[KLCHN+3])/100
  @ 10,A_M_NAME[KLCHN+3,16]   SAY DD3	PICT "&XDSPC"

  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  DD4=N_DIV(DD4*100,DSP_DIV[KLCHN+4])/100
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"

  XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  DD5=N_DIV(DD5*100,DSP_DIV[KLCHN+5])/100
  @ 10,A_M_NAME[KLCHN+5,16]   SAY DD5	PICT "&XDSPC"


  IF SIO1_FAULT = 0
    _SEND_RS40D(KLCHN,0,DD1)
    _SEND_RS40D(KLCHN+1,0,DD2)
    _SEND_RS40D(KLCHN+2,2,DD3)
    _SEND_RS40D(KLCHN+3,2,DD4)
    _SEND_RS40D(KLCHN+4,2,DD5)
  endif
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   PRL21
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1 .AND. DSPD_NOR=0
      FOR I=1 TO GS_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (STP1 >0)  .OR. (STP2 >0)   .OR. (STP3 >0)  .OR. (STP4 >0)	.OR. (STP5 >0)
	  IF  A_PRESS_N0[2,1,I,1]>0
	   *A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+ A_PRESS_N0[2,STPN&IC_X,I,11])/(A_PRESS_N0[2,STPN&IC_X,I,1]+ A_PRESS_N0[2,STPN&IC_X,I,2]   )
	    x= (A_PRESS_N0[2,STPN&IC_X,I,8]+ A_PRESS_N0[2,STPN&IC_X,I,11])/(A_PRESS_N0[2,STPN&IC_X,I,1]+ A_PRESS_N0[2,STPN&IC_X,I,2]   )
	    A_M_NAME[I,10]=A_M_NAME[I,9] * x
	  ELSEIF (GS_CHG > 0)
	     IF (GS_CHG=3) .AND. (I=2)
	       A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I+1,1]
	     ELSEIF (GS_CHG=2) .AND. (I=3)
	       A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I-1,1]
	     ENDIF
	  ENDIF
	ELSE
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	ENDIF
      NEXT
    ENDIF

    DD1=INT((CHENDATA(0))*A_M_NAME[1,10]/PER/2048)
    DD2=INT((CHENDATA(1))*A_M_NAME[2,10]/PER/2048)
    DD3=INT((CHENDATA(2))*A_M_NAME[3,10]/PER/2048)-disc2_s3
    DD4=INT((CHENDATA(3))*A_M_NAME[4,10]/PER/2048)
    DD5=INT((CHENDATA(4))*A_M_NAME[5,10]/PER/2048)
    @ 8,A_M_NAME[1,13]	SAY    DD1   PICT "9999"
    @ 8,A_M_NAME[2,13]	SAY   DD2   PICT "9999"
    @ 8,A_M_NAME[3,13]	SAY   DD3   PICT "9999"
    @ 8,A_M_NAME[4,13]	SAY   DD4   PICT "9999"
    @ 8,A_M_NAME[5,13]	SAY   DD5   PICT "9999"
    IF (STP1 >0)  .OR. (STP2 >0)   .OR. (STP3 >0)  .OR. (STP4 >0)   .OR. (STP5 >0)
      DD9=DD1+DD2+DD3+DD4+DD5
      DD8=CHENDATA(0)+CHENDATA(1)+CHENDATA(2)+CHENDATA(3) +CHENDATA(4)
      IF DD8 > 0
	DD9_MY=INT((WDATA(0)-DD8-2048)* DD9 /PER/DD8)
      ELSE
	A_M_NAME[1,12]=A_M_NAME[1,10]
	DD9_MY=INT((WDATA(0)-DD3-2048)* A_M_NAME[1,12] /PER/2048)
      ENDIF
      dd9= DD9 +DD9_MY
      DD9=N_DIV(DD9,DSP_DIV[1])
      @ 10,A_M_NAME[1,16]  SAY	dd9  PICT "9999"
    ELSE
      A_M_NAME[1,12]=A_M_NAME[1,6]
      DD9=INT((WDATA(0)-2048)*A_M_NAME[1,12]/PER/2048)
      DD9=N_DIV(DD9,DSP_DIV[1])
      @ 10,A_M_NAME[1,16] SAY dd9   PICT "9999"
    ENDIF

    IF	W0DBF=1
      FOR I=  1  to GS_TOT
	A_M_NAME[I,10]=A_M_NAME[I,9]
      NEXT
    ENDIF
  ELSE
    dd9=INT((WDATA(0)-2048)*A_M_NAME[1,6]/PER/2048)
    DD9=N_DIV(DD9,DSP_DIV[1])
    @ 10,A_M_NAME[1,16] SAY  dd9   PICT "9999"
  ENDIF
  _SEND_RS40D(0,0,DD9)
  IF W0DBF=1
    A_M_NAME[1,12]=A_M_NAME[1,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP21
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (STP&IC_X >=1)  .OR. (I=6 .AND. STP7 >0)
	  IF  A_PRESS_N0[2,1,I,1]>0
	    A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+A_PRESS_N0[2,STPN&IC_X,I,11])/(A_PRESS_N0[2,STPN&IC_X,I,1]+A_PRESS_N0[2,STPN&IC_X,I,2] )
	    if A_PRESS_N0[2,1,I,8] =0
	       A_M_NAME[I,10]=0
	    endif
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ELSE
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	ENDIF
      NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[GS_TOT+1,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[GS_TOT+2,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[GS_TOT+3,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[GS_TOT+4,10]*100/PER/2048)/100
    @ 8,A_M_NAME[GS_TOT+1,13]	 SAY	DD1   PICT "9999"
    @ 8,A_M_NAME[GS_TOT+2,13]	  SAY	DD2   PICT "9999"
    @ 8,A_M_NAME[GS_TOT+3,13]	  SAY	DD3   PICT "9999"
    tstn=dd3
    ICS=A_M_NAME[GS_TOT+4,3]
    @ 8,A_M_NAME[GS_TOT+4,13]	  SAY	DD4   PICT "&ICS"
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+4,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  DD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  *DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  IF (STP6 >0)	.OR. (STP7 >0)
    IF	(A_PRESS_N0[2,1,6,1]>0)  .or.  (A_PRESS_N0[2,1,7,1]>0)
      A_M_NAME[KLCHN+2 ,12]=A_M_NAME[KLCHN +2,6]
    ENDIF
     DD2=DD2+DD3
     DD5=CHENDATA(GS_TOT +1)+CHENDATA(GS_TOT +2)
     IF DD5 > 0
       DD2_MY=INT((WDATA(klchn +1)-DD5-2048)* DD2 /PER/DD5)
     ELSE
       DD2_MY=INT((WDATA(klchn +1)-2048)* A_M_NAME[klchn +2,12] /PER/2048)
     ENDIF
     dd2= DD2 +DD2_MY

  else
    DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  ENDIF

  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12]) *100/PER/2048)/100
  if A_M_NAME[KLCHN+4,12] >2
    DD4=INT((((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048) * 100)/100
  ELSE
    DD4=INT((((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048) *100)/100
  ENDIF
  *DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  DD3=N_DIV(DD3 *100,DSP_DIV[KLCHN+3])/100
  @ 10,A_M_NAME[KLCHN+3,16]   SAY DD3	PICT "&XDSPC"
  IF LED_IO >0
    LED_DSP(1,0,DD1,0)
    LED_DSP(1,1,DD2,0)
    LED_DSP(1,2,DD3*100,2)
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP22
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	 IC_X=ALLTRIM(STR(I,2,0))
	 IF ((STP&IC_X >=1)   .and. (STP&IC_X <7 ) )  .OR. (I=5 .AND. STP6 >0)	  .OR. (I=8 .AND. STP9 >0)
	   IF  A_PRESS_N0[2,STPN&IC_X,I,1]>0
	     A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	   ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	   ENDIF
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	 ENDIF
       NEXT
    ENDIF
    XNDD1=  CHENDATA(GS_TOT)
    XNDD2=  CHENDATA(GS_TOT +1)
    XDSPC=RIGHT(ALLTRIM(A_M_NAME[KLCHN+1,3]),2)
    IF XDSPC="."
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/204.8)/10
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/204.8)/10
    ELSE
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/2048)
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/2048)
    ENDIF
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    XNDD4=  CHENDATA(GS_TOT +3)
    DD4=INT( XNDD4  *A_M_NAME[8,10]/PER/2048)
    XNDD5=  CHENDATA(GS_TOT +4)
    DD5=( XNDD5  *A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    DD7=INT((CHENDATA(GS_TOT +6))*A_M_NAME[11,10]*100/PER/2048)/100
    DD8=INT((CHENDATA(GS_TOT +7))*A_M_NAME[12,10]*100/PER/2048)/100
    XDD1=DD1
    XDD2=DD2
    XDD4=DD4
    XDD5=DD5
    ICS=A_M_NAME[5,3]
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "&ICS"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT  "&ICS"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
    ICS=A_M_NAME[11,3]
    @ 8,A_M_NAME[11,13]     SAY   DD7	PICT "&ICS"
    ICS=A_M_NAME[12,3]
    @ 8,A_M_NAME[12,13]     SAY   DD8	PICT "&ICS"

  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+4,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+6,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+7,10]
    A_M_NAME[KLCHN+6,12]=A_M_NAME[GS_TOT+8,10]
  ENDIF

  DD1=(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  if  (stp6>0 .and.  stp6 <=3 )  .or.  ( stp5 >0 )
    IF	(A_M_NAME[GS_TOT +1,10] <>A_M_NAME[GS_TOT +1,9])  .OR.	(A_M_NAME[GS_TOT +2,10] <>A_M_NAME[GS_TOT +2,9])
      DD1=XDD1+XDD2
    ENDIF
  ELSEIF (STP6 >3  )   .AND.  (STP6 <=6 )
    DD1=(WDATA(KLCHN+0)-2048) * (XDD1 +XDD2)/ ( XNDD1+XNDD2)
  ENDIF
  if DSPDATA_A[3]=1
    DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
    ACTWEIT_A[KLCHN+1] :=DD2
  ELSE
    DD2 := ACTWEIT_A[KLCHN+1]
  ENDIF
  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  if  (stp9>0 .and.  stp9 <=3 )  .or.  ( stp8 >0 )
    IF	(A_M_NAME[GS_TOT +4,10] <>A_M_NAME[GS_TOT +4,9])  .OR.	(A_M_NAME[GS_TOT +5,10] <>A_M_NAME[GS_TOT +5,9])
      DD3=XDD4+XDD5
    ENDIF
  ELSEIF (STP9 >3  )   .AND.  (STP9 <=6 )
    DD3=(WDATA(KLCHN+2)-2048) * (XDD4 +XDD5)/ ( XNDD4+XNDD5)
  ENDIF
  *if A_M_NAME[KLCHN+4,12] >2
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048)
  *ELSE
  *  DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)
  *ENDIF
  DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  DD6=(((WDATA(KLCHN+5)-2048)*A_M_NAME[KLCHN+6,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  DD3=N_DIV(DD3,DSP_DIV[KLCHN+3])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY DD3	 PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  DD4=N_DIV(DD4,DSP_DIV[KLCHN+4])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  DD5=N_DIV(DD5,DSP_DIV[KLCHN+5])
  @ 10,A_M_NAME[KLCHN+5,16]   SAY DD5	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+6,5])
  DD6=N_DIV(DD6,DSP_DIV[KLCHN+6])
  @ 10,A_M_NAME[KLCHN+6,16]   SAY DD6	PICT "&XDSPC"


  IF LCHTYPE=6
    XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
    IF SUBSTR(XDSPC,-2,1) ="."
      XDSPC=1
    ELSE
      XDSPC=0
    ENDIF
     _SEND_RS40D(KLCHN+0,XDSPC,DD1)
     _SEND_RS40D(KLCHN+1,0,DD2)

     _SEND_RS40D(KLCHN+2,0,DD3)
     _SEND_RS40D(KLCHN+3,2,DD4)
     _SEND_RS40D(KLCHN+4,2,DD5)
     _SEND_RS40D(KLCHN+5,2,DD6)
  ENDIF


  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   LDSP26
PARAMETERS  P1,P2,P3
IF STAR=1
  IF	 ISDEMO=1   .and. dosign=0
    DO DEMO_INP
  ENDIF
  IF W0DBF=1 .AND. DSPD_NOR=0
    FOR I=1 TO GS_TOT
      IC_X=ALLTRIM(STR(I,2,0))
      IF (STP&IC_X >=1)  .OR. (I=1 .AND. STP2 >0)   .OR. (I=3 .AND. STP4 >0)
	IF  A_PRESS_N0[2,1,I,1]>0
	  x=A_PRESS_N0[2,STPN&IC_X,i,2]
	  A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+x)/(A_PRESS_N0[2,STPN&IC_X,I,1]+x)
	ENDIF
      ELSE
	A_M_NAME[I,10]=A_M_NAME[I,9]
      ENDIF
    NEXT
  ENDIF
  DD1=INT((CHENDATA(0))*A_M_NAME[1,10]/PER/2048)
  DD2=INT((CHENDATA(1))*A_M_NAME[2,10]/PER/2048)
  DD3=INT((CHENDATA(2))*A_M_NAME[3,10]/PER/2048)-disc2_s3
  DD4=INT((CHENDATA(3))*A_M_NAME[4,10]/PER/2048)
  DD5=INT((CHENDATA(4))*A_M_NAME[5,10]/PER/2048)
  @ 8,A_M_NAME[1,13]  SAY    DD1   PICT "9999"
  @ 8,A_M_NAME[2,13]  SAY   DD2   PICT "9999"
  @ 8,A_M_NAME[3,13]  SAY   DD3   PICT "9999"
  @ 8,A_M_NAME[4,13]  SAY   DD4   PICT "9999"
  @ 8,A_M_NAME[5,13]  SAY   DD5   PICT "9999"
  IF W0DBF=1  .AND. DSPD_NOR=0

      IF (STP1 >=1) .or. (stp2 > 0)
	IF  (A_PRESS_N0[2,stpn1,1,1]>0 )
	  A_M_NAME[1,12]=A_M_NAME[1,6] * A_PRESS_N0[2,STPN1,1,8]/A_PRESS_N0[2,STPn1,1,1]
	else
	  IF  (A_PRESS_N0[2,stpn2,2,1]>0 )
	    A_M_NAME[1,12]=A_M_NAME[1,6] * A_PRESS_N0[2,STPN2,2,8]/A_PRESS_N0[2,STPn2,2,1]
	  endif
	ENDIF
      ENDIF
      IF (STP3 >=1) .or. (stp4 > 0)
	IF  (A_PRESS_N0[2,stpn3,3,1]>0 )
	  A_M_NAME[2,12]=A_M_NAME[2,6] * A_PRESS_N0[2,STPN3,3,8]/A_PRESS_N0[2,STPn3,3,1]
	else
	  IF  (A_PRESS_N0[2,stpn4,4,1]>0 )
	    A_M_NAME[1,12]=A_M_NAME[1,6] * A_PRESS_N0[2,STPN4,4,8]/A_PRESS_N0[2,STPn4,4,1]
	  endif
	ENDIF
      ENDIF
  ENDIF
  A_M_NAME[4,12]=A_M_NAME[4,10]
  IF  W0DBF=1
    FOR I=  1  to GS_TOT
      *IC_X=ALLTRIM(STR(I,2,0))
      *IF (STP&IC_X >=1)
	A_M_NAME[I,10]=A_M_NAME[I,9]
      *ENDIF
    NEXT
  ENDIF
ENDIF
IF  (DSPD_NOR=0) .AND. ((STP1>=1 .AND. STP1<=3) .OR. (STP2>=1 .AND. STP2<=6))
  if  dspch1_nor=1
    XD1=INT((WDATA(0)-2048)*A_M_NAME[1,12]/PER/2048)  + REMOTE[1]
  else
    xad_o= CHENDATA(0) +CHENDATA(1)
    DD2_MY=INT((WDATA(0)-XAD_O-2048)*(DD1+DD2)/XAD_O)
    XD1=INT(DD1 +DD2 +DD2_MY)  + REMOTE[1]
  endif
ELSE
  XD1=INT((WDATA(0)-2048)*A_M_NAME[1,12]/PER/2048)  + REMOTE[1]
ENDIF
XD1=N_DIV(XD1,DSP_DIV[1])
@ 10,A_M_NAME[1,16] SAY XD1   PICT "9999"


IF  (DSPD_NOR=0) .AND. ((STP3>=1 .AND. STP3<=3) .OR. (STP4>=1 .AND. STP4<=6))
  if  dspch2_nor=1
    XD2=INT((WDATA(1)-2048)*A_M_NAME[2,12]/PER/2048)  + REMOTE[2]
  else
    xad_o= CHENDATA(2) +CHENDATA(3)
    DD4_MY=INT((WDATA(1)-XAD_O-2048)*(DD3+DD4)/XAD_O)
    XD2=INT(DD3 +DD4 +DD4_MY)  + REMOTE[2]
  endif
ELSE
  XD2=INT((WDATA(1)-2048)*A_M_NAME[2,12]/PER/2048)  + REMOTE[2]
ENDIF
XD2=N_DIV(XD2,DSP_DIV[2])
@ 10,A_M_NAME[2,16]  SAY  XD2  PICT "9999"


XD3=INT((WDATA(2)-2048)*A_M_NAME[3,12]/PER/2048)  + REMOTE[3]
XD3=N_DIV(XD3,DSP_DIV[3])
@ 10,A_M_NAME[3,16]  SAY  XD3  PICT "9999"
_SEND_RS40D(0,0,XD1)
_SEND_RS40D(1,0,XD2)
_SEND_RS40D(2,0,XD3)
IF W0DBF=1
  FOR I=1 TO KLCHN
    *IC_X=ALLTRIM(STR(I,2,0))
    *IF (STP&IC_X >=1)
    *  IF  A_PRESS_N0[2,1,I,8]>0
	A_M_NAME[I,12]=A_M_NAME[I,6]
    *  ENDIF
    *ENDIF
  NEXT
ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP26
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (STP&IC_X >=1)  .OR. (I=8 .AND. STP9 >0)
	  IF  A_PRESS_N0[2,1,I,1]>0
	    A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ELSE
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	ENDIF
      NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[GS_TOT +1,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[GS_TOT +2,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[GS_TOT +3,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[GS_TOT +4,10]/PER/2048)
    DD5=((CHENDATA(GS_TOT +4))*A_M_NAME[GS_TOT +5,10]/PER/2048)
    if (uchtype=26)
      DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[GS_TOT +6,10]*100/PER/2048)/100
    endif
    @ 8,A_M_NAME[GS_TOT +1,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[GS_TOT +2,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[GS_TOT +3,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[GS_TOT +4,3]
    @ 8,A_M_NAME[GS_TOT +4,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[GS_TOT +5,3]
    @ 8,A_M_NAME[GS_TOT +5,13]	   SAY	 DD5   PICT "&ICS"

    if (uchtype=26)
      IF A_M_NAME[GS_TOT +6,13]  <>0
	ICS=A_M_NAME[GS_TOT +6,3]
	@ 8,A_M_NAME[GS_TOT +6,13]     SAY   DD6   PICT "&ICS"
      ENDIF
    endif
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+5,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+6,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  DD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  if A_M_NAME[KLCHN+4,12] >2
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048)
  ELSE
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)
  ENDIF
  DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  DD3=N_DIV(DD3,DSP_DIV[KLCHN+3])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY (DD3 + DISC2_C2N)   PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  DD4=N_DIV(DD4,DSP_DIV[KLCHN+4])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
   if (uchtype=26)
     XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
     DD5=N_DIV(DD5,DSP_DIV[KLCHN+5])
     @ 10,A_M_NAME[KLCHN+5,16]	 SAY DD5   PICT "&XDSPC"
  endif
  _SEND_RS40D(KLCHN+0,0,DD1)
  _SEND_RS40D(KLCHN+1,0,DD2)
  _SEND_RS40D(KLCHN+2,0,DD3)
  _SEND_RS40D(KLCHN+3,2,DD4)
   if (uchtype=26)
     _SEND_RS40D(KLCHN+4,2,DD5)
  endif
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP30
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	 IC_X=ALLTRIM(STR(I,2,0))
	 IF ((STP&IC_X >=1)   .and. (STP&IC_X <7 ) )  .OR. (I=5 .AND. STP6 >0)	  .OR. (I=8 .AND. STP9 >0)
	   IF  A_PRESS_N0[2,STPN&IC_X,I,1]>0
	     A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	   ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	   ENDIF
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	 ENDIF
       NEXT
    ENDIF
    XNDD1=  CHENDATA(GS_TOT)
    XNDD2=  CHENDATA(GS_TOT +1)
    XDSPC=RIGHT(ALLTRIM(A_M_NAME[KLCHN+1,3]),2)
    IF XDSPC="."
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/204.8)/10
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/204.8)/10
    ELSE
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/2048)
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/2048)
    ENDIF
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    XNDD4=  CHENDATA(GS_TOT +3)
    DD4=INT( XNDD4  *A_M_NAME[8,10]/PER/2048)
    XNDD5=  CHENDATA(GS_TOT +4)
    DD5=( XNDD5  *A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    DD7=INT((CHENDATA(GS_TOT +6))*A_M_NAME[11,10]*100/PER/2048)/100
    XDD1=DD1
    XDD2=DD2
    XDD4=DD4
    XDD5=DD5
    ICS=A_M_NAME[5,3]
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "&ICS"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT  "&ICS"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
    ICS=A_M_NAME[11,3]
    @ 8,A_M_NAME[11,13]     SAY   DD7	PICT "&ICS"

  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+4,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+6,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+7,10]
  ENDIF

  DD1=(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  if  (stp6>0 .and.  stp6 <=3 )  .or.  ( stp5 >0 )
    IF	(A_M_NAME[GS_TOT +1,10] <>A_M_NAME[GS_TOT +1,9])  .OR.	(A_M_NAME[GS_TOT +2,10] <>A_M_NAME[GS_TOT +2,9])
      DD1=XDD1+XDD2
    ENDIF
  ELSEIF (STP6 >3  )   .AND.  (STP6 <=6 )
    DD1=(WDATA(KLCHN+0)-2048) * (XDD1 +XDD2)/ ( XNDD1+XNDD2)
  ENDIF
  if DSPDATA_A[3]=1
    DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
    ACTWEIT_A[KLCHN+1] :=DD2
  ELSE
    DD2 := ACTWEIT_A[KLCHN+1]
  ENDIF
  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  if  (stp9>0 .and.  stp9 <=3 )  .or.  ( stp8 >0 )
    IF	(A_M_NAME[GS_TOT +4,10] <>A_M_NAME[GS_TOT +4,9])  .OR.	(A_M_NAME[GS_TOT +5,10] <>A_M_NAME[GS_TOT +5,9])
      DD3=XDD4+XDD5
    ENDIF
  ELSEIF (STP9 >3  )   .AND.  (STP9 <=6 )
    DD3=(WDATA(KLCHN+2)-2048) * (XDD4 +XDD5)/ ( XNDD4+XNDD5)
  ENDIF
  *if A_M_NAME[KLCHN+4,12] >2
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048)
  *ELSE
  *  DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)
  *ENDIF
  DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  DD3=N_DIV(DD3,DSP_DIV[KLCHN+3])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY DD3	 PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  DD4=N_DIV(DD4,DSP_DIV[KLCHN+4])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  DD5=N_DIV(DD5,DSP_DIV[KLCHN+5])
  @ 10,A_M_NAME[KLCHN+5,16]   SAY DD5	PICT "&XDSPC"
  IF LCHTYPE=30
    XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
    IF SUBSTR(XDSPC,-2,1) ="."
      XDSPC=1
    ELSE
      XDSPC=0
    ENDIF
     _SEND_RS40D(KLCHN+0,XDSPC,DD1)
     _SEND_RS40D(KLCHN+1,0,DD2)

     _SEND_RS40D(KLCHN+2,0,DD3)
     _SEND_RS40D(KLCHN+3,2,DD4)
     _SEND_RS40D(KLCHN+4,2,DD5)
  ENDIF


  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF
RETU
&&-----------------------------------------------------------------------------
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP31
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	 IC_X=ALLTRIM(STR(I,2,0))
	 IF ((STP&IC_X >=1)   .and. (STP&IC_X <7 ) )  .OR. (I=5 .AND. STP6 >0)	  .OR. (I=8 .AND. STP9 >0)
	   IF  A_PRESS_N0[2,STPN&IC_X,I,1]>0
	     A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	   ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	   ENDIF
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	 ENDIF
       NEXT
    ENDIF
    XNDD1=  CHENDATA(GS_TOT)
    XNDD2=  CHENDATA(GS_TOT +1)
    XDSPC=RIGHT(ALLTRIM(A_M_NAME[KLCHN+1,3]),2)
    IF XDSPC="."
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/204.8)/10
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/204.8)/10
    ELSE
      DD1=INT(XNDD1 *A_M_NAME[5,10]/PER/2048)
      DD2=INT(XNDD2 *A_M_NAME[6,10]/PER/2048)
    ENDIF
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    XNDD3=  CHENDATA(GS_TOT +2)
    XNDD4=  CHENDATA(GS_TOT +3)
    DD4=INT( XNDD4  *A_M_NAME[8,10]/PER/2048)
    XNDD5=  CHENDATA(GS_TOT +4)
    DD5=( XNDD5  *A_M_NAME[9,10]/PER/2048)
    DD6=INT((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]*100/PER/2048)/100
    DD7=INT((CHENDATA(GS_TOT +6))*A_M_NAME[11,10]*100/PER/2048)/100
    XDD1=DD1
    XDD2=DD2
    XDD3=DD3
    XDD4=DD4
    XDD5=DD5
    ICS=A_M_NAME[5,3]
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "&ICS"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT  "&ICS"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    IF A_M_NAME[10,13]	<>0
      ICS=A_M_NAME[10,3]
      @ 8,A_M_NAME[10,13]     SAY   DD6   PICT "&ICS"
    ENDIF
    ICS=A_M_NAME[11,3]
    @ 8,A_M_NAME[11,13]     SAY   DD7	PICT "&ICS"

  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+3,10]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[GS_TOT+6,10]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[GS_TOT+7,10]
  ENDIF

  DD1=(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  *if  (stp6>0 .and.  stp6 <=3 )  .or.	( stp5 >0 )
  *  IF  (A_M_NAME[GS_TOT +1,10] <>A_M_NAME[GS_TOT +1,9])  .OR.  (A_M_NAME[GS_TOT +2,10] <>A_M_NAME[GS_TOT +2,9])
  *    DD1=XDD1+XDD2
  *  ENDIF
  *ELSEIF (STP6 >3  )	.AND.  (STP6 <=6 )
  *  DD1=(WDATA(KLCHN+0)-2048) * (XDD1 +XDD2)/ ( XNDD1+XNDD2)
  *ENDIF
  *if DSPDATA_A[3]=1
    DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  *  ACTWEIT_A[KLCHN+1] :=DD2
  *ELSE
  *  DD2 := ACTWEIT_A[KLCHN+1]
  *ENDIF
  DD3=INT(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])/PER/2048)
  if  (stp9>0 .and.  stp9 <=3 )  .or.  ( stp7 >0 )
    IF	(A_M_NAME[GS_TOT +3,10] <>A_M_NAME[GS_TOT +3,9])  .OR.	(A_M_NAME[GS_TOT +4,10] <>A_M_NAME[GS_TOT +4,9])   .OR.  (A_M_NAME[GS_TOT +5,10] <>A_M_NAME[GS_TOT +5,9])
      DD3=XDD3+ XDD4+XDD5
    ENDIF
  ELSEIF (STP9 >3  )   .AND.  (STP9 <=6 )
    DD3=(WDATA(KLCHN+2)-2048) * (XDD3 +XDD4 +XDD5)/ (XnDD3 + XNDD4+XNDD5)
  ENDIF
  *if A_M_NAME[KLCHN+4,12] >2
    DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,12])/PER/2048)
  *ELSE
  *  DD4=(((WDATA(KLCHN+3)-2048)*A_M_NAME[KLCHN+4,6])/PER/2048)
  *ENDIF
  DD5=(((WDATA(KLCHN+4)-2048)*A_M_NAME[KLCHN+5,12])/PER/2048)
  W_1=DD2
  W_2=DD3
  XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  DD3=N_DIV(DD3,DSP_DIV[KLCHN+3])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY DD3	 PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+4,5])
  DD4=N_DIV(DD4,DSP_DIV[KLCHN+4])
  @ 10,A_M_NAME[KLCHN+4,16]   SAY DD4	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+5,5])
  DD5=N_DIV(DD5,DSP_DIV[KLCHN+5])
  @ 10,A_M_NAME[KLCHN+5,16]   SAY DD5	PICT "&XDSPC"
  IF LCHTYPE=30
    XDSPC= ALLTRIM(A_M_NAME[KLCHN+1,5])
    IF SUBSTR(XDSPC,-2,1) ="."
      XDSPC=1
    ELSE
      XDSPC=0
    ENDIF
     _SEND_RS40D(KLCHN+0,XDSPC,DD1)
     _SEND_RS40D(KLCHN+1,0,DD2)

     _SEND_RS40D(KLCHN+2,0,DD3)
     _SEND_RS40D(KLCHN+3,2,DD4)
     _SEND_RS40D(KLCHN+4,2,DD5)
  ENDIF


  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
    A_M_NAME[KLCHN+4,12]=A_M_NAME[KLCHN+4,6]
    A_M_NAME[KLCHN+5,12]=A_M_NAME[KLCHN+5,6]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF
RETU
&&-----------------------------------------------------------------------------
&&-----------------------------------------------------------------------------
FUNCTION   SEND_ES2001
PARAMETERS  x_decn,sdn1
IF SIO2_FAULT <> 0
   RETU
ENDIF
txc="ST,GS,"
IF (SDN1 <0)
  TXC =TXC +"-"
  SDN1=-SDN1
ELSE
  TXC =TXC +"+"
ENDIF
IF (X_DECN >0)
  SDNC=STR(SDN1,7,X_DECN)
ELSE
  SDNC=STR(SDN1,7,0)
ENDIF
TXC=TXC +SDNC
TXC=TXC +CHR(13) +  CHR(10)
SIO_PUTB(S2_PORT,TXC)
RETU


&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP33
PARAMETERS  P1,P2,P3
  IF STAR=1
    IF W0DBF=1	.AND. DSPD_NOR=0
      FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	IC_X=ALLTRIM(STR(I,2,0))
	IF (STP&IC_X >=1)  .OR. (I=6 .AND. STP7 >0)    .OR. (I=8 .AND. STP9 >0)
	  IF  A_PRESS_N0[2,1,I,1]>0
	    A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	  ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	  ENDIF
	ELSE
	  A_M_NAME[I,10]=A_M_NAME[I,9]
	ENDIF
      NEXT
    ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[5,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[6,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3)*A_M_NAME[8,10]*100/PER/2048))/100
    DD5=INT((CHENDATA(GS_TOT +4)*A_M_NAME[9,10]*100/PER/2048))/100
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+4,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  XD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  XD1=N_DIV(XD1,DSP_DIV[KLCHN+1])
  IF  (DSPD_NOR=0) .AND. ((STP6>=1 .AND. STP6<=3) .OR. (STP7>=1 .AND. STP7<=6))
    DD3_MY=INT((WDATA(KLCHN+1)-CHENDATA(GS_TOT +1)-CHENDATA(GS_TOT +2)-2048)*A_M_NAME[KLCHN+2,12]/PER/2048)
    XD2=INT(DD2 +DD3 +DD3_MY)
  ELSE
    XD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])*PERCON/PER/2048)
  ENDIF
  XD2=N_DIV(XD2,DSP_DIV[KLCHN+2])
  IF  (DSPD_NOR=0) .AND. ((STP8>=1 .AND. STP8<=3) .OR. (STP9>=1 .AND. STP9<=6))
    DD5_MY=INT(100*(WDATA(KLCHN+2)-CHENDATA(GS_TOT +3)-CHENDATA(GS_TOT +4)-2048)*A_M_NAME[KLCHN+3,12]/PER/2048)/100
    XD3=INT((DD4 +DD5 +DD5_MY)	*100) /100
  ELSE
    XD3=(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])*PERCON/PER/2048)
  ENDIF
  XD3=N_DIV(XD3*100,DSP_DIV[KLCHN+3])/100
  W_1=XD2
  W_2=XD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY XD1	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY XD2	PICT "&XDSPC"
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY  XD3	  PICT "&XDSPC"
  _SEND_RS40D(KLCHN+0,0,XD1)
  _SEND_RS40D(KLCHN+1,0,XD2)
  _SEND_RS40D(KLCHN+2,2,XD3)



  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP34
PARAMETERS  P1,P2,P3
  IF STAR=1
     IF W0DBF=1  .AND. DSPD_NOR=0
       FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
	 IC_X=ALLTRIM(STR(I,2,0))
	 IF (STP&IC_X >=1)  .OR. (I=6 .AND.( STP7 >0 .or. STP8 >0  ))	 .OR. (I=9 .AND. STP10 >0)
	   IF  A_PRESS_N0[2,1,I,1]>0
	     A_M_NAME[I,10]=A_M_NAME[I,9] * A_PRESS_N0[2,STPN&IC_X,I,8]/A_PRESS_N0[2,STPN&IC_X,I,1]
	   ELSE
	    A_M_NAME[I,10]=A_M_NAME[I,9]
	   ENDIF
	 ELSE
	   A_M_NAME[I,10]=A_M_NAME[I,9]
	 ENDIF
       NEXT
     ENDIF
    DD1=INT((CHENDATA(GS_TOT))*A_M_NAME[5,10]/PER/2048)
    DD2=INT((CHENDATA(GS_TOT +1))*A_M_NAME[6,10]/PER/2048)
    DD3=INT((CHENDATA(GS_TOT +2))*A_M_NAME[7,10]/PER/2048)
    DD4=INT((CHENDATA(GS_TOT +3))*A_M_NAME[8,10]/PER/2048)
    DD5=((CHENDATA(GS_TOT +4))*A_M_NAME[9,10]/PER/2048)
    DD6=((CHENDATA(GS_TOT +5))*A_M_NAME[10,10]/PER/2048)
    @ 8,A_M_NAME[5,13]	  SAY	 DD1   PICT "9999"
    @ 8,A_M_NAME[6,13]	   SAY	 DD2   PICT "9999"
    @ 8,A_M_NAME[7,13]	   SAY	 DD3   PICT "9999"
    tstn=dd3
    ICS=A_M_NAME[8,3]
    @ 8,A_M_NAME[8,13]	   SAY	 DD4   PICT "&ICS"
    ICS=A_M_NAME[9,3]
    @ 8,A_M_NAME[9,13]	   SAY	 DD5   PICT "&ICS"
    ICS=A_M_NAME[10,3]
    @ 8,A_M_NAME[10,13]     SAY   DD6	PICT "&ICS"
  ENDIF
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[GS_TOT+1,10]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[GS_TOT+2,10]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[GS_TOT+5,10]
    FOR I= GS_TOT + 1  to GS_TOT + UWC_TOT
      A_M_NAME[I,10]=A_M_NAME[I,9]
    NEXT
  ENDIF

  DD1=INT(((WDATA(KLCHN+0)-2048)*A_M_NAME[KLCHN+1,12])/PER/2048)
  IF (STP6 >0)	.OR. (STP7 >0)	.OR. (STP8 >0)
    IF	(A_PRESS_N0[2,1,6,1]>0)  .or. (A_PRESS_N0[2,1,7,1]>0)  .or.  (A_PRESS_N0[2,1,8,1]>0)
      A_M_NAME[KLCHN+2 ,12]=A_M_NAME[KLCHN +2,6]
    ENDIF
     DD2=DD2+DD3+DD4
     XD5=CHENDATA(GS_TOT +1)+CHENDATA(GS_TOT +2)+ CHENDATA(GS_TOT +3)
     IF XD5 > 0
       DD2_MY=INT((WDATA(klchn +1)-XD5-2048)* DD2 /PER/XD5)
     ELSE
       DD2_MY=INT((WDATA(klchn +1)-2048)* A_M_NAME[klchn +2,12] /PER/2048)
     ENDIF
     dd2= DD2 +DD2_MY
  else
    DD2=INT(((WDATA(KLCHN+1)-2048)*A_M_NAME[KLCHN+2,12])/PER/2048)
  ENDIF
  IF  (DSPD_NOR=0) .AND. ((STP9>=1 .AND. STP9<=3) .OR. (STP10>=1 .AND. STP10<=6))
    DD5_MY=INT(100*(WDATA(KLCHN+2)-CHENDATA(GS_TOT +4)-CHENDATA(GS_TOT +5)-2048)*A_M_NAME[KLCHN+3,12]/PER/2048)/100
    XD3=INT((DD5 +DD6 +DD5_MY)	*100) /100
  ELSE
    XD3=(((WDATA(KLCHN+2)-2048)*A_M_NAME[KLCHN+3,12])*PERCON/PER/2048)
  ENDIF
  XD3=N_DIV(XD3*100,DSP_DIV[KLCHN+3])/100
  W_1=DD2
  W_2=DD3
  XDSPC=ALLTRIM(A_M_NAME[KLCHN+1,5])
  DD1=N_DIV(DD1,DSP_DIV[KLCHN+1])
  @ 10,A_M_NAME[KLCHN+1,16]   SAY DD1	PICT "&XDSPC"

  XDSPC=ALLTRIM(A_M_NAME[KLCHN+2,5])
  DD2= (DD2 + DISC2_C2N)
  DD2=N_DIV(DD2,DSP_DIV[KLCHN+2])
  @ 10,A_M_NAME[KLCHN+2,16]   SAY DD2	PICT "&XDSPC"

  XDSPC=ALLTRIM(A_M_NAME[KLCHN+3,5])
  @ 10,A_M_NAME[KLCHN+3,16]   SAY XD3	PICT "&XDSPC"
  IF SIO1_FAULT = 0
    _SEND_RS40D(KLCHN,0,DD1)
    _SEND_RS40D(KLCHN+1,0,DD2)
    _SEND_RS40D(KLCHN+2,2,DD3)
  endif
  IF W0DBF=1
    A_M_NAME[KLCHN+1,12]=A_M_NAME[KLCHN+1,6]
    A_M_NAME[KLCHN+2,12]=A_M_NAME[KLCHN+2,6]
    A_M_NAME[KLCHN+3,12]=A_M_NAME[KLCHN+3,6]
  ENDIF
RETU
&&-----------------------------------------------------------------------------
FUNCTION   GET_RND
PARAMETERS  STDN
IF STDN=0
   STDN=2
ENDIF
XRAND=int(RAND() *  SECONDS())
RETN =( -STDN + MOD(XRAND,2*STDN))
RETU   RETN
&&-----------------------------------------------------------------------------
&&-----------------------------------------------------------------------------
PROCEDURE   DSP2_UP99
PARAMETERS  P1,P2,P3
IF STAR=1
  IF	 ISDEMO=1   .and. dosign=0
    DO DEMO_INP
  ENDIF
  IF W0DBF=1 .AND. DSPD_NOR=0
    FOR I=1 TO (GS_TOT +UWC_TOT)
      IC_X=ALLTRIM(STR(I,2,0))
      STXC=IC_X
      IF (I>GS_TOT)
	  X=I
	  STXC_2=ALLTRIM(STR(X-1,2,0))
	  STXC=ALLTRIM(STR(X,2,0))
	  STXC_B=ALLTRIM(STR(X+1,2,0))
      ENDIF
      A_M_NAME[I,10]=A_M_NAME[I,9]
      do case
      case  WEIGHT_TYPE[I]=77
	  IF (STP&STXC >=1)
	      x=A_PRESS_N0[2,STPN&IC_X,i,2]
	      x1=A_PRESS_N0[2,STPN&IC_X,i,11]
	      A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+x1)/(A_PRESS_N0[2,STPN&IC_X,I,1]+x)
	  ENDIF
      case  WEIGHT_TYPE[I]=1
	  IF ((STP&STXC >=1) .OR. (STP&STXC_B >=1)  )
	      x=A_PRESS_N0[2,STPN&IC_X,i,2]
	      x1=A_PRESS_N0[2,STPN&IC_X,i,11]
	      A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+x1)/(A_PRESS_N0[2,STPN&IC_X,I,1]+x)
	  ENDIF
      case  WEIGHT_TYPE[I]=2
	  IF ((STP&STXC >=1) .OR. (STP&STXC_2 >=1)  )
	      x=A_PRESS_N0[2,STPN&IC_X,i,2]
	      x1=A_PRESS_N0[2,STPN&IC_X,i,11]
	      A_M_NAME[I,10]=A_M_NAME[I,9] * (A_PRESS_N0[2,STPN&IC_X,I,8]+x1)/(A_PRESS_N0[2,STPN&IC_X,I,1]+x)
	  ENDIF
      endcase
    NEXT
  ENDIF
  DDY1 :=ARRAY(14)
  FOR XN1=1  TO  (GS_TOT + UWC_TOT)
      IF (VAL(A_M_NAME[XN1,3])	<100)
	  DDY1[XN1] =INT((CHENDATA(XN1-1))*A_M_NAME[XN1,10]*100/PER/2048)/100
      ELSE
	  DDY1[XN1] =INT((CHENDATA(XN1-1))*A_M_NAME[XN1,10]/PER/2048)
      ENDIF
      XN2=A_M_NAME[XN1,3]
      @ 8,A_M_NAME[XN1,13]  SAY   DDY1[XN1]   PICT   "&XN2"
      A_M_NAME[XN1,10]=A_M_NAME[XN1,9]
  NEXT
ENDIF
DDY2 :=ARRAY(14)
FOR XN1=1  TO  (KLCHN + KUCHN )
    IF W0DBF=0	.OR. DSPD_NOR=1 .OR. STAR=0
       DDY2[XN1] = (WDATA(XN1-1)-2048)*A_M_NAME[XN1,12]/PER/2048
    ELSE
       DO CASE
       CASE  WSCALE_TYPE[xn1]=1
	      DDY2[XN1] = (WDATA(XN1-1)-2048)*A_M_NAME[XN1,12]/PER/2048
       CASE  WSCALE_TYPE[xn1]=2
	   IF ((STP&XC >0) .OR. ((STP&XC_B >0) .and. (STP&XC_B <6) ))
	       DDY2[XN1] = DDY1[xn1] + DDY1[XN1 +1]
	       d_my=((WDATA(XN1-1)-2048) -chendata(XN1-1)-chendata(XN1))*A_M_NAME[XN1,12]/2048
	       DDY2[XN1] =  DDY2[XN1] +d_my
	   ELSE
	       DDY2[XN1] = (WDATA(XN1-1)-2048)*A_M_NAME[XN1,12]/PER/2048
	   ENDIF
       CASE  WSCALE_TYPE[XN1]=5

	 DDY2[XN1] = (WDATA(XN1-1)-2048)*A_M_NAME[XN1,12]/PER/2048
       ENDCASE
    ENDIF
    IF (VAL(A_M_NAME[XN1,5])  <100)
	DDY2[XN1] =INT(DDY2[XN1] *100)/100
	XDIGIT=2
    ELSE
	DDY2[XN1] =INT(DDY2[XN1])
	XDIGIT=0
    ENDIF
    DDY2[XN1] =DDY2[XN1] + REMOTE[XN1]
    XN2=A_M_NAME[XN1,5]
    XN3=N_DIV(DDY2[XN1] ,DSP_DIV[XN1])
    @ 10,A_M_NAME[XN1,16]  SAY	XN3  PICT "&XN2"
    _SEND_RS40D(XN1-1,XDIGIT,XN3)
NEXT
RETU
&&-----------------------------------------------------------------------------
