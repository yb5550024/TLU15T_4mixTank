PROCEDURE  MONI_G12
PARAMETERS  P1,P2,P3
DO CASE
CASE MNGSTP=1  .AND. DIN(8)=0  .AND. DIN(10)=1	  .AND.  DIN(11)=1 .AND.  DIN(15)=1
    MNGSTP=2
    FOR XF=1  TO 2
      IF WTANK_F[XF,1] <> 1
	 MNGSTP=1
	 RETU
      ENDIF
    NEXT
    FOR XF=1  TO 2
	WTANK_F[XF,1]=-99
	WTANK_F[XF,2]=0
    NEXT
    SET COLOR TO B+ / &C1
    @ 13,UPTANK[5,1]-2 SAY "ú^ú]ú_"
    SET COLOR TO &C2 / &C1


CASE MNGSTP=2
  MNGSTP=3
  FOR XF=1  TO 2
    IF WTANK_F[XF,2] <> 1
       MNGSTP=2
       RETU
    ENDIF
  NEXT
  FOR XF=1  TO 2
      WTANK_F[XF,2]=0
  NEXT
  UPTANK[4,2]=SECONDS()


CASE MNGSTP=3
  MNGSTP=4
  X=SECONDS()-UPTANK[4,2]
  IF X<0
    X=86399+SECONDS()-UPTANK[4,2]
  ENDIF
  X=UPTANK[4,1]-X
  IF  X<=0
    X=0
  ENDIF
  SET  COLO TO GR+ /&C1
  @  4,UPTANK[5,1]   say  X  PICT "99"
  SET  COLO TO &C2 /&C1
  IF X >0
    CNVSTP=10
    MNGSTP=3
  ENDIF
CASE MNGSTP=4
  MNGSTP=0
ENDCASE
RETU
