  IF DIN(15)=0	 && PAUSE
    DROPTM_S=SECONDS()
    DROPTM=0
    DOUT(15,0)
  ELSE
    IF DIN(13)=1
      IF DIN(9)=0
	DROPT_S=SECONDS()
	DROPTM=0
	DOUT(12,0)
	IF BEEP=2
	  BEEP=1
	ENDIF
      ELSE
	IF BEEP=1
	  DOUT(12,1)
	  ALMTM[1,2] := SECONDS()
	  ALMTM[2,2] := 0
	  BEEP=2
	ENDIF
      ENDIF
      IF ABS(SECONDS()-DROPTM_S)>=1
	DROPTM=DROPTM+1
	DROPTM_S=SECONDS()
      ENDIF
      DOUT(15,1)
    ELSE
      DROPTM_S=SECONDS()
      DROPTM=0
      DOUT(15,0)
    ENDIF
  ENDIF
  IF DROPTM >=PMIXOP
