      NEXT
    ENDIF
  CASE	(LCHTYPE=14 .OR. LCHTYPE=5  .OR. LCHTYPE=15 ) .AND. NEXTOK1=1 .and. STP2=0 .and. STP3=0 .and. STP4=0
    IF (A_PRESS_N0[1,21,1,1] =77)
      A_PRESS_N0[1,21,1,1] :=0
