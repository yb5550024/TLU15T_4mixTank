FUNCTION GET_DATA
PARAMETERS  GD_PRESS
SELE 2
LOCA FOR RATNO=ARATNO
IF .NOT. EOF()
  @ 23,75 SAY ACALW_REP  PICT "99"
  ACALW_REP=ACALW_REP-1
  IF  ACALW_REP <0
    ACALW_REP=0
  ENDIF
  NEXTOK1=1
  NSCANO1=ASCANO
  VUSE=AVUSE
  RATNO=ARATNO
  CARNO=ACARNO
  TANDO=ATANDO
  FILL_A_D4(A_PRESS_N0,1,1,21,12,11,0)
  FILL_A_D2(A_PRESS_N1,GD_PRESS,GD_PRESS,18,0)
  FILL_A_D4(A_PRESS_B0,1,1,21,12,11,0)

  A_PRESS_N1[GD_PRESS,13] :=RATVOL
  A_PRESS_N1[GD_PRESS,15] :=VUSE
  FOR IX=1 TO 12
    A_PRESS_N0[1,21,IX,1] :=77
    A_PRESS_N0[1,21,IX,2] :=RATNO
  NEXT
  IF AUTOR =0
    DO MP1
  ELSE
    DO MP1_1
  ENDIF
  actx=0
  FOR I=1  TO GS_TOT +UWC_TOT
    ic=ltrim(str(i,2,0))
    if (stp&ic > 0)
      actx=1
      exit
    endif
  NEXT
  MX=1
  WHILE  A_PRESS_N0[GD_PRESS,MX,1,5] >0
    FOR I=1  TO GS_TOT +UWC_TOT
      IC_X=ALLTRIM(STR(I,2,0))
      X0= A_PRESS_N0[GD_PRESS,MX,I,1]
      A_PRESS_N0[GD_PRESS,MX,I,8] := X0
      IF MX=1
	if( actx=0  .and.  lchtype=6)
	   SET COLOR TO gr+/ &C1
	   XMC_F=A_M_NAME[i,3]
	   @  4,A_M_NAME[I,13]	SAY  x0  PICT "&XMC_F"
	   SET COLOR TO &C7 +/ &C1
	endif
      endif
    NEXT
    MX=MX+1
  ENDDO
  IF W0DBF=1
    SELE 17
    LOCA FOR RATNO=ARATNO
    IF	(.NOT. EOF() )	.AND.  (W0_EN=1)
      MX=1
      WHILE  A_PRESS_N0[GD_PRESS,MX,1,5] >0
	FOR I=1  TO GS_TOT +UWC_TOT
	  IC_X=ALLTRIM(STR(I,2,0))
	  X0= A_PRESS_N0[GD_PRESS,MX,I,1]
	  X1= A_PRESS_N0[GD_PRESS,MX,I,5] * M&IC_X
	  A_PRESS_N0[GD_PRESS,MX,I,1] := X1
	  IF  LCHTYPE=16 .or. LCHTYPE=17   .or. UCHTYPE=19
	    A_PRESS_B0[GD_PRESS,MX,I,1] := X1
	  ENDIF


	NEXT
	MX=MX+1
      ENDDO
    else
      if disc2>0
	do case
	case lchtype=13
	  MX=1
	  IF A_PRESS_N0[GD_PRESS,MX,6,8] >0
	    WHILE  A_PRESS_N0[GD_PRESS,MX,1,5] >0
		XDISC=DISC2  *	A_PRESS_N0[GD_PRESS,MX,1,5]
		X0= XDISC  * A_PRESS_N0[GD_PRESS,MX,3,8]/(A_PRESS_N0[GD_PRESS,MX,3,8] +A_PRESS_N0[GD_PRESS,MX,4,8] )
		A_PRESS_N0[GD_PRESS,MX,3,1]=A_PRESS_N0[GD_PRESS,MX,3,1]  + X0
		X0= XDISC  *  A_PRESS_N0[GD_PRESS,MX,4,8]/(A_PRESS_N0[GD_PRESS,MX,3,8] +A_PRESS_N0[GD_PRESS,MX,4,8] )
		A_PRESS_N0[GD_PRESS,MX,4,1]=A_PRESS_N0[GD_PRESS,MX,4,1]  + X0
		A_PRESS_N0[GD_PRESS,MX,6,1]=A_PRESS_N0[GD_PRESS,MX,6,1]  -XDISC
	      MX=MX+1
	    ENDDO
	  ENDIF
	endcase
      ENDIF
    ENDIF
    SELE 2
  ENDIF
  SET COLOR TO GR + * / &C1
  @ 23,15 SAY ASCANO  PICT "9999"
  @ 23,25 SAY ACARNO
  @ 23,42 SAY ARATNO  PICT "9999"
  @ 23,52 SAY AVUSE   PICT "99.9"
  @ 23,61 SAY ATANDO  PICT "9999"
  SET COLOR TO &C7 +/ &C1
  &&¨®¸¹	    ACARNO
  &&ªÅ­«	    ACARW
  &&°t¤ñNO	    ARATNO
  &&¦Ì¼Æ	    AVUSE
  &&§~«×	    ATANDO
  &&«È¤áNO	    AUS2
  &&DRIVER NAME     ACARDRV
  &&²Ö­p¦Ì¼Æ	    AUS3=XU
  &&²Ö­p¨®¦¸	    ATOT_CAR
  &&«È¤á¦WºÙ	    AUS2_1
  &&°e³f¦a§}	    AUS2_2
  &&³æ»ù	    AU_PRICE
  X=_TOT_D_A[20,4]
  IF  X =0
    IF _TOT_D_A[20,3]=0
      _TOT_D_A[20,4] :=1
      X=3
    ELSE
      _TOT_D_A[20,4] := _TOT_D_A[20,3]
      X=_TOT_D_A[20,3]
      X=MOD(X,2)+1
      _TOT_D_A[20,3] :=X
      X=X+2
    ENDIF
  ELSE
    X=_TOT_D_A[20,4]
    X=MOD(X,2)+1
    _TOT_D_A[20,3] :=X
    X=X+2
  ENDIF
   _TOT_D_A[3,X]  :=AUS2_1
   _TOT_D_A[4,X]  :=AUS2_2
   _TOT_D_A[5,X]  :=0
   _TOT_D_A[6,X]  :=ACARW
   _TOT_D_A[7,X]  :=0
   _TOT_D_A[8,X]  :=TIME()
   _TOT_D_A[9,X]  :=ATOT_CAR
   _TOT_D_A[10,X] :=AVUSE
   _TOT_D_A[11,X] :=AUS3

   IF FPS=77  &&  PAR.DBF 30 PA7=77  28TH C12  STRIGHT	=XX00  LB
     _TOT_D_A[12,X] :=(INT(ARATNO /100) *100)
   ELSE
     _TOT_D_A[12,X] :=S_STRO
   ENDIF
   _TOT_D_A[13,X] :=ACARNO
   _TOT_D_A[14,X] :=ATANDO
   _TOT_D_A[15,X] :=ACARDRV
   _TOT_D_A[16,X] :=AUS2
   _TOT_D_A[17,X] :=ASCANO
   _TOT_D_A[18,X] :=ARATNO
   _TOT_D_A[21,X] :=AU_PRICE
  IF ASCANO <> 0
    IF	LAG_REPNO <> ASCANO
      LAG_REPNO = ASCANO
    ENDIF
    IF LAGDATE=DATE()
      LAG_REPNO=LAG_REPNO+1
    ELSE
      LAG_REPNO=1
      LAGDATE=DATE()
    ENDIF
