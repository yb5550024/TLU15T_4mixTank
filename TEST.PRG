      A_PRESS_N0[1,21,3,1] :=0
      A_PRESS_N0[1,21,4,1] :=0
      a_copy_4(A_PRESS_N0,1,4)
      IF UCHTYPE=19
	a_copy_4(A_PRESS_B0,1,4)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP1=1
      STP2=0
      STP3=0
      STP4=0
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,ix,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE	(LCHTYPE=21 ) .AND. NEXTOK1=1 .and. STP2=0 .and. STP3=0 .and. STP4=0 .and. STP5=0
    IF (A_PRESS_N0[1,21,1,1] =77)
      A_PRESS_N0[1,21,1,1] :=0
      A_PRESS_N0[1,21,2,1] :=0
      A_PRESS_N0[1,21,3,1] :=0
      A_PRESS_N0[1,21,4,1] :=0
      A_PRESS_N0[1,21,5,1] :=0
      a_copy_4(A_PRESS_N0,1,5)
      NEXTOK1=0
      STP1=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,ix,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE (LCHTYPE=8  .or. LCHTYPE=16 .or. LCHTYPE=17 )  .AND. NEXTOK1=1 .and. STP2=0
    IF (A_PRESS_N0[1,21,1,1] =77)
      A_PRESS_N0[1,21,1,1] :=0
      A_PRESS_N0[1,21,2,1] :=0
      a_copy_4(A_PRESS_N0,1,2)
      IF LCHTYPE=16
	a_copy_4(A_PRESS_B0,1,2)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      ENDIF
      NEXTOK1=0
      STP1=1
      STP2=0
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,ix,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  ENDCASE

CASE (STP1=1)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  STP1=2
  IF STPN1=1
    E_STORE = 1
    X=_TOT_D_A[20,4] +2
    IF _TOT_D_A[17,X]=0
      E_STORE = 0
    ENDIF
    &&IF E_STORE =1
    &&	DO  PNT_TIT
    &&ENDIF
  ENDIF
  DO  CASE
  CASE LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7  .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12  .or. LCHTYPE=13
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      WTANK_F[STP_FN,1] :=77	&& 77=­p¶q¤¤,1=­p¶qok,-99=can ¶i®Æ,0=NOTHING
      STP1=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE LCHTYPE=4
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      IF KOT=1
	WTANK_F[1,1] :=77
	WTANK_F[2,1] :=77
	WTANK_F[3,1] :=77
      ENDIF
      STP1=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE	 LCHTYPE=14 .OR. LCHTYPE=5    .OR. LCHTYPE=15
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      WTANK_F[1,1] :=77
      WTANK_F[2,1] :=77
      WTANK_F[3,1] :=77
      WTANK_F[4,1] :=77
      STP1=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE	 LCHTYPE=21
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      WTANK_F[1,1] :=77
      WTANK_F[2,1] :=77
      WTANK_F[3,1] :=77
      WTANK_F[4,1] :=77
      WTANK_F[5,1] :=77
      STP1=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE (LCHTYPE=8  .or.  LCHTYPE=16 .or. LCHTYPE=17 )
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      WTANK_F[1,1] :=77
      WTANK_F[2,1] :=77
      STP1=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  ENDCASE
CASE STP1=2
  DO CASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    SETDLA(0,0)
    DO CASE
    CASE LCHTYPE=2 .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      WTANK_F[STP_FN,1] :=1    && 77=­p¶q¤¤,1=­p¶qok,-99=can ¶i®Æ,0=NOTHING
      STP&STP_FC=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      STP&STP_FC=4
    CASE LCHTYPE=4
      STP1=0
      STP2=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE   LCHTYPE=14 .OR. LCHTYPE=5   .or.  LCHTYPE=8	  .OR. LCHTYPE=15  .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=21
      STP1=0
      STP2=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    ENDCASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    ADJWN=0
    ADJWN_f=0
    IF WATER_INPUT=1
      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * G1_WATER/100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      IF  UCHTYPE=16 .or. UCHTYPE=17
	XA1=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * GS_ADJ[1]  /100)
	XA2=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] * GS_ADJ[3]	/100)
	GS_ADJW[3]=XA1 +XA2
	XA1=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * GS_ADJ[2]  /100)
	XA2=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] * GS_ADJ[4]	/100)
	GS_ADJW[4]=XA1 +XA2
      ENDIF
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] *(1+ ((GS_ADJ[1] +GS_ADJ[2]) /100)))
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * G1_WATER   /100)
    ENDIF
    DO CASE
    CASE LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] + ADJWN )
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1  && THE WEIGHT SCALE BIGGER THEN THE SETTING DATA
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +ADJWN_f  PICT "&XMC_F"
	  DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
	  WTANK_F[STP_FN,1] :=1     && 77=­p¶q¤¤,1=­p¶qok,-99=can ¶i®Æ,0=NOTHING
	  EWN=WDATA(STP_ZN)-2048
	  EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	  XMC_F=A_M_NAME[STP_FN,3]
	  *@  8,A_M_NAME[STP_FN,13]  SAY  EW1	PICT "&XMC_F"
	  SETCHDATA(STP_ZN,EWN)
	  STP&STP_FC=4
