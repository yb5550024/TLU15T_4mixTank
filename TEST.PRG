	 ALMTM[1,2] := SECONDS()
	 ALMTM[2,2] =0
      ENDIF
    ENDIF
  ENDIF
  SET COLOR TO &C7 +/ &C1
  IF DIN(15)=0	 && PAUSE
    DROPTM_S=SECONDS()
    DROPTM=0
    DOUT(15,0)
    DOUT(12,0)
  ELSE
    IF DIN(13)=1
