  IF INT((MIXA()-2048)*MAIN_AMP/2048)<=PMIXA
    IF PLOT_E=1
      DO  TANK_DSP
    ENDIF
    TANKSTP=5
    DROPTM_S=SECONDS()
    DROPTM=0
    X=1
    FOR IX=(GS_TOT+1) TO (GS_TOT+UWC_TOT)
      IF WTANK_F[IX,3]=0
	X=0
	EXIT
      ENDIF
    NEXT
    IF X=1
     &&DOUT(12,1)
      BEEP=1


      FOR IX=(GS_TOT+1) TO (GS_TOT+UWC_TOT)
	WTANK_F[IX,3]=0
      NEXT
    ELSE
      BEEP=0
    ENDIF
  ENDIF
  IF DIN(15)=0	 && PAUSE
    MIXTM_S=SECONDS()
  ELSE
    IF ABS(SECONDS()-MIXTM_S)>=1
      MIXTM=MIXTM+1
      MIXTM_S=SECONDS()
    ENDIF
  ENDIF
  SET COLO TO  GR+ /&C1
  X=0
  IF PLOT_ACT=1
    X=1
  ENDIF
  @ 17+X,51 SAY MIXTM  PICT "999"
  SET COLO TO  &C2 /&C1
CASE  TANKSTP=5
  IF DIN(13)=1
