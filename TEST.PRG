    @ 15,12 SAY "    "
    @ 16,12 SAY "    "
    @ 17,12 SAY "    "
  ENDIF
  IF  SPACIAL_0=1
     set  colo	to  W+	/&C1
     @ 15,41 SAY "©Õ¦X¢²"

  ENDIF
  SET COLOR TO &C2 / &C1
  @ 18,40 SAY "úLúPúPúPúPúPúPúPúPúPúPúPúPúPúPúPúPúPúO"
  SET COLOR TO &C7 +/ &C1
  @ 17,64 SAY  "   "
  @ 17,51 SAY "   "
  TANKSTP=0
ENDCASE

