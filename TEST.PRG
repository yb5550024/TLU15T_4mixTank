  IF BEEP=2
    IF ALMTM[1,2] >0
      IF (SECONDS()-ALMTM[1,2]) >= ALMTM[1,1]
	 DOUT(12,0)
	 ALMTM[1,2] =0
	 ALMTM[2,2] := SECONDS()
      ENDIF
    ELSE
      IF (SECONDS()-ALMTM[2,2]) >= ALMTM[2,1]
	 DOUT(12,1)
	 ALMTM[1,2] := SECONDS()
	 ALMTM[2,2] =0
      ENDIF
    ENDIF
  ENDIF
CASE  TANKSTP=6
  DOUT(15,0)  &&MAIN M/C DOOR
  DOUT(12,0)  && LAST ALARM
  X=1
  FOR IX=1 TO 12
    IF WTANK_F[IX,3]=0
      X=0
      EXIT
    ENDIF
  NEXT
  IF X=1
    FOR IX=1 TO 12
      WTANK_F[IX,3] :=0
    NEXT
