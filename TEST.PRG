      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
      SETDLA(1,0)
    CASE   LCHTYPE=14  .OR. LCHTYPE=15 .or.  LCHTYPE=5 .or. LCHTYPE=21
      STP3=0
      STP4=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    ENDCASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    IF	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
      DSPDATA_A[STP_FN] := 1
    ELSE
      DSPDATA_A[STP_FN] := 0
    ENDIF
    ADJWN=0
    ADJWN_f=0
    IF WATER_INPUT=1
       IF UCHTYPE=16 .or. UCHTYPE=17
	 IF GS_ADJW[4]=0
	   XA1=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,1,1] * (GS_ADJ[2] )  /100)
	   XA2=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,2,1] * (GS_ADJ[4] )  /100)
	   XA0=XA1+XA2
	   GS_ADJW[4]=XA0
	 ENDIF
	 IF GS_ADJW[3]=0
	   XA1=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,1,1] * (GS_ADJ[1] )  /100)
	   XA2=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,2,1] * (GS_ADJ[3] )  /100)
	   XA0=XA1+XA2
	 ELSE
	   XA0=GS_ADJW[3]
	 ENDIF
	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] -XA0
       *ELSE
	 *ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * (WATER_INC[STP_FN] ) /100)
	 *ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * (WATER_INC[STP_FN] ) /100)
	 *A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
       ENDIF
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * (S1_WATER  ) /100)
      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * S1_WATER /100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f




    ELSE
      ADJWN=-PWATER
      ADJWN_F=-PWATER
    ENDIF
    DO CASE
    CASE   LCHTYPE=14 .OR. LCHTYPE=5   .or. LCHTYPE=8  .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13	.OR. LCHTYPE=15 .or.  LCHTYPE=16 .or. LCHTYPE=17
      do case
      CASE   LCHTYPE=14
	XPA1=0
	XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
	ADJWN=	-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
	ADJWN_F=ADJWN
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-2,4] +adjwn
      case    LCHTYPE=5  .OR. LCHTYPE=15  .OR. LCHTYPE=21
	XPA1=0
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-2,4]
      case   LCHTYPE=16
	XPA1=1
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      case  LCHTYPE=8 .or. LCHTYPE=17
	XPA1=1
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
	ADJWN=-PWATER *XP4/ (XP4 +XP5)
	ADJWN=	INT(ADJWN *A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol)
	ADJWN_F=ADJWN
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]+adjwn
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
      case  LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
	XPA1=2
	XPA2= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] + ADJWN
      ENDCASE
      RDDLY(STP_FN,XPA1,XPA2)
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF (XRD=1)
	  XMC_F=A_M_NAME[STP_FN,3]
	  if  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	    X= A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]  + ADJWN_f
	    @  4,A_M_NAME[STP_FN,13]  SAY  X PICT "&XMC_F"
	  endif
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	    DO CASE
	    CASE   LCHTYPE=14 .OR. LCHTYPE=5 .OR. LCHTYPE=8  .OR. LCHTYPE=15 .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=21
	      EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	      EWN=(EW1)*2048/A_M_NAME[STP_FN,10]
	    CASE LCHTYPE=9 .OR. LCHTYPE=10 .OR. LCHTYPE=12   .OR. LCHTYPE=13
	      EWN=WDATA(STP_ZN)-2048
	      EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    ENDCASE
	    XMC_F=A_M_NAME[STP_FN,3]
	    IF DSPDATA_A[STP_FN] =1
	      *@  8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    ENDIF
	    SETCHDATA(STP_ZN,EWN)
	    DO CASE
	    CASE   LCHTYPE=14 .OR. LCHTYPE=5  .OR. LCHTYPE=15
	      EWN=(EW1+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-2,4])*2048/A_M_NAME[STP_FN,10]
	      SETDLA(0,EWN)
	      STP3=0
	      STP4=1
	    CASE LCHTYPE=8 .or.  LCHTYPE=16 .or. LCHTYPE=17
	      SETDLA(1,EWN)
	      STP3=0
	      STP4=1
	    CASE LCHTYPE=13
	      SETDLA(2,0)
	      STP3=3
	    ENDCASE
	  ELSE
	    EWN=WDATA(0)-2048
	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048) -A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4]-A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-2,4]
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    IF DSPDATA_A[STP_FN] =1
	      *@  8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    endif
	    EWN=(EW1)*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    DO CASE
	    *CASE   LCHTYPE=14 .OR. LCHTYPE=5  .OR. LCHTYPE=15
	    *  EWN=(EW1+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4])*2048/A_M_NAME[STP_FN,10]
	    *  SETDLA(0,EWN)
	    CASE   LCHTYPE=21 .OR.  LCHTYPE=14 .OR. LCHTYPE=5  .OR. LCHTYPE=15
	      EWN=(EW1+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,4]+A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-2,4])*2048/A_M_NAME[STP_FN,10]
	      SETDLA(0,EWN)
	    CASE LCHTYPE=8 .or.  LCHTYPE=16 .or. LCHTYPE=17
	    SETDLA(1,EWN)
	    ENDCASE
	    STP3=0
	    STP4=1
	  ENDIF
	ENDIF
	RETU
      ENDIF
    ENDCASE
    XMC_F=A_M_NAME[STP_FN,3]
    IF DSPDATA_A[STP_FN] =1
      @  4,A_M_NAME[STP_FN,13]	SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ ADJWN_f	PICT "&XMC_F"
      SET COLOR TO &C2	/ &C1
      *MTANK_MARK(6,STP_FN,1)
      DSPA_ARROW(STP_FN,1,14)  &&   úD
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)	&& "úZúYúYú["
    ELSE
      *if LCHTYPE=14
      *   IF   (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] = 0 )	 .AND. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,8] > 0 )
      *     ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,8] * G2_WATER /100)
      *     A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,11]=ADJWN_f
      *      @	4,A_M_NAME[STP_FN-1,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,8]+ ADJWN_f  PICT "&XMC_F"
      *      SET COLOR TO &C2  / &C1
      *      *MTANK_MARK(6,STP_FN,1)
      *      DSPA_ARROW(STP_FN-1,1,14)	&&   úD
      *      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
      *      GS_CHG=3
      *   ENDIF
      *ENDIF
    endif
    do case
    CASE LCHTYPE=9 .or. LCHTYPE=10    .or. LCHTYPE=6 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13  .or. LCHTYPE=14
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
    CASE LCHTYPE=4
      SET COLOR TO &C10 / &C1
      *@ 11,7  SAY   "úZúYúYúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_RESCALL(STP_FN)
    CASE   LCHTYPE=14 .OR. LCHTYPE=5  .or. LCHTYPE=8  .OR. LCHTYPE=15 .or.  LCHTYPE=16 .or. LCHTYPE=17
      SET COLOR TO &C10 / &C1
      *@ 11,7  SAY   "úZúYúYúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_RESCALL(STP_FN)
      SETDLA(1,0)
    ENDCASE
    SET COLOR TO &C7 +/ &C1
    CLEACHMEM(STP_ZN)
    SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] +ADJWN
    x1=PFLOR&STP_FC
    x2=A_M_NAME[STP_FN,10]
    SETW1(STP_ZN,(SW1-PFLOR&STP_FC)*2048/A_M_NAME[STP_FN,10])
    x1=ERKG&STP_FC
    x2=A_M_NAME[STP_FN,10]
    SETW2(STP_ZN,(SW1-ERKG&STP_FC)*2048/A_M_NAME[STP_FN,10])
    SETOK(STP_ZN)
    DOUT(STP_ZN,1)
    STP3=3
  ENDCASE
CASE STP3=3
  do case
  case LCHTYPE=5  .or. LCHTYPE=8 .or. LCHTYPE=13  .OR. LCHTYPE=15   .or. LCHTYPE=17
    XP3=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
    XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
    XP5=XP3
    X=A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2]
    IF	-INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))   <> X
      ADJW12(STP_ZN,(-INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))  -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[U_PRESS,STPN&STP_FC,STP_FN,2] :=-INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))
      XMC_F=A_M_NAME[STP_FN,3]
      IF MODY_D1=0
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]-INT(PWATER *XP3*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP3+XP4))   PICT "&XMC_F"
      ENDIF
    ENDIF
  case	 LCHTYPE=14 .OR.  LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12
    ADJWN=0
    IF WATER_INPUT=1
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * S1_WATER /100)
      X=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
      IF  ADJWN   <> X
	ADJW12(STP_ZN,(ADJWN  -X)*2048/A_M_NAME[STP_FN,10])
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] :=ADJWN
	ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * S1_WATER /100)
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
	XMC_F=A_M_NAME[STP_FN,3]
	IF MODY_D1=0
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN_f  PICT "&XMC_F"
	ENDIF
      ENDIF
    else
       if    LCHTYPE=14
	 XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	 XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
	 ADJWN=  -INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
       endif
       X=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
       IF  ADJWN   <> X
	 ADJW12(STP_ZN,(ADJWN  -X)*2048/A_M_NAME[STP_FN,10])
	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] :=ADJWN
	 ADJWN_f=adjwn
	 A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
	 XMC_F=A_M_NAME[STP_FN,3]
	 IF MODY_D1=0
	   @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN_f  PICT "&XMC_F"
	 ENDIF
       ENDIF
    ENDIF
  case	 LCHTYPE=16
    ADJWN=0
    IF WATER_INPUT=1
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * (S1_WATER ) /100)
    ENDIF
    X=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]
    IF	ADJWN	<> X
      ADJW12(STP_ZN,(ADJWN  -X)*2048/A_M_NAME[STP_FN,10])
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] :=ADJWN
      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * S1_WATER /100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      XMC_F=A_M_NAME[STP_FN,3]
      IF MODY_D1=0
	@  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]+ADJWN_f  PICT "&XMC_F"
      ENDIF
    ENDIF
  ENDCASE
  TST1_LS1(STP_FN)
  IF LS1[STP_FN,2]=1
    RETU
  ENDIF
  TST0_LS2(STP_FN)
      IF RDOK2(STP_ZN)=0
	DOUT(STP_ZN,0)
	STOPTM&STP_FC=0
	EWN=CHENDATA(STP_ZN)
	if lchtype=14
	  EW1=EWN*A_M_NAME[STP_FN,9]/PER/2048
	  A_PRESS_B0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	endif
	EW1=EWN*A_M_NAME[STP_FN,10]/PER/2048
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	XMC_F=A_M_NAME[STP_FN,3]
	*@  8,A_M_NAME[STP_FN,13]  SAY	EW1   PICT "&XMC_F"
	SET COLOR TO &C2 / &C1
	*MTANK_MARK(6,STP_FN,0)
	DSPA_ARROW(STP_FN,0,0)	&& EREASE  úD
	SET COLOR TO &C7 +/ &C1
	DO CASE
	CASE LCHTYPE=2	.or. LCHTYPE=6	 .or. LCHTYPE=7 .or. LCHTYPE=9	 .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
	  STP&STP_FC=4
	  WTANK_F[STP_FN,1] :=1
	  *STP2=2
	  *X=EWN
	  *SETDLA(0,X)
	CASE LCHTYPE=4
	  STP3=4
	  DOUT3(0,0)
	  SETDLA(0,0)
	  IF KOT=1
	    WTANK_F[1,1] :=1
	    WTANK_F[2,1] :=1
	    WTANK_F[3,1] :=1
	  ENDIF
	CASE   LCHTYPE=14 .OR. LCHTYPE=5  .OR. LCHTYPE=15   .OR. LCHTYPE=21
	  DSPA_ARROW(STP_FN-1,0,0)  && EREASE  úD
	  STP3=0
	  STP4=1
	  DOUT3(0,0)
	  EWN=EWN+CHENDATA(0) +  CHENDATA(1)
	  SETDLA(0,EWN)
	CASE LCHTYPE=8	.or.  LCHTYPE=16 .or. LCHTYPE=17
	  STP3=0
	  STP4=1
	  DOUT3(0,0)
	  SETDLA(1,EWN)
	ENDCASE
      ENDIF
CASE STP3=4  .AND.  (WTANK_F[3,1]=-99)
  IF KOT=1
    IF ( DIN(9)=1 )   .OR.  ( DIN(12)=0)
      RETU
    ENDIF
  ELSE
    IF ( DIN(8)=1) .OR. (DIN(11)=0)
      RETU
    ENDIF
  ENDIF
  IF  TIME1[STP_FN,2] =0
    TIME1[STP_FN,2] :=SECONDS()
  ENDIF
  IF ABS(SECONDS()-TIME1[STP_FN,2]) >=TIME1[STP_FN,1]
    TIME1[STP_FN,2] :=0
    STP3=5
  ENDIF
  IF GS_DROPOK(A_M_NAME[STP_FN,8] +1)<> 1
    IF SPACIAL_0=0
      STP3=4
    ENDIF
  ENDIF
CASE STP3=5
  GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=2
  DO CAse
  CASE LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
    WTANK_F[3,1]=0
    TOTDR1=TOTDR1-1
    DRTKF=0
    TOTANK1=0
    STP3=6
    IF DSPDATA_A[STP_FN] =1
      SET COLOR TO &C11 / &C1
      *@ 11,7  SAY   "úLúPúPúKúPúPúO"
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
    ENDIF
    if	(A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
      SET COLOR TO &C11 / &C1
      *@ 11,7  SAY   "úLúPúPúKúPúPúO"
      DSPB_ARROW(A_M_NAME[STP_FN,8]+1,1,14)  && úD
      SETZERTM(2,PZERTM3)
      SETZEROK(2)
      dout2(A_M_NAME[STP_FN,8],1)
    ENDIF
    TOTANK=1
    SET COLOR TO &C7 +/ &C1
  CASE LCHTYPE=4
    WTANK_F[3,1]=0
    TOTDR1=TOTDR1-1
    DRTKF=0
    TOTANK1=0
    STP3=6
    SET COLOR TO &C11 / &C1
    *@ 11,7  SAY   "úLúPúPúKúPúPúO"
    DSPB_ARROW(1,1,14)	&& úD
    TOTANK=1

    if (LCHTYPE <> 6 .OR.   (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0))
      SET COLOR TO &C7 +/ &C1
      SETZERTM(0,PZERTM1)
      *SETZER(0,INT(((PZER1/A_M_NAME[1,6]))*PER*2048)+2048)
      SETZEROK(0)
      dout2(A_M_NAME[STP_FN,8],1)
    ENDIF
    IF LAGDATE=DATE()
      LAGW=LAGW+ A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]
    ELSE
      LAGW=VUSE
      LAGDATE=DATE()
    ENDIF
    SAVE TO LAGDATA9 ALL LIKE LAG*
    @ 0,26 SAY	LAGW   PICT  "9999.9"
    ACT_V=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,6]
    @ 17,12 SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,6]  PICT  "99.9"
  ENDCASE
  SANDCUTW[STP_FN,2] := 0
CASE STP3=6
  if ((LCHTYPE <> 6 .and.  LCHTYPE <> 13)  .OR.   (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0))
    TST1_LS2(STP_FN)
    IF LS2[STP_FN,2]=1
      RETU
    ENDIF
  ELSE
      setZokn(A_M_NAME[STP_FN,8],0)
  ENDIF
  IF SANDCUTW[STP_FN,1] >0
    DO	CASE
    CASE LCHTYPE=6
      IF  ( SANDCUTW[STP_FN,2] =0 )
	 X=INT((WDATA(A_M_NAME[STP_FN,8])-2048)*A_M_NAME[STP_FN,6]/PER/2048)
	 IF X <= SANDCUTW[STP_FN,1]
	   dout2(A_M_NAME[STP_FN,8],0)
	   GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=1
	   SANDCUTW[STP_FN,2] := 1
	   RETU
	 ENDIF
      ELSE
	IF CHK_LASTOUT() >1
	  RETU
	ENDIF
	SANDCUTW[STP_FN,2] := 1
	if  (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
	  dout2(A_M_NAME[STP_FN,8],1)
	ENDIF
      ENDIF
    ENDCASE
  ENDIF
  if  (A_PRESS_N0[L_PRESS,1,STP_FN,1]  <> 0)
    TST0_LS1(STP_FN,STP_FN)
  ENDIF
  IF  RDZEROK(A_M_NAME[STP_FN,8])=0
    DO CASE
    CASE  LCHTYPE=2 .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      dout2(A_M_NAME[STP_FN,8],0)
      DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      *@  4,A_M_NAME[3,13]  SAY  "    " PICT "&XMC_F"
      A_M_NAME[3,10] := A_M_NAME[3,9]
      A_M_NAME[3,12] := A_M_NAME[3,6]
      CLEACHMEM(STP_ZN)
      STPN3=STPN3+1
      STP3=7
      SET COLOR TO &C2 / &C1
      *@ 11,7  SAY   "úLúPúPúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[3,1] :=0
      WTANK_F[3,2] :=1
    CASE  LCHTYPE=4
      dout2(A_M_NAME[STP_FN,8],0)
      DOUT3(4,0)
      XMC_F=A_M_NAME[STP_FN,3]
      @  4,A_M_NAME[1,13]  SAY	"     " PICT "&XMC_F"
      @  4,A_M_NAME[2,13]  SAY	"     " PICT "&XMC_F"
      @  4,A_M_NAME[3,13]  SAY	"     " PICT "&XMC_F"
      A_M_NAME[1,10] := A_M_NAME[1,9]
      A_M_NAME[2,10] := A_M_NAME[2,9]
      A_M_NAME[3,10] := A_M_NAME[3,9]
      A_M_NAME[1,12] := A_M_NAME[1,6]
      CLEACHMEM(0)
      CLEACHMEM(1)
      CLEACHMEM(2)
      STPN1=STPN1+1
      STPN2=STPN2+1
      STPN3=STPN3+1
      STP3=7
      SET COLOR TO &C2 / &C1
      *@ 11,7  SAY   "úLúPúPúPúPúPúO"
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,0)
      SET COLOR TO &C7 +/ &C1
      WTANK_F[1,2] :=1
      WTANK_F[2,2] :=1
      WTANK_F[3,2] :=1
      WTANK_F[1,1] :=0
      WTANK_F[2,1] :=0
      WTANK_F[3,1] :=0
    ENDCASE
  ENDIF
CASE STP3=7
  DSPDATA_A[STP_FN] := 1
  IF SANDCUTW[STP_FN,1] =0
    GS_DROP[A_M_NAME[STP_FN,8] +1,2] :=1
  ENDIF
  GS_DROPRST()
  DO CASE
    CASE  LCHTYPE=2  .or. LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
      IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
	STP3=1
      ELSE
	STP3=0
	STPN3=1
	WTANK_F[STP_FN,3] :=1
      ENDIF
    CASE  LCHTYPE=4
      IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0)
	STP1=1
      ELSE
	STP1=0
	STPN1=1
	STPN2=1
	STPN3=1
	WTANK_F[STP_FN-2,3] :=1
	WTANK_F[STP_FN-1,3] :=1
	WTANK_F[STP_FN,3] :=1
      ENDIF
      STP3=0
  ENDCASE
ENDCASE
RETU
**------------------------------------------------------------------------------------------------------------
PROCEDURE  STP4
PARAMETERS  P1,P2,P3
STP_ZN=3
STP_FN=4
STP_FC="4"
DO CASE
CASE (STP4=0)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE LCHTYPE=2 .AND. NEXTOK1=1    .and. STP5=0
    IF (A_PRESS_N0[1,21,STP_FN,1] =77)
      a_copy_4(A_PRESS_N0,STP_FN,STP_FN+1)  && COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
      NEXTOK1=0
      A_PRESS_N0[1,21,STP_FN,1] :=0
      A_PRESS_N0[1,21,STP_FN+1,1] :=0
      STP&STP_FC=1
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,ix,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
  CASE LCHTYPE=4 .AND. NEXTOK1=1   .and. STP5=0
    IF (A_PRESS_N0[1,21,4,1] =77)
      A_PRESS_N0[1,21,4,1] :=0
      A_PRESS_N0[1,21,5,1] :=0
      a_copy_4(A_PRESS_N0,4,5)
      NEXTOK1=0
      STP4=1
      STP5=0
      FOR IX=1 TO (GS_TOT+UWC_TOT)
	IF  A_PRESS_N0[1,21,IX,1] =77
	  NEXTOK1=1
	ENDIF
      NEXT
    ENDIF
CASE (LCHTYPE=6   .or. LCHTYPE=7 .or. LCHTYPE=9 .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12  .or. LCHTYPE=13  ) .AND. NEXTOK1=1
  IF (A_PRESS_N0[1,21,STP_FN,1] =77)
    A_PRESS_N0[1,21,STP_FN,1] :=0
    a_copy_4(A_PRESS_N0,STP_FN,STP_FN)	&& COPY A_PRESS_N0[1,1-20,N1-N3,1-7) DATA TO A_PRESS_N0[2,1-20,N1-N3,1-7)
    A_PRESS_N0[1,21,STP_FN,1] :=0
    NEXTOK1=0
    STP&STP_FC=1
    FOR IX=1 TO (GS_TOT+UWC_TOT)
      IF  A_PRESS_N0[1,21,ix,1] =77
	NEXTOK1=1
      ENDIF
    NEXT
  ENDIF
  ENDCASE
CASE (STP4=1)	.and. (din(14)=1) .AND. (DIN(15)=1)    &&AUTO ,NO PAUSE
  DO  CASE
  CASE LCHTYPE=2
    IF ((A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1))
      WTANK_F[STP_FN,1] :=77
      WTANK_F[STP_FN+1,1] :=77
      STP&STP_FC=2
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
    ENDIF
  CASE LCHTYPE=4
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      IF KOT=1
	WTANK_F[4,1] :=77
	WTANK_F[5,1] :=77
      ENDIF
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
      STP4=2
    ENDIF
  CASE	 LCHTYPE=14 .OR. LCHTYPE=5   .or.  LCHTYPE=8  .OR. LCHTYPE=15 .or.  LCHTYPE=16 .or. LCHTYPE=17	 .or. LCHTYPE=21
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      WTANK_F[STP_FN,1] :=77
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
      STP4=2
    ENDIF
  CASE	 LCHTYPE=6    .or. LCHTYPE=7 .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13
    IF (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5] <>0 ) .and. (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] <>1)
      WTANK_F[STP_FN,1] :=77
      RDDELAY[STP_FN,2] :=SECONDS()
      RDDELAY[STP_FN,3] :=0
      STP4=2
    ENDIF
  ENDCASE
CASE STP4=2
  DRAF=0
  DO CASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] =0 )
    DO CASE
    CASE LCHTYPE=2
      STP&STP_FC=0
      STP5=1
      WTANK_F[STP_FN,1] :=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE LCHTYPE=4
      STP4=0
      STP5=2
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE   LCHTYPE=14 .OR. LCHTYPE=5   .OR.  LCHTYPE=6	 .or. LCHTYPE=7  .or.  LCHTYPE=8 .or. LCHTYPE=9   .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13  .OR. LCHTYPE=15
      STP4=3
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE   LCHTYPE=21
      STP4=0
      STP5=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    CASE     LCHTYPE=16 .or. LCHTYPE=17
      STP4=4
      WTANK_F[STP_FN-1,1] :=1
      WTANK_F[STP_FN,1] :=1
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4]	:=0
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7]	:=1
    ENDCASE
  CASE (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] > 0 )
    IF	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
      DSPDATA_A[STP_FN] := 1
    ELSE
      DSPDATA_A[STP_FN] := 0
    ENDIF
    ADJWN=0
    ADJWN_f=0
    IF WATER_INPUT=1
      IF UCHTYPE=16 .or. UCHTYPE=17
	IF GS_ADJW[3]>0
	  XA0=GS_ADJW[3]
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] -XA0
	ENDIF
      ENDIF
      ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * (S2_WATER )	/100)
      ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * S2_WATER /100)
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
      A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2]=ADJWN
      *adjwn=adjwn_f
    ENDIF
    DO CASE
    CASE LCHTYPE=2
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
      RDDLY(STP_FN,A_M_NAME[STP_FN,8],A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5)))     &&care
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  if  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] >0
	    @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8]-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5)) PICT  "&XMC_F"
	  endif
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] := -INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
	  DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
	  WTANK_F[STP_FN,1] :=1
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	    EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=EW1*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(A_M_NAME[STP_FN,8],EWN)

	    STP4=0
	    STP5=1
	  ELSE
	    EWN=WDATA(STP_ZN)-2048
	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    *SETCHDATA(STP_ZN,EWN)
	    *SETDLA(0,EWN)
	    STP&STP_FC=0
	    STP5=1
	  ENDIF
	ENDIF
	RETU
      ENDIF
    CASE LCHTYPE=21
       do  stp4_2_21
    CASE LCHTYPE=4
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1]
      RDDLY(STP_FN,1,A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5)))     &&care
      XRD := RDDELAY[STP_FN,3]
      IF XRD<>0
	IF XRD=1
	  XMC_F=A_M_NAME[STP_FN,3]
	  @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5)) PICT  "&XMC_F"
	  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] := -INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
	  DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
	  WTANK_F[STP_FN,1] :=1
	  IF  (A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN+1,1] >0)
	    EW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]-INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    EWN=EW1*2048/A_M_NAME[STP_FN,10]
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(1,EWN)
	    STP4=0
	    STP5=1
	  ELSE
	    EWN=WDATA(0)-2048
	    EW1=INT  ((EWN)*A_M_NAME[STP_FN,10]/PER/2048)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,4] := INT(EW1)
	    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,7] := 1
	    XMC_F=A_M_NAME[STP_FN,3]
	    *@	8,A_M_NAME[STP_FN,13]  SAY  EW1   PICT "&XMC_F"
	    SETCHDATA(STP_ZN,EWN)
	    SETDLA(1,EWN)
	    STP4=0
	    STP5=1
	  ENDIF
	ENDIF
	RETU
      endIF
    CASE   LCHTYPE=14 .OR. LCHTYPE=5   .OR.  LCHTYPE=6	.or. LCHTYPE=7	.or.  LCHTYPE=8 .or. LCHTYPE=9	.or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13  .OR. LCHTYPE=15  .or.	LCHTYPE=16 .or. LCHTYPE=17
      XP4=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1]
      XP5=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN-1,1]
    ENDCASE
    XMC_F=A_M_NAME[STP_FN,3]
    IF WATER_INPUT =0
      ADJWN=  -INT(PWATER *XP4*A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,5]/ratvol/(XP4+XP5))
      ADJWN_F=ADJWN
    ELSE
	ADJWN=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] * (S2_WATER )  /100)
	ADJWN_f=INT(A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] * S2_WATER /100)
	A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,11]=ADJWN_f
    ENDIF
    A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,2] := ADJWN
    *adjwn_f=adjwn
    IF	DSPDATA_A[STP_FN]=1
    @  4,A_M_NAME[STP_FN,13]  SAY  A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,8] +ADJWN_f PICT "&XMC_F"
    ENDIF
    SET COLOR TO &C2  / &C1
    *MTANK_MARK(6,STP_FN,1)
    IF DSPDATA_A[STP_FN] =1
      DSPA_ARROW(STP_FN,1,14)  &&   úD
      *DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)  && "úZúYúYú["
    ENDIF
    do case
    CASE LCHTYPE=2
      SET COLOR TO &C10 / &C1
      *@ 11,22 SAY   "úZúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_RESCALL(STP_FN)
      SETDLA(A_M_NAME[STP_FN,8],0)
    CASE LCHTYPE=4
      SET COLOR TO &C10 / &C1
      *@ 11,22 SAY   "úZúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_RESCALL(STP_FN)
      SETDLA(A_M_NAME[STP_FN,8],0)
    CASE   LCHTYPE=14 .OR. LCHTYPE=5   .or.  LCHTYPE=8	.OR. LCHTYPE=15 .or.  LCHTYPE=16 .or. LCHTYPE=17 .or. LCHTYPE=21
      SET COLOR TO &C10 / &C1
      *@ 11,22 SAY   "úZúYúYúYú["
      DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      WEIG_RESCALL(STP_FN)
    CASE   LCHTYPE=6  .or. LCHTYPE=7 .or. LCHTYPE=9  .or. LCHTYPE=10 .or. LCHTYPE=11 .or. LCHTYPE=12 .or. LCHTYPE=13

      SET COLOR TO &C10 / &C1
      *@ 11,22 SAY   "úZúYúYúYú["
      IF DSPDATA_A[STP_FN] =1
	DSPB_FMK(A_M_NAME[STP_FN,8]+1,1)
      ENDIF
      WEIG_RESCALL(STP_FN)
      SETDLA(A_M_NAME[STP_FN,8],0)
    ENDCASE
    SET COLOR TO &C7 +/ &C1
    SW1=A_PRESS_N0[L_PRESS,STPN&STP_FC,STP_FN,1] + ADJWN
    IF LCHTYPE =21
