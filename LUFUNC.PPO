#line 1 "\clip52e\INCLUDE\INKEY.CH"
#line 3 "LUFUNC.PRG"
FUNCTION   fget_dec
PARAMETERS  xsrc    
xint=len(alltrim(str(int(val(xsrc)),10,0)))
x_dec=len(xsrc)-xint
if x_dec >0
  x_dec=x_dec-1
endif
RETU x_dec



FUNCTION fSeek_C
PARAMETERS  f_dbfn,f_recname,f_seek,ret_rec,f_retu,ABSOL
ISSEEK=-1
actano=select(dbf())
dbSelectArea( f_dbfn )
IF EMPTY(DBF())=.F.
   __dbLocate( {||  ALLTRIM(f_seek) ==ALLTRIM( &f_recname)},,,, .F. )
     if  eof()=.T.  .AND. (ABSOL<>1)
       __dbLocate( {||  f_seek $ &f_recname},,,, .F. )
     endif
   if eof()=.F.
     ISSEEK=RECNO()
     f_retu=&ret_rec
   endif
ENDIF
dbSelectArea( actano )
retu  ISSEEK

FUNCTION fSeek_2C
PARAMETERS  f_dbfn,f_recname1,f_seek1,f_recname2,f_seek2,ret_rec1,ret_rec2,f_ret1,f_ret2
ISSEEK=-1
actano=select(dbf())
dbSelectArea( f_dbfn )
if empty(f_recname2)=.F.
  __dbLocate( {||  (    alltrim(&f_recname1)==alltrim(f_seek1))  .AND.      (  alltrim(&f_recname2)==alltrim(f_seek2))},,,, .F. )
else
  __dbLocate( {||  (    alltrim(&f_recname1)==alltrim(f_seek1))},,,, .F. )
endif
if eof()=.F.
  ISSEEK=RECNO()
   f_ret1=&ret_rec1
   IF EMPTY(ret_rec2)=.F.
     f_ret2=&ret_rec2
   ENDIF
endif
dbSelectArea( actano )
retu  ISSEEK

FUNCTION   fgetserno
PARAMETERS  xlen,xindex
xserno =substr(str(year(date()),4,0),-2,2)
xn=int(month(date()))
xserno=xserno    + fsubstr(xn,-2,"0",0)
xn=int(day(date()))
xserno=xserno    + fsubstr(xn,-2,"0",0)
xserno=xserno  + fsubstr(xindex,-(xlen-6),"0",0)
RETU  xserno

FUNCTION  fSelectNo
  workno=select(dbf())
RETU  workno

FUNCTION fTimeTON
PARAMETERS  P_TIME
TTON=(VAL(SUBSTR(P_TIME,1,2)) *3600 ) +(VAL(SUBSTR(P_TIME,4,2)) *60 )+VAL(SUBSTR(P_TIME,7,2))
RETU  TTON

FUNCTION fctoTime
PARAMETERS  xh,xm,xs
if valtype(xh)="C"
   xh=INT(val(xh))
endif
xh=INT(mod(xh,24))
xh=alltrim(str(xh,2,0))
xh=fsubstr(xh,-2,"0",0)

if valtype(xM)="C"
   xM=INT(val(xM))
endif
xm=INT(mod(xm,60))
xm=alltrim(str(xm,2,0))
xm=fsubstr(xm,-2,"0",0)
if valtype(xS)="C"
   xS=INT(val(xS))
endif
xs=INT(mod(xs,60))
xs=alltrim(str(xs,2,0))
xs=fsubstr(xs,-2,"0",0)

xret=xh+":"+xm +":" + xs
RETU   xret

FUNCTION  FNTOTIME
PARAMETERS p_hn,p_mn,p_sn,p_tots
if p_tots >=0
   p_hn=INT(p_TOTS/3600)
   p_mn=INT(MOD(p_TOTS,3600)/60)
   p_sn=MOD(p_TOTS,60)
endif
xret=FSUBSTR(p_hn,-2,"0",-2) +":" + FSUBSTR(p_mn,-2,"0",-2) +":" + FSUBSTR(p_sn,-2,"0",-2)

RETU  XRET

FUNCTION    FSUBSTR
PARAMETERS  S_S,XLEN,FC,S_DECN
if empty(s_s)=.T.
   S_S=0
   XRET_S=SPACE(ABS(XLEN))
   IF EMPTY(S_DECN)=.T.
      S_DECN=0
   ENDIF
   if s_s=0  .AND.  s_decn <0
     s_s=FC
     XRET_S=PADR(S_S,ABS(XLEN),FC)
   endif
ELSE
   if empty(s_s)=.T.
     RETU  SPACE(XLEN)
   endif

   IF EMPTY(S_DECN)=.T.
      S_DECN=0
   ENDIF
   IF S_DECN <0
     S_DECN=0
   ENDIF
   IF VALTYPE(S_S)="N"
     S_S=ALLTRIM(STR(S_S,10,S_DECN))
   ELSEIF VALTYPE(S_S)="D"
     S_S=DTOc(S_S)
   ENDIF
   S_S=ALLTRIM(S_S)
   if empty(s_s)=.T.
      XRET_S=SPACE(ABS(XLEN))
   ELSE
     IF XLEN >0
       XRET_S=PADR(S_S,XLEN,FC)
     ELSE
       XRET_S=PADL(S_S,ABS(XLEN),FC)
     ENDIF
   ENDIF
endif
RETU  XRET_S

