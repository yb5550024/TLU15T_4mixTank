SELE 5
SET CURS OFF
GOTO 2
    SET COLOR TO &C6 / &C1
 @ 24,0 SAY "∥      << 零點修正 >>    Esc- 恢復原值,  Enter- 輸入,    Ctl-End  結束       ∥"
    SET COLOR TO  gr +/ &C1
      @ 24,11 SAY "零點修正"
      @ 24,26 SAY "Esc"
      @ 24,42 SAY "Enter"
      @ 24,58 SAY "Ctl-End"
SET COLOR TO &C7 +/ &C1



 TN1=0
 TNSTP=1
 DO WHILE TN1<>233  .AND. TNSTP <=8
    DO CASE
    CASE TNSTP=1
	  TNSTP=READ2(PZER1,7,21,1,4)
	  SELE 5
	  GOTO 2
	  PZER1=PA1
    CASE TNSTP=2
	  TNSTP=READ2(PZER2,15,21,2,4)
	  SELE 5
	  GOTO 2
	  PZER2=PA2
    CASE TNSTP=3
	  TNSTP=READ2(PZER3,23,21,3,4)
	 SELE 5
	 GOTO 2
	 PZER3=PA3
    CASE TNSTP=4
	  TNSTP=READ2(PZER4,31,21,4,4)
	 SELE 5
	 GOTO 2
	 PZER4=PA4
    CASE TNSTP=5
	  TNSTP=READ2(PZER5,41,21,5,4)
	 SELE 5
	 GOTO 2
	 PZER5=PA5
    CASE TNSTP=6
	  TNSTP=READ2(PZER6,47,21,6,4)
	 SELE 5
	 GOTO 2
	 PZER6=PA6
    CASE TNSTP=7
	  TNSTP=READ2(PZER7,57,21,7,4)
	 SELE 5
	 GOTO 2
	 PZER7=PA7
    CASE TNSTP=9 .OR. TNSTP=8
	 TNSTP=9
	  TNSTP=READ2(PZER8,73,21,9,5)
	 SELE 5
	 GOTO 2
	 PZER8=PA8
    ENDCASE
 ENDDO



